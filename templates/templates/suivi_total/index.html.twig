{% extends 'admin/base_admin.html.twig' %}

{% block title %}Suivis Totaux{% endblock %}
{% block page_title %}<i class="fas fa-chart-line me-2"></i> Suivis totaux{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title">Liste des suivis</h4>
        <a href="{{ path('app_suivi_total_new') }}" class="btn btn-primary btn-sm">
            <i class="fa fa-plus"></i> Ajouter
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ENFANT</th>
                        <th>MOYENNE</th>
                        <th>REMARQUE</th>
                        <th>NIVEAU</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                {% for suivi_total in suivi_totals %}
                    <tr>
                        <td>{{ suivi_total.id }}</td>
                        <td>{{ suivi_total.enfantId }}</td>
                        <td>{{ suivi_total.moyenne }}</td>
                        <td>{{ suivi_total.remarque ?: '-' }}</td>
                        <td>{{ suivi_total.niveauJeu ? suivi_total.niveauJeu.libelle : '-' }}</td>
                        <td>
                            <a href="{{ path('app_suivi_total_show', {'id': suivi_total.id}) }}" class="btn btn-info btn-sm">
                                Show
                            </a>

                            <a href="{{ path('app_suivi_total_edit', {'id': suivi_total.id}) }}" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form method="post"
                                  action="{{ path('app_suivi_total_delete', {'id': suivi_total.id}) }}"
                                  style="display:inline-block"
                                  onsubmit="return confirm('Tu es sûr de vouloir supprimer ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suivi_total.id) }}">
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun suivi trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}