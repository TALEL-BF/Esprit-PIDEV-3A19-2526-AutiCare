{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="row">
    <div class="col-md-4 mb-3">
        {{ form_label(form.enfantId, 'Id enfant', {'label_attr': {'class': 'form-label fw-bold'}}) }}
        {{ form_widget(form.enfantId, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger small">{{ form_errors(form.enfantId) }}</div>
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.moyenne, 'Moyenne', {'label_attr': {'class': 'form-label fw-bold'}}) }}
        {{ form_widget(form.moyenne, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger small">{{ form_errors(form.moyenne) }}</div>
    </div>

    <div class="col-md-4 mb-3">
        {{ form_label(form.niveauJeu, 'Niveau', {'label_attr': {'class': 'form-label fw-bold'}}) }}
        {{ form_widget(form.niveauJeu, {'attr': {'class': 'form-select'}}) }}
        <div class="text-danger small">{{ form_errors(form.niveauJeu) }}</div>
    </div>

    <div class="col-12 mb-3">
        {{ form_label(form.remarque, 'Remarque', {'label_attr': {'class': 'form-label fw-bold'}}) }}
        {{ form_widget(form.remarque, {'attr': {'class': 'form-control', 'rows': 4}}) }}
        <div class="text-danger small">{{ form_errors(form.remarque) }}</div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    <a href="{{ path('app_suivi_total_index') }}" class="btn btn-secondary">Retour</a>
</div>

{{ form_end(form) }}