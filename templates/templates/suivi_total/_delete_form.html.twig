<form method="post"
      action="{{ path('app_suivi_total_delete', {'id': suivi_total.id}) }}"
      onsubmit="return confirm('Tu es sûr de vouloir supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suivi_total.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>