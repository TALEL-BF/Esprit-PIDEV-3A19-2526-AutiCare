{% extends 'base.html.twig' %}

{% block title %}TherapieEntity index{% endblock %}

{% block body %}
    <h1>TherapieEntity index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for therapie_entity in therapie_entities %}
            <tr>
                <td>{{ therapie_entity.id }}</td>
                <td>
                    <a href="{{ path('app_therapie_show', {'id': therapie_entity.id}) }}">show</a>
                    <a href="{{ path('app_therapie_edit', {'id': therapie_entity.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_therapie_new') }}">Create new</a>
{% endblock %}
