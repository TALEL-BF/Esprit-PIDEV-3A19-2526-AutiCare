<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Auticare Admin{% endblock %}</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Your shared styles -->
    <link rel="stylesheet" href="{{ asset('back/css/shared.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Sidebar included here #}
    {% include 'admin/partials/sidebar.html.twig' %}
    
    {# Navbar included here #}
    {% include 'admin/partials/navbar.html.twig' %}
    
    {# Main content #}
    <main id="main-content">
        {% block body %}{% endblock %}
    </main>
    
    <script>
        // ==================== SIDEBAR TOGGLE ====================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const navbar = document.getElementById('navbar');
            const mainContent = document.getElementById('main-content');
            
            if (sidebar) sidebar.classList.toggle('collapsed');
            if (navbar) navbar.classList.toggle('full-width');
            if (mainContent) mainContent.classList.toggle('full-width');
        }
        
        // ==================== NAVIGATION SECTION TOGGLE ====================
        function toggleSection(sectionId, event) {
            // Récupérer l'événement
            const evt = event || window.event;
            if (!evt) return;
            
            const navItem = evt.currentTarget.closest('.nav-item-wrap');
            if (!navItem) return;
            
            // Si on clique sur un élément déjà ouvert, on le ferme
            if (navItem.classList.contains('open')) {
                navItem.classList.remove('open');
            } else {
                // Sinon, on ferme tous les autres et on ouvre celui-ci
                document.querySelectorAll('.nav-item-wrap.open').forEach(item => {
                    item.classList.remove('open');
                });
                navItem.classList.add('open');
            }
        }
        
        // ==================== MOBILE SIDEBAR CLOSE ====================
        document.addEventListener('DOMContentLoaded', function() {
            // Fermer le sidebar sur mobile quand on clique sur un lien
            const allLinks = document.querySelectorAll('.nav-link-item, .nav-sub-link');
            allLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth <= 768) {
                        const sidebar = document.getElementById('sidebar');
                        if (sidebar) sidebar.classList.remove('open');
                    }
                });
            });
            
            // ==================== GARDER LE MENU OUVERT SUR LA PAGE ACTIVE ====================
            // Trouver le lien actif dans les sous-menus
            const activeSubLink = document.querySelector('.nav-sub-link.active');
            if (activeSubLink) {
                const parentWrap = activeSubLink.closest('.nav-item-wrap');
                if (parentWrap) {
                    parentWrap.classList.add('open');
                }
            }
            
            // Pour les liens directs (comme Tableau de bord)
            const activeDirectLink = document.querySelector('.nav-link-item.active');
            if (activeDirectLink) {
                const parentWrap = activeDirectLink.closest('.nav-item-wrap');
                if (parentWrap) {
                    parentWrap.classList.add('open');
                }
            }
        });
        
        // ==================== SÉCURITÉ POUR LES LIENS EXTERNES ====================
        // Éviter les erreurs si des éléments n'existent pas
        window.addEventListener('load', function() {
            console.log('Admin panel chargé avec succès');
        });
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>