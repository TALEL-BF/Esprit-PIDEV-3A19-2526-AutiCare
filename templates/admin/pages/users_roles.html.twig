{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Rôles & Permissions{% endblock %}

{% block page_title %}Rôles & Permissions{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
    .badge-purple {
        background: rgba(168, 85, 247, 0.15);
        color: #a855f7;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-shield-alt me-2" style="color:var(--purple-500)"></i>Rôles & Permissions</h2>
    <p>Configurer les accès et droits de chaque rôle</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Rôles actifs</div>
                    <div class="stat-value">{{ totalRoles|default(4) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-shield-alt"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> configurés</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Admins</div>
                    <div class="stat-value">{{ adminCount|default(48) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-user-cog"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> 4% total</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Thérapeutes</div>
                    <div class="stat-value">{{ therapistCount|default(240) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-user-md"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> 19% total</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Parents</div>
                    <div class="stat-value">{{ parentCount|default(680) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-users"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> 54% total</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Créer / Modifier un Rôle</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom du rôle</label>
                        <input type="text" class="form-control" id="roleName" placeholder="Ex: Superviseur">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Couleur d'identification</label>
                        <input type="color" class="form-control" id="roleColor" value="#a855f7">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="roleDescription" rows="2" placeholder="Décrivez les responsabilités..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Accès tableau de bord</label>
                        <select class="form-select" id="roleDashboard">
                            <option>Complet</option>
                            <option>Partiel</option>
                            <option>Aucun</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gestion utilisateurs</label>
                        <select class="form-select" id="roleUsers">
                            <option>Lecture seule</option>
                            <option>Lecture/Écriture</option>
                            <option>Aucun</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gestion cours</label>
                        <select class="form-select" id="roleCourses">
                            <option>Lecture/Écriture</option>
                            <option>Lecture seule</option>
                            <option>Aucun</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="roleStatus">
                            <option>Actif</option>
                            <option>Désactivé</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveRoleBtn"><i class="fas fa-save"></i> Enregistrer</button>
                        <button class="btn-outline-purple" id="cancelRoleBtn"><i class="fas fa-times"></i> Annuler</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-pie"></i> Répartition des rôles</span>
            </div>
            <div class="card-box-body">
                <canvas id="rolesChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Tableau des Rôles</span>
        <input type="text" class="form-control filter-input" id="roleFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="rolesTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Rôle</th>
                        <th>Utilisateurs</th>
                        <th>Dashboard</th>
                        <th>Cours</th>
                        <th>Consultations</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles|default([
                        {id:1, name:'Admin', users:48, dashboard:'Complet', courses:'Lecture/Écriture', consultations:'Lecture/Écriture', status:'Actif'},
                        {id:2, name:'Thérapeute', users:240, dashboard:'Partiel', courses:'Lecture seule', consultations:'Lecture/Écriture', status:'Actif'},
                        {id:3, name:'Enseignant', users:280, dashboard:'Partiel', courses:'Lecture/Écriture', consultations:'Lecture seule', status:'Actif'},
                        {id:4, name:'Parent', users:680, dashboard:'Aucun', courses:'Lecture seule', consultations:'Lecture seule', status:'Actif'}
                    ]) %}
                        <tr>
                            <td>{{ role.id }}</td>
                            <td><span class="badge-purple">{{ role.name }}</span></td>
                            <td>{{ role.users }}</td>
                            <td>{{ role.dashboard }}</td>
                            <td>{{ role.courses }}</td>
                            <td>{{ role.consultations }}</td>
                            <td>
                                {% if role.status == 'Actif' %}
                                    <span class="badge-status badge-active">{{ role.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ role.status }}</span>
                                {% endif %}
                            </span>
                            </td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-role-btn" data-id="{{ role.id }}">Modifier</button>
                                <button class="btn-danger-soft delete-role-btn" data-id="{{ role.id }}">Supprimer</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const P = { p400: '#a855f7', pink: '#f472b6', indigo: '#818cf8', accent: '#e040fb' };

    // Doughnut Chart - Répartition des rôles
    new Chart(document.getElementById('rolesChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Parent', 'Thérapeute', 'Enseignant', 'Admin'],
            datasets: [{
                data: [680, 240, 280, 48],
                backgroundColor: [P.p400, P.pink, P.indigo, P.accent],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        font: { family: 'DM Sans', size: 11 }
                    }
                }
            },
            cutout: '60%',
            responsive: true
        }
    });

    // Filter table
    document.getElementById('roleFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#rolesTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Edit button
    document.querySelectorAll('.edit-role-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('formMode').textContent = 'Mode : Modification';
            const id = this.getAttribute('data-id');
            console.log('Edit role:', id);
            // Here you would load role data into the form
        });
    });

    // Delete button
    document.querySelectorAll('.delete-role-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Supprimer ce rôle ?')) {
                this.closest('tr').remove();
            }
        });
    });

    // Cancel button
    document.getElementById('cancelRoleBtn')?.addEventListener('click', function() {
        document.getElementById('formMode').textContent = 'Mode : Ajout';
        document.getElementById('roleName').value = '';
        document.getElementById('roleColor').value = '#a855f7';
        document.getElementById('roleDescription').value = '';
    });

    // Save button
    document.getElementById('saveRoleBtn')?.addEventListener('click', function() {
        const roleName = document.getElementById('roleName')?.value;
        if (!roleName) {
            alert('Veuillez saisir un nom de rôle');
            return;
        }
        console.log('Save role:', {
            name: roleName,
            color: document.getElementById('roleColor')?.value,
            description: document.getElementById('roleDescription')?.value,
            dashboard: document.getElementById('roleDashboard')?.value,
            users: document.getElementById('roleUsers')?.value,
            courses: document.getElementById('roleCourses')?.value,
            status: document.getElementById('roleStatus')?.value
        });
        alert('Rôle enregistré (démo)');
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    });
});
</script>
{% endblock %}