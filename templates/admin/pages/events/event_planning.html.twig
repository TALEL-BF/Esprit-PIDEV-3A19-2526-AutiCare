{% extends 'admin/base_admin.html.twig' %}

{% block title %}Planning IA - {{ event.titre }}{% endblock %}

{% block page_title %}🤖 Planning Intelligent : {{ event.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ========== DESIGN ÉLÉVATÉ POUR LE PLANNING ========== */
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-success: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --gradient-warning: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --gradient-info: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
        --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.1);
        --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.05);
        --border-radius: 28px;
    }

    .planning-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* En-tête avec effet glassmorphism */
    .planning-hero {
        background: var(--gradient-primary);
        border-radius: var(--border-radius);
        padding: 30px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }

    .planning-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 1%, transparent 1%);
        background-size: 50px 50px;
        animation: shimmer 20s linear infinite;
    }

    @keyframes shimmer {
        0% { transform: translate(0, 0); }
        100% { transform: translate(50px, 50px); }
    }

    .planning-hero h3 {
        font-size: 1.8rem;
        font-weight: 800;
        color: white;
        margin-bottom: 15px;
        position: relative;
        z-index: 1;
    }

    .planning-hero p {
        color: rgba(255,255,255,0.9);
        margin-bottom: 8px;
        position: relative;
        z-index: 1;
    }

    /* Boutons avec effet 3D */
    .btn-3d {
        padding: 12px 28px;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-3d::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }

    .btn-3d:hover::before {
        left: 100%;
    }

    .btn-3d:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .btn-generate {
        background: var(--gradient-warning);
        color: white;
    }

    .btn-save-all {
        background: var(--gradient-success);
        color: white;
    }

    .btn-back {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.3);
        color: white;
    }

    /* Cartes des créneaux avec animation */
    .creneau-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid rgba(102, 126, 234, 0.15);
        position: relative;
        overflow: hidden;
    }

    .creneau-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        transition: width 0.3s ease;
    }

    .creneau-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .creneau-card:hover::before {
        width: 8px;
    }

    /* Couleurs de bordure par type */
    .creneau-card[data-type="accueil"]::before { background: #4facfe; }
    .creneau-card[data-type="activite"]::before { background: #11998e; }
    .creneau-card[data-type="pause"]::before { background: #f093fb; }
    .creneau-card[data-type="transition"]::before { background: #f5576c; }
    .creneau-card[data-type="cloture"]::before { background: #764ba2; }

    .creneau-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px dashed #e0e7ff;
    }

    .creneau-title {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .creneau-title input {
        font-size: 1.2rem;
        font-weight: 700;
        padding: 8px 16px;
        border: 2px solid #e0e7ff;
        border-radius: 50px;
        background: white;
        width: 250px;
        transition: all 0.2s;
    }

    .creneau-title input:focus {
        border-color: #667eea;
        outline: none;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
    }

    .creneau-hours {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        padding: 5px 15px;
        border-radius: 50px;
    }

    .creneau-hours input {
        width: 100px;
        padding: 8px 12px;
        border: 1px solid #e0e7ff;
        border-radius: 30px;
        text-align: center;
        font-weight: 600;
        background: white;
    }

    .creneau-hours span {
        font-weight: 700;
        color: #667eea;
    }

    /* Grille des champs */
    .creneau-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .creneau-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .creneau-field label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #667eea;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .creneau-field select,
    .creneau-field textarea {
        padding: 10px 14px;
        border: 2px solid #e0e7ff;
        border-radius: 16px;
        background: white;
        transition: all 0.2s;
        font-family: inherit;
    }

    .creneau-field select:focus,
    .creneau-field textarea:focus {
        border-color: #667eea;
        outline: none;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
    }

    .creneau-field textarea {
        resize: vertical;
        min-height: 80px;
    }

    /* Boutons d'action sur les créneaux */
    .creneau-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #e0e7ff;
    }

    .btn-creneau-save {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-creneau-delete {
        background: linear-gradient(135deg, #f5576c, #f093fb);
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-creneau-save:hover,
    .btn-creneau-delete:hover {
        transform: scale(1.02);
        filter: brightness(1.05);
    }

    /* Bouton ajouter */
    .btn-add-container {
        text-align: center;
        margin: 30px 0 20px;
    }

    .btn-add-creneau {
        background: var(--gradient-primary);
        color: white;
        border: none;
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--shadow-sm);
    }

    .btn-add-creneau:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: var(--shadow-lg);
    }

    /* État vide */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 32px;
    }

    .empty-state i {
        font-size: 4rem;
        color: #cbd5e1;
        margin-bottom: 20px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 1.1rem;
    }

    /* Badges de type */
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .type-accueil { background: #e0f2fe; color: #0369a1; }
    .type-activite { background: #dcfce7; color: #166534; }
    .type-pause { background: #fef3c7; color: #92400e; }
    .type-transition { background: #fce7f3; color: #9d174d; }
    .type-cloture { background: #e0e7ff; color: #3730a3; }

    /* Loader */
    .loading-state {
        text-align: center;
        padding: 60px;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e0e7ff;
        border-top-color: #667eea;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 20px;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .planning-hero h3 { font-size: 1.3rem; }
        .creneau-grid { grid-template-columns: 1fr; }
        .creneau-header { flex-direction: column; align-items: stretch; }
        .btn-3d { padding: 8px 16px; font-size: 0.8rem; }
    }

    /* Toast notification */
    .toast-notification {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: white;
        border-radius: 16px;
        padding: 12px 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 10000;
        animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast-success { border-left: 4px solid #11998e; }
    .toast-error { border-left: 4px solid #f5576c; }
</style>
{% endblock %}

{% block body %}
<div class="planning-container">
    <!-- Hero section -->
    <div class="planning-hero">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
            <div>
                <h3>
                    <i class="fas fa-robot"></i> 
                    Planning Intelligent
                </h3>
                <p><i class="fas fa-calendar-alt"></i> {{ event.dateDebut|date('d/m/Y') }} | 
                   <i class="fas fa-clock"></i> {{ event.heureDebut|date('H:i') }} - {{ event.heureFin|date('H:i') }}
                </p>
                <p><i class="fas fa-map-marker-alt"></i> {{ event.lieu }}</p>
            </div>
            <div style="display: flex; gap: 15px;">
                <a href="{{ path('admin_evenements') }}" class="btn-3d btn-back">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <button class="btn-3d btn-generate" onclick="generatePlanning()">
                    <i class="fas fa-magic"></i> Générer avec IA
                </button>
                <button class="btn-3d btn-save-all" onclick="saveAllCreneaux()">
                    <i class="fas fa-save"></i> Sauvegarder tout
                </button>
            </div>
        </div>
    </div>

    <!-- Conteneur des créneaux -->
    <div id="creneauxContainer">
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Chargement du planning...</p>
        </div>
    </div>

    <!-- Bouton ajouter -->
    <div class="btn-add-container">
        <button class="btn-add-creneau" onclick="ajouterCreneau()">
            <i class="fas fa-plus-circle"></i> Ajouter un créneau
        </button>
    </div>
</div>

<script>
    let eventId = {{ event.idEvent }};
    let creneaux = [];

    // Chargement initial
    document.addEventListener('DOMContentLoaded', loadPlanning);

    function loadPlanning() {
        fetch('/admin/evenements/' + eventId + '/planning/get')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    creneaux = data.planning.creneaux || [];
                } else {
                    creneaux = [];
                }
                renderCreneaux();
            })
            .catch(error => {
                console.error('Erreur:', error);
                creneaux = [];
                renderCreneaux();
            });
    }

    function renderCreneaux() {
        const container = document.getElementById('creneauxContainer');
        
        if (!creneaux || creneaux.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-calendar-alt"></i>
                    <p>Aucun créneau pour le moment</p>
                    <small>Cliquez sur "Générer avec IA" ou "Ajouter un créneau" pour commencer</small>
                </div>
            `;
            return;
        }

        let html = '';
        creneaux.forEach((creneau, index) => {
            const typeClass = {
                'accueil': 'type-accueil',
                'activite': 'type-activite',
                'pause': 'type-pause',
                'transition': 'type-transition',
                'cloture': 'type-cloture'
            }[creneau.type] || 'type-accueil';

            const typeIcon = {
                'accueil': '🏠',
                'activite': '🎨',
                'pause': '🧘',
                'transition': '🔄',
                'cloture': '🏁'
            }[creneau.type] || '📌';

            html += `
                <div class="creneau-card" data-type="${creneau.type}">
                    <div class="creneau-header">
                        <div class="creneau-title">
                            <input type="text" value="${escapeHtml(creneau.titre)}" 
                                   onchange="updateCreneau(${index}, 'titre', this.value)"
                                   placeholder="Titre du créneau">
                            <span class="type-badge ${typeClass}">${typeIcon} ${creneau.type}</span>
                        </div>
                        <div class="creneau-hours">
                            <input type="time" value="${creneau.heure_debut}" 
                                   onchange="updateCreneau(${index}, 'heure_debut', this.value)">
                            <span>→</span>
                            <input type="time" value="${creneau.heure_fin}" 
                                   onchange="updateCreneau(${index}, 'heure_fin', this.value)">
                        </div>
                    </div>

                    <div class="creneau-grid">
                        <div class="creneau-field">
                            <label><i class="fas fa-tag"></i> Type d'activité</label>
                            <select onchange="updateCreneau(${index}, 'type', this.value)">
                                <option value="accueil" ${creneau.type === 'accueil' ? 'selected' : ''}>🏠 Accueil</option>
                                <option value="activite" ${creneau.type === 'activite' ? 'selected' : ''}>🎨 Activité</option>
                                <option value="pause" ${creneau.type === 'pause' ? 'selected' : ''}>🧘 Pause sensorielle</option>
                                <option value="transition" ${creneau.type === 'transition' ? 'selected' : ''}>🔄 Transition</option>
                                <option value="cloture" ${creneau.type === 'cloture' ? 'selected' : ''}>🏁 Clôture</option>
                            </select>
                        </div>

                        <div class="creneau-field">
                            <label><i class="fas fa-brain"></i> Charge sensorielle</label>
                            <select onchange="updateCreneau(${index}, 'sensoriel', this.value)">
                                <option value="calme" ${creneau.sensoriel === 'calme' ? 'selected' : ''}>🧘 Calme - Peu de stimuli</option>
                                <option value="modere" ${creneau.sensoriel === 'modere' ? 'selected' : ''}>🎨 Modéré - Stimuli contrôlés</option>
                                <option value="actif" ${creneau.sensoriel === 'actif' ? 'selected' : ''}>🏃 Actif - Mouvement et interaction</option>
                                <option value="pause" ${creneau.sensoriel === 'pause' ? 'selected' : ''}>🧘 Pause - Retrait sensoriel</option>
                            </select>
                        </div>

                        <div class="creneau-field">
                            <label><i class="fas fa-align-left"></i> Description</label>
                            <textarea onchange="updateCreneau(${index}, 'description', this.value)" 
                                      placeholder="Description détaillée du créneau...">${escapeHtml(creneau.description || '')}</textarea>
                        </div>
                    </div>

                    <div class="creneau-actions">
                        <button class="btn-creneau-save" onclick="sauvegarderCreneau(${index})">
                            <i class="fas fa-save"></i> Sauvegarder
                        </button>
                        <button class="btn-creneau-delete" onclick="supprimerCreneau(${index})">
                            <i class="fas fa-trash-alt"></i> Supprimer
                        </button>
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    function updateCreneau(index, field, value) {
        if (creneaux[index]) {
            creneaux[index][field] = value;
        }
    }

    function sauvegarderCreneau(index) {
        saveAllCreneaux();
    }

    function supprimerCreneau(index) {
        if (confirm('Supprimer ce créneau ?')) {
            creneaux.splice(index, 1);
            renderCreneaux();
            saveAllCreneaux();
        }
    }

    function ajouterCreneau() {
        const newCreneau = {
            heure_debut: '09:00',
            heure_fin: '09:20',
            titre: 'Nouveau créneau',
            description: '',
            type: 'activite',
            sensoriel: 'modere'
        };
        creneaux.push(newCreneau);
        renderCreneaux();
        showToast('Nouveau créneau ajouté', 'success');
    }

    function saveAllCreneaux() {
        const planningData = { creneaux: creneaux };
        
        fetch('/admin/evenements/' + eventId + '/planning/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planning: planningData })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showToast('Planning sauvegardé avec succès !', 'success');
            } else {
                showToast('Erreur lors de la sauvegarde', 'error');
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            showToast('Erreur de connexion', 'error');
        });
    }

    function generatePlanning() {
        if (!confirm('Générer un planning avec IA ? Cela remplacera le planning actuel.')) {
            return;
        }
        
        showLoading(true);
        
        fetch('/admin/evenements/' + eventId + '/planning/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            showLoading(false);
            if (data.success) {
                creneaux = data.planning.creneaux || [];
                renderCreneaux();
                showToast('Planning généré avec succès par l\'IA !', 'success');
            } else {
                showToast('Erreur: ' + (data.error || 'Génération échouée'), 'error');
            }
        })
        .catch(error => {
            showLoading(false);
            console.error('Erreur:', error);
            showToast('Erreur de connexion au serveur', 'error');
        });
    }

    function showLoading(show) {
        const container = document.getElementById('creneauxContainer');
        if (show) {
            container.innerHTML = `
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>🤖 L'IA génère le planning intelligent...</p>
                    <small>Cela peut prendre quelques secondes</small>
                </div>
            `;
        }
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `toast-notification toast-${type === 'success' ? 'success' : 'error'}`;
        toast.innerHTML = `
            <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}" 
               style="color: ${type === 'success' ? '#11998e' : '#f5576c'}; font-size: 1.2rem;"></i>
            <span>${message}</span>
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
{% endblock %}