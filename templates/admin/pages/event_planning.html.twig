{% extends 'admin/base_admin.html.twig' %}

{% block title %}Planning IA - {{ event.titre }}{% endblock %}

{% block page_title %}📅 Planning : {{ event.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ========== PASTEL DASHBOARD STYLE ========== */
    :root {
        --pastel-purple: #f3e8ff;
        --pastel-purple-dark: #a855f7;
        --pastel-purple-light: #e879f9;
        --pastel-green: #dcfce7;
        --pastel-green-dark: #22c55e;
        --pastel-orange: #ffedd5;
        --pastel-orange-dark: #f97316;
        --pastel-red: #fee2e2;
        --pastel-red-dark: #ef4444;
        --pastel-pink: #fce7f3;
        --pastel-blue: #e0f2fe;
        --pastel-mint: #d1fae5;
        --pastel-yellow: #fef3c7;
        --text-main: #1f2937;
        --text-soft: #6b7280;
    }

    body {
        background: linear-gradient(135deg, #faf5ff 0%, #fdf4ff 100%);
        min-height: 100vh;
    }
    /* Couleurs pour les émojis dans les stats */
.recap-stat i, .recap-stat .emoji {
    font-size: 1.1rem;
}
/* ========== POPUP DE CONFIRMATION SUPPRESSION ========== */
.delete-popup-wrap {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2001;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}
/* ========== POPUP DE CONFIRMATION IA ========== */
.ia-popup-wrap {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2002;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.ia-popup-wrap.show {
    opacity: 1;
    visibility: visible;
}

.ia-popup {
    background: linear-gradient(135deg, #ffffff, #faf5ff);
    border-radius: 40px;
    padding: 30px 35px;
    max-width: 380px;
    width: 90%;
    text-align: center;
    transform: scale(0.9);
    transition: transform 0.3s ease;
    border: 2px solid #f59e0b;
}

.ia-popup-wrap.show .ia-popup {
    transform: scale(1);
}

.ia-popup-icon {
    font-size: 4rem;
    display: block;
    margin-bottom: 12px;
}

.ia-popup-title {
    font-family: 'Baloo 2', cursive;
    font-size: 1.6rem;
    font-weight: 900;
    color: #d97706;
    margin-bottom: 8px;
}

.ia-popup-stars {
    font-size: 1.2rem;
    letter-spacing: 4px;
    color: #f59e0b;
    margin-bottom: 12px;
}

.ia-popup-desc {
    font-size: 0.9rem;
    color: #4b5563;
    background: #fffbeb;
    border-radius: 20px;
    padding: 12px;
    margin: 12px 0;
}

.ia-popup-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 15px;
}

.ia-popup-btn {
    border: none;
    border-radius: 50px;
    padding: 10px 20px;
    font-family: 'Baloo 2', cursive;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s;
    flex: 1;
}

.ia-popup-btn.confirm {
    background: linear-gradient(135deg, #f59e0b, #fbbf24);
    color: white;
}

.ia-popup-btn.confirm:hover {
    transform: scale(1.02);
}

.ia-popup-btn.cancel {
    background: linear-gradient(135deg, #e5e7eb, #d1d5db);
    color: #4b5563;
}

.ia-popup-btn.cancel:hover {
    transform: scale(1.02);
}

