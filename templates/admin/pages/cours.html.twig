{# templates/admin/pages/cours.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Gestion des Cours{% endblock %}
{% block page_title %}Gestion des Cours{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>

:root {
    --pastel-sky:         #dbeafe;
    --pastel-sky-b:       #9fc8f7;
    --pastel-mint:        #d1fae5;
    --pastel-mint-b:      #ccf6e5;
    --pastel-peach:       #ffe4cc;
    --pastel-peach-b:     #f1d2b0;
    --pastel-lavender:    #ede9fe;
    --pastel-lavender-b:  #c4b5fd;
    --pastel-rose:        #fce7f3;
    --pastel-rose-b:      #f9a8d4;
    --pastel-yellow:      #fef9c3;
    --pastel-yellow-b:    #fde68a;
    --txt-soft:           #475569;
    --txt-label:          #334155;
}

/* ── filtre ── */
.filter-input {
    width: 200px; font-size:.8rem; padding:6px 14px;
    border-radius:20px; border:1.5px solid var(--pastel-lavender-b);
    background:var(--pastel-lavender);
}
.filter-input:focus { outline:none; border-color:#a78bfa; box-shadow:0 0 0 3px rgba(167,139,250,.15); }

/* ══════════════════════════
   SECTIONS COLORÉES DU FORM
   ══════════════════════════ */
.form-section {
    border-radius:18px;
    padding:1.1rem 1.4rem 1.2rem;
    margin-bottom:1rem;
    border:1.5px solid transparent;
}
.form-section-title {
    font-size:0.78rem; font-weight:700; letter-spacing:.05em;
    text-transform:uppercase; margin-bottom:.9rem;
    display:flex; align-items:center; gap:.5rem;
}
.section-icon {
    width:26px; height:26px; border-radius:8px;
    display:flex; align-items:center; justify-content:center; font-size:.85rem;
}

/* Bleu – Infos générales */
.fs-blue  { background:var(--pastel-sky);      border-color:var(--pastel-sky-b);      }
.fs-blue  .form-section-title { color:#1d4ed8; }
.fs-blue  .section-icon       { background:#bfdbfe; color:#1d4ed8; }

/* Vert – Niveau & Durée */
.fs-mint  { background:var(--pastel-mint);     border-color:var(--pastel-mint-b);     }
.fs-mint  .form-section-title { color:#065f46; }
.fs-mint  .section-icon       { background:#a7f3d0; color:#065f46; }

/* Pêche – Image */
.fs-peach { background:var(--pastel-peach);    border-color:var(--pastel-peach-b);    }
.fs-peach .form-section-title { color:#9a3412; }
.fs-peach .section-icon       { background:#fed7aa; color:#c2410c; }

/* Lavande – Description */
.fs-lavender { background:var(--pastel-lavender); border-color:var(--pastel-lavender-b); }
.fs-lavender .form-section-title { color:#5b21b6; }
.fs-lavender .section-icon       { background:#ddd6fe; color:#6d28d9; }

/* Rose – Mots & Images */
.fs-rose  { background:var(--pastel-rose);     border-color:var(--pastel-rose-b);     }
.fs-rose  .form-section-title { color:#9d174d; }
.fs-rose  .section-icon       { background:var(--pastel-rose); color:#be185d; }

/* ── Champs formulaire ── */
.form-control, .form-select {
    border-radius:12px; border:1.5px solid #cbd5e1;
    font-size:.88rem; padding:.5rem .85rem;
    transition:all 0.2s; background:#fff; color:var(--txt-soft);
}
.form-control:focus, .form-select:focus {
    outline:none; border-color:#a78bfa;
    box-shadow:0 0 0 3px rgba(167,139,250,.18); background:#fefefe;
}
.form-label {
    font-size:.8rem; font-weight:600; color:var(--txt-label);
    margin-bottom:4px; display:flex; align-items:center; gap:5px;
}

/* Badge mode */
.form-mode-badge {
    font-size:.72rem; font-weight:600; padding:4px 12px;
    border-radius:20px; background:var(--pastel-yellow);
    color:#92400e; border:1px solid var(--pastel-yellow-b);
}

/* ── Carte mot ── */
.mot-image-card {
    background:#fff; border-radius:16px; padding:1rem 1.2rem;
    margin-bottom:.85rem; border:1.5px solid var(--pastel-rose-b);
    transition:all 0.2s;
}
.mot-image-card:hover {
    border-color:#f472b6;
    box-shadow:0 4px 14px rgba(244,114,182,.12);
}
.mot-image-card:nth-child(odd)  { border-color:#f9a8d4; background:#fff9fb; }
.mot-image-card:nth-child(even) { border-color:#c4b5fd; background:#fdfbff; }

.mot-number {
    width:34px; height:34px;
    background:linear-gradient(135deg,#f9a8d4,#c4b5fd);
    color:#fff; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:.9rem;
    box-shadow:0 2px 6px rgba(196,181,253,.4);
}

/* ── Bouton ajouter mot ── */
.btn-add-word {
    background:linear-gradient(135deg,var(--pastel-mint),var(--pastel-sky));
    color:#065f46; border:1.5px dashed var(--pastel-mint-b);
    border-radius:14px; padding:.75rem; text-align:center;
    cursor:pointer; transition:all 0.2s; width:100%;
    font-weight:600; font-size:.85rem;
}
.btn-add-word:hover {
    background:linear-gradient(135deg,#a7f3d0,#bfdbfe);
    border-color:#6ee7b7; transform:translateY(-1px);
    box-shadow:0 4px 12px rgba(110,231,183,.2);
}

/* ── Bouton sauvegarder ── */
.btn-save-cours {
    background:linear-gradient(135deg,#818cf8,#a78bfa);
    color:#fff; border:none; border-radius:14px;
    padding:.65rem 1.8rem; font-weight:700; font-size:.9rem;
    cursor:pointer; transition:all 0.2s;
    box-shadow:0 4px 12px rgba(129,140,248,.3);
}
.btn-save-cours:hover {
    background:linear-gradient(135deg,#6366f1,#8b5cf6);
    transform:translateY(-1px); box-shadow:0 6px 18px rgba(99,102,241,.35);
}

/* ── Bouton annuler ── */
.btn-cancel-cours {
    background:var(--pastel-peach); color:#9a3412;
    border:1.5px solid var(--pastel-peach-b); border-radius:14px;
    padding:.65rem 1.4rem; font-weight:600; font-size:.9rem;
    cursor:pointer; transition:all 0.2s;
}
.btn-cancel-cours:hover { background:#fed7aa; transform:translateY(-1px); }

/* ── Bouton danger ── */
.btn-danger-soft {
    background:var(--pastel-rose); color:#be185d;
    border:1.5px solid var(--pastel-rose-b); border-radius:10px;
    padding:5px 11px; font-size:.78rem; font-weight:600;
    cursor:pointer; transition:all 0.2s;
    display:inline-flex; align-items:center; gap:4px;
}
.btn-danger-soft:hover { background:#fce7f3; border-color:#f472b6; }

/* ── Images ── */
.image-preview {
    width:80px; height:80px; object-fit:cover;
    border-radius:12px; border:2px solid var(--pastel-lavender-b);
}
.image-list, .existing-images-list, .new-images-list {
    display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;
}
.image-item, .existing-image { position:relative; display:inline-block; }
.remove-image, .remove-existing {
    position:absolute; top:-8px; right:-8px;
    width:20px; height:20px; background:#f472b6; color:#fff;
    border-radius:50%; display:flex; align-items:center;
    justify-content:center; font-size:12px; cursor:pointer; transition:all 0.2s;
}
.remove-image:hover, .remove-existing:hover { background:#db2777; transform:scale(1.1); }
.existing-image img {
    width:80px; height:80px; object-fit:cover;
    border-radius:12px; border:2px solid var(--pastel-lavender-b);
}

/* Info-box pastel */
.info-box-pastel {
    background:var(--pastel-yellow); border:1.5px solid var(--pastel-yellow-b);
    border-radius:12px; padding:.65rem 1rem;
    font-size:.82rem; color:#78350f;
    display:flex; align-items:center; gap:.6rem; margin-bottom:1rem;
}

/* ── Niveaux ── */
.niveau-section { display:flex; flex-direction:column; gap:1.25rem; }
.niveau-card {
    display:flex; align-items:center; gap:1rem;
    padding:1rem 1.25rem; border-radius:16px;
    background:#fff; border:1.5px solid #e2e8f0;
    transition:box-shadow 0.2s, transform 0.2s;
}
.niveau-card:hover { box-shadow:0 4px 16px rgba(167,139,250,.12); transform:translateY(-2px); }
.niveau-icon {
    width:46px; height:46px; border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    font-size:1.3rem; flex-shrink:0;
}
.niveau-icon.debutant      { background:var(--pastel-mint);    color:#059669; }
.niveau-icon.intermediaire { background:var(--pastel-sky);     color:#1d4ed8; }
.niveau-icon.avance        { background:var(--pastel-rose);    color:#be185d; }
.niveau-info { flex:1; min-width:0; }
.niveau-label { font-size:.85rem; font-weight:700; color:#334155; margin-bottom:4px; }
.niveau-bar-wrap { height:10px; background:#f1f5f9; border-radius:99px; overflow:hidden; }
.niveau-bar-fill { height:100%; border-radius:99px; transition:width .8s cubic-bezier(.4,0,.2,1); }
.niveau-bar-fill.debutant      { background:linear-gradient(90deg,#6ee7b7,#34d399); }
.niveau-bar-fill.intermediaire { background:linear-gradient(90deg,#93c5fd,#60a5fa); }
.niveau-bar-fill.avance        { background:linear-gradient(90deg,#f9a8d4,#f472b6); }
.niveau-count { font-size:1.4rem; font-weight:800; color:#1e293b; min-width:32px; text-align:right; flex-shrink:0; }
.niveau-pct   { font-size:.7rem; color:#94a3b8; text-align:right; margin-top:2px; }
.niveau-totals {
    display:flex; justify-content:space-between; align-items:center;
    margin-top:.5rem; padding:.6rem 1rem;
    background:var(--pastel-lavender); border-radius:12px;
    font-size:.8rem; color:#5b21b6;
}
.niveau-totals strong { color:#7c3aed; }

/* ── Badges tableau ── */
.badge-type {
    display:inline-block; padding:3px 10px;
    border-radius:20px; font-size:.72rem; font-weight:600;
}
.badge-type.academique { background:var(--pastel-sky);      color:#1d4ed8; }
.badge-type.social     { background:var(--pastel-mint);     color:#065f46; }
.badge-type.motricite  { background:var(--pastel-peach);    color:#9a3412; }
.badge-type.langage    { background:var(--pastel-lavender); color:#5b21b6; }

.badge-niveau {
    display:inline-block; padding:3px 10px;
    border-radius:20px; font-size:.72rem; font-weight:600;
}
.badge-niveau.debutant      { background:var(--pastel-mint);  color:#065f46; }
.badge-niveau.intermediaire { background:var(--pastel-sky);   color:#1d4ed8; }
.badge-niveau.avance        { background:var(--pastel-rose);  color:#9d174d; }

/* Bouton modifier tableau */
.btn-edit-table {
    background:var(--pastel-sky); color:#1d4ed8;
    border:1.5px solid var(--pastel-sky-b); border-radius:10px;
    padding:5px 12px; font-size:.78rem; font-weight:600; cursor:pointer;
    transition:all 0.2s; display:inline-flex; align-items:center; gap:4px;
}
.btn-edit-table:hover { background:#bfdbfe; }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-book-open me-2" style="color:#a78bfa"></i>Gestion des Cours</h2>
    <p>Créer et organiser les cours pédagogiques avec leurs mots et images</p>
</div>

{# ── STAT CARDS ── #}
<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="stat-card" style="background:var(--pastel-lavender); border:1.5px solid var(--pastel-lavender-b);">
            <div class="stat-top">
                <div>
                    <div class="stat-label" style="color:#5b21b6;">Total cours</div>
                    <div class="stat-value" style="color:#4c1d95;">{{ totalCourses|default(cours_list|length) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-book"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +8 ce trimestre</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card" style="background:var(--pastel-mint); border:1.5px solid var(--pastel-mint-b);">
            <div class="stat-top">
                <div>
                    <div class="stat-label" style="color:#065f46;">Publiés</div>
                    <div class="stat-value" style="color:#064e3b;">{{ publishedCount|default(cours_list|length) }}</div>
                </div>
                <div class="stat-icon" style="background:#a7f3d0; color:#065f46;"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> actifs</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card" style="background:var(--pastel-rose); border:1.5px solid var(--pastel-rose-b);">
            <div class="stat-top">
                <div>
                    <div class="stat-label" style="color:#9d174d;">Mots total</div>
                    <div class="stat-value" style="color:#831843;">{{ totalMots|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-tags"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> indexés</div>
        </div>
    </div>
</div>

{# ── FORMULAIRE + CHART ── #}
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box" style="border-radius:20px; border:1.5px solid #e9d5ff;">
            <div class="card-box-header"
                 style="background:linear-gradient(135deg,var(--pastel-lavender),var(--pastel-sky));
                        border-radius:18px 18px 0 0; border-bottom:1.5px solid #ddd6fe;">
                <span class="card-box-title" style="color:#4c1d95; font-weight:700;">
                    <i class="fas fa-magic" style="color:#a78bfa;"></i> Ajouter / Modifier un Cours
                </span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body" style="background:#fdfcff; border-radius:0 0 18px 18px;">
                <form id="courseForm" method="post" enctype="multipart/form-data"
                      action="{{ path('admin_cours_save') }}">
                    <input type="hidden" name="id_cours" id="courseId" value="">

                    {# ── Section 1 : Infos générales ── #}
                    <div class="form-section fs-blue">
                        <div class="form-section-title">
                            <span class="section-icon"><i class="fas fa-info-circle"></i></span>
                            Informations générales
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">📝 Titre du cours *</label>
                                <input type="text" class="form-control" name="titre" id="courseTitle"
                                       required placeholder="Ex: Les animaux de la ferme">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">🏷️ Type de cours *</label>
                                <select class="form-select" name="type_cours" id="courseType" required>
                                    <option value="">Sélectionnez un type</option>
                                    <option value="Académique">🎓 Académique</option>
                                    <option value="Social">🤝 Social</option>
                                    <option value="Motricité">🏃 Motricité</option>
                                    <option value="Langage">💬 Langage</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# ── Section 2 : Niveau & Durée ── #}
                    <div class="form-section fs-mint">
                        <div class="form-section-title">
                            <span class="section-icon"><i class="fas fa-sliders-h"></i></span>
                            Niveau &amp; Durée
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">🌱 Niveau *</label>
                                <select class="form-select" name="niveau" id="courseLevel" required>
                                    <option value="">Sélectionnez un niveau</option>
                                    <option value="Débutant">🌱 Débutant</option>
                                    <option value="Intermédiaire">📈 Intermédiaire</option>
                                    <option value="Avancé">🔥 Avancé</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">⏱️ Durée (minutes) *</label>
                                <input type="number" class="form-control" name="duree" id="courseDuration"
                                       required placeholder="Ex: 30" min="1">
                            </div>
                        </div>
                    </div>

                    {# ── Section 3 : Image ── #}
                    <div class="form-section fs-peach">
                        <div class="form-section-title">
                            <span class="section-icon"><i class="fas fa-image"></i></span>
                            Image du cours
                        </div>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-8">
                                <label class="form-label">🖼️ Choisir une image</label>
                                <input type="file" class="form-control" name="image_file" id="courseImage"
                                       accept="image/*"
                                       style="background:var(--pastel-peach); border-color:var(--pastel-peach-b);">
                                <small style="color:#9a3412; font-size:.75rem; margin-top:4px; display:block;">
                                    
                                </small>
                            </div>
                            <div class="col-md-4 text-center">
                                <div id="currentImagePreview" style="display:none;">
                                    <img id="currentImage" src=""
                                         style="max-width:90px; border-radius:14px;
                                                border:2px solid var(--pastel-peach-b);
                                                box-shadow:0 2px 8px rgba(0,0,0,.08);">
                                    <div style="font-size:.7rem; color:#9a3412; margin-top:4px;">Image actuelle</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ── Section 4 : Description ── #}
                    <div class="form-section fs-lavender">
                        <div class="form-section-title">
                            <span class="section-icon"><i class="fas fa-align-left"></i></span>
                            Description
                        </div>
                        <label class="form-label">📄 Description du cours *</label>
                        <textarea class="form-control" name="description" id="courseDescription" rows="3"
                                  required placeholder="Décrivez le cours de façon claire et simple..."
                                  style="background:var(--pastel-lavender); border-color:var(--pastel-lavender-b); resize:vertical;"></textarea>
                    </div>

                    {# ── Section 5 : Mots & Images ── #}
                    <div class="form-section fs-rose">
                        <div class="form-section-title">
                            <span class="section-icon"><i class="fas fa-images"></i></span>
                            Mots &amp; Images associées
                        </div>
                        <div class="info-box-pastel">
                            <i class="fas fa-lightbulb" style="font-size:1rem; flex-shrink:0;"></i>
                            Pour chaque mot, associez <strong>une ou plusieurs images claires et expressives</strong>.
                        </div>
                        <div id="motsImagesContainer">
                            <div class="mot-image-card" data-index="0">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-1 d-flex justify-content-center">
                                        <div class="mot-number">1</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">🔤 Mot *</label>
                                        <input type="text" class="form-control word-input" name="mots[]"
                                               placeholder="Ex: CHEVAL" required
                                               style="background:#fff8fb; border-color:#f9a8d4;
                                                      text-transform:uppercase; font-weight:600; letter-spacing:.04em;">
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">📷 Images du mot</label>
                                        <input type="file" class="form-control images-file" name="images_files_0[]"
                                               accept="image/*" multiple
                                               style="background:#fff8fb; border-color:#f9a8d4;">
                                        
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn-danger-soft remove-mot"
                                                style="display:none; width:100%;">
                                            <i class="fas fa-trash-alt"></i> Retirer
                                        </button>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="existing-images-list"></div>
                                        <div class="new-images-list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-add-word mt-2" id="addMotBtn">
                            <i class="fas fa-plus-circle"></i> Ajouter un mot avec ses images
                        </button>
                    </div>

                    {# ── Boutons ── #}
                    <div style="display:flex; gap:.75rem; margin-top:1.5rem; align-items:center;">
                        <button type="submit" class="btn-save-cours">
                            <i class="fas fa-save me-1"></i> Enregistrer le cours
                        </button>
                        <button type="button" class="btn-cancel-cours" id="cancelCourseBtn">
                            <i class="fas fa-times me-1"></i> Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# ── Chart donut types ── #}
    <div class="col-lg-4">
        <div class="card-box h-100"
             style="border-radius:20px; border:1.5px solid var(--pastel-lavender-b);">
            <div class="card-box-header"
                 style="background:var(--pastel-lavender); border-radius:18px 18px 0 0;
                        border-bottom:1.5px solid var(--pastel-lavender-b);">
                <span class="card-box-title" style="color:#4c1d95;">
                    <i class="fas fa-chart-pie" style="color:#a78bfa;"></i> Types de cours
                </span>
            </div>
            <div class="card-box-body">
                <canvas id="coursTypeChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── TABLEAU ── #}
<div class="card-box mb-4" style="border-radius:20px; border:1.5px solid var(--pastel-sky-b);">
    <div class="card-box-header"
         style="background:var(--pastel-sky); border-radius:18px 18px 0 0;
                border-bottom:1.5px solid var(--pastel-sky-b);">
        <span class="card-box-title" style="color:#1d4ed8;">
            <i class="fas fa-list" style="color:#60a5fa;"></i> Liste des Cours
        </span>
        <input type="text" class="form-control filter-input" id="courseFilterInput" placeholder="🔍 Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="coursTable">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Niveau</th>
                        <th>Durée</th>
                        <th>Mots</th>
                        <th>Images</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% set typeMap  = {'Académique':'academique','Social':'social','Motricité':'motricite','Langage':'langage'} %}
                    {% set niveauMap = {'Débutant':'debutant','Intermédiaire':'intermediaire','Avancé':'avance'} %}
                    {% for item in cours_list|default([]) %}
                    <tr>
                        <td><strong style="color:#334155;">{{ item.titre }}</strong></td>
                        <td>
                            <span class="badge-type {{ typeMap[item.typeCours]|default('') }}">
                                {{ item.typeCours }}
                            </span>
                        </td>
                        <td>
                            <span class="badge-niveau {{ niveauMap[item.niveau]|default('') }}">
                                {{ item.niveau }}
                            </span>
                        </td>
                        <td style="color:#64748b;">{{ item.duree }} min</td>
                        <td>
                            <span style="background:var(--pastel-lavender); color:#5b21b6;
                                         padding:2px 9px; border-radius:10px; font-size:.75rem; font-weight:600;">
                                {{ item.mots ? item.mots|split(';')|length : 0 }}
                            </span>
                        </td>
                        <td>
                            <span style="background:var(--pastel-peach); color:#9a3412;
                                         padding:2px 9px; border-radius:10px; font-size:.75rem; font-weight:600;">
                                {{ item.imagesMots ? item.imagesMots|split(';')|length : 0 }}
                            </span>
                        </td>
                        <td style="white-space:nowrap;">
                            <button class="btn-edit-table edit-course-btn me-1" data-id="{{ item.idCours }}">
                                <i class="fas fa-pen"></i> Modifier
                            </button>
                            <button class="btn-danger-soft delete-course-btn" data-id="{{ item.idCours }}">
                                <i class="fas fa-trash-alt"></i> Supprimer
                            </button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" style="text-align:center; padding:2.5rem; color:#94a3b8;">
                            <i class="fas fa-book-open" style="font-size:2rem; margin-bottom:.5rem; display:block; opacity:.25;"></i>
                            Aucun cours trouvé
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ── RÉPARTITION PAR NIVEAU ── #}
{% set nbDebutant      = cours_list|default([])|filter(c => c.niveau == 'Débutant')|length %}
{% set nbIntermediaire = cours_list|default([])|filter(c => c.niveau == 'Intermédiaire')|length %}
{% set nbAvance        = cours_list|default([])|filter(c => c.niveau == 'Avancé')|length %}
{% set nbTotal         = nbDebutant + nbIntermediaire + nbAvance %}

<div class="card-box mb-4" style="border-radius:20px; border:1.5px solid var(--pastel-mint-b);">
    <div class="card-box-header"
         style="background:var(--pastel-mint); border-radius:18px 18px 0 0;
                border-bottom:1.5px solid var(--pastel-mint-b);">
        <span class="card-box-title" style="color:#065f46;">
            <i class="fas fa-layer-group" style="color:#34d399;"></i> Répartition par niveau
        </span>
        <span style="font-size:.78rem; color:#047857; font-weight:600;">{{ nbTotal }} cours au total</span>
    </div>
    <div class="card-box-body">
        <div class="niveau-section">
            <div class="niveau-card">
                <div class="niveau-icon debutant"><i class="fas fa-seedling"></i></div>
                <div class="niveau-info">
                    <div class="niveau-label">🌱 Débutant</div>
                    <div class="niveau-bar-wrap">
                        <div class="niveau-bar-fill debutant"
                             style="width:{{ nbTotal > 0 ? ((nbDebutant/nbTotal)*100)|round : 0 }}%"></div>
                    </div>
                </div>
                <div>
                    <div class="niveau-count">{{ nbDebutant }}</div>
                    <div class="niveau-pct">{{ nbTotal > 0 ? ((nbDebutant/nbTotal)*100)|round : 0 }}%</div>
                </div>
            </div>
            <div class="niveau-card">
                <div class="niveau-icon intermediaire"><i class="fas fa-chart-line"></i></div>
                <div class="niveau-info">
                    <div class="niveau-label">📈 Intermédiaire</div>
                    <div class="niveau-bar-wrap">
                        <div class="niveau-bar-fill intermediaire"
                             style="width:{{ nbTotal > 0 ? ((nbIntermediaire/nbTotal)*100)|round : 0 }}%"></div>
                    </div>
                </div>
                <div>
                    <div class="niveau-count">{{ nbIntermediaire }}</div>
                    <div class="niveau-pct">{{ nbTotal > 0 ? ((nbIntermediaire/nbTotal)*100)|round : 0 }}%</div>
                </div>
            </div>
            <div class="niveau-card">
                <div class="niveau-icon avance"><i class="fas fa-fire"></i></div>
                <div class="niveau-info">
                    <div class="niveau-label">🔥 Avancé</div>
                    <div class="niveau-bar-wrap">
                        <div class="niveau-bar-fill avance"
                             style="width:{{ nbTotal > 0 ? ((nbAvance/nbTotal)*100)|round : 0 }}%"></div>
                    </div>
                </div>
                <div>
                    <div class="niveau-count">{{ nbAvance }}</div>
                    <div class="niveau-pct">{{ nbTotal > 0 ? ((nbAvance/nbTotal)*100)|round : 0 }}%</div>
                </div>
            </div>
        </div>
        <div class="niveau-totals">
            <span><i class="fas fa-info-circle me-1"></i> Total : <strong>{{ nbTotal }} cours</strong></span>
            <span>🌱 Débutant &nbsp;·&nbsp; 📈 Intermédiaire &nbsp;·&nbsp; 🔥 Avancé</span>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Chart donut couleurs pastels ── */
    new Chart(document.getElementById('coursTypeChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Académique', 'Social', 'Motricité', 'Langage'],
            datasets: [{
                data: [
                    {{ cours_list|default([])|filter(c => c.typeCours == 'Académique')|length }},
                    {{ cours_list|default([])|filter(c => c.typeCours == 'Social')|length }},
                    {{ cours_list|default([])|filter(c => c.typeCours == 'Motricité')|length }},
                    {{ cours_list|default([])|filter(c => c.typeCours == 'Langage')|length }}
                ],
                backgroundColor: ['#e76ecd', '#9333ea', '#c16996', '#c4b5fd'],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, font: { family: 'DM Sans', size: 11 } } } },
            cutout: '60%',
            responsive: true
        }
    });

    let motIndex = 1;

    /* ── Helpers images ── */
    function attachImagePreview(fileInput, container) {
        fileInput.addEventListener('change', function () {
            container.innerHTML = '';
            Array.from(this.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    const div = document.createElement('div');
                    div.className = 'image-item';
                    div.innerHTML = `<img src="${e.target.result}" class="image-preview"><span class="remove-image">×</span>`;
                    div.querySelector('.remove-image').onclick = () => div.remove();
                    container.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        });
    }

    function displayExistingImages(container, images) {
        container.innerHTML = '';
        images.forEach(image => {
            const div = document.createElement('div');
            div.className = 'existing-image';
            div.innerHTML = `<img src="/uploads/images/${image}" alt="Image du mot"><span class="remove-existing">×</span>`;
            div.querySelector('.remove-existing').onclick = () => div.remove();
            container.appendChild(div);
        });
    }

    function initPreviews() {
        document.querySelectorAll('.mot-image-card').forEach(card => {
            const fi = card.querySelector('.images-file');
            const nl = card.querySelector('.new-images-list');
            if (fi && nl) attachImagePreview(fi, nl);
        });
    }

    function updateMotNumbers() {
        document.querySelectorAll('.mot-image-card').forEach((card, idx) => {
            const n = card.querySelector('.mot-number');
            if (n) n.textContent = idx + 1;
            const fi = card.querySelector('.images-file');
            if (fi) fi.setAttribute('name', fi.getAttribute('name').replace(/images_files_\d+/, `images_files_${idx}`));
            const rb = card.querySelector('.remove-mot');
            if (rb) rb.style.display = idx === 0 ? 'none' : 'inline-flex';
        });
    }

    function setupRemoveButtons() {
        document.querySelectorAll('.remove-mot').forEach(btn => {
            btn.onclick = function () {
                this.closest('.mot-image-card').remove();
                updateMotNumbers();
            };
        });
    }

    function makeMotCard(idx, motVal, imgs) {
        const card = document.createElement('div');
        card.className = 'mot-image-card';
        card.setAttribute('data-index', idx);
        card.innerHTML = `
            <div class="row g-3 align-items-end">
                <div class="col-md-1 d-flex justify-content-center">
                    <div class="mot-number">${idx + 1}</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">🔤 Mot *</label>
                    <input type="text" class="form-control word-input" name="mots[]"
                           value="${(motVal || '').replace(/"/g,'&quot;')}"
                           placeholder="Ex: CHEVAL" required
                           style="background:#fff8fb; border-color:#f9a8d4; text-transform:uppercase; font-weight:600; letter-spacing:.04em;">
                </div>
                <div class="col-md-5">
                    <label class="form-label">📷 Images du mot</label>
                    <input type="file" class="form-control images-file" name="images_files_${idx}[]"
                           accept="image/*" multiple
                           style="background:#fff8fb; border-color:#f9a8d4;">
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn-danger-soft remove-mot" style="width:100%;">
                        <i class="fas fa-trash-alt"></i> Retirer
                    </button>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <div class="existing-images-list"></div>
                    <div class="new-images-list"></div>
                </div>
            </div>`;
        if (imgs && imgs.length) displayExistingImages(card.querySelector('.existing-images-list'), imgs);
        attachImagePreview(card.querySelector('.images-file'), card.querySelector('.new-images-list'));
        return card;
    }

    /* ── Ajouter un mot ── */
    document.getElementById('addMotBtn')?.addEventListener('click', function () {
        document.getElementById('motsImagesContainer').appendChild(makeMotCard(motIndex, '', []));
        motIndex++;
        updateMotNumbers();
        setupRemoveButtons();
    });

    /* ── Annuler ── */
    document.getElementById('cancelCourseBtn')?.addEventListener('click', function () {
        if (confirm('Voulez-vous vraiment annuler ? Les modifications non sauvegardées seront perdues.')) {
            document.getElementById('courseForm').reset();
            document.getElementById('formMode').textContent = 'Mode : Ajout';
            document.getElementById('courseId').value = '';
            document.getElementById('currentImagePreview').style.display = 'none';
            const c = document.getElementById('motsImagesContainer');
            c.innerHTML = '';
            c.appendChild(makeMotCard(0, '', []));
            motIndex = 1;
            updateMotNumbers();
            setupRemoveButtons();
        }
    });

    /* ── Filtre ── */
    document.getElementById('courseFilterInput')?.addEventListener('input', function (e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#coursTable tbody tr').forEach(row => {
            if (row.querySelector('td'))
                row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    /* ── Modifier ── */
    document.querySelectorAll('.edit-course-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const id = this.getAttribute('data-id');
            document.getElementById('formMode').textContent = 'Mode : Modification';
            document.getElementById('courseId').value = id;
            try {
                const data = await fetch(`/admin/cours/${id}/edit`).then(r => r.json());
                document.getElementById('courseTitle').value       = data.titre || '';
                document.getElementById('courseType').value        = data.typeCours || '';
                document.getElementById('courseLevel').value       = data.niveau || '';
                document.getElementById('courseDuration').value    = data.duree || '';
                document.getElementById('courseDescription').value = data.description || '';
                if (data.image) {
                    document.getElementById('currentImage').src = `/uploads/images/${data.image}`;
                    document.getElementById('currentImagePreview').style.display = 'block';
                } else {
                    document.getElementById('currentImagePreview').style.display = 'none';
                }
                const mots = (data.mots && data.mots !== '') ? data.mots.split(';') : [''];
                const motImagesMap = {};
                if (data.imagesMots) {
                    data.imagesMots.split(';').forEach(item => {
                        const [k, v] = item.split(':');
                        if (k && v) motImagesMap[k.trim()] = v.split(',');
                    });
                }
                const container = document.getElementById('motsImagesContainer');
                container.innerHTML = '';
                mots.forEach((mot, idx) => {
                    container.appendChild(makeMotCard(idx, mot.trim(), motImagesMap[mot.trim()] || []));
                });
                motIndex = mots.length;
                updateMotNumbers();
                setupRemoveButtons();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } catch (err) {
                console.error(err);
                alert('Erreur lors du chargement du cours');
            }
        });
    });

    /* ── Supprimer ── */
    document.querySelectorAll('.delete-course-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            if (confirm('Supprimer ce cours définitivement ?')) {
                const id = this.getAttribute('data-id');
                try {
                    const r = await fetch(`/admin/cours/${id}/delete`, { method: 'DELETE' });
                    if (r.ok) { window.location.reload(); }
                    else { alert('Erreur lors de la suppression'); }
                } catch { alert('Erreur lors de la suppression'); }
            }
        });
    });

    initPreviews();
    updateMotNumbers();
    setupRemoveButtons();
});
</script>
{% endblock %}
