{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Séances{% endblock %}
{% block page_title %}Gestion des Séances{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Filter ──────────────────────────────────────────── */
.filter-input { width: 200px; font-size: .8rem; padding: 6px 12px; }

/* ── Toast ───────────────────────────────────────────── */
#toast-container {
    position: fixed; top: 24px; right: 24px;
    z-index: 9999; display: flex; flex-direction: column; gap: 12px;
    pointer-events: none;
}
.toast {
    display: flex; align-items: flex-start; gap: 14px;
    background: #fff; border-radius: 14px;
    padding: 16px 20px 16px 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,.14);
    min-width: 320px; max-width: 420px;
    border-left: 4px solid transparent;
    pointer-events: all;
    animation: toastIn .35s cubic-bezier(.34,1.56,.64,1) forwards;
    position: relative; overflow: hidden;
}
.toast.hiding { animation: toastOut .3s ease forwards; }
.toast-success { border-left-color: #10b981; }
.toast-error   { border-left-color: #ef4444; }
.toast-warning { border-left-color: #f59e0b; }
.toast-icon { width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
.toast-success .toast-icon { background:#d1fae5;color:#059669; }
.toast-error   .toast-icon { background:#fee2e2;color:#dc2626; }
.toast-warning .toast-icon { background:#fef3c7;color:#d97706; }
.toast-body { flex:1; }
.toast-title { font-weight:700;font-size:.88rem;margin-bottom:2px;color:#1e1b4b; }
.toast-msg   { font-size:.8rem;color:#6b7280;line-height:1.4; }
.toast-close { background:none;border:none;cursor:pointer;color:#9ca3af;font-size:14px;padding:0;flex-shrink:0; }
.toast-progress { position:absolute;bottom:0;left:0;height:3px;background:currentColor;opacity:.25;animation:toastProgress var(--dur,4s) linear forwards; }
.toast-success .toast-progress{color:#10b981;}.toast-error .toast-progress{color:#ef4444;}.toast-warning .toast-progress{color:#f59e0b;}
@keyframes toastIn  { from{opacity:0;transform:translateX(40px) scale(.94);}to{opacity:1;transform:translateX(0) scale(1);} }
@keyframes toastOut { from{opacity:1;transform:translateX(0) scale(1);}to{opacity:0;transform:translateX(40px) scale(.94);} }
@keyframes toastProgress { from{width:100%;}to{width:0%;} }

/* ── Modals ──────────────────────────────────────────── */
.modal-overlay {
    display:none;position:fixed;inset:0;
    background:rgba(15,10,40,.55);z-index:9000;
    align-items:center;justify-content:center;
    backdrop-filter:blur(4px);
}
.modal-overlay.open { display:flex !important; }
@keyframes modalIn { from{opacity:0;transform:scale(.92) translateY(20px);}to{opacity:1;transform:scale(1) translateY(0);} }

/* Confirm */
.confirm-box {
    background:#fff;border-radius:20px;padding:2rem;
    width:100%;max-width:400px;
    box-shadow:0 24px 64px rgba(0,0,0,.22);
    animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);
    text-align:center;
}
.confirm-icon { width:64px;height:64px;border-radius:50%;background:#fee2e2;color:#dc2626;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 1.2rem; }
.confirm-title { font-size:1.1rem;font-weight:700;color:#1e1b4b;margin-bottom:.5rem; }
.confirm-msg   { font-size:.875rem;color:#6b7280;margin-bottom:1.5rem;line-height:1.5; }
.confirm-actions { display:flex;gap:10px;justify-content:center; }
.btn-confirm-cancel { padding:9px 22px;border-radius:10px;border:1.5px solid #e5e7eb;background:#fff;color:#374151;font-weight:600;font-size:.875rem;cursor:pointer;transition:all .2s; }
.btn-confirm-cancel:hover { background:#f9fafb; }
.btn-confirm-delete { padding:9px 22px;border-radius:10px;border:none;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-weight:600;font-size:.875rem;cursor:pointer;box-shadow:0 4px 12px rgba(239,68,68,.35); }

/* Detail modal */
.detail-modal-box {
    background:#fff;border-radius:20px;width:100%;max-width:820px;
    max-height:90vh;overflow-y:auto;
    box-shadow:0 24px 64px rgba(0,0,0,.22);
    animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);
}
.detail-header {
    background:linear-gradient(135deg,#a855f7,#7c3aed);
    padding:1.6rem 2rem;color:#fff;
    display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;
    border-radius:20px 20px 0 0;
}
.detail-badge { display:inline-block;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);border-radius:50px;font-size:.75rem;font-weight:600;padding:3px 12px;margin-bottom:.5rem; }
.detail-title  { font-size:1.3rem;font-weight:800;margin:0; }
.detail-subtitle { font-size:.82rem;opacity:.8;margin-top:4px; }
.detail-close-btn { background:rgba(255,255,255,.15);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.detail-body { padding:1.6rem 2rem; }
.detail-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.2rem; }
.detail-card { background:#f8f7ff;border-radius:12px;padding:12px 14px;border:1px solid #ede9fe; }
.detail-card-label { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#7c3aed;margin-bottom:4px;display:flex;align-items:center;gap:5px; }
.detail-card-value { font-size:.88rem;color:#1e1b4b;font-weight:500;line-height:1.4; }
.detail-full { background:#f8f7ff;border-radius:12px;padding:12px 14px;border:1px solid #ede9fe;margin-bottom:12px; }
.detail-full:last-child { margin-bottom:0; }

/* Score pills */
.score-pill { display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:50px;font-size:.8rem;font-weight:700; }
.score-low  { background:#d1fae5;color:#059669; }
.score-mid  { background:#fef3c7;color:#d97706; }
.score-high { background:#fee2e2;color:#dc2626; }

/* ══ STAT CARDS PERSONNALISÉES ══════════════════════════ */

/* Card humeur — dégradé vert/teal */
.stat-card-humeur {
    background: linear-gradient(135deg, #f0fdf4, #d1fae5);
    border: 1.5px solid #a7f3d0;
    border-radius: 18px;
    padding: 20px 22px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
}
.stat-card-humeur:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(16,185,129,.18); }
.stat-card-humeur::before {
    content: '';
    position: absolute; top: -20px; right: -20px;
    width: 100px; height: 100px;
    background: rgba(16,185,129,.1);
    border-radius: 50%;
}
.humeur-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
.humeur-label { font-size: .72rem; font-weight: 700; color: #059669; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.humeur-value { font-size: 2rem; font-weight: 900; color: #065f46; line-height: 1; }
.humeur-unit { font-size: .8rem; color: #059669; font-weight: 600; }
.humeur-icon {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #10b981, #059669);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; box-shadow: 0 4px 14px rgba(16,185,129,.35);
}
.humeur-bar-track { height: 6px; background: #a7f3d0; border-radius: 99px; overflow: hidden; margin-top: 4px; }
.humeur-bar-fill  { height: 6px; background: linear-gradient(90deg, #10b981, #059669); border-radius: 99px; transition: width 1s ease; }
.humeur-sub { font-size: .72rem; color: #059669; font-weight: 600; margin-top: 8px; display: flex; align-items: center; gap: 4px; }

/* Card enfants suivis — dégradé bleu/indigo */
.stat-card-enfants {
    background: linear-gradient(135deg, #eef2ff, #e0e7ff);
    border: 1.5px solid #c7d2fe;
    border-radius: 18px;
    padding: 20px 22px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
}
.stat-card-enfants:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(79,70,229,.18); }
.stat-card-enfants::before {
    content: '';
    position: absolute; top: -20px; right: -20px;
    width: 100px; height: 100px;
    background: rgba(79,70,229,.08);
    border-radius: 50%;
}
.enfants-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
.enfants-label { font-size: .72rem; font-weight: 700; color: #4f46e5; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.enfants-value { font-size: 2rem; font-weight: 900; color: #3730a3; line-height: 1; }
.enfants-icon {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; box-shadow: 0 4px 14px rgba(79,70,229,.35);
}
.enfants-avatars { display: flex; gap: -6px; margin-top: 8px; }
.enfants-avatar-dot {
    width: 22px; height: 22px; border-radius: 50%;
    background: linear-gradient(135deg, #818cf8, #4f46e5);
    border: 2px solid #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 800; color: #fff;
    margin-right: -6px;
    box-shadow: 0 2px 6px rgba(79,70,229,.3);
}
.enfants-sub { font-size: .72rem; color: #4f46e5; font-weight: 600; margin-top: 8px; display: flex; align-items: center; gap: 4px; }

/* Status badges */
.badge-planifie  { background:#ede9fe;color:#5b21b6; }
.badge-en-cours  { background:#dbeafe;color:#1d4ed8; }
.badge-termine   { background:#d1fae5;color:#059669; }
.badge-annule    { background:#fee2e2;color:#dc2626; }

/* Form validation */
.form-control.is-valid, textarea.is-valid, select.is-valid {
    border-color:#10b981!important;box-shadow:0 0 0 3px rgba(16,185,129,.12)!important;
}
.form-control.is-invalid, textarea.is-invalid, select.is-invalid {
    border-color:#ef4444!important;box-shadow:0 0 0 3px rgba(239,68,68,.12)!important;
    animation:shake .35s ease;
}
@keyframes shake {
    0%,100%{transform:translateX(0);}20%{transform:translateX(-5px);}
    40%{transform:translateX(5px);}60%{transform:translateX(-4px);}80%{transform:translateX(4px);}
}
.field-error { font-size:.75rem;color:#ef4444;margin-top:4px;display:flex;align-items:center;gap:4px;animation:fadeInDown .2s ease; }
@keyframes fadeInDown { from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:translateY(0);} }
.req::after { content:' *';color:#ef4444;font-size:.8rem; }

/* Spinner */
.btn-purple .spinner { width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px; }
@keyframes spin { to{transform:rotate(360deg);} }

/* Score slider */
.score-wrap { display:flex;align-items:center;gap:10px; }
.score-wrap input[type=range] { flex:1;accent-color:#a855f7; }
.score-val { width:32px;height:32px;border-radius:50%;background:#ede9fe;color:#5b21b6;font-weight:700;font-size:.85rem;display:flex;align-items:center;justify-content:center;flex-shrink:0; }

/* Reco panel */
.reco-panel{border-radius:12px;border:1.5px solid #ede9fe;background:#faf5ff;padding:12px 14px;margin-top:4px;}
.reco-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.reco-title{font-size:.75rem;font-weight:700;color:#5b21b6;text-transform:uppercase;letter-spacing:.4px;}
.reco-niveaux{display:flex;gap:6px;flex-wrap:wrap;}
.reco-tag{font-size:.68rem;font-weight:700;padding:2px 9px;border-radius:50px;}
.reco-tag-faible{background:#d1fae5;color:#059669;}
.reco-tag-moyenne{background:#fef3c7;color:#d97706;}
.reco-tag-elevee{background:#fee2e2;color:#dc2626;}
.reco-list{list-style:none;margin:0;padding:0;max-height:160px;overflow-y:auto;}
.reco-list li{display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px solid #ede9fe;font-size:.78rem;color:#374151;cursor:pointer;border-radius:6px;transition:background .15s;}
.reco-list li:last-child{border-bottom:none;}
.reco-list li:hover{background:#ede9fe;}
.reco-list li i{color:#a855f7;font-size:.7rem;flex-shrink:0;}
.reco-empty{font-size:.78rem;color:#9ca3af;text-align:center;padding:8px 0;margin:0;}
.reco-spinner{width:12px;height:12px;border:2px solid #ede9fe;border-top-color:#7c3aed;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px;}

/* Send report btn spinner */
@keyframes btnSpin { to{transform:rotate(360deg);} }
.btn-send-spinner {
    width:14px;height:14px;
    border:2px solid rgba(255,255,255,.4);
    border-top-color:#fff;
    border-radius:50%;
    animation:btnSpin .6s linear infinite;
    display:inline-block;
    vertical-align:middle;
    margin-right:6px;
}
</style>
{% endblock %}

{% block body %}

{# ── Toasts ─────────────────────────────────────────── #}
<div id="toast-container"></div>

{# ── Confirm delete modal ───────────────────────────── #}
<div class="modal-overlay" id="confirmModal">
    <div class="confirm-box">
        <div class="confirm-icon"><i class="fas fa-trash-alt"></i></div>
        <div class="confirm-title">Supprimer cette séance ?</div>
        <div class="confirm-msg">Cette action est <strong>irréversible</strong>. La séance sera définitivement supprimée.</div>
        <div class="confirm-actions">
            <button class="btn-confirm-cancel" id="confirmCancel"><i class="fas fa-times me-1"></i>Annuler</button>
            <button class="btn-confirm-delete" id="confirmOk"><i class="fas fa-trash me-1"></i>Supprimer</button>
        </div>
    </div>
</div>

{# ── Detail modal ───────────────────────────────────── #}
<div class="modal-overlay" id="detailModal">
    <div class="detail-modal-box">
        <div class="detail-header">
            <div style="flex:1">
                <div class="detail-badge" id="d-statut"></div>
                <div class="detail-title" id="d-nom"></div>
                <div class="detail-subtitle" id="d-subtitle"></div>
            </div>
            <button class="detail-close-btn" id="closeDetailBtn"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="detail-body">
            <div class="detail-grid">
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-user"></i> Nom enfant</div>
                    <div class="detail-card-value" id="d-enfant"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-user-md"></i> Psychologue</div>
                    <div class="detail-card-value" id="d-psy"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-envelope"></i> Email parent</div>
                    <div class="detail-card-value" id="d-email"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-birthday-cake"></i> Âge</div>
                    <div class="detail-card-value" id="d-age"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-calendar"></i> Date &amp; Heure</div>
                    <div class="detail-card-value" id="d-date"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-signal"></i> Niveau séance</div>
                    <div class="detail-card-value" id="d-niveau"></div>
                </div>
            </div>

            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-chart-bar"></i> Scores cliniques</div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:10px;">
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">😊 Humeur</div>
                        <div id="d-humeur"></div>
                    </div>
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">⚡ Stress</div>
                        <div id="d-stress"></div>
                    </div>
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">🧠 Attention</div>
                        <div id="d-attention"></div>
                    </div>
                </div>
            </div>

            <div class="detail-grid">
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-brain"></i> Comportement</div>
                    <div class="detail-card-value" id="d-comportement"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-users"></i> Interaction sociale</div>
                    <div class="detail-card-value" id="d-interaction"></div>
                </div>
            </div>

            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-puzzle-piece"></i> Thérapie recommandée</div>
                <div class="detail-card-value mt-1" id="d-therapie"></div>
            </div>
            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-eye"></i> Observation</div>
                <div class="detail-card-value mt-1" id="d-observation"></div>
            </div>

            {# ── Zone envoi rapport ── #}
            <div style="margin-top:20px;padding-top:16px;border-top:1.5px solid #ede9fe;">
                <div id="d-mail-info" style="display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                    <div style="font-size:.78rem;color:#6b7280;display:flex;align-items:center;gap:6px;">
                        <i class="fas fa-paper-plane" style="color:#a855f7;"></i>
                        Rapport PDF envoyé à&nbsp;<strong id="d-mail-dest" style="color:#5b21b6;"></strong>
                    </div>
                    <button id="sendReportBtn" style="
                        display:inline-flex;align-items:center;gap:8px;
                        background:linear-gradient(135deg,#7c3aed,#4f46e5);
                        color:#fff;border:none;border-radius:12px;
                        padding:10px 22px;font-size:.85rem;font-weight:700;
                        cursor:pointer;box-shadow:0 4px 14px rgba(124,58,237,.35);
                        transition:all .2s;white-space:nowrap;">
                        <i class="fas fa-envelope-open-text"></i>
                        Envoyer le rapport au parent
                    </button>
                </div>
                <div id="d-no-email-warn" style="display:none;padding:10px 14px;
                     background:#fef3c7;border:1.5px solid #f59e0b;border-radius:10px;
                     font-size:.78rem;color:#92400e;align-items:center;gap:8px;">
                    <i class="fas fa-triangle-exclamation" style="color:#f59e0b;flex-shrink:0;"></i>
                    Aucun email parent enregistré. Modifiez la séance pour en ajouter un.
                </div>

<button id="genCompteRenduBtn"
               data-seance-id=""
               data-email="">
           <i class="fas fa-robot me-2"></i> Compte-rendu IA
       </button>


            </div>
        </div>
    </div>
</div>

{# ── Page header ────────────────────────────────────── #}
<div class="page-header">
    <h2><i class="fas fa-calendar-check me-2" style="color:var(--purple-500)"></i>Gestion des Séances</h2>
    <p>Suivi individuel des séances thérapeutiques pour enfants TSA</p>
</div>

{# ══ STAT CARDS ═════════════════════════════════════════ #}
{# Calcul du nombre d'enfants uniques #}
{% set enfantsUniques = [] %}
{% for s in sessions %}
    {% if s.nomEnfant not in enfantsUniques %}
        {% set enfantsUniques = enfantsUniques|merge([s.nomEnfant]) %}
    {% endif %}
{% endfor %}
{% set nbEnfants = enfantsUniques|length %}

{# Initiales des 4 premiers enfants pour les avatars #}
{% set premiersEnfants = enfantsUniques|slice(0, 4) %}

<div class="row g-3 mb-4">

    {# ── Card 1 : Total séances ── #}
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total séances</div>
                    <div class="stat-value">{{ total|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-calendar-check"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> dans la base</div>
        </div>
    </div>

    {# ── Card 2 : Planifiées ── #}
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Planifiées</div>
                    <div class="stat-value">{{ planifie|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-clock"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> à venir</div>
        </div>
    </div>

    {# ══ Card 3 : Humeur moyenne (remplace "Terminées") ══ #}
    <div class="col-6 col-xl-3">
        <div class="stat-card-humeur">
            <div class="humeur-top">
                <div>
                    <div class="humeur-label">😊 Humeur moyenne</div>
                    <div class="humeur-value">
                        {{ avgHumeur|default(0) }}
                        <span class="humeur-unit">/10</span>
                    </div>
                </div>
                <div class="humeur-icon">😊</div>
            </div>
            <div class="humeur-bar-track">
                <div class="humeur-bar-fill" style="width:{{ (avgHumeur|default(0) * 10)|round }}%;"></div>
            </div>
            <div class="humeur-sub">
                <i class="fas fa-chart-line"></i>
                {% if avgHumeur|default(0) >= 7 %}
                    Niveau élevé — bon signe 🎉
                {% elseif avgHumeur|default(0) >= 4 %}
                    Niveau moyen — à surveiller
                {% else %}
                    Niveau faible — attention ⚠️
                {% endif %}
            </div>
        </div>
    </div>

    {# ══ Card 4 : Enfants suivis (remplace "Annulées") ══ #}
    <div class="col-6 col-xl-3">
        <div class="stat-card-enfants">
            <div class="enfants-top">
                <div>
                    <div class="enfants-label">👶 Enfants suivis</div>
                    <div class="enfants-value">{{ nbEnfants }}</div>
                </div>
                <div class="enfants-icon">👶</div>
            </div>
            <div class="enfants-avatars">
                {% for nomE in premiersEnfants %}
                    <div class="enfants-avatar-dot" title="{{ nomE }}">
                        {{ nomE|slice(0,1)|upper }}
                    </div>
                {% endfor %}
                {% if nbEnfants > 4 %}
                    <div class="enfants-avatar-dot" style="background:linear-gradient(135deg,#c4b5fd,#7c3aed);">
                        +{{ nbEnfants - 4 }}
                    </div>
                {% endif %}
            </div>
            <div class="enfants-sub">
                <i class="fas fa-child"></i>
                {{ nbEnfants }} enfant{{ nbEnfants > 1 ? 's' : '' }} en cours de suivi
            </div>
        </div>
    </div>

</div>

{# ── Formulaire + Chart ─────────────────────────────── #}
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter un suivi</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <input type="hidden" id="editId">
                <div class="row g-3" id="seanceForm">

                    <div class="col-md-6">
                        <label class="form-label req">Nom enfant</label>
                        <input type="text" class="form-control" id="nomEnfant"
                               placeholder="Ex: Adam Mejri" data-rule="required|min:3|alpha">
                        <div class="field-error d-none" id="err-nomEnfant"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Âge</label>
                        <input type="number" class="form-control" id="age"
                               placeholder="Ex: 8" min="1" max="120" data-rule="required|range:1:120">
                        <div class="field-error d-none" id="err-age"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Email parent</label>
                        <input type="email" class="form-control" id="emailParent"
                               placeholder="parent@email.com" data-rule="required|email">
                        <div class="field-error d-none" id="err-emailParent"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Niveau séance</label>
                        <input type="number" class="form-control" id="niveauSeance"
                               placeholder="1" min="1" max="10" data-rule="required|range:1:10">
                        <div class="field-error d-none" id="err-niveauSeance"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Nom psychologue</label>
                        <input type="text" class="form-control" id="nomPsy"
                               placeholder="Dr. Fatma Trabelsi" data-rule="required|min:3">
                        <div class="field-error d-none" id="err-nomPsy"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">État</label>
                        <select class="form-select" id="statut" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="normal">Normal</option>
                            <option value="immobile">Immobile</option>
                            <option value="ne_bouge_pas">Il ne bouge pas</option>
                            <option value="n_entend_pas">Il n'entend pas</option>
                            <option value="ne_voit_pas">Il ne voit pas</option>
                        </select>
                        <div class="field-error d-none" id="err-statut"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Date</label>
                        <input type="date" class="form-control" id="dateSuivieDate" data-rule="required">
                        <div class="field-error d-none" id="err-dateSuivieDate"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Heure (HH:mm)</label>
                        <input type="time" class="form-control" id="dateSuivieHeure" data-rule="required">
                        <div class="field-error d-none" id="err-dateSuivieHeure"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label req">Score humeur</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreHumeur" min="0" max="10" value="5"
                                   oninput="document.getElementById('valHumeur').textContent=this.value">
                            <div class="score-val" id="valHumeur">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreHumeur"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label req">Score stress</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreStress" min="0" max="10" value="5"
                                   oninput="document.getElementById('valStress').textContent=this.value">
                            <div class="score-val" id="valStress">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreStress"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label req">Score attention</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreAttention" min="0" max="10" value="5"
                                   oninput="document.getElementById('valAttention').textContent=this.value">
                            <div class="score-val" id="valAttention">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreAttention"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Comportement</label>
                        <select class="form-select" id="comportement" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="calme">😌 Calme</option>
                            <option value="agite">😤 Agité</option>
                            <option value="agressif">😠 Agressif</option>
                            <option value="cooperatif">🤝 Coopératif</option>
                            <option value="retrait">😶 En retrait</option>
                        </select>
                        <div class="field-error d-none" id="err-comportement"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Interaction sociale</label>
                        <select class="form-select" id="interactionSociale" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="bonne">✅ Bonne</option>
                            <option value="moyenne">🟡 Moyenne</option>
                            <option value="faible">🔴 Faible</option>
                            <option value="absente">⛔ Absente</option>
                        </select>
                        <div class="field-error d-none" id="err-interactionSociale"></div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Thérapie recommandée</label>
                        <div class="reco-panel" id="recoPanel">
                            <div class="reco-header">
                                <span class="reco-title"><i class="fas fa-magic me-1"></i> Exercices adaptés aux scores</span>
                                <div class="reco-niveaux" id="recoNiveaux">—</div>
                            </div>
                            <div id="recoContent"><p class="reco-empty">Ajustez les scores pour voir les recommandations</p></div>
                        </div>
                        <select class="form-select mt-2" id="therapieId">
                            <option value="">-- Aucune (ou choisir manuellement) --</option>
                            {% for th in therapies|default([]) %}
                            <option value="{{ th.id }}">{{ th.nomExercice }} ({{ th.typeExercice }})</option>
                            {% endfor %}
                        </select>
                        <small style="color:#6b7280;margin-top:3px;display:block;">
                            <i class="fas fa-info-circle"></i> Cliquez sur un exercice recommandé pour le sélectionner
                        </small>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Observation <small style="color:#6b7280;">(max 255 car.)</small></label>
                        <textarea class="form-control" id="observation" rows="2"
                                  placeholder="Observations cliniques..." maxlength="255"
                                  oninput="document.getElementById('obsCount').textContent=this.value.length"></textarea>
                        <div style="text-align:right;font-size:.72rem;color:#9ca3af;margin-top:3px;">
                            <span id="obsCount">0</span>/255
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveBtn">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                        <button class="btn-outline-purple" id="cancelBtn">
                            <i class="fas fa-times"></i> Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-line"></i> Évolution d'un enfant</span>
            </div>
            <div class="card-box-body">
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                    <div style="flex:1;background:#fdf4ff;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">😊 Humeur</div>
                        <div style="font-size:1rem;font-weight:800;color:#a855f7;">{{ avgHumeur|default(0) }}/10</div>
                    </div>
                    <div style="flex:1;background:#fff5f5;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">⚡ Stress</div>
                        <div style="font-size:1rem;font-weight:800;color:#ef4444;">{{ avgStress|default(0) }}/10</div>
                    </div>
                    <div style="flex:1;background:#eef2ff;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">🧠 Attention</div>
                        <div style="font-size:1rem;font-weight:800;color:#4f46e5;">{{ avgAttention|default(0) }}/10</div>
                    </div>
                </div>

                <div style="margin-bottom:10px;">
                    <label style="font-size:.75rem;font-weight:700;color:#5b21b6;text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:4px;">
                        <i class="fas fa-child me-1"></i> Choisir un enfant
                    </label>
                    <select id="enfantSelect" class="form-select" style="font-size:.82rem;">
                        <option value="">-- Sélectionner un enfant --</option>
                        {% set seenEnfants = [] %}
                        {% for s in sessions %}
                            {% if s.nomEnfant not in seenEnfants %}
                                {% set seenEnfants = seenEnfants|merge([s.nomEnfant]) %}
                                <option value="{{ s.nomEnfant }}">{{ s.nomEnfant }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                <div id="enfantInfo" style="display:none;margin-bottom:8px;padding:8px 12px;background:#f5f3ff;border-radius:10px;border:1px solid #ede9fe;">
                    <div style="font-size:.78rem;font-weight:700;color:#5b21b6;" id="enfantInfoNom"></div>
                    <div style="font-size:.7rem;color:#6b7280;" id="enfantInfoDetails"></div>
                </div>

                <canvas id="seancesChart" height="220"></canvas>
                <div id="chartEmpty" style="text-align:center;color:#9ca3af;font-size:.8rem;padding:20px 0;display:none;">
                    <i class="fas fa-chart-line fa-2x" style="color:#c4b5fd;display:block;margin-bottom:8px;"></i>
                    Sélectionnez un enfant pour voir son évolution
                </div>
            </div>
        </div>
    </div>
</div>

{# Données séances pour JS #}
<script id="sessionsData" type="application/json">
[
{% for s in sessions %}
    {
        "nom": "{{ s.nomEnfant|e('js') }}",
        "date": "{{ s.dateSuivie is not null ? s.dateSuivie|date('d/m/Y') : '' }}",
