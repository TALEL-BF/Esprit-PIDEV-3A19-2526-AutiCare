{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Séances{% endblock %}
{% block page_title %}Gestion des Séances{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Filter ──────────────────────────────────────────── */
.filter-input { width: 200px; font-size: .8rem; padding: 6px 12px; }

/* ── Toast ───────────────────────────────────────────── */
#toast-container {
    position: fixed; top: 24px; right: 24px;
    z-index: 9999; display: flex; flex-direction: column; gap: 12px;
    pointer-events: none;
}
.toast {
    display: flex; align-items: flex-start; gap: 14px;
    background: #fff; border-radius: 14px;
    padding: 16px 20px 16px 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,.14);
    min-width: 320px; max-width: 420px;
    border-left: 4px solid transparent;
    pointer-events: all;
    animation: toastIn .35s cubic-bezier(.34,1.56,.64,1) forwards;
    position: relative; overflow: hidden;
}
.toast.hiding { animation: toastOut .3s ease forwards; }
.toast-success { border-left-color: #10b981; }
.toast-error   { border-left-color: #ef4444; }
.toast-warning { border-left-color: #f59e0b; }
.toast-icon { width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
.toast-success .toast-icon { background:#d1fae5;color:#059669; }
.toast-error   .toast-icon { background:#fee2e2;color:#dc2626; }
.toast-warning .toast-icon { background:#fef3c7;color:#d97706; }
.toast-body { flex:1; }
.toast-title { font-weight:700;font-size:.88rem;margin-bottom:2px;color:#1e1b4b; }
.toast-msg   { font-size:.8rem;color:#6b7280;line-height:1.4; }
.toast-close { background:none;border:none;cursor:pointer;color:#9ca3af;font-size:14px;padding:0;flex-shrink:0; }
.toast-progress { position:absolute;bottom:0;left:0;height:3px;background:currentColor;opacity:.25;animation:toastProgress var(--dur,4s) linear forwards; }
.toast-success .toast-progress{color:#10b981;}.toast-error .toast-progress{color:#ef4444;}.toast-warning .toast-progress{color:#f59e0b;}
@keyframes toastIn  { from{opacity:0;transform:translateX(40px) scale(.94);}to{opacity:1;transform:translateX(0) scale(1);} }
@keyframes toastOut { from{opacity:1;transform:translateX(0) scale(1);}to{opacity:0;transform:translateX(40px) scale(.94);} }
@keyframes toastProgress { from{width:100%;}to{width:0%;} }

/* ── Modals ──────────────────────────────────────────── */
.modal-overlay {
    display:none;position:fixed;inset:0;
    background:rgba(15,10,40,.55);z-index:9000;
    align-items:center;justify-content:center;
    backdrop-filter:blur(4px);
}
.modal-overlay.open { display:flex !important; }
@keyframes modalIn { from{opacity:0;transform:scale(.92) translateY(20px);}to{opacity:1;transform:scale(1) translateY(0);} }

/* Confirm */
.confirm-box {
    background:#fff;border-radius:20px;padding:2rem;
    width:100%;max-width:400px;
    box-shadow:0 24px 64px rgba(0,0,0,.22);
    animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);
    text-align:center;
}
.confirm-icon { width:64px;height:64px;border-radius:50%;background:#fee2e2;color:#dc2626;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 1.2rem; }
.confirm-title { font-size:1.1rem;font-weight:700;color:#1e1b4b;margin-bottom:.5rem; }
.confirm-msg   { font-size:.875rem;color:#6b7280;margin-bottom:1.5rem;line-height:1.5; }
.confirm-actions { display:flex;gap:10px;justify-content:center; }
.btn-confirm-cancel { padding:9px 22px;border-radius:10px;border:1.5px solid #e5e7eb;background:#fff;color:#374151;font-weight:600;font-size:.875rem;cursor:pointer;transition:all .2s; }
.btn-confirm-cancel:hover { background:#f9fafb; }
.btn-confirm-delete { padding:9px 22px;border-radius:10px;border:none;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-weight:600;font-size:.875rem;cursor:pointer;box-shadow:0 4px 12px rgba(239,68,68,.35); }

/* Detail modal */
.detail-modal-box {
    background:#fff;border-radius:20px;width:100%;max-width:820px;
    max-height:90vh;overflow-y:auto;
    box-shadow:0 24px 64px rgba(0,0,0,.22);
    animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);
}
.detail-header {
    background:linear-gradient(135deg,#a855f7,#7c3aed);
    padding:1.6rem 2rem;color:#fff;
    display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;
    border-radius:20px 20px 0 0;
}
.detail-badge { display:inline-block;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);border-radius:50px;font-size:.75rem;font-weight:600;padding:3px 12px;margin-bottom:.5rem; }
.detail-title  { font-size:1.3rem;font-weight:800;margin:0; }
.detail-subtitle { font-size:.82rem;opacity:.8;margin-top:4px; }
.detail-close-btn { background:rgba(255,255,255,.15);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.detail-body { padding:1.6rem 2rem; }
.detail-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.2rem; }
.detail-card { background:#f8f7ff;border-radius:12px;padding:12px 14px;border:1px solid #ede9fe; }
.detail-card-label { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#7c3aed;margin-bottom:4px;display:flex;align-items:center;gap:5px; }
.detail-card-value { font-size:.88rem;color:#1e1b4b;font-weight:500;line-height:1.4; }
.detail-full { background:#f8f7ff;border-radius:12px;padding:12px 14px;border:1px solid #ede9fe;margin-bottom:12px; }
.detail-full:last-child { margin-bottom:0; }

/* Score pills */
.score-pill { display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:50px;font-size:.8rem;font-weight:700; }
.score-low  { background:#d1fae5;color:#059669; }
.score-mid  { background:#fef3c7;color:#d97706; }
.score-high { background:#fee2e2;color:#dc2626; }

/* Status badges */
.badge-planifie  { background:#ede9fe;color:#5b21b6; }
.badge-en-cours  { background:#dbeafe;color:#1d4ed8; }
.badge-termine   { background:#d1fae5;color:#059669; }
.badge-annule    { background:#fee2e2;color:#dc2626; }

/* Form validation */
.form-control.is-valid, textarea.is-valid, select.is-valid {
    border-color:#10b981!important;box-shadow:0 0 0 3px rgba(16,185,129,.12)!important;
}
.form-control.is-invalid, textarea.is-invalid, select.is-invalid {
    border-color:#ef4444!important;box-shadow:0 0 0 3px rgba(239,68,68,.12)!important;
    animation:shake .35s ease;
}
@keyframes shake {
    0%,100%{transform:translateX(0);}20%{transform:translateX(-5px);}
    40%{transform:translateX(5px);}60%{transform:translateX(-4px);}80%{transform:translateX(4px);}
}
.field-error { font-size:.75rem;color:#ef4444;margin-top:4px;display:flex;align-items:center;gap:4px;animation:fadeInDown .2s ease; }
@keyframes fadeInDown { from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:translateY(0);} }
.req::after { content:' *';color:#ef4444;font-size:.8rem; }

/* Spinner */
.btn-purple .spinner { width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px; }
@keyframes spin { to{transform:rotate(360deg);} }

/* Score slider */
.score-wrap { display:flex;align-items:center;gap:10px; }
.score-wrap input[type=range] { flex:1;accent-color:#a855f7; }
.score-val { width:32px;height:32px;border-radius:50%;background:#ede9fe;color:#5b21b6;font-weight:700;font-size:.85rem;display:flex;align-items:center;justify-content:center;flex-shrink:0; }

/* Reco panel */
.reco-panel { border-radius:12px; border:1.5px solid #ede9fe; background:#faf5ff; padding:12px 14px; margin-top:4px; }
.reco-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
.reco-title { font-size:.75rem; font-weight:700; color:#5b21b6; text-transform:uppercase; letter-spacing:.4px; }
.reco-niveaux { display:flex; gap:6px; flex-wrap:wrap; }
.reco-tag { font-size:.68rem; font-weight:700; padding:2px 9px; border-radius:50px; }
.reco-tag-faible  { background:#d1fae5; color:#059669; }
.reco-tag-moyenne { background:#fef3c7; color:#d97706; }
.reco-tag-elevee  { background:#fee2e2; color:#dc2626; }
.reco-list { list-style:none; margin:0; padding:0; max-height:160px; overflow-y:auto; }
.reco-list li { display:flex; align-items:center; gap:8px; padding:6px 4px; border-bottom:1px solid #ede9fe; font-size:.78rem; color:#374151; cursor:pointer; border-radius:6px; transition:background .15s; }
.reco-list li:last-child { border-bottom:none; }
.reco-list li:hover { background:#ede9fe; }
.reco-list li i { color:#a855f7; font-size:.7rem; flex-shrink:0; }
.reco-empty { font-size:.78rem; color:#9ca3af; text-align:center; padding:8px 0; margin:0; }
.reco-spinner { width:12px; height:12px; border:2px solid #ede9fe; border-top-color:#7c3aed; border-radius:50%; animation:spin .6s linear infinite; display:inline-block; vertical-align:middle; margin-right:6px; }
</style>
{% endblock %}

{% block body %}

{# ── Toasts ─────────────────────────────────────────── #}
<div id="toast-container"></div>

{# ── Confirm delete modal ───────────────────────────── #}
<div class="modal-overlay" id="confirmModal">
    <div class="confirm-box">
        <div class="confirm-icon"><i class="fas fa-trash-alt"></i></div>
        <div class="confirm-title">Supprimer cette séance ?</div>
        <div class="confirm-msg">Cette action est <strong>irréversible</strong>. La séance sera définitivement supprimée.</div>
        <div class="confirm-actions">
            <button class="btn-confirm-cancel" id="confirmCancel"><i class="fas fa-times me-1"></i>Annuler</button>
            <button class="btn-confirm-delete" id="confirmOk"><i class="fas fa-trash me-1"></i>Supprimer</button>
        </div>
    </div>
</div>

{# ── Detail modal ───────────────────────────────────── #}
<div class="modal-overlay" id="detailModal">
    <div class="detail-modal-box">
        <div class="detail-header">
            <div style="flex:1">
                <div class="detail-badge" id="d-statut"></div>
                <div class="detail-title" id="d-nom"></div>
                <div class="detail-subtitle" id="d-subtitle"></div>
            </div>
            <button class="detail-close-btn" id="closeDetailBtn"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="detail-body">
            <div class="detail-grid">
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-user"></i> Nom enfant</div>
                    <div class="detail-card-value" id="d-enfant"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-user-md"></i> Psychologue</div>
                    <div class="detail-card-value" id="d-psy"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-envelope"></i> Email parent</div>
                    <div class="detail-card-value" id="d-email"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-birthday-cake"></i> Âge</div>
                    <div class="detail-card-value" id="d-age"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-calendar"></i> Date & Heure</div>
                    <div class="detail-card-value" id="d-date"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-signal"></i> Niveau séance</div>
                    <div class="detail-card-value" id="d-niveau"></div>
                </div>
            </div>

            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-chart-bar"></i> Scores cliniques</div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:10px;">
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">😊 Humeur</div>
                        <div id="d-humeur"></div>
                    </div>
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">⚡ Stress</div>
                        <div id="d-stress"></div>
                    </div>
                    <div style="text-align:center;">
                        <div style="font-size:.7rem;color:#6b7280;font-weight:600;margin-bottom:6px;">🧠 Attention</div>
                        <div id="d-attention"></div>
                    </div>
                </div>
            </div>

            <div class="detail-grid">
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-brain"></i> Comportement</div>
                    <div class="detail-card-value" id="d-comportement"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-users"></i> Interaction sociale</div>
                    <div class="detail-card-value" id="d-interaction"></div>
                </div>
            </div>

            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-puzzle-piece"></i> Thérapie recommandée</div>
                <div class="detail-card-value mt-1" id="d-therapie"></div>
            </div>
            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-eye"></i> Observation</div>
                <div class="detail-card-value mt-1" id="d-observation"></div>
            </div>
        </div>
    </div>
</div>

{# ── Page header ────────────────────────────────────── #}
<div class="page-header">
    <h2><i class="fas fa-calendar-check me-2" style="color:var(--purple-500)"></i>Gestion des Séances</h2>
    <p>Suivi individuel des séances thérapeutiques pour enfants TSA</p>
</div>

{# ── Stat cards ─────────────────────────────────────── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total séances</div>
                    <div class="stat-value">{{ total|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-calendar-check"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> dans la base</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Planifiées</div>
                    <div class="stat-value">{{ planifie|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-clock"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> à venir</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Terminées</div>
                    <div class="stat-value">{{ termine|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> complétées</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Annulées</div>
                    <div class="stat-value">{{ annule|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-times-circle"></i></div>
            </div>
            <div class="stat-change down"><i class="fas fa-arrow-down"></i> ce mois</div>
        </div>
    </div>
</div>

{# ── Formulaire + Chart ─────────────────────────────── #}
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter un suivi</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <input type="hidden" id="editId">
                <div class="row g-3" id="seanceForm">

                    <div class="col-md-6">
                        <label class="form-label req">Nom enfant</label>
                        <input type="text" class="form-control" id="nomEnfant"
                               placeholder="Ex: Adam Mejri" data-rule="required|min:3|alpha">
                        <div class="field-error d-none" id="err-nomEnfant"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Âge</label>
                        <input type="number" class="form-control" id="age"
                               placeholder="Ex: 8" min="1" max="120" data-rule="required|range:1:120">
                        <div class="field-error d-none" id="err-age"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email parent</label>
                        <input type="email" class="form-control" id="emailParent"
                               placeholder="parent@email.com" data-rule="email">
                        <div class="field-error d-none" id="err-emailParent"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Niveau séance</label>
                        <input type="number" class="form-control" id="niveauSeance"
                               placeholder="1" min="1" max="10" data-rule="required|range:1:10">
                        <div class="field-error d-none" id="err-niveauSeance"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Nom psychologue</label>
                        <input type="text" class="form-control" id="nomPsy"
                               placeholder="Dr. Fatma Trabelsi" data-rule="required|min:3">
                        <div class="field-error d-none" id="err-nomPsy"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">État</label>
                        <select class="form-select" id="statut" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="normal">Normal</option>
                            <option value="immobile">Immobile</option>
                            <option value="ne_bouge_pas">Il ne bouge pas</option>
                            <option value="n_entend_pas">Il n'entend pas</option>
                            <option value="ne_voit_pas">Il ne voit pas</option>
                        </select>
                        <div class="field-error d-none" id="err-statut"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Date</label>
                        <input type="date" class="form-control" id="dateSuivieDate" data-rule="required">
                        <div class="field-error d-none" id="err-dateSuivieDate"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Heure (HH:mm)</label>
                        <input type="time" class="form-control" id="dateSuivieHeure" data-rule="required">
                        <div class="field-error d-none" id="err-dateSuivieHeure"></div>
                    </div>

                    {# Score Humeur #}
                    <div class="col-md-4">
                        <label class="form-label req">Score humeur</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreHumeur" min="0" max="10" value="5"
                                   oninput="document.getElementById('valHumeur').textContent=this.value">
                            <div class="score-val" id="valHumeur">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreHumeur"></div>
                    </div>

                    {# Score Stress #}
                    <div class="col-md-4">
                        <label class="form-label req">Score stress</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreStress" min="0" max="10" value="5"
                                   oninput="document.getElementById('valStress').textContent=this.value">
                            <div class="score-val" id="valStress">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreStress"></div>
                    </div>

                    {# Score Attention #}
                    <div class="col-md-4">
                        <label class="form-label req">Score attention</label>
                        <div class="score-wrap">
                            <input type="range" id="scoreAttention" min="0" max="10" value="5"
                                   oninput="document.getElementById('valAttention').textContent=this.value">
                            <div class="score-val" id="valAttention">5</div>
                        </div>
                        <div class="field-error d-none" id="err-scoreAttention"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Comportement</label>
                        <select class="form-select" id="comportement" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="calme">😌 Calme</option>
                            <option value="agite">😤 Agité</option>
                            <option value="agressif">😠 Agressif</option>
                            <option value="cooperatif">🤝 Coopératif</option>
                            <option value="retrait">😶 En retrait</option>
                        </select>
                        <div class="field-error d-none" id="err-comportement"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label req">Interaction sociale</label>
                        <select class="form-select" id="interactionSociale" data-rule="required">
                            <option value="">-- Choisir --</option>
                            <option value="bonne">✅ Bonne</option>
                            <option value="moyenne">🟡 Moyenne</option>
                            <option value="faible">🔴 Faible</option>
                            <option value="absente">⛔ Absente</option>
                        </select>
                        <div class="field-error d-none" id="err-interactionSociale"></div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Thérapie recommandée</label>
                        <div class="reco-panel" id="recoPanel">
                            <div class="reco-header">
                                <span class="reco-title"><i class="fas fa-magic me-1"></i> Exercices adaptés aux scores</span>
                                <div class="reco-niveaux" id="recoNiveaux">—</div>
                            </div>
                            <div id="recoContent"><p class="reco-empty">Ajustez les scores pour voir les recommandations</p></div>
                        </div>
                        <select class="form-select mt-2" id="therapieId">
                            <option value="">-- Aucune (ou choisir manuellement) --</option>
                            {% for th in therapies|default([]) %}
                            <option value="{{ th.id }}">{{ th.nomExercice }} ({{ th.typeExercice }})</option>
                            {% endfor %}
                        </select>
                        <small style="color:#6b7280;margin-top:3px;display:block;">
                            <i class="fas fa-info-circle"></i> Cliquez sur un exercice recommandé pour le sélectionner
                        </small>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Observation <small style="color:#6b7280;">(max 255 car.)</small></label>
                        <textarea class="form-control" id="observation" rows="2"
                                  placeholder="Observations cliniques..." maxlength="255"
                                  oninput="document.getElementById('obsCount').textContent=this.value.length"></textarea>
                        <div style="text-align:right;font-size:.72rem;color:#9ca3af;margin-top:3px;">
                            <span id="obsCount">0</span>/255
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveBtn">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                        <button class="btn-outline-purple" id="cancelBtn">
                            <i class="fas fa-times"></i> Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-line"></i> Évolution d'un enfant</span>
            </div>
            <div class="card-box-body">
                {# Scores moyens globaux #}
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                    <div style="flex:1;background:#fdf4ff;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">😊 Humeur</div>
                        <div style="font-size:1rem;font-weight:800;color:#a855f7;">{{ avgHumeur|default(0) }}/10</div>
                    </div>
                    <div style="flex:1;background:#fff5f5;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">⚡ Stress</div>
                        <div style="font-size:1rem;font-weight:800;color:#ef4444;">{{ avgStress|default(0) }}/10</div>
                    </div>
                    <div style="flex:1;background:#eef2ff;border-radius:10px;padding:8px 10px;text-align:center;">
                        <div style="font-size:.68rem;color:#6b7280;font-weight:600;">🧠 Attention</div>
                        <div style="font-size:1rem;font-weight:800;color:#4f46e5;">{{ avgAttention|default(0) }}/10</div>
                    </div>
                </div>

                {# Sélecteur d'enfant #}
                <div style="margin-bottom:10px;">
                    <label style="font-size:.75rem;font-weight:700;color:#5b21b6;text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:4px;">
                        <i class="fas fa-child me-1"></i> Choisir un enfant
                    </label>
                    <select id="enfantSelect" class="form-select" style="font-size:.82rem;">
                        <option value="">-- Sélectionner un enfant --</option>
                        {% set enfants = [] %}
                        {% for s in sessions %}
                            {% if s.nomEnfant not in enfants %}
                                {% set enfants = enfants|merge([s.nomEnfant]) %}
                                <option value="{{ s.nomEnfant }}">{{ s.nomEnfant }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                {# Info enfant sélectionné #}
                <div id="enfantInfo" style="display:none;margin-bottom:8px;padding:8px 12px;background:#f5f3ff;border-radius:10px;border:1px solid #ede9fe;">
                    <div style="font-size:.78rem;font-weight:700;color:#5b21b6;" id="enfantInfoNom"></div>
                    <div style="font-size:.7rem;color:#6b7280;" id="enfantInfoDetails"></div>
                </div>

                {# Courbe d'évolution #}
                <canvas id="seancesChart" height="220"></canvas>
                <div id="chartEmpty" style="text-align:center;color:#9ca3af;font-size:.8rem;padding:20px 0;display:none;">
                    <i class="fas fa-chart-line fa-2x" style="color:#c4b5fd;display:block;margin-bottom:8px;"></i>
                    Sélectionnez un enfant pour voir son évolution
                </div>
            </div>
        </div>
    </div>
</div>

{# Données séances pour JS (injectées en JSON) #}
<script id="sessionsData" type="application/json">
[
{% for s in sessions %}
    {
        "nom": "{{ s.nomEnfant|e('js') }}",
        "date": "{{ s.dateSuivie is not null ? s.dateSuivie|date('d/m/Y') : '' }}",
        "dateSort": "{{ s.dateSuivie is not null ? s.dateSuivie|date('Y-m-d') : '' }}",
        "humeur": {{ s.scoreHumeur|default(0) }},
        "stress": {{ s.scoreStress|default(0) }},
        "attention": {{ s.scoreAttention|default(0) }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
]
</script>

{# ── Table ──────────────────────────────────────────── #}
<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title">
            <i class="fas fa-list"></i>
            Liste des Séances (<span id="visibleCount">{{ total|default(0) }}</span>)
        </span>
        <input type="text" class="form-control filter-input" id="filterInput" placeholder="🔍 Rechercher...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="seancesTable">
                <thead>
                    <tr>
                        <th>Enfant</th>
                        <th>Psychologue</th>
                        <th>Date & Heure</th>
                        <th>Scores H/S/A</th>
                        <th>Comportement</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
{% for s in sessions %}
                    <tr data-id="{{ s.id }}"
                        data-nom="{{ s.nomEnfant }}"
                        data-age="{{ s.age }}"
                        data-email="{{ s.emailParent|default('') }}"
                        data-psy="{{ s.nomPsy }}"
                        data-date="{{ s.dateSuivie is not null ? s.dateSuivie|date('Y-m-d') : '' }}"
                        data-heure="{{ s.dateSuivie is not null ? s.dateSuivie|date('H:i') : '' }}"
                        data-humeur="{{ s.scoreHumeur }}"
                        data-stress="{{ s.scoreStress }}"
                        data-attention="{{ s.scoreAttention }}"
                        data-niveau="{{ s.niveauSeance|default('') }}"
                        data-comportement="{{ s.comportement }}"
                        data-interaction="{{ s.interactionSociale }}"
                        data-observation="{{ s.observation|default('') }}"
                        data-statut="{{ s.statut }}"
                        data-therapie-id="{{ s.therapie is not null ? s.therapie.id : '' }}"
                        data-therapie-nom="{{ s.therapie is not null ? s.therapie.nomExercice : '' }}">

                        <td>
                            <span class="exercise-name-link detail-trigger" style="cursor:pointer;color:#6d28d9;font-weight:700;border-bottom:1.5px dashed #a78bfa;">
                                {{ s.nomEnfant }}
                            </span>
                            <div style="font-size:.72rem;color:#6b7280;margin-top:2px;">
                                {{ s.age }} ans
                            </div>
                        </td>
                        <td>
                            <span style="font-size:.82rem;font-weight:600;color:#374151;">{{ s.nomPsy }}</span>
                        </td>
                        <td>
                            <div style="font-size:.82rem;font-weight:600;">{{ s.dateSuivie is not null ? s.dateSuivie|date('d/m/Y') : '—' }}</div>
                            <div style="font-size:.72rem;color:#6b7280;">{{ s.dateSuivie is not null ? s.dateSuivie|date('H:i') : '' }}</div>
                        </td>
                        <td>
                            <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                {% set h = s.scoreHumeur|default(0) %}
                                <span class="score-pill {% if h >= 7 %}score-high{% elseif h >= 4 %}score-mid{% else %}score-low{% endif %}">
                                    😊 {{ h }}
                                </span>
                                {% set st = s.scoreStress|default(0) %}
                                <span class="score-pill {% if st >= 7 %}score-high{% elseif st >= 4 %}score-mid{% else %}score-low{% endif %}">
                                    ⚡ {{ st }}
                                </span>
                                {% set at = s.scoreAttention|default(0) %}
                                <span class="score-pill {% if at >= 7 %}score-high{% elseif at >= 4 %}score-mid{% else %}score-low{% endif %}">
                                    🧠 {{ at }}
                                </span>
                            </div>
                        </td>
                        <td>
                            <span style="font-size:.82rem;color:#374151;text-transform:capitalize;">{{ s.comportement|default("—") }}</span>
                        </td>
                        <td>
                            {% if s.statut == 'normal' %}
                                <span class="badge-status badge-termine">✅ Normal</span>
                            {% elseif s.statut == 'immobile' %}
                                <span class="badge-status badge-en-cours">🧍 Immobile</span>
                            {% elseif s.statut == 'ne_bouge_pas' %}
                                <span class="badge-status badge-planifie">🛑 Ne bouge pas</span>
                            {% elseif s.statut == "n_entend_pas" %}
                                <span class="badge-status badge-annule">🔇 N'entend pas</span>
                            {% elseif s.statut == 'ne_voit_pas' %}
                                <span class="badge-status badge-annule">👁️ Ne voit pas</span>
                            {% else %}
                                <span class="badge-status">{{ s.statut }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <button class="btn-edit-soft me-1 edit-btn" data-id="{{ s.id }}">
                                <i class="fas fa-edit"></i> Modifier
                            </button>
                            <button class="btn-danger-soft delete-btn" data-id="{{ s.id }}"
                                    data-token="{{ csrf_token('delete' ~ s.id) }}">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">Aucune séance enregistrée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {

    /* ══════════════════════════════════════════════════════════════
       TOAST
    ══════════════════════════════════════════════════════════════ */
    function showToast(type, title, msg, duration = 4000) {
        const icons = { success:'fa-check', error:'fa-xmark', warning:'fa-triangle-exclamation' };
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.style.setProperty('--dur', duration + 'ms');
        toast.innerHTML = `
            <div class="toast-icon"><i class="fas ${icons[type]}"></i></div>
            <div class="toast-body"><div class="toast-title">${title}</div><div class="toast-msg">${msg}</div></div>
            <button class="toast-close" onclick="this.closest('.toast').remove()"><i class="fas fa-xmark"></i></button>
            <div class="toast-progress"></div>`;
        document.getElementById('toast-container').appendChild(toast);
        setTimeout(() => { toast.classList.add('hiding'); setTimeout(()=>toast.remove(),300); }, duration);
    }

    /* ══════════════════════════════════════════════════════════════
       CONFIRM MODAL
    ══════════════════════════════════════════════════════════════ */
    let _resolve = null;
    function showConfirm() {
        return new Promise(r => { _resolve=r; document.getElementById('confirmModal').classList.add('open'); });
    }
    document.getElementById('confirmCancel').addEventListener('click', ()=>{ document.getElementById('confirmModal').classList.remove('open'); if(_resolve)_resolve(false); });
    document.getElementById('confirmOk').addEventListener('click',     ()=>{ document.getElementById('confirmModal').classList.remove('open'); if(_resolve)_resolve(true); });
    document.getElementById('confirmModal').addEventListener('click', function(e){ if(e.target===this){this.classList.remove('open');if(_resolve)_resolve(false);} });

    /* ══════════════════════════════════════════════════════════════
       DETAIL MODAL
    ══════════════════════════════════════════════════════════════ */
    function scorePill(val) {
        const v = parseInt(val)||0;
        const cls = v>=7?'score-high':v>=4?'score-mid':'score-low';
        return `<span class="score-pill ${cls}">${v}/10</span>`;
    }
    function statutLabel(s) {
        const map = {
            normal:       '✅ Normal',
            immobile:     '🧍 Immobile',
            ne_bouge_pas: '🛑 Il ne bouge pas',
            n_entend_pas: "🔇 Il n'entend pas",
            ne_voit_pas:  '👁️ Il ne voit pas',
        };
        return map[s]||s;
    }

    function openDetail(d) {
        const set  = (id,v) => { const el=document.getElementById(id); if(el) el.textContent=v||'—'; };
        const setH = (id,h) => { const el=document.getElementById(id); if(el) el.innerHTML=h; };
        set('d-statut',    statutLabel(d.statut));
        set('d-nom',       d.nom);
        set('d-subtitle',  `${d.psy} • ${d.date ? d.date+' à '+d.heure : '—'}`);
        set('d-enfant',    d.nom);
        set('d-psy',       d.psy);
        set('d-email',     d.email||'—');
        set('d-age',       d.age ? d.age+' ans' : '—');
        set('d-date',      d.date ? d.date+' à '+d.heure : '—');
        set('d-niveau',    d.niveau ? 'Niveau '+d.niveau : '—');
        setH('d-humeur',    scorePill(d.humeur));
        setH('d-stress',    scorePill(d.stress));
        setH('d-attention', scorePill(d.attention));
        set('d-comportement', d.comportement);
        set('d-interaction',  d.interaction);
        set('d-therapie',  d.therapieNom||'Aucune');
        set('d-observation', d.observation||'—');
        document.getElementById('detailModal').classList.add('open');
    }

    document.getElementById('closeDetailBtn').addEventListener('click', ()=>document.getElementById('detailModal').classList.remove('open'));
    document.getElementById('detailModal').addEventListener('click', function(e){ if(e.target===this) this.classList.remove('open'); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape'){document.getElementById('detailModal').classList.remove('open');document.getElementById('confirmModal').classList.remove('open');} });

    document.querySelector('#seancesTable tbody').addEventListener('click', function(e){
        const trigger = e.target.closest('.detail-trigger');
        if(!trigger) return;
        const row = trigger.closest('tr');
        if(row) openDetail(row.dataset);
    });

    /* ══════════════════════════════════════════════════════════════
       VALIDATION
    ══════════════════════════════════════════════════════════════ */
    const RULES = {
        required: v => v.trim()!==''              || 'Ce champ est obligatoire',
        min:      (v,n) => v.trim().length>=+n    || `Minimum ${n} caractères requis`,
        range:    (v,mn,mx) => (+v>=+mn&&+v<=+mx) || `Valeur entre ${mn} et ${mx} requise`,
        email:    v => v===''||/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) || 'Email invalide (ex: parent@email.com)',
        alpha:    v => /^[a-zA-ZÀ-ÿ\s\-']+$/.test(v.trim()) || 'Lettres et espaces uniquement',
    };

    function validateField(el) {
        const rule = el.dataset.rule; if(!rule) return true;
        const errEl = document.getElementById('err-'+el.id);
        let error = null;
        for(const part of rule.split('|')) {
            const [name,...args] = part.split(':');
            if(!RULES[name]) continue;
            const res = RULES[name](el.value,...args);
            if(res!==true){error=res;break;}
        }
        el.classList.toggle('is-invalid',!!error);
        el.classList.toggle('is-valid',!error&&el.value.trim()!=='');
        if(errEl){
            if(error){errEl.innerHTML=`<i class="fas fa-circle-exclamation"></i> ${error}`;errEl.classList.remove('d-none');}
            else errEl.classList.add('d-none');
        }
        return !error;
    }

    function validateAll() {
        let ok=true, first=null;
        document.querySelectorAll('#seanceForm [data-rule]').forEach(el=>{
            if(!validateField(el)){ok=false;if(!first)first=el;}
        });
        if(first){first.scrollIntoView({behavior:'smooth',block:'center'});first.focus();}
        return ok;
    }

    document.querySelectorAll('#seanceForm [data-rule]').forEach(el=>{
        el.addEventListener('blur',()=>validateField(el));
        el.addEventListener('input',()=>{if(el.classList.contains('is-invalid'))validateField(el);});
    });

    /* ══════════════════════════════════════════════════════════════
       CHART — ÉVOLUTION PAR ENFANT
    ══════════════════════════════════════════════════════════════ */
    let allSessions = [];
    try {
        const raw = document.getElementById('sessionsData');
        if (raw) allSessions = JSON.parse(raw.textContent);
    } catch(e) { allSessions = []; }

    let evolutionChart = null;

    function buildEvolutionChart(enfantNom) {
        const canvas = document.getElementById('seancesChart');
        const empty  = document.getElementById('chartEmpty');
        const info   = document.getElementById('enfantInfo');

        const data = allSessions
            .filter(s => s.nom === enfantNom && s.dateSort)
            .sort((a,b) => a.dateSort.localeCompare(b.dateSort));

        if (!data.length) {
            canvas.style.display = 'none';
            empty.style.display  = 'block';
            info.style.display   = 'none';
            return;
        }

        canvas.style.display = 'block';
        empty.style.display  = 'none';

        const avgH = Math.round(data.reduce((s,d)=>s+d.humeur,0)/data.length*10)/10;
        const avgS = Math.round(data.reduce((s,d)=>s+d.stress,0)/data.length*10)/10;
        const avgA = Math.round(data.reduce((s,d)=>s+d.attention,0)/data.length*10)/10;
        document.getElementById('enfantInfoNom').textContent = '👤 ' + enfantNom;
        document.getElementById('enfantInfoDetails').textContent =
            `${data.length} séance(s) · 😊 ${avgH} · ⚡ ${avgS} · 🧠 ${avgA}`;
        info.style.display = 'block';

        const labels  = data.map(d => d.date);
        const humeurs = data.map(d => d.humeur);
        const stress  = data.map(d => d.stress);
        const attents = data.map(d => d.attention);

        if (evolutionChart) evolutionChart.destroy();
        evolutionChart = new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels,
                datasets: [
                    { label: '😊 Humeur', data: humeurs, borderColor: '#a855f7', backgroundColor: 'rgba(168,85,247,.1)', fill: true, tension: 0.4, pointBackgroundColor: '#a855f7', pointRadius: 4, borderWidth: 2.5 },
                    { label: '⚡ Stress', data: stress, borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,.08)', fill: true, tension: 0.4, pointBackgroundColor: '#ef4444', pointRadius: 4, borderWidth: 2.5 },
                    { label: '🧠 Attention', data: attents, borderColor: '#4f46e5', backgroundColor: 'rgba(79,70,229,.08)', fill: true, tension: 0.4, pointBackgroundColor: '#4f46e5', pointRadius: 4, borderWidth: 2.5 }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, font: { size: 10 }, padding: 10 } },
                    tooltip: { callbacks: { title: ctx => '📅 ' + ctx[0].label, label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y}/10` } }
                },
                scales: { y: { min: 0, max: 10, stepSize: 2, grid: { color: '#f3e8ff' }, ticks: { font: { size: 10 } } }, x: { grid: { display: false }, ticks: { font: { size: 9 }, maxRotation: 30 } } }
            }
        });
    }

    const enfantSelect = document.getElementById('enfantSelect');
    if (enfantSelect) {
        enfantSelect.addEventListener('change', function() {
            const nom = this.value;
            if (nom) { buildEvolutionChart(nom); }
            else {
                document.getElementById('enfantInfo').style.display = 'none';
                document.getElementById('seancesChart').style.display = 'none';
                document.getElementById('chartEmpty').style.display = 'block';
                if (evolutionChart) evolutionChart.destroy();
            }
        });
        if (enfantSelect.options.length === 2) {
            enfantSelect.selectedIndex = 1;
            enfantSelect.dispatchEvent(new Event('change'));
        } else {
            document.getElementById('seancesChart').style.display = 'none';
            document.getElementById('chartEmpty').style.display = 'block';
        }
    }

    /* ══════════════════════════════════════════════════════════════
       RECOMMANDATIONS DYNAMIQUES
    ══════════════════════════════════════════════════════════════ */
    function scoreToNiveau(v){ const n=parseInt(v)||0; if(n<=3) return 'faible'; if(n<=6) return 'moyenne'; return 'elevee'; }
    const _nl={faible:'↓ Faible', moyenne:'— Moyenne', elevee:'↑ Élevée'};
    const _nc={faible:'reco-tag-faible', moyenne:'reco-tag-moyenne', elevee:'reco-tag-elevee'};
    let _rt=null;

    async function updateRecommendations(){
        const h=parseInt(document.getElementById('scoreHumeur').value)||0;
        const s=parseInt(document.getElementById('scoreStress').value)||0;
        const a=parseInt(document.getElementById('scoreAttention').value)||0;
        const nh=scoreToNiveau(h), ns=scoreToNiveau(s), na=scoreToNiveau(a);
        document.getElementById('recoNiveaux').innerHTML=
            `<span class="reco-tag ${_nc[nh]}">😊 ${_nl[nh]}</span>
             <span class="reco-tag ${_nc[ns]}">⚡ ${_nl[ns]}</span>
             <span class="reco-tag ${_nc[na]}">🧠 ${_nl[na]}</span>`;
        document.getElementById('recoContent').innerHTML=`<span class="reco-spinner"></span> Recherche...`;
        try{
            const res=await fetch('/admin/seance/recommendations',{
                method:'POST', headers:{'Content-Type':'application/json'},
                body:JSON.stringify({humeur:h, stress:s, attention:a})
            });
            const list=await res.json();
            if(!Array.isArray(list)||list.length===0){
                document.getElementById('recoContent').innerHTML='<p class="reco-empty"><i class="fas fa-search me-1"></i>Aucun exercice trouvé</p>';
                return;
            }
            const ul=document.createElement('ul'); ul.className='reco-list';
            list.forEach(item=>{
                const li=document.createElement('li');
                li.innerHTML=`<i class="fas fa-dumbbell"></i> ${item.nom}`;
                li.addEventListener('click',()=>{
                    const sel=document.getElementById('therapieId');
                    const opt=[...sel.options].find(o=>o.value==item.id);
                    if(opt){ sel.value=item.id; sel.classList.add('is-valid'); showToast('success','Sélectionné',item.nom,2000); }
                });
                ul.appendChild(li);
            });
            document.getElementById('recoContent').innerHTML='';
            document.getElementById('recoContent').appendChild(ul);
        }catch{
            document.getElementById('recoContent').innerHTML='<p class="reco-empty" style="color:#ef4444;">Erreur de chargement</p>';
        }
    }

    ['scoreHumeur','scoreStress','scoreAttention'].forEach(id=>{
        document.getElementById(id)?.addEventListener('input',()=>{ clearTimeout(_rt); _rt=setTimeout(updateRecommendations,400); });
    });
    updateRecommendations();

    /* ══════════════════════════════════════════════════════════════
       FILTER
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('filterInput')?.addEventListener('input', e=>{
        const val = e.target.value.toLowerCase();
        let visible=0;
        document.querySelectorAll('#seancesTable tbody tr').forEach(row=>{
            const show = row.textContent.toLowerCase().includes(val);
            row.style.display=show?'':'none';
            if(show)visible++;
        });
        const c=document.getElementById('visibleCount');
        if(c)c.textContent=visible;
    });

    /* ══════════════════════════════════════════════════════════════
       RESET
    ══════════════════════════════════════════════════════════════ */
    function resetForm() {
        ['editId','nomEnfant','age','emailParent','nomPsy','niveauSeance',
         'dateSuivieDate','dateSuivieHeure','comportement','interactionSociale',
         'observation','statut','therapieId'].forEach(id=>{
            const el=document.getElementById(id);
            if(el){ el.value=''; el.classList.remove('is-valid','is-invalid'); }
        });
        ['scoreHumeur','scoreStress','scoreAttention'].forEach(id=>{
            const el=document.getElementById(id);
            if(el){ el.value=5; }
        });
        document.getElementById('valHumeur').textContent='5';
        document.getElementById('valStress').textContent='5';
        document.getElementById('valAttention').textContent='5';
        document.getElementById('obsCount').textContent='0';
        document.querySelectorAll('.field-error').forEach(e=>e.classList.add('d-none'));
        document.getElementById('formMode').textContent='Mode : Ajout';
        updateRecommendations(); // rafraîchir la liste après reset
    }
    document.getElementById('cancelBtn')?.addEventListener('click', resetForm);

    /* ══════════════════════════════════════════════════════════════
       EDIT — fill form
    ══════════════════════════════════════════════════════════════ */
    document.querySelectorAll('.edit-btn').forEach(btn=>{
        btn.addEventListener('click', function(){
            const d = this.closest('tr').dataset;
            document.getElementById('editId').value              = d.id;
            document.getElementById('nomEnfant').value           = d.nom;
            document.getElementById('age').value                 = d.age;
            document.getElementById('emailParent').value         = d.email||'';
            document.getElementById('nomPsy').value              = d.psy;
            document.getElementById('niveauSeance').value        = d.niveau;
            document.getElementById('dateSuivieDate').value      = d.date;
            document.getElementById('dateSuivieHeure').value     = d.heure;
            document.getElementById('scoreHumeur').value         = d.humeur;
            document.getElementById('scoreStress').value         = d.stress;
            document.getElementById('scoreAttention').value      = d.attention;
            document.getElementById('valHumeur').textContent     = d.humeur;
            document.getElementById('valStress').textContent     = d.stress;
            document.getElementById('valAttention').textContent  = d.attention;
            document.getElementById('comportement').value        = d.comportement;
            document.getElementById('interactionSociale').value  = d.interaction;
            document.getElementById('statut').value              = d.statut;
            document.getElementById('therapieId').value          = d.therapieId||'';
            const obs = document.getElementById('observation');
            obs.value = d.observation||'';
            document.getElementById('obsCount').textContent = obs.value.length;
            document.getElementById('formMode').textContent = 'Mode : Modification';
            document.querySelectorAll('#seanceForm [data-rule]').forEach(el=>{
                if(el.value.trim()){ el.classList.remove('is-invalid'); el.classList.add('is-valid'); }
            });
            document.getElementById('nomEnfant').scrollIntoView({behavior:'smooth'});
            // Mettre à jour les recommandations avec les scores chargés
            updateRecommendations();
        });
    });

    /* ══════════════════════════════════════════════════════════════
       SAVE (AJOUT / MODIFICATION)
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('saveBtn')?.addEventListener('click', async function(){
        if(!validateAll()){
            showToast('warning','Formulaire incomplet','Corrigez les champs en rouge avant d\'enregistrer.');
            return;
        }
        const btn=this, ori=btn.innerHTML;
        btn.disabled=true;
        btn.innerHTML=`<span class="spinner"></span> Enregistrement...`;

        const editId = document.getElementById('editId').value;
        const dateVal = document.getElementById('dateSuivieDate').value;
        const heureVal = document.getElementById('dateSuivieHeure').value;

        const body = {
            nomEnfant:          document.getElementById('nomEnfant').value.trim(),
            age:                parseInt(document.getElementById('age').value)||0,
            emailParent:        document.getElementById('emailParent').value.trim()||null,
            nomPsy:             document.getElementById('nomPsy').value.trim(),
            niveauSeance:       parseInt(document.getElementById('niveauSeance').value)||null,
            date:               dateVal,
            time:               heureVal||'00:00',
            scoreHumeur:        parseInt(document.getElementById('scoreHumeur').value)||0,
            scoreStress:        parseInt(document.getElementById('scoreStress').value)||0,
            scoreAttention:     parseInt(document.getElementById('scoreAttention').value)||0,
            comportement:       document.getElementById('comportement').value,
            interactionSociale: document.getElementById('interactionSociale').value,
            observation:        document.getElementById('observation').value.trim()||'',
            statut:             document.getElementById('statut').value,
            therapieId:         document.getElementById('therapieId').value||null,
        };

        const url = editId ? `/admin/seance/${editId}/edit` : '/admin/seance/new';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if(data.success){
                showToast('success', editId ? 'Modification réussie' : 'Séance créée', data.message, 4000);
                setTimeout(()=>location.reload(), 1200);
            } else {
                showToast('error', 'Erreur serveur', data.message, 5000);
                btn.disabled=false; btn.innerHTML=ori;
            }
        } catch(e) {
            showToast('error', 'Erreur réseau', 'Impossible de contacter le serveur.', 5000);
            btn.disabled=false; btn.innerHTML=ori;
        }
    });

    /* ══════════════════════════════════════════════════════════════
       DELETE
    ══════════════════════════════════════════════════════════════ */
    document.querySelectorAll('.delete-btn').forEach(btn=>{
        btn.addEventListener('click', async function(){
            const confirmed = await showConfirm();
            if(!confirmed) return;
            const id = this.dataset.id;
            const token = this.dataset.token;
            const formData = new FormData();
            formData.append('_token', token);
            try {
                const res = await fetch(`/admin/seance/${id}/delete`, {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if(data.success){
                    this.closest('tr').style.animation = 'toastOut .3s ease forwards';
                    setTimeout(() => this.closest('tr').remove(), 300);
                    showToast('success', 'Supprimée', data.message, 3500);
                } else {
                    showToast('error', 'Erreur', data.message, 5000);
                }
            } catch(e) {
                showToast('error', 'Erreur réseau', 'La suppression a échoué.', 5000);
            }
        });
    });
});
</script>
{% endblock %}