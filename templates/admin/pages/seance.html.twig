.cr-section--orange .cr-section-label { color:#d97706; }
.cr-section--blue   { background:#f0f9ff; border:1px solid #bae6fd; }
.cr-section--blue .cr-section-label   { color:#0369a1; }
.cr-section--indigo { background:#eef2ff; border:1px solid #c7d2fe; }
.cr-section--indigo .cr-section-label { color:#4f46e5; }
.cr-section--pink   { background:#fdf2f8; border:1px solid #f0abfc; }
.cr-section--pink .cr-section-label   { color:#a21caf; }

/* Listes */
.cr-list { margin:0; padding-left:0; list-style:none; }
.cr-list li {
    font-size: 12px;
    color: #374151;
    padding: 5px 0;
    border-bottom: 1px solid rgba(0,0,0,.05);
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 6px;
}
.cr-list li:last-child { border-bottom: none; }
.cr-list--green li::before { content: '✅'; font-size: 11px; flex-shrink:0; margin-top:2px; }
.cr-list--orange li::before{ content: '⚠️'; font-size: 11px; flex-shrink:0; margin-top:2px; }

/* Actions */
.cr-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
    padding-top: 12px;
    border-top: 1px solid #f3f0ff;
    margin-top: 4px;
}
.cr-btn-copy, .cr-btn-regen, .cr-btn-email {
    display: inline-flex; align-items: center; gap: 6px;
    border-radius: 10px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
    border: none;
}
.cr-btn-copy  { background:#f5f3ff; color:#5b21b6; border:1.5px solid #ede9fe; }
.cr-btn-copy:hover  { background:#ede9fe; }
.cr-btn-regen { background:#f8f7ff; color:#6d28d9; border:1.5px solid #ddd6fe; }
.cr-btn-regen:hover { background:#ede9fe; }
.cr-btn-email {
    background: linear-gradient(135deg,#7c3aed,#4f46e5);
    color: #fff;
    box-shadow: 0 4px 12px rgba(124,58,237,.3);
}
.cr-btn-email:hover { opacity: .9; transform: translateY(-1px); }
.cr-btn-email:disabled { opacity: .6; cursor: not-allowed; transform: none; }

/* Erreur */
.cr-error {
    padding: 32px 24px;
    text-align: center;
    color: #dc2626;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}
.cr-error i { font-size: 28px; color: #fca5a5; }
</style>

{# ══ SCRIPT COMPTE-RENDU IA ═══════════════════════════════════════════════════ #}
<script>
(function () {

    let _crSeanceId   = null;
    let _crSeanceEmail = null;
    let _crData       = null;   // Stocke le dernier compte-rendu généré

    /* ── Ouvrir le modal CR depuis le bouton dans le detail modal ── */
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('#genCompteRenduBtn');
        if (btn) {
            _crSeanceId    = btn.dataset.seanceId;
            _crSeanceEmail = btn.dataset.email || '';
            ouvrirCrModal();
            genererCompteRendu();
        }
    });

    function ouvrirCrModal() {
        document.getElementById('compteRenduModal').classList.add('open');
        document.getElementById('crLoading').style.display  = 'block';
        document.getElementById('crContent').style.display  = 'none';
        document.getElementById('crError').style.display    = 'none';
    }

    /* ── Fermer ── */
    document.getElementById('closeCrBtn').addEventListener('click', () => {
        document.getElementById('compteRenduModal').classList.remove('open');
    });
    document.getElementById('compteRenduModal').addEventListener('click', function (e) {
        if (e.target === this) this.classList.remove('open');
    });

    /* ── Générer le compte-rendu ── */
    window.genererCompteRendu = async function () {
        if (!_crSeanceId) return;

        document.getElementById('crLoading').style.display  = 'block';
        document.getElementById('crContent').style.display  = 'none';
        document.getElementById('crError').style.display    = 'none';

        try {
            const resp = await fetch(`/admin/seance/${_crSeanceId}/compte-rendu-ia`, { method: 'POST' });
            const data = await resp.json();

            if (!data.success) {
                showCrError(data.message || 'Erreur inconnue');
                return;
            }

            _crData = data.compteRendu;
            afficherCompteRendu(_crData);

        } catch (err) {
            showCrError('Impossible de contacter le serveur IA.');
        }
    };

    /* ── Afficher le compte-rendu ── */
    function afficherCompteRendu(cr) {
        // Résumé
        document.getElementById('crResume').textContent = cr.resume_clinique || '—';

        // Points positifs
        const ulPos = document.getElementById('crPositifs');
        ulPos.innerHTML = (cr.points_positifs || []).map(p => `<li>${escHtml(p)}</li>`).join('');

        // Points d'attention
        const ulAtt = document.getElementById('crAttentions');
        ulAtt.innerHTML = (cr.points_attention || []).map(p => `<li>${escHtml(p)}</li>`).join('');

        // Évolution
        document.getElementById('crEvolution').textContent = cr.evolution || '—';

        // Recommandation
        document.getElementById('crRecommandation').textContent = cr.recommandation_prochaine || '—';

        // Message parent
        document.getElementById('crMessageParent').textContent = cr.message_parent || '—';

        // Afficher bouton email si email disponible
        const emailBtn = document.getElementById('crEmailBtn');
        if (_crSeanceEmail && _crSeanceEmail.trim()) {
            emailBtn.style.display = 'inline-flex';
            emailBtn.innerHTML = `<i class="fas fa-envelope"></i> Envoyer à ${escHtml(_crSeanceEmail)}`;
        } else {
            emailBtn.style.display = 'none';
        }

        document.getElementById('crLoading').style.display = 'none';
        document.getElementById('crContent').style.display = 'block';
    }

    function showCrError(msg) {
        document.getElementById('crLoading').style.display = 'none';
        document.getElementById('crError').style.display   = 'flex';
        document.getElementById('crErrorMsg').textContent  = msg;
    }

    /* ── Copier ── */
    window.copyCompteRendu = function () {
        if (!_crData) return;
        const texte = [
            '=== COMPTE-RENDU IA AutiCare ===\n',
            '📋 RÉSUMÉ CLINIQUE\n' + (_crData.resume_clinique || ''),
            '\n✅ POINTS POSITIFS\n' + (_crData.points_positifs || []).map((p, i) => `${i+1}. ${p}`).join('\n'),
            '\n⚠️ POINTS D\'ATTENTION\n' + (_crData.points_attention || []).map((p, i) => `${i+1}. ${p}`).join('\n'),
            '\n📈 ÉVOLUTION\n' + (_crData.evolution || ''),
            '\n📅 RECOMMANDATION\n' + (_crData.recommandation_prochaine || ''),
            '\n💬 MESSAGE PARENTS\n' + (_crData.message_parent || ''),
        ].join('\n');

        navigator.clipboard.writeText(texte).then(() => {
            const btn = document.getElementById('crCopyBtn');
            btn.innerHTML = '<i class="fas fa-check"></i> Copié !';
            btn.style.background = '#d1fae5';
            btn.style.color = '#059669';
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-copy"></i> Copier';
                btn.style.background = '';
                btn.style.color = '';
            }, 2000);
        });
    };

    /* ── Envoyer par email ── */
    document.getElementById('crEmailBtn').addEventListener('click', async function () {
        if (!_crData || !_crSeanceId) return;
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span style="width:12px;height:12px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:crDot 0.6s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px;"></span> Envoi...';

        try {
            const resp = await fetch(`/admin/seance/${_crSeanceId}/envoyer-compte-rendu`, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ compteRendu: _crData })
            });
            const data = await resp.json();
            if (data.success) {
                btn.innerHTML = '<i class="fas fa-check"></i> Envoyé !';
                btn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
            } else {
                btn.innerHTML = '<i class="fas fa-times"></i> Erreur';
                btn.style.background = 'linear-gradient(135deg,#ef4444,#dc2626)';
            }
            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-envelope"></i> Envoyer à ${escHtml(_crSeanceEmail)}`;
                btn.style.background = '';
            }, 3000);
        } catch {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-times"></i> Erreur réseau';
        }
    });

    /* ── Régénérer ── */
    document.getElementById('crRegenBtn').addEventListener('click', genererCompteRendu);

    /* ── Helper ── */
    function escHtml(str) {
        const d = document.createElement('div');
        d.appendChild(document.createTextNode(String(str)));
        return d.innerHTML;
    }

})();
</script>




