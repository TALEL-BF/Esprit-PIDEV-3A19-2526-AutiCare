{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Scores & Statistiques{% endblock %}

{% block page_title %}Scores & Statistiques{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
    .rank-medal {
        font-size: 1.2rem;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-trophy me-2" style="color:var(--purple-500)"></i>Scores & Statistiques</h2>
    <p>Suivre les performances et progrès des enfants</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Parties jouées</div>
                    <div class="stat-value">{{ totalGamesPlayed|default(4521) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-play-circle"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +320 ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Score moyen</div>
                    <div class="stat-value">{{ averageScore|default(76) }}%</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-star"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +4% ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Meilleur score</div>
                    <div class="stat-value">{{ bestScore|default(98) }}%</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-trophy"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> record</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Joueurs actifs</div>
                    <div class="stat-value">{{ activePlayers|default(384) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-users"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +28 ce mois</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-line"></i> Performance par catégorie</span>
            </div>
            <div class="card-box-body">
                <canvas id="radarChart" height="260"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-line"></i> Parties jouées par mois</span>
            </div>
            <div class="card-box-body">
                <canvas id="partiesChart" height="260"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Classement des Joueurs</span>
        <input type="text" class="form-control filter-input" id="scoreFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="scoresTable">
                <thead>
                    <tr>
                        <th>Rang</th>
                        <th>Joueur</th>
                        <th>Jeu favori</th>
                        <th>Parties</th>
                        <th>Score moy.</th>
                        <th>Meilleur score</th>
                        <th>Niveau atteint</th>
                    </tr>
                </thead>
                <tbody>
                    {% for player in players|default([
                        {rank:'🥇 1', name:'Adam Mejri', favoriteGame:'Puzzle des animaux', gamesPlayed:245, avgScore:94, bestScore:98, level:'Expert', levelStatus:'active'},
                        {rank:'🥈 2', name:'Sara Hamdi', favoriteGame:'Associer les formes', gamesPlayed:189, avgScore:88, bestScore:96, level:'Avancé', levelStatus:'active'},
                        {rank:'🥉 3', name:'Youssef Ben Amor', favoriteGame:'Mémoire des couleurs', gamesPlayed:312, avgScore:82, bestScore:91, level:'Avancé', levelStatus:'active'},
                        {rank:'4', name:'Nour Gharbi', favoriteGame:'Les émotions', gamesPlayed:98, avgScore:75, bestScore:87, level:'Intermédiaire', levelStatus:'pending'},
                        {rank:'5', name:'Lina Kaddour', favoriteGame:'Puzzle des animaux', gamesPlayed:145, avgScore:71, bestScore:83, level:'Intermédiaire', levelStatus:'pending'}
                    ]) %}
                        <tr>
                            <td>{% if player.rank starts with '🥇' or player.rank starts with '🥈' or player.rank starts with '🥉' %}
                                <span class="rank-medal">{{ player.rank }}</span>
                            {% else %}
                                {{ player.rank }}
                            {% endif %}</td>
                            <td>{{ player.name }}</td>
                            <td>{{ player.favoriteGame }}</td>
                            <td>{{ player.gamesPlayed }}</td>
                            <td>{{ player.avgScore }}%</td>
                            <td>{{ player.bestScore }}%</td>
                            <td>
                                {% if player.levelStatus == 'active' %}
                                    <span class="badge-status badge-active">{{ player.level }}</span>
                                {% elseif player.levelStatus == 'pending' %}
                                    <span class="badge-status badge-pending">{{ player.level }}</span>
                                {% else %}
                                    <span class="badge-status">{{ player.level }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const P = { p400: '#a855f7', pink: '#f472b6', indigo: '#818cf8', accent: '#e040fb', p300: '#c084fc' };
    const months = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];

    // Radar Chart - Performance par catégorie
    new Chart(document.getElementById('radarChart').getContext('2d'), {
        type: 'radar',
        data: {
            labels: ['Reconnaissance', 'Mémoire', 'Langage', 'Motricité', 'Socialisation'],
            datasets: [
                {
                    label: 'Score moyen %',
                    data: [82, 74, 68, 88, 72],
                    borderColor: P.p400,
                    backgroundColor: 'rgba(168,85,247,.15)',
                    pointBackgroundColor: P.p400,
                    pointRadius: 4
                },
                {
                    label: 'Objectif',
                    data: [85, 80, 80, 90, 80],
                    borderColor: P.pink,
                    backgroundColor: 'rgba(244,114,182,.08)',
                    pointBackgroundColor: P.pink,
                    pointRadius: 4,
                    borderDash: [4, 3]
                }
            ]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        font: { family: 'DM Sans', size: 11 }
                    }
                }
            },
            scales: {
                r: {
                    grid: { color: '#f3e8ff' },
                    pointLabels: { font: { family: 'DM Sans', size: 11 } }
                }
            },
            responsive: true
        }
    });

    // Line Chart - Parties jouées par mois
    new Chart(document.getElementById('partiesChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: months,
            datasets: [{
                label: 'Parties jouées',
                data: [280, 350, 420, 390, 460, 520, 490, 580, 620, 690, 750, 800],
                borderColor: P.p400,
                backgroundColor: 'rgba(168,85,247,.1)',
                fill: true,
                tension: 0.4,
                pointBackgroundColor: P.p400,
                pointRadius: 4
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { x: { grid: { display: false } }, y: { grid: { color: '#f3e8ff' } } },
            responsive: true
        }
    });

    // Filter table
    document.getElementById('scoreFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#scoresTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });
});
</script>
{% endblock %}