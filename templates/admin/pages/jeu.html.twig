{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Jeux & Niveaux{% endblock %}

{% block page_title %}Jeux & Niveaux{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-puzzle-piece me-2" style="color:var(--purple-500)"></i>Jeux & Niveaux</h2>
    <p>Configurer les jeux éducatifs et leurs niveaux</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Jeux actifs</div>
                    <div class="stat-value">{{ activeGames|default(32) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-gamepad"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +3 nouveaux</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Niveaux totaux</div>
                    <div class="stat-value">{{ totalLevels|default(128) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-layer-group"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> configurés</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Catégories</div>
                    <div class="stat-value">{{ categories|default(5) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-tags"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> disponibles</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">En développement</div>
                    <div class="stat-value">{{ inDevelopment|default(7) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-code"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> en cours</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter / Modifier un Jeu</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Nom du jeu</label>
                        <input type="text" class="form-control" id="gameName" placeholder="Ex: Associer les formes">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Niveau</label>
                        <select class="form-select" id="gameDifficulty">
                            <option>Facile</option>
                            <option>Moyen</option>
                            <option>Difficile</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Catégorie</label>
                        <select class="form-select" id="gameCategory">
                            <option>Reconnaissance</option>
                            <option>Mémoire</option>
                            <option>Langage</option>
                            <option>Motricité</option>
                            <option>Socialisation</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Âge cible</label>
                        <select class="form-select" id="gameAge">
                            <option>3-5 ans</option>
                            <option>6-8 ans</option>
                            <option>9-12 ans</option>
                            <option>13+ ans</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Durée estimée (min)</label>
                        <input type="number" class="form-control" id="gameDuration" placeholder="10">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="gameStatus">
                            <option>Actif</option>
                            <option>En développement</option>
                            <option>Désactivé</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Objectifs pédagogiques</label>
                        <textarea class="form-control" id="gameObjectives" rows="2" placeholder="Décrivez les objectifs du jeu..."></textarea>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveGameBtn"><i class="fas fa-save"></i> Enregistrer</button>
                        <button class="btn-outline-purple" id="cancelGameBtn"><i class="fas fa-times"></i> Annuler</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-pie"></i> Par catégorie</span>
            </div>
            <div class="card-box-body">
                <canvas id="jeuChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Jeux</span>
        <input type="text" class="form-control filter-input" id="gameFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="jeuTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Niveau</th>
                        <th>Âge</th>
                        <th>Niveaux</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for game in games|default([
                        {id:1, name:'Associer les formes', category:'Reconnaissance', difficulty:'Facile', age:'3-5 ans', levels:5, status:'Actif'},
                        {id:2, name:'Mémoire des couleurs', category:'Mémoire', difficulty:'Moyen', age:'6-8 ans', levels:8, status:'Actif'},
                        {id:3, name:'Les émotions du visage', category:'Langage', difficulty:'Moyen', age:'6-8 ans', levels:6, status:'En développement'},
                        {id:4, name:'Puzzle des animaux', category:'Motricité', difficulty:'Facile', age:'3-5 ans', levels:10, status:'Actif'}
                    ]) %}
                        <tr>
                            <td>{{ game.id }}</td>
                            <td>{{ game.name }}</td>
                            <td>{{ game.category }}</td>
                            <td>{{ game.difficulty }}</td>
                            <td>{{ game.age }}</td>
                            <td>{{ game.levels }}</td>
                            <td>
                                {% if game.status == 'Actif' %}
                                    <span class="badge-status badge-active">{{ game.status }}</span>
                                {% elseif game.status == 'En développement' %}
                                    <span class="badge-status badge-pending">{{ game.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ game.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-game-btn" data-id="{{ game.id }}">Modifier</button>
                                <button class="btn-danger-soft delete-game-btn" data-id="{{ game.id }}">Supprimer</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const P = { p400:'#a855f7', pink:'#f472b6', indigo:'#818cf8', accent:'#e040fb', p300:'#c084fc' };

    // Doughnut Chart - Par catégorie
    new Chart(document.getElementById('jeuChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Reconnaissance', 'Mémoire', 'Langage', 'Motricité', 'Social'],
            datasets: [{
                data: [8, 6, 7, 7, 4],
                backgroundColor: [P.p400, P.pink, P.indigo, P.accent, P.p300],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        font: { family: 'DM Sans', size: 11 }
                    }
                }
            },
            cutout: '60%',
            responsive: true
        }
    });

    // Filter table
    document.getElementById('gameFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#jeuTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Edit button
    document.querySelectorAll('.edit-game-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('formMode').textContent = 'Mode : Modification';
            const id = this.getAttribute('data-id');
            console.log('Edit game:', id);
        });
    });

    // Delete button
    document.querySelectorAll('.delete-game-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Supprimer ce jeu ?')) {
                this.closest('tr').remove();
            }
        });
    });

    // Cancel button
    document.getElementById('cancelGameBtn')?.addEventListener('click', function() {
        document.getElementById('formMode').textContent = 'Mode : Ajout';
        document.getElementById('gameName').value = '';
        document.getElementById('gameDuration').value = '';
        document.getElementById('gameObjectives').value = '';
    });

    // Save button
    document.getElementById('saveGameBtn')?.addEventListener('click', function() {
        const gameName = document.getElementById('gameName')?.value;
        if (!gameName) {
            alert('Veuillez saisir un nom de jeu');
            return;
        }
        console.log('Save game:', {
            name: gameName,
            difficulty: document.getElementById('gameDifficulty')?.value,
            category: document.getElementById('gameCategory')?.value,
            age: document.getElementById('gameAge')?.value,
            duration: document.getElementById('gameDuration')?.value,
            status: document.getElementById('gameStatus')?.value,
            objectives: document.getElementById('gameObjectives')?.value
        });
        alert('Jeu enregistré (démo)');
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    });
});
</script>
{% endblock %}