{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Liste des Utilisateurs{% endblock %}
{% block page_title %}Liste des Utilisateurs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="fas fa-list-ul me-2" style="color:var(--purple-500)"></i>Liste des Utilisateurs</h2>
        <p>Gérer tous les comptes de la plateforme</p>
    </div>

    <a href="{{ path('admin_users_new') }}" class="btn-purple">
        <i class="fas fa-user-plus"></i> Ajouter un utilisateur
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total</div>
                    <div class="stat-value">{{ totalUsers|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-users"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> Utilisateurs enregistrés</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Actifs</div>
                    <div class="stat-value">{{ activeUsers|default(0) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-user-check"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> Comptes actifs</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Nouveaux</div>
                    <div class="stat-value">{{ newUsers|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-user-plus"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> Ce mois</div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Inactifs</div>
                    <div class="stat-value">{{ inactiveUsers|default(0) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-user-times"></i></div>
            </div>
            <div class="stat-change down"><i class="fas fa-arrow-down"></i> Comptes inactifs</div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Utilisateurs</span>
        <input type="text" class="form-control filter-input" id="userFilterInput" placeholder="Filtrer...">
    </div>

    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="usersTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users|default([]) %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.firstname }} {{ user.lastname }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.role }}</td>
                            <td>
                                {% if user.status == 'Actif' %}
                                    <span class="badge-status badge-active"><span class="pulse-dot"></span> {{ user.status }}</span>
                                {% elseif user.status == 'En attente' %}
                                    <span class="badge-status badge-pending">{{ user.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ user.status }}</span>
                                {% endif %}
                            </td>
                            <td>{{ user.registeredAt }}</td>
                            <td>
                                <a href="{{ path('admin_users_edit', {'id': user.id}) }}" class="btn-edit-soft me-1">
                                    Modifier
                                </a>

                                <form method="post"
                                      action="{{ path('admin_users_delete', {'id': user.id}) }}"
                                      style="display:inline-block"
                                      onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="btn-danger-soft">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterInput = document.getElementById('userFilterInput');
    if (filterInput) {
        filterInput.addEventListener('input', function(e) {
            const val = e.target.value.toLowerCase();
            document.querySelectorAll('#usersTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    }
});
</script>
{% endblock %}