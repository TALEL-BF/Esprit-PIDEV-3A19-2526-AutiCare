{# templates/admin/pages/users.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Liste des Utilisateurs{% endblock %}

{% block page_title %}Liste des Utilisateurs{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-list-ul me-2" style="color:var(--purple-500)"></i>Liste des Utilisateurs</h2>
        <p>Gérer tous les comptes de la plateforme</p>
    </div>
    <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Ajouter un utilisateur
    </a>
</div>

{# Dashboard mini stats #}
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total</div>
                    <div class="stat-value">{{ totalUsers|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-users"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Actifs</div>
                    <div class="stat-value">{{ activeUsers|default(0) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-user-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Nouveaux</div>
                    <div class="stat-value">{{ newUsers|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-user-plus"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Inactifs</div>
                    <div class="stat-value">{{ inactiveUsers|default(0) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-user-times"></i></div>
            </div>
        </div>
    </div>
</div>

{# Messages flash #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

{# Tableau des utilisateurs #}
<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Utilisateurs</span>
        <input type="text" class="form-control filter-input" id="userFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.prenom }} {{ user.nom }}</td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if user.role == 'admin' %}
                                    <span class="badge bg-danger">Admin</span>
                                {% elseif user.role == 'parent' %}
                                    <span class="badge bg-primary">Parent</span>
                                {% elseif user.role == 'enfant' %}
                                    <span class="badge bg-success">Enfant</span>
                                {% elseif user.role == 'professeur' %}
                                    <span class="badge bg-info">Professeur</span>
                                {% elseif user.role == 'psychologue' %}
                                    <span class="badge bg-warning">Psychologue</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ user.role }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.status == 'active' %}
                                    <span class="badge bg-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactif</span>
                                {% endif %}
                            </td>
                            <td>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</td>
                            <td>
                                <a href="{{ path('admin_users_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('admin_users_delete', {'id': user.id}) }}" style="display: inline-block;" onsubmit="return confirm('Supprimer cet utilisateur ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterInput = document.getElementById('userFilterInput');
    if (filterInput) {
        filterInput.addEventListener('input', function(e) {
            const val = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#usersTable tbody tr');
            rows.forEach(row => {
                if (row.cells) {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(val) ? '' : 'none';
                }
            });
        });
    }
});
</script>
{% endblock %}