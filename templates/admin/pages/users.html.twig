{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Liste des Utilisateurs{% endblock %}

{% block page_title %}Liste des Utilisateurs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-list-ul me-2" style="color:var(--purple-500)"></i>Liste des Utilisateurs</h2>
    <p>Gérer tous les comptes de la plateforme</p>
</div>

{# Dashboard mini stats #}
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total</div>
                    <div class="stat-value">{{ totalUsers|default(1248) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-users"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +12% ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Actifs</div>
                    <div class="stat-value">{{ activeUsers|default(1089) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-user-check"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> 87%</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Nouveaux</div>
                    <div class="stat-value">{{ newUsers|default(42) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-user-plus"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Inactifs</div>
                    <div class="stat-value">{{ inactiveUsers|default(159) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-user-times"></i></div>
            </div>
            <div class="stat-change down"><i class="fas fa-arrow-down"></i> 13%</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-user-plus"></i> Ajouter / Modifier un Utilisateur</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" id="userFirstname" placeholder="Ex: Ahmed">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" id="UserLastname" placeholder="Ex: Ben Ali">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="userEmail" placeholder="email@exemple.com">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" class="form-control" id="userPhone" placeholder="+216 xx xxx xxx">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rôle</label>
                        <select class="form-select" id="userRole">
                            <option>Parent</option>
                            <option>Thérapeute</option>
                            <option>Enseignant</option>
                            <option>Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="userStatus">
                            <option>Actif</option>
                            <option>Inactif</option>
                            <option>En attente</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveUserBtn"><i class="fas fa-save"></i> Enregistrer</button>
                        <button class="btn-outline-purple" id="cancelUserBtn"><i class="fas fa-times"></i> Annuler</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-bar"></i> Par rôle</span>
            </div>
            <div class="card-box-body">
                <canvas id="roleChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Utilisateurs</span>
        <input type="text" class="form-control filter-input" id="userFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="usersTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Inscription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users|default([
                        {id:1, firstname:'Ahmed', lastname:'Ben Ali', email:'ahmed@exemple.com', role:'Parent', status:'Actif', registeredAt:'12/01/2024'},
                        {id:2, firstname:'Fatma', lastname:'Trabelsi', email:'fatma@exemple.com', role:'Thérapeute', status:'Actif', registeredAt:'05/02/2024'},
                        {id:3, firstname:'Mohamed', lastname:'Khelil', email:'mohamed@exemple.com', role:'Enseignant', status:'En attente', registeredAt:'18/02/2024'},
                        {id:4, firstname:'Leila', lastname:'Mansouri', email:'leila@exemple.com', role:'Parent', status:'Inactif', registeredAt:'22/03/2024'},
                        {id:5, firstname:'Karim', lastname:'Bouazizi', email:'karim@exemple.com', role:'Admin', status:'Actif', registeredAt:'01/04/2024'}
                    ]) %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.firstname }} {{ user.lastname }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.role }}</td>
                            <td>
                                {% if user.status == 'Actif' %}
                                    <span class="badge-status badge-active"><span class="pulse-dot"></span> {{ user.status }}</span>
                                {% elseif user.status == 'En attente' %}
                                    <span class="badge-status badge-pending">{{ user.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ user.status }}</span>
                                {% endif %}
                            </span>
                            </td>
                            <td>{{ user.registeredAt }}</td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-user-btn" data-id="{{ user.id }}">Modifier</button>
                                <button class="btn-danger-soft delete-user-btn" data-id="{{ user.id }}">Supprimer</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Role chart
    const ctx = document.getElementById('roleChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Parents', 'Thérapeutes', 'Enseignants', 'Admin'],
            datasets: [{
                data: [680, 320, 180, 68],
                backgroundColor: ['#9333ea', '#ec4899', '#06b6d4', '#f59e0b'],
                borderWidth: 0
            }]
        },
        options: {
            plugins: {
                legend: { position: 'bottom', labels: { font: { size: 11 } } }
            },
            cutout: '60%',
            responsive: true
        }
    });

    // Filter table
    document.getElementById('userFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#usersTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Edit button
    document.querySelectorAll('.edit-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('formMode').textContent = 'Mode : Modification';
            const id = this.getAttribute('data-id');
            console.log('Edit user:', id);
            // Here you would load user data into the form
        });
    });

    // Delete button
    document.querySelectorAll('.delete-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Supprimer cet utilisateur ?')) {
                this.closest('tr').remove();
            }
        });
    });

    // Cancel button
    document.getElementById('cancelUserBtn')?.addEventListener('click', function() {
        document.getElementById('formMode').textContent = 'Mode : Ajout';
        document.getElementById('userFirstname').value = '';
        document.getElementById('UserLastname').value = '';
        document.getElementById('userEmail').value = '';
        document.getElementById('userPhone').value = '';
    });

    // Save button
    document.getElementById('saveUserBtn')?.addEventListener('click', function() {
        const firstname = document.getElementById('userFirstname')?.value;
        const lastname = document.getElementById('UserLastname')?.value;
        if (!firstname || !lastname) {
            alert('Veuillez saisir le prénom et le nom');
            return;
        }
        console.log('Save user:', {
            firstname: firstname,
            lastname: lastname,
            email: document.getElementById('userEmail')?.value,
            phone: document.getElementById('userPhone')?.value,
            role: document.getElementById('userRole')?.value,
            status: document.getElementById('userStatus')?.value
        });
        alert('Utilisateur enregistré (démo)');
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    });
});
</script>
{% endblock %}