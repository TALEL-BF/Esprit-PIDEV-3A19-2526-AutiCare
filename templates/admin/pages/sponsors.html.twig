{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Sponsors{% endblock %}

{% block page_title %}Gestion des Sponsors{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ========== PALETTE DE COULEURS PASTEL ========== */
:root {
    --pastel-pink: #f8e4f0;
    --pastel-pink-dark: #e8a0c4;
    --pastel-pink-soft: #fce4ec;
    --pastel-blue: #e0f0ff;
    --pastel-blue-dark: #7eb8e0;
    --pastel-green: #e0f5e8;
    --pastel-green-dark: #7ec89e;
    --pastel-yellow: #fff5e0;
    --pastel-yellow-dark: #f5c842;
    --pastel-purple: #f0e4ff;
    --pastel-purple-dark: #b87ef5;
    --pastel-orange: #ffe4e0;
    --pastel-orange-dark: #f5a07e;
    --pastel-mint: #e0fff0;
    --pastel-mint-dark: #7ef5c8;
}
/* Add to your existing styles */
/* ========== FORM ERROR STYLES (MATCHING EVENTS PAGE) ========== */
.form-error {
    display: block;
    margin-top: 6px;
    font-size: 0.75rem;
    border-radius: 8px;
    padding: 4px 10px;
    animation: slideDown 0.2s ease;
}

.form-error i {
    margin-right: 6px;
}

.form-error.success-message {
    background: var(--pastel-green);
    color: #2d6a4f;
}

.form-error.error-message {
    background: var(--pastel-coral);
    color: #c92a2a;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-5px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

.is-invalid {
    animation: shake 0.3s ease-in-out;
}

/* Field colors based on type (like events page) */
input#sponsorName.form-control {
    background-color: var(--pastel-pink-soft);
}
input#sponsorName.form-control:focus {
    background-color: white;
}

select#sponsorType.form-select {
    background-color: var(--pastel-purple);
}

input#sponsorEmail.form-control {
    background-color: var(--pastel-sky);
}

input#sponsorPhone.form-control {
    background-color: var(--pastel-mint);
}

input#sponsorAmount.form-control {
    background-color: var(--pastel-green);
}

textarea#sponsorDescription.form-control {
    background-color: var(--pastel-yellow);
}
/* Green success state */
.is-valid {
    border-color: #198754 !important;
    border-width: 2px !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right calc(0.375em + 0.1875rem) center;
    background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    padding-right: calc(1.5em + 0.75rem);
}

.valid-feedback {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    font-size: 0.875em;
    color: #198754;
    animation: slideDown 0.3s ease;
}

.valid-feedback i, .invalid-feedback i {
    margin-right: 4px;
}
/* Add this to your existing styles */
.invalid-feedback {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    font-size: 0.875em;
    color: #dc3545;
    animation: slideDown 0.3s ease;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
/* Validation error styles */
.is-invalid {
    border-color: #dc3545 !important;
    border-width: 2px !important;
}

.invalid-feedback {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    font-size: 0.875em;
    color: #dc3545;
}
.current-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 5px;
}
.current-image-wrapper {
    margin-top: 10px;
    padding: 15px;
    background: var(--pastel-pink-soft);
    border-radius: 12px;
    border-left: 4px solid var(--pastel-pink-dark);
}
select[multiple] {
    padding: 8px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}
select[multiple] option {
    padding: 8px;
    border-bottom: 1px solid #f3f4f6;
}
select[multiple] option:checked {
    background: var(--pastel-purple-dark) linear-gradient(0deg, var(--pastel-purple-dark) 0%, var(--pastel-purple-dark) 100%);
    color: white;
}
.sponsor-image {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
}
.sponsor-image-placeholder {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pastel-yellow);
    border-radius: 8px;
    color: var(--pastel-yellow-dark);
}
.alert {
    padding: 12px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    border: none;
}
.alert-success {
    background: var(--pastel-green);
    color: #2d6a4f;
}
.alert-danger {
    background: var(--pastel-pink);
    color: #c92a2a;
}
.btn-close {
    float: right;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
}
.custom-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
}
.custom-popup {
    background: white;
    border-radius: 20px;
    padding: 25px;
    width: 450px;
    max-width: 90%;
    text-align: center;
    animation: fadeIn 0.3s ease;
}
.custom-popup.warning {
    border-top: 5px solid #ef4444;
}
.custom-popup-icon {
    font-size: 60px;
    margin-bottom: 15px;
}
.custom-popup h3 {
    font-size: 24px;
    margin-bottom: 10px;
}
.custom-popup p {
    color: #6b7280;
    margin-bottom: 20px;
}
.custom-popup-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}
.btn-popup-confirm {
    background: #ef4444;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}
.btn-popup-confirm:hover {
    background: #dc2626;
}
.btn-popup-cancel {
    background: #f3f4f6;
    color: #374151;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}
.btn-popup-cancel:hover {
    background: #e5e7eb;
}
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}
#loadingIndicator {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    padding: 20px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    z-index: 9999;
    text-align: center;
}

/* Search icon inside input */
.search-wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
}
.search-wrapper .search-input-wrapper {
    flex: 1;
}
.search-input-wrapper {
    position: relative;
}
.search-input-wrapper i {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--pastel-pink-dark);
    font-size: 1rem;
    z-index: 1;
}
.search-input-wrapper input {
    padding-left: 40px !important;
}

.btn-reset {
    background: var(--pastel-pink);
    color: #c92a2a;
    border: none;
    padding: 8px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-reset:hover {
    background: var(--pastel-pink-dark);
    color: white;
    transform: translateY(-2px);
}

/* Active filters */
.active-filters {
    background: var(--pastel-purple);
    padding: 10px 15px;
    border-radius: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 15px;
}
.badge-grey {
    background: rgba(107,114,128,0.1);
    color: #6b7280;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    display: inline-block;
}

/* Card styles */
.card-box {
    background: white;
    border-radius: 20px;
    margin-bottom: 24px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.card-box-header {
    padding: 16px 24px;
    border-bottom: 2px solid var(--pastel-pink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    background: linear-gradient(135deg, #fff, var(--pastel-pink-soft));
}

.card-box-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: #1f2937;
    display: flex;
    align-items: center;
    gap: 8px;
}

.card-box-title i {
    color: var(--pastel-purple-dark);
    font-size: 1.3rem;
}

.card-box-body {
    padding: 24px;
}

.btn-purple {
    background: linear-gradient(135deg, var(--pastel-purple-dark), #a78bfa);
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-purple:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
}

.btn-outline-purple {
    background: transparent;
    color: var(--pastel-purple-dark);
    border: 2px solid var(--pastel-purple-dark);
    padding: 8px 22px;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-outline-purple:hover {
    background: var(--pastel-purple);
    transform: translateY(-2px);
}

.btn-edit-soft {
    background: var(--pastel-yellow);
    color: #b45309;
    border: none;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-edit-soft:hover {
    background: var(--pastel-yellow-dark);
    transform: translateY(-1px);
}

.btn-danger-soft {
    background: var(--pastel-pink);
    color: #c92a2a;
    border: none;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-danger-soft:hover {
    background: #f8d4e4;
    transform: translateY(-1px);
}

.form-label {
    font-weight: 600;
    margin-bottom: 6px;
    color: #374151;
}
.form-label i {
    color: var(--pastel-pink-dark);
    margin-right: 5px;
}

.form-control, .form-select {
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    padding: 8px 12px;
    transition: all 0.2s;
    width: 100%;
}

.form-control:focus, .form-select:focus {
    border-color: var(--pastel-purple-dark);
    outline: none;
    box-shadow: 0 0 0 2px rgba(180, 126, 245, 0.2);
}

.form-mode-badge {
    background: var(--pastel-green);
    color: #2d6a4f;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

.text-muted i {
    color: var(--pastel-pink-dark);
    margin-right: 6px;
}

.table-wrapper {
    overflow-x: auto;
}

.custom-table {
    width: 100%;
    border-collapse: collapse;
}

.custom-table th {
    background: var(--pastel-pink-soft);
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    color: #1f2937;
    border-bottom: 2px solid var(--pastel-pink-dark);
}

.custom-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: middle;
}

.custom-table tr:hover {
    background: var(--pastel-pink-soft);
}

.filter-select {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 8px 12px;
    background: white;
    transition: all 0.2s;
    width: 100%;
}
.filter-select:focus {
    border-color: var(--pastel-purple-dark);
    outline: none;
    box-shadow: 0 0 0 2px rgba(180, 126, 245, 0.2);
}

.filter-label {
    font-weight: 600;
    color: #4b5563;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.filter-label i {
    color: var(--pastel-pink-dark);
    width: 18px;
}

.filters-row {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}
.filters-row .filter-group {
    flex: 1;
    min-width: 150px;
}

.pink-badge {
    background: var(--pastel-pink);
    color: #c92a2a;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
}

/* Section titles */
.form-section-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--pastel-purple-dark);
    margin: 20px 0 15px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--pastel-pink);
    display: flex;
    align-items: center;
    gap: 8px;
}
.form-section-title:first-of-type {
    margin-top: 0;
}
.form-section-title i {
    font-size: 0.9rem;
    color: var(--pastel-pink-dark);
}
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-handshake me-2" style="color:var(--pastel-purple-dark)"></i>Gestion des Sponsors</h2>
    <p>Gérer les partenaires et sponsors des événements</p>
</div>

{# Messages flash #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
    </div>
{% endfor %}

<!-- FORMULAIRE AJOUT/MODIFICATION -->
<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter / Modifier un Sponsor</span>
        <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
    </div>
    <div class="card-box-body">
       <form method="POST" action="{{ path('admin_sponsors_add') }}" id="sponsorForm" enctype="multipart/form-data" novalidate>
            <input type="hidden" id="sponsorId" name="sponsorId" value="">
            
            <!-- INFORMATIONS PRINCIPALES -->
            <div class="form-section-title">
                <i class="fas fa-info-circle"></i> INFORMATIONS PRINCIPALES
            </div>
            <div class="row g-3">
               <div class="col-md-6">
    <label class="form-label"><i class="fas fa-building"></i> Nom du sponsor</label>
    <input type="text" class="form-control {% if formErrors is defined %}is-invalid{% endif %}" id="sponsorName" name="sponsorName" placeholder="Ex: Tunisie Telecom" value="{{ submittedData.sponsorName|default('') }}">
    {% if formErrors is defined %}
        <div class="invalid-feedback d-block">
            {% for error in formErrors %}
                {% if 'nom' in error|lower %}
                    {{ error }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>
                <div class="col-md-6">
    <label class="form-label"><i class="fas fa-tag"></i> Type de sponsor</label>
    <select class="form-select" id="sponsorType" name="sponsorType">
        <option value="">Sélectionner un type</option>
        <option {% if submittedData.sponsorType|default('') == 'Platine' %}selected{% endif %}>Platine</option>
        <option {% if submittedData.sponsorType|default('') == 'Gold' %}selected{% endif %}>Gold</option>
        <option {% if submittedData.sponsorType|default('') == 'Silver' %}selected{% endif %}>Silver</option>
        <option {% if submittedData.sponsorType|default('') == 'Bronze' %}selected{% endif %}>Bronze</option>
    </select>
</div>
               <div class="col-md-6">
    <label class="form-label"><i class="fas fa-coins"></i> Montant (TND)</label>
    <input type="number" class="form-control" id="sponsorAmount" name="sponsorAmount" placeholder="5000">
</div>
               <div class="col-md-6">
    <label class="form-label"><i class="fas fa-envelope"></i> Email</label>
    <input type="email" class="form-control" id="sponsorEmail" name="sponsorEmail" placeholder="contact@entreprise.com" value="{{ submittedData.sponsorEmail|default('') }}">
</div>
               <div class="col-md-6">
    <label class="form-label"><i class="fas fa-phone"></i> Téléphone</label>
    <input type="tel" class="form-control" id="sponsorPhone" name="sponsorPhone" placeholder="+216 xx xxx xxx" value="{{ submittedData.sponsorPhone|default('') }}">
</div>
            </div>
            
            <!-- DESCRIPTION -->
            <div class="form-section-title">
                <i class="fas fa-align-left"></i> DESCRIPTION
            </div>
            <div class="row g-3">
                <div class="col-12">
    <label class="form-label"><i class="fas fa-file-alt"></i> Description</label>
    <textarea class="form-control {% if formErrors is defined %}is-invalid{% endif %}" id="sponsorDescription" name="sponsorDescription" rows="3" placeholder="Description du sponsor...">{{ submittedData.sponsorDescription|default('') }}</textarea>
    {% if formErrors is defined %}
        <div class="invalid-feedback d-block">
            {% for error in formErrors %}
                {% if 'description' in error|lower %}
                    {{ error }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>
            </div>
            
            <!-- ÉVÉNEMENTS & IMAGE -->
            <div class="form-section-title">
                <i class="fas fa-calendar-alt"></i> ÉVÉNEMENTS & IMAGE
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label"><i class="fas fa-calendar-check"></i> Événements sponsorisés</label>
                    <select class="form-select" id="sponsorEvents" name="sponsorEvents[]" multiple style="height: 150px;">
                        {% for event in events|default([]) %}
                            <option value="{{ event.idEvent }}">
                                {{ event.titre }} - {{ event.dateDebut|date('d/m/Y') }} ({{ event.lieu|default('Lieu non défini') }})
                            </option>
                        {% endfor %}
                    </select>
                    <small class="text-muted"><i class="fas fa-info-circle"></i> Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs événements</small>
                </div>
                <div class="col-12">
                    <label class="form-label"><i class="fas fa-image"></i> Logo / Image</label>
                    <input type="file" class="form-control" id="sponsorImage" name="sponsorImage" accept="image/*">
                    <small class="text-muted"><i class="fas fa-info-circle"></i> Formats acceptés : JPG, PNG (max 2MB)</small>
                </div>

                <!-- APERÇU DE L'IMAGE EXISTANTE -->
                <div class="col-12" id="currentImageContainer" style="display: none;">
                    <label class="form-label"><i class="fas fa-image"></i> Image actuelle :</label>
                    <div class="current-image-wrapper">
                        <img id="currentImagePreview" src="" alt="Image actuelle" class="current-image">
                        <div class="mt-2">
                            <i class="fas fa-file-image"></i>
                            <span id="currentImageName" class="pink-badge"></span>
                        </div>
                        <div class="mt-2">
                            <div class="input-group" style="max-width: 100%;">
                                <input type="text" id="currentImagePath" class="form-control" readonly style="background: #f3f4f6; font-size: 0.75rem;">
                                <button class="btn-outline-purple" type="button" onclick="copyImagePath()">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle"></i> 
                            Laissez le champ "Choisir un fichier" vide pour conserver cette image
                        </small>
                    </div>
                </div>
            </div>
            
            <div class="row g-3 mt-2">
                <div class="col-12 d-flex gap-2">
                    <button class="btn-purple" type="button" onclick="showConfirmPopup()"><i class="fas fa-save"></i> Enregistrer</button>
                    <button class="btn-outline-purple" id="cancelSponsorBtn" type="button"><i class="fas fa-times"></i> Annuler</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- RECHERCHE INTELLIGENTE -->
<div class="card-box mb-4">
    <div class="card-box-body">
        <label class="filter-label">
            <i class="fas fa-search"></i> Recherche intelligente
        </label>
        <div class="search-wrapper">
            <div class="search-input-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" 
                       class="form-control" 
                       id="smartSearch" 
                       name="smartSearch" 
                       placeholder="Rechercher par nom, description, email, téléphone..."
                       onkeyup="loadSponsors()">
            </div>
            <button class="btn-reset" type="button" onclick="resetSearch()">
                <i class="fas fa-trash-alt"></i> Réinitialiser
            </button>
        </div>
        <small class="text-muted mt-1 d-block"><i class="fas fa-magic"></i> La recherche se fait automatiquement en tapant</small>
    </div>
</div>

<!-- FILTRES -->
<div class="filters-row">
    <div class="filter-group">
        <label class="filter-label">
            <i class="fas fa-tag"></i> Type de sponsor
        </label>
        <select class="form-select filter-select" id="filterType" onchange="loadSponsors()">
            <option value="tous">Tous les types</option>
