{% block javascripts %}
{{ parent() }}
<script>
// ========== VALIDATION SYSTEM (MATCHING EVENTS PAGE) ==========
// ========== VARIABLES ==========
let pendingDeleteId = null;
let pendingDeleteRow = null;
let pendingDeleteName = null;
let validationTimeout = null;

// ========== VALIDATION RULES ==========
const validationRules = {
    sponsorName: {
        required: true,
        minLength: 2,
        maxLength: 100,
        message: 'Le nom doit contenir entre 2 et 100 caractères'
    },
    sponsorDescription: {
        required: true,
        minLength: 10,
        maxLength: 500,
        message: 'La description doit contenir entre 10 et 500 caractères'
    },
    sponsorAmount: {
        required: true,
        minValue: 1,
        maxValue: 1000000,
        message: 'Le montant doit être entre 1 et 1,000,000 TND'
    },
    sponsorEmail: {
        required: false,
        pattern: /^[^\s@]+@([^\s@]+\.)+[^\s@]+$/,
        message: 'Format d\'email invalide (ex: nom@domaine.com)'
    },
    sponsorPhone: {
        required: false,
        pattern: /^[+\d\s\-\(\)]{8,20}$/,
        message: 'Format de téléphone invalide (8-20 chiffres)'
    },
    sponsorType: {
        required: false,
        message: 'Type de sponsor invalide'
    }
};

// ========== UTILITY FUNCTIONS ==========
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function showTempMessage(message, type) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
    alertDiv.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 10001; min-width: 300px;';
    alertDiv.innerHTML = `
        <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
    `;
    document.body.appendChild(alertDiv);
    setTimeout(() => alertDiv.remove(), 3000);
}

function copyImagePath() {
    const pathInput = document.getElementById('currentImagePath');
    if (pathInput && pathInput.value) {
        pathInput.select();
        document.execCommand('copy');
        showTempMessage('✅ Chemin copié !', 'success');
    }
}

// ========== FIELD VALIDATION FUNCTIONS ==========
function showFieldMessage(inputId, message, isValid) {
    let errorDiv = document.getElementById(`${inputId}_error`);
    if (!errorDiv) {
        const input = document.getElementById(inputId);
        if (input && input.parentNode) {
            errorDiv = document.createElement('div');
            errorDiv.id = `${inputId}_error`;
            errorDiv.className = 'form-error';
            input.parentNode.appendChild(errorDiv);
        }
    }
    if (errorDiv) {
        errorDiv.innerHTML = `<i class="fas ${isValid ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
        errorDiv.className = `form-error ${isValid ? 'success-message' : 'error-message'}`;
        errorDiv.style.display = 'block';
    }
}

function hideFieldMessage(inputId) {
    const errorDiv = document.getElementById(`${inputId}_error`);
    if (errorDiv) errorDiv.style.display = 'none';
}

function validateField(input, isBlur = false) {
    const fieldName = input.id;
    const rules = validationRules[fieldName];
    if (!rules) return true;
    
    const value = input.value.trim();
    let isValid = true;
    let errorMessage = '';
    
    // Check if field is empty and required
    if (rules.required && !value) {
        isValid = false;
        errorMessage = rules.message;
    }
    // Check if field has value (or is optional with value)
    else if (value) {
        // Check min length
        if (rules.minLength && value.length < rules.minLength) {
            isValid = false;
            errorMessage = rules.message;
        }
        // Check max length
        else if (rules.maxLength && value.length > rules.maxLength) {
            isValid = false;
            errorMessage = rules.message;
        }
        // Check min value
        else if (rules.minValue && parseFloat(value) < rules.minValue) {
            isValid = false;
            errorMessage = rules.message;
        }
        // Check max value
        else if (rules.maxValue && parseFloat(value) > rules.maxValue) {
            isValid = false;
            errorMessage = rules.message;
        }
        // Check pattern (email, phone)
        else if (rules.pattern && !rules.pattern.test(value)) {
            isValid = false;
            errorMessage = rules.message;
        }
        // Field is valid
        else {
            errorMessage = '✓ Champ valide';
        }
    }
    
    // Apply visual feedback
    if (!isValid) {
        showFieldMessage(fieldName, errorMessage, false);
        input.style.borderColor = '#e8a0c4';
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
    } 
    else if (value.length > 0 || (rules.required && value)) {
        if (!isBlur) {
            showFieldMessage(fieldName, errorMessage, true);
            input.style.borderColor = '#7ec89e';
            input.classList.add('is-valid');
            input.classList.remove('is-invalid');
        } else {
            hideFieldMessage(fieldName);
            input.style.borderColor = '';
            input.classList.remove('is-invalid', 'is-valid');
        }
    } 
    else {
        hideFieldMessage(fieldName);
        input.style.borderColor = '';
        input.classList.remove('is-invalid', 'is-valid');
    }
    
    return isValid;
}

// ========== IMAGE VALIDATION (REQUIRED) ==========
function validateImageFile(isBlur = false) {
    const imageInput = document.getElementById('sponsorImage');
    const currentImageContainer = document.getElementById('currentImageContainer');
    const errorDiv = document.getElementById('imageError');
    const sponsorId = document.getElementById('sponsorId').value;
    const isEditMode = sponsorId && sponsorId !== '';
    const hasExistingImage = currentImageContainer && currentImageContainer.style.display === 'block';
    
    // For edit mode with existing image, image is optional
    if (isEditMode && hasExistingImage) {
        if (errorDiv) {
            errorDiv.style.display = 'none';
        }
        if (imageInput) {
            imageInput.classList.remove('is-invalid', 'is-valid');
            imageInput.style.borderColor = '';
        }
        return true;
    }
    
    // For add mode OR edit mode without image, image is REQUIRED
    if (!imageInput || !imageInput.files || imageInput.files.length === 0) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ❌ Une image est obligatoire pour le sponsor`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        if (imageInput) {
            imageInput.style.borderColor = '#e8a0c4';
            imageInput.classList.add('is-invalid');
            imageInput.classList.remove('is-valid');
        }
        return false;
    }
    
    const file = imageInput.files[0];
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
    const maxSize = 2 * 1024 * 1024;
    
    // Check file type
    if (!allowedTypes.includes(file.type)) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> Format non supporté. Utilisez JPG, PNG ou GIF.`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        imageInput.style.borderColor = '#e8a0c4';
        imageInput.classList.add('is-invalid');
        imageInput.classList.remove('is-valid');
        return false;
    }
    
    // Check file size
    if (file.size > maxSize) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> L'image ne doit pas dépasser 2MB. (${(file.size / 1024 / 1024).toFixed(2)}MB)`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        imageInput.style.borderColor = '#e8a0c4';
        imageInput.classList.add('is-invalid');
        imageInput.classList.remove('is-valid');
        return false;
    }
    
    // Image is valid
    if (errorDiv) {
        errorDiv.innerHTML = `<i class="fas fa-check-circle"></i> ✓ Image valide (${(file.size / 1024).toFixed(0)}KB)`;
        errorDiv.className = 'form-error success-message';
        errorDiv.style.display = 'block';
    }
    if (!isBlur) {
        imageInput.style.borderColor = '#7ec89e';
        imageInput.classList.add('is-valid');
        imageInput.classList.remove('is-invalid');
    }
    return true;
}

// ========== FORM VALIDATION BEFORE SUBMIT ==========
function validateFormForSubmit() {
    const name = document.getElementById('sponsorName')?.value.trim() || '';
    const description = document.getElementById('sponsorDescription')?.value.trim() || '';
    const amount = document.getElementById('sponsorAmount')?.value || '';
    const email = document.getElementById('sponsorEmail')?.value.trim() || '';
    const phone = document.getElementById('sponsorPhone')?.value.trim() || '';
    const sponsorId = document.getElementById('sponsorId')?.value || '';
    const isEditMode = sponsorId && sponsorId !== '';
    
    // Required fields validation
    if (!name) {
        showTempMessage('❌ Le nom du sponsor est obligatoire', 'danger');
        document.getElementById('sponsorName').focus();
        return false;
    }
    if (name.length < 2 || name.length > 100) {
        showTempMessage('❌ Le nom doit contenir entre 2 et 100 caractères', 'danger');
        document.getElementById('sponsorName').focus();
        return false;
    }
    
    if (!description) {
        showTempMessage('❌ La description est obligatoire', 'danger');
        document.getElementById('sponsorDescription').focus();
        return false;
    }
    if (description.length < 10 || description.length > 500) {
        showTempMessage('❌ La description doit contenir entre 10 et 500 caractères', 'danger');
        document.getElementById('sponsorDescription').focus();
        return false;
    }
    
    if (!amount || parseFloat(amount) <= 0) {
        showTempMessage('❌ Le montant doit être un nombre positif', 'danger');
        document.getElementById('sponsorAmount').focus();
        return false;
    }
    if (parseFloat(amount) > 1000000) {
        showTempMessage('❌ Le montant ne peut pas dépasser 1,000,000 TND', 'danger');
        document.getElementById('sponsorAmount').focus();
        return false;
    }
    
    // Optional fields validation (only if provided)
    if (email && !/^[^\s@]+@([^\s@]+\.)+[^\s@]+$/.test(email)) {
        showTempMessage('❌ Format d\'email invalide', 'danger');
        document.getElementById('sponsorEmail').focus();
        return false;
    }
    
    if (phone && !/^[+\d\s\-\(\)]{8,20}$/.test(phone)) {
        showTempMessage('❌ Format de téléphone invalide', 'danger');
        document.getElementById('sponsorPhone').focus();
        return false;
    }
    
    // IMAGE VALIDATION - REQUIRED for new sponsors
    const currentImageContainer = document.getElementById('currentImageContainer');
    const hasExistingImage = currentImageContainer && currentImageContainer.style.display === 'block';
    const imageInput = document.getElementById('sponsorImage');
    const hasNewImage = imageInput && imageInput.files && imageInput.files.length > 0;
    
    if (!isEditMode) {
        // New sponsor - image is REQUIRED
        if (!hasNewImage) {
            showTempMessage('❌ Une image est obligatoire pour le sponsor', 'danger');
            if (imageInput) {
                imageInput.style.borderColor = '#e8a0c4';
                imageInput.classList.add('is-invalid');
                const errorDiv = document.getElementById('imageError');
                if (errorDiv) {
                    errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ❌ Une image est obligatoire pour le sponsor`;
                    errorDiv.className = 'form-error error-message';
                    errorDiv.style.display = 'block';
                }
                imageInput.focus();
            }
            return false;
        }
    } else {
        // Edit mode - image is optional only if existing image exists
        if (!hasExistingImage && !hasNewImage) {
            showTempMessage('❌ Une image est obligatoire pour le sponsor', 'danger');
            if (imageInput) {
                imageInput.style.borderColor = '#e8a0c4';
                imageInput.classList.add('is-invalid');
                const errorDiv = document.getElementById('imageError');
                if (errorDiv) {
                    errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ❌ Veuillez ajouter une image`;
                    errorDiv.className = 'form-error error-message';
                    errorDiv.style.display = 'block';
                }
                imageInput.focus();
            }
            return false;
        }
    }
    
    // Validate image file if one is selected
    if (hasNewImage) {
        const file = imageInput.files[0];
        const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
        const maxSize = 2 * 1024 * 1024;
        
        if (!allowedTypes.includes(file.type)) {
            showTempMessage('❌ Format d\'image non supporté. Utilisez JPG, PNG ou GIF', 'danger');
            return false;
        }
        if (file.size > maxSize) {
            showTempMessage('❌ L\'image ne doit pas dépasser 2MB', 'danger');
            return false;
        }
    }
    
    return true;
}

// ========== CLEAR VALIDATION ERRORS ==========
function clearValidationErrors() {
    // Remove all error messages
    const feedbackMessages = document.querySelectorAll('.form-error');
    feedbackMessages.forEach(msg => msg.remove());
    
    // Reset all input styles
    const invalidInputs = document.querySelectorAll('.is-invalid, .is-valid');
    invalidInputs.forEach(input => {
        input.classList.remove('is-invalid', 'is-valid');
        input.style.borderColor = '';
    });
}

// ========== LOAD SPONSORS ==========
function loadSponsors() {
    const searchTerm = document.getElementById('smartSearch')?.value || '';
    const type = document.getElementById('filterType')?.value || 'tous';
    const sortBy = document.getElementById('filterSort')?.value || 'montant_desc';
    
    const loadingIndicator = document.getElementById('loadingIndicator');
    const tableBody = document.getElementById('sponsorTableBody');
    
    if (loadingIndicator) loadingIndicator.style.display = 'block';
    
    const formData = new URLSearchParams();
    formData.append('search', searchTerm);
    formData.append('type', type);
    formData.append('sortBy', sortBy);
    
    fetch('{{ path('admin_sponsors_search') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: formData.toString()
    })
    .then(response => response.json())
    .then(data => {
        const resultCount = document.getElementById('resultCount');
        if (resultCount) resultCount.textContent = data.total;
        
        if (tableBody) {
            if (data.sponsors.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px;">
                            <i class="fas fa-search fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted">Aucun sponsor trouvé</p>
                            <small>Essayez d'autres critères</small>
                        </td>
                    </tr>
                `;
            } else {
                tableBody.innerHTML = data.sponsors.map((sponsor, index) => `
                    <tr>
                        <td>${index + 1}</td>
                        <td>
                            ${sponsor.image ? 
                                `<img src="${sponsor.image}" alt="${sponsor.nom}" class="sponsor-image">` : 
                                `<div class="sponsor-image-placeholder"><i class="fas fa-building"></i></div>`
                            }
                        </td>
                        <td><strong>${escapeHtml(sponsor.nom)}</strong><br><small>${escapeHtml(sponsor.description ? sponsor.description.substring(0, 50) : '')}</small></td>
                        <td><span class="badge-grey">${escapeHtml(sponsor.TypeSponsor || 'Non défini')}</span></td>
                        <td>${sponsor.email || '-'}</td>
                        <td>${sponsor.telephone || '-'}</td>
                        <td><strong class="text-success">${(sponsor.montant || 0).toLocaleString()} TND</strong></td>
                        <td>
                            <button class="btn-edit-soft me-1 edit-sponsor" data-id="${sponsor.idSponsor}"><i class="fas fa-edit"></i> Modifier</button>
                            <button class="btn-danger-soft delete-sponsor" data-id="${sponsor.idSponsor}"><i class="fas fa-trash"></i> Supprimer</button>
                        </td>
                    </tr>
                `).join('');
                
                attachSponsorButtons();
            }
        }
        
        updateSponsorActiveFilters(type, sortBy, searchTerm);
        
        if (loadingIndicator) loadingIndicator.style.display = 'none';
    })
    .catch(error => {
        console.error('Erreur:', error);
        if (loadingIndicator) loadingIndicator.style.display = 'none';
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="8" style="text-align: center; color: red; padding: 40px;">
                        <i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>
                        Erreur lors du chargement des données
                    </td>
                </tr>
            `;
        }
    });
}

function updateSponsorActiveFilters(type, sortBy, search) {
    const container = document.getElementById('activeFiltersContainer');
    const listElement = document.getElementById('activeFiltersList');
    
    const activeFilters = [];
    
    if (type && type !== 'tous') activeFilters.push(`<span class="badge-grey"><i class="fas fa-tag"></i> Type: ${type}</span>`);
    if (sortBy && sortBy !== 'montant_desc') {
        const sortLabels = {
            'montant_desc': 'Tri: Montant élevé',
            'montant_asc': 'Tri: Montant faible',
            'nom_asc': 'Tri: Nom A→Z',
            'nom_desc': 'Tri: Nom Z→A',
            'type_asc': 'Tri: Type A→Z'
        };
        activeFilters.push(`<span class="badge-grey"><i class="fas fa-sort"></i> ${sortLabels[sortBy]}</span>`);
    }
    if (search && search.trim() !== '') activeFilters.push(`<span class="badge-grey"><i class="fas fa-search"></i> Recherche: "${escapeHtml(search)}"</span>`);
    
    if (activeFilters.length > 0) {
        container.style.display = 'block';
        listElement.innerHTML = activeFilters.join(' ');
    } else {
        container.style.display = 'none';
    }
}

// ========== RESET FUNCTIONS ==========
function resetSearch() {
    document.getElementById('smartSearch').value = '';
    loadSponsors();
}

function resetAllFilters() {
    const filterType = document.getElementById('filterType');
    const filterSort = document.getElementById('filterSort');
    const smartSearch = document.getElementById('smartSearch');
    
    if (filterType) filterType.value = 'tous';
    if (filterSort) filterSort.value = 'montant_desc';
    if (smartSearch) smartSearch.value = '';
    
    loadSponsors();
}

function resetSponsorForm() {
    document.getElementById('sponsorForm').reset();
    document.getElementById('sponsorId').value = '';
    document.getElementById('sponsorForm').action = "{{ path('admin_sponsors_add') }}";
    document.getElementById('formMode').textContent = 'Mode : Ajout';
    
    // Clear validation errors
    clearValidationErrors();
    
    // Reset image field validation
    const imageInput = document.getElementById('sponsorImage');
    if (imageInput) {
        imageInput.value = '';
        imageInput.classList.remove('is-invalid', 'is-valid');
        imageInput.style.borderColor = '';
    }
    
    const errorDiv = document.getElementById('imageError');
    if (errorDiv) {
        errorDiv.style.display = 'none';
        errorDiv.innerHTML = '';
    }
    
    const imageContainer = document.getElementById('currentImageContainer');
    if (imageContainer) {
        imageContainer.style.display = 'none';
        const imagePreview = document.getElementById('currentImagePreview');
        const imageNameSpan = document.getElementById('currentImageName');
        const imagePathInput = document.getElementById('currentImagePath');
        if (imagePreview) imagePreview.src = '';
        if (imageNameSpan) imageNameSpan.textContent = '';
        if (imagePathInput) imagePathInput.value = '';
    }
    
    const eventSelect = document.getElementById('sponsorEvents');
    if (eventSelect) {
        for (let i = 0; i < eventSelect.options.length; i++) {
            eventSelect.options[i].selected = false;
        }
    }
}

// ========== SPONSOR CRUD OPERATIONS ==========
function attachSponsorButtons() {
    document.querySelectorAll('.edit-sponsor').forEach(btn => {
        btn.removeEventListener('click', handleSponsorEditClick);
        btn.addEventListener('click', handleSponsorEditClick);
    });
    
    document.querySelectorAll('.delete-sponsor').forEach(btn => {
        btn.removeEventListener('click', handleSponsorDeleteClick);
        btn.addEventListener('click', handleSponsorDeleteClick);
    });
}

function handleSponsorEditClick(e) {
    const id = e.currentTarget.getAttribute('data-id');
    loadSponsorForEdit(id);
}

function handleSponsorDeleteClick(e) {
    const id = e.currentTarget.getAttribute('data-id');
    const row = e.currentTarget.closest('tr');
    const nom = row.querySelector('td:nth-child(3) strong').textContent;
    
    pendingDeleteId = id;
    pendingDeleteRow = row;
    pendingDeleteName = nom;
    
    document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer <strong>"${nom}"</strong> ?<br>Cette action est irréversible.`;
    document.getElementById('deleteConfirmPopup').style.display = 'flex';
}

function loadSponsorForEdit(id) {
    fetch(`/admin/sponsors/get/${id}`)
        .then(response => response.json())
        .then(data => {
            if (data.error) {
                showTempMessage(data.error, 'danger');
                return;
            }
            
            document.getElementById('sponsorId').value = data.idSponsor;
            document.getElementById('sponsorName').value = data.nom || '';
            document.getElementById('sponsorType').value = data.TypeSponsor || '';
            document.getElementById('sponsorEmail').value = data.email || '';
            document.getElementById('sponsorPhone').value = data.telephone || '';
            document.getElementById('sponsorAmount').value = data.montant || '';
            document.getElementById('sponsorDescription').value = data.description || '';
            
            // Clear any existing validation errors
            clearValidationErrors();
            
            if (data.image) {
                const imagePreview = document.getElementById('currentImagePreview');
                const imageContainer = document.getElementById('currentImageContainer');
                const imageNameSpan = document.getElementById('currentImageName');
                const imagePathInput = document.getElementById('currentImagePath');
                
                if (imagePreview && imageContainer) {
                    imagePreview.src = data.image;
                    imageContainer.style.display = 'block';
                    
                    if (imageNameSpan) {
                        const fileName = data.image.split('/').pop();
                        imageNameSpan.textContent = fileName;
                    }
                    
                    if (imagePathInput) {
                        imagePathInput.value = data.image;
                    }
                }
                
                // Clear image input validation since we have existing image
                const imageInput = document.getElementById('sponsorImage');
                if (imageInput) {
                    imageInput.classList.remove('is-invalid', 'is-valid');
                    imageInput.style.borderColor = '';
                }
                const errorDiv = document.getElementById('imageError');
                if (errorDiv) {
                    errorDiv.style.display = 'none';
                }
            } else {
                const imageContainer = document.getElementById('currentImageContainer');
                if (imageContainer) imageContainer.style.display = 'none';
                // In edit mode but no image - make image required
                const imageInput = document.getElementById('sponsorImage');
                if (imageInput) {
                    imageInput.classList.add('is-invalid');
                    const errorDiv = document.getElementById('imageError');
                    if (errorDiv) {
                        errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ❌ Une image est obligatoire pour le sponsor`;
                        errorDiv.className = 'form-error error-message';
                        errorDiv.style.display = 'block';
                    }
                }
            }
            
            const eventSelect = document.getElementById('sponsorEvents');
            if (eventSelect && data.eventIds) {
                for (let i = 0; i < eventSelect.options.length; i++) {
                    eventSelect.options[i].selected = data.eventIds.includes(parseInt(eventSelect.options[i].value));
                }
            }
            
            document.getElementById('sponsorForm').action = "{{ path('admin_sponsors_update') }}";
            document.getElementById('formMode').textContent = 'Mode : Modification';
            
            document.querySelector('.card-box').scrollIntoView({ behavior: 'smooth' });
            showTempMessage('📝 Sponsor chargé pour modification', 'success');
        })
        .catch(error => {
            console.error('Erreur:', error);
            showTempMessage('Erreur lors du chargement du sponsor', 'danger');
        });
}

// ========== POPUP FUNCTIONS ==========
function showConfirmPopup() {
    // Validate form before showing popup
    if (!validateFormForSubmit()) {
        return;
    }
    
    const sponsorName = document.getElementById('sponsorName').value;
    if (!sponsorName) {
        showTempMessage('Veuillez remplir le nom du sponsor', 'danger');
        return;
    }
    document.getElementById('confirmPopup').style.display = 'flex';
}

function closePopup() {
    document.getElementById('confirmPopup').style.display = 'none';
}

function closeDeletePopup() {
    document.getElementById('deleteConfirmPopup').style.display = 'none';
    pendingDeleteId = null;
    pendingDeleteRow = null;
    pendingDeleteName = null;
}

function submitSponsorForm() {
    closePopup();
    
    // Validate one more time before submission
    if (!validateFormForSubmit()) {
        showTempMessage('Veuillez corriger les erreurs dans le formulaire', 'danger');
        return;
    }
    
    const form = document.getElementById('sponsorForm');
    const formData = new FormData(form);
    const action = form.action;
    
    // Show loading
    showTempMessage('Enregistrement en cours...', 'info');
    
    fetch(action, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showTempMessage(data.message, 'success');
            resetSponsorForm();
            loadSponsors();
            closePopup();
        } else if (data.errors) {
            // Display validation errors
            let errorHtml = '<div class="alert alert-danger"><strong>Erreurs de validation:</strong><ul>';
            for (const error of data.errors) {
                errorHtml += `<li>${escapeHtml(error)}</li>`;
            }
            errorHtml += '</ul></div>';
            
            // Remove existing error alert and add new one
            const formContainer = document.querySelector('.card-box-body');
            const existingAlert = formContainer.querySelector('.alert-danger');
            if (existingAlert) existingAlert.remove();
            formContainer.insertAdjacentHTML('afterbegin', errorHtml);
            
            // Also highlight individual fields if field errors exist
            if (data.fieldErrors) {
                for (const [field, errorMsg] of Object.entries(data.fieldErrors)) {
                    const input = document.getElementById(field);
                    if (input) {
                        input.classList.add('is-invalid');
                        input.classList.remove('is-valid');
                        showFieldMessage(field, errorMsg, false);
                    }
                }
            }
            
            showTempMessage('Veuillez corriger les erreurs', 'danger');
            closePopup();
        }
    })
    .catch(error => {
        console.error('Error:', error);
        // Fallback to normal form submission
        form.submit();
    });
}

// ========== INITIALIZATION ==========
document.addEventListener('DOMContentLoaded', function() {
    // Setup validation for each field
    const fieldsToValidate = ['sponsorName', 'sponsorDescription', 'sponsorAmount', 'sponsorEmail', 'sponsorPhone', 'sponsorType'];
    
    fieldsToValidate.forEach(fieldId => {
        const input = document.getElementById(fieldId);
        if (input) {
            // Create error div if it doesn't exist
            if (!document.getElementById(`${fieldId}_error`)) {
                const errorDiv = document.createElement('div');
                errorDiv.id = `${fieldId}_error`;
                errorDiv.className = 'form-error';
                input.parentNode.appendChild(errorDiv);
            }
            
            // Add event listeners
            input.addEventListener('focus', function() { 
                validateField(this, false); 
            });
            input.addEventListener('input', function() { 
                validateField(this, false); 
            });
            input.addEventListener('blur', function() { 
                validateField(this, true); 
            });
        }
    });
    
    // Setup image validation
    const imageInput = document.getElementById('sponsorImage');
    if (imageInput) {
        // Create error div for image if it doesn't exist
        if (!document.getElementById('imageError')) {
            const errorDiv = document.createElement('div');
            errorDiv.id = 'imageError';
            errorDiv.className = 'form-error';
            imageInput.parentNode.appendChild(errorDiv);
        }
        
        // Add required indicator to the label
        const imageLabel = document.querySelector('label[for="sponsorImage"]');
        if (imageLabel && !imageLabel.querySelector('.text-danger')) {
            imageLabel.innerHTML = '<i class="fas fa-image"></i> Logo / Image <span class="text-danger">*</span>';
        }
        
        imageInput.addEventListener('focus', function() { 
            validateImageFile(false); 
        });
        imageInput.addEventListener('change', function() { 
            validateImageFile(false); 
        });
        imageInput.addEventListener('blur', function() { 
            validateImageFile(true); 
        });
    }
    
    // Recherche en temps réel avec debounce
    let searchTimeout;
    const smartSearch = document.getElementById('smartSearch');
    if (smartSearch) {
        smartSearch.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                loadSponsors();
            }, 300);
        });
    }
    
    // Filtres
    const filters = ['filterType', 'filterSort'];
    filters.forEach(filterId => {
        const element = document.getElementById(filterId);
        if (element) {
            element.addEventListener('change', function() {
                loadSponsors();
            });
        }
    });
    
    // Bouton réinitialiser tous les filtres
    const resetSponsorFiltersBtn = document.getElementById('resetSponsorFilters');
    if (resetSponsorFiltersBtn) {
        resetSponsorFiltersBtn.addEventListener('click', resetAllFilters);
    }
    
    // Bouton annuler formulaire
    document.getElementById('cancelSponsorBtn')?.addEventListener('click', function() {
        resetSponsorForm();
        showTempMessage('Formulaire réinitialisé', 'success');
    });
    
    // Confirmation de suppression
    document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
        if (pendingDeleteId) {
            fetch(`/admin/sponsors/delete/${pendingDeleteId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeDeletePopup();
                    showTempMessage(`✅ "${pendingDeleteName}" a été supprimé avec succès !`, 'success');
                    loadSponsors();
                    resetSponsorForm();
                } else {
                    showTempMessage('❌ Erreur: ' + (data.error || 'Impossible de supprimer ce sponsor'), 'danger');
                    closeDeletePopup();
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                showTempMessage('Erreur lors de la suppression', 'danger');
                closeDeletePopup();
            });
        }
    });
    
    // Chargement initial
    loadSponsors();
});
</script>
{% endblock %}