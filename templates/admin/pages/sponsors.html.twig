{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Sponsors{% endblock %}

{% block page_title %}Gestion des Sponsors{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-handshake me-2" style="color:var(--purple-500)"></i>Gestion des Sponsors</h2>
    <p>Gérer les partenaires et sponsors des événements</p>
</div>

<!-- Dashboard mini stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Sponsors actifs</div>
                    <div class="stat-value">{{ activeSponsors|default(12) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-handshake"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +2 ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Budget total</div>
                    <div class="stat-value">{{ totalBudget|default(45) }}K</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-coins"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> TND</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Événements sponsorisés</div>
                    <div class="stat-value">{{ sponsoredEvents|default(9) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-calendar-alt"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> ce trimestre</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">En négociation</div>
                    <div class="stat-value">{{ pendingSponsors|default(4) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-file-contract"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> prospects</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter / Modifier un Sponsor</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom de l'entreprise</label>
                        <input type="text" class="form-control" id="sponsorName" placeholder="Ex: Tunisie Telecom">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Personne de contact</label>
                        <input type="text" class="form-control" id="sponsorContact" placeholder="Nom complet">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="sponsorEmail" placeholder="contact@entreprise.com">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" class="form-control" id="sponsorPhone" placeholder="+216 xx xxx xxx">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Montant sponsoring (TND)</label>
                        <input type="number" class="form-control" id="sponsorAmount" placeholder="5000">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="sponsorStatus">
                            <option>Actif</option>
                            <option>En négociation</option>
                            <option>Expiré</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Événements associés</label>
                        <input type="text" class="form-control" id="sponsorEvents" placeholder="Ex: Atelier peinture, Conférence parents">
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveSponsorBtn"><i class="fas fa-save"></i> Enregistrer</button>
                        <button class="btn-outline-purple" id="cancelSponsorBtn"><i class="fas fa-times"></i> Annuler</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-pie"></i> Répartition des Sponsors</span>
            </div>
            <div class="card-box-body">
                <canvas id="sponsorChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Sponsors</span>
        <input type="text" class="form-control filter-input" id="sponsorFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="sponsorTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Entreprise</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Montant (TND)</th>
                        <th>Événements</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sponsor in sponsors|default([
                        {id:1, company:'Tunisie Telecom', contact:'Ali Chaouachi', email:'ali@tunisietelecom.tn', amount:15000, events:3, status:'Actif'},
                        {id:2, company:'Fondation BIAT', contact:'Sonia Dridi', email:'sonia@biat.tn', amount:12000, events:2, status:'Actif'},
                        {id:3, company:'Orange Tunisie', contact:'Karim Ayari', email:'karim@orange.tn', amount:8000, events:2, status:'En négociation'},
                        {id:4, company:'Ministère de l\'Éducation', contact:'Rania Meddeb', email:'rania@education.tn', amount:10000, events:4, status:'Actif'},
                        {id:5, company:'Ooredoo Tunisie', contact:'Mohamed Ali', email:'mohamed@ooredoo.tn', amount:5000, events:1, status:'En négociation'}
                    ]) %}
                        <tr>
                            <td>{{ sponsor.id }}</td>
                            <td>{{ sponsor.company }}</td>
                            <td>{{ sponsor.contact }}</td>
                            <td>{{ sponsor.email }}</td>
                            <td>{{ sponsor.amount }}</td>
                            <td>{{ sponsor.events }}</td>
                            <td>
                                {% if sponsor.status == 'Actif' %}
                                    <span class="badge-status badge-active">{{ sponsor.status }}</span>
                                {% elseif sponsor.status == 'En négociation' %}
                                    <span class="badge-status badge-pending">{{ sponsor.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ sponsor.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-sponsor-btn" data-id="{{ sponsor.id }}">Modifier</button>
                                <button class="btn-danger-soft delete-sponsor-btn" data-id="{{ sponsor.id }}">Supprimer</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const P = { p400: '#a855f7', pink: '#f472b6', indigo: '#818cf8', accent: '#e040fb' };

    // Doughnut Chart
    new Chart(document.getElementById('sponsorChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Actifs', 'En négociation', 'Expirés'],
            datasets: [{
                data: [{{ activeSponsors|default(12) }}, {{ pendingSponsors|default(4) }}, 2],
                backgroundColor: [P.p400, P.pink, P.indigo],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        font: { family: 'DM Sans', size: 11 }
                    }
                }
            },
            cutout: '60%',
            responsive: true
        }
    });

    // Filter table
    document.getElementById('sponsorFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#sponsorTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Edit button
    document.querySelectorAll('.edit-sponsor-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('formMode').textContent = 'Mode : Modification';
            const id = this.getAttribute('data-id');
            console.log('Edit sponsor:', id);
        });
    });

    // Delete button
    document.querySelectorAll('.delete-sponsor-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Supprimer ce sponsor ?')) {
                this.closest('tr').remove();
            }
        });
    });

    // Cancel button
    document.getElementById('cancelSponsorBtn')?.addEventListener('click', function() {
        document.getElementById('formMode').textContent = 'Mode : Ajout';
        document.getElementById('sponsorName').value = '';
        document.getElementById('sponsorContact').value = '';
        document.getElementById('sponsorEmail').value = '';
        document.getElementById('sponsorPhone').value = '';
        document.getElementById('sponsorAmount').value = '';
        document.getElementById('sponsorEvents').value = '';
    });

    // Save button
    document.getElementById('saveSponsorBtn')?.addEventListener('click', function() {
        const name = document.getElementById('sponsorName')?.value;
        if (!name) {
            alert('Veuillez saisir un nom d\'entreprise');
            return;
        }
        console.log('Save sponsor:', {
            name: name,
            contact: document.getElementById('sponsorContact')?.value,
            email: document.getElementById('sponsorEmail')?.value,
            phone: document.getElementById('sponsorPhone')?.value,
            amount: document.getElementById('sponsorAmount')?.value,
            status: document.getElementById('sponsorStatus')?.value,
            events: document.getElementById('sponsorEvents')?.value
        });
        alert('Sponsor enregistré (démo)');
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    });
});
</script>
{% endblock %}