{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Modules & Contenu{% endblock %}

{% block page_title %}Modules & Contenu{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .filter-input {
        width: 200px;
        font-size: .8rem;
        padding: 6px 12px;
    }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-layer-group me-2" style="color:var(--purple-500)"></i>Modules & Contenu</h2>
    <p>Organiser les modules et le contenu pédagogique</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Modules</div>
                    <div class="stat-value">{{ totalModules|default(248) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-layer-group"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> +18 ce mois</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Vidéos</div>
                    <div class="stat-value">{{ totalVideos|default(124) }}</div>
                </div>
                <div class="stat-icon violet"><i class="fas fa-video"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> hébergées</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Exercices</div>
                    <div class="stat-value">{{ totalExercises|default(376) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-tasks"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> interactifs</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Quiz</div>
                    <div class="stat-value">{{ totalQuizzes|default(89) }}</div>
                </div>
                <div class="stat-icon indigo"><i class="fas fa-question-circle"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> disponibles</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card-box">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter / Modifier un Module</span>
                <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
            </div>
            <div class="card-box-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Cours parent</label>
                        <select class="form-select" id="parentCourse">
                            <option>Communication par pictogrammes</option>
                            <option>Motricité fine</option>
                            <option>Reconnaître les émotions</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Titre du module</label>
                        <input type="text" class="form-control" id="moduleTitle" placeholder="Ex: Introduction aux pictogrammes">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Type de contenu</label>
                        <select class="form-select" id="contentType">
                            <option>Vidéo</option>
                            <option>Exercice interactif</option>
                            <option>Quiz</option>
                            <option>Document PDF</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ordre dans le cours</label>
                        <input type="number" class="form-control" id="moduleOrder" placeholder="1">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Durée estimée (min)</label>
                        <input type="number" class="form-control" id="moduleDuration" placeholder="15">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="moduleStatus">
                            <option>Publié</option>
                            <option>Brouillon</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description du module</label>
                        <textarea class="form-control" id="moduleDescription" rows="2" placeholder="Objectifs du module..."></textarea>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn-purple" id="saveModuleBtn"><i class="fas fa-save"></i> Enregistrer</button>
                        <button class="btn-outline-purple" id="cancelModuleBtn"><i class="fas fa-times"></i> Annuler</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-box h-100">
            <div class="card-box-header">
                <span class="card-box-title"><i class="fas fa-chart-pie"></i> Types de contenu</span>
            </div>
            <div class="card-box-body">
                <canvas id="modulesChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Modules</span>
        <input type="text" class="form-control filter-input" id="moduleFilterInput" placeholder="Filtrer...">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="modulesTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cours</th>
                        <th>Module</th>
                        <th>Type</th>
                        <th>Durée</th>
                        <th>Ordre</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for module in modules|default([
                        {id:1, course:'Pictogrammes', title:'Introduction', type:'Vidéo', duration:'10 min', order:1, status:'Publié'},
                        {id:2, course:'Pictogrammes', title:'Exercice 1', type:'Exercice interactif', duration:'15 min', order:2, status:'Publié'},
                        {id:3, course:'Motricité fine', title:'Coordination', type:'Vidéo', duration:'12 min', order:1, status:'Brouillon'},
                        {id:4, course:'Émotions', title:'Quiz final', type:'Quiz', duration:'20 min', order:5, status:'Publié'}
                    ]) %}
                        <tr>
                            <td>{{ module.id }}</td>
                            <td>{{ module.course }}</td>
                            <td>{{ module.title }}</td>
                            <td>{{ module.type }}</td>
                            <td>{{ module.duration }}</td>
                            <td>{{ module.order }}</td>
                            <td>
                                {% if module.status == 'Publié' %}
                                    <span class="badge-status badge-active">{{ module.status }}</span>
                                {% elseif module.status == 'Brouillon' %}
                                    <span class="badge-status badge-pending">{{ module.status }}</span>
                                {% else %}
                                    <span class="badge-status badge-inactive">{{ module.status }}</span>
                                {% endif %}
                            </span>
                            </td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-module-btn" data-id="{{ module.id }}">Modifier</button>
                                <button class="btn-danger-soft delete-module-btn" data-id="{{ module.id }}">Supprimer</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const P = { p400: '#a855f7', pink: '#f472b6', indigo: '#818cf8', accent: '#e040fb' };

    // Doughnut Chart - Types de contenu
    new Chart(document.getElementById('modulesChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Vidéo', 'Exercice', 'Quiz', 'PDF'],
            datasets: [{
                data: [124, 376, 89, 58],
                backgroundColor: [P.p400, P.pink, P.indigo, P.accent],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        font: { family: 'DM Sans', size: 11 }
                    }
                }
            },
            cutout: '60%',
            responsive: true
        }
    });

    // Filter table
    document.getElementById('moduleFilterInput')?.addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        document.querySelectorAll('#modulesTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Edit button
    document.querySelectorAll('.edit-module-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('formMode').textContent = 'Mode : Modification';
            const id = this.getAttribute('data-id');
            console.log('Edit module:', id);
        });
    });

    // Delete button
    document.querySelectorAll('.delete-module-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Supprimer ce module ?')) {
                this.closest('tr').remove();
            }
        });
    });

    // Cancel button
    document.getElementById('cancelModuleBtn')?.addEventListener('click', function() {
        document.getElementById('formMode').textContent = 'Mode : Ajout';
        document.getElementById('moduleTitle').value = '';
        document.getElementById('moduleOrder').value = '';
        document.getElementById('moduleDuration').value = '';
        document.getElementById('moduleDescription').value = '';
    });

    // Save button
    document.getElementById('saveModuleBtn')?.addEventListener('click', function() {
        const title = document.getElementById('moduleTitle')?.value;
        if (!title) {
            alert('Veuillez saisir un titre de module');
            return;
        }
        console.log('Save module:', {
            title: title,
            parentCourse: document.getElementById('parentCourse')?.value,
            contentType: document.getElementById('contentType')?.value,
            order: document.getElementById('moduleOrder')?.value,
            duration: document.getElementById('moduleDuration')?.value,
            status: document.getElementById('moduleStatus')?.value,
            description: document.getElementById('moduleDescription')?.value
        });
        alert('Module enregistré (démo)');
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    });
});
</script>
{% endblock %}