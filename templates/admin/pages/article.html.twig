{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Articles{% endblock %}
{% block page_title %}Articles Conseillés{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Filter ──────────────────────────────────── */
.filter-input { width: 220px; font-size:.8rem; padding:6px 12px; }

/* ── Toast ───────────────────────────────────── */
#toast-container {
    position:fixed;top:24px;right:24px;z-index:9999;
    display:flex;flex-direction:column;gap:12px;pointer-events:none;
}
.toast {
    display:flex;align-items:flex-start;gap:14px;background:#fff;
    border-radius:14px;padding:16px 20px 16px 16px;
    box-shadow:0 8px 32px rgba(0,0,0,.14);
    min-width:320px;max-width:420px;border-left:4px solid transparent;
    pointer-events:all;animation:toastIn .35s cubic-bezier(.34,1.56,.64,1) forwards;
    position:relative;overflow:hidden;
}
.toast.hiding{animation:toastOut .3s ease forwards;}
.toast-success{border-left-color:#10b981;}.toast-error{border-left-color:#ef4444;}.toast-warning{border-left-color:#f59e0b;}
.toast-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.toast-success .toast-icon{background:#d1fae5;color:#059669;}
.toast-error   .toast-icon{background:#fee2e2;color:#dc2626;}
.toast-warning .toast-icon{background:#fef3c7;color:#d97706;}
.toast-body{flex:1;}.toast-title{font-weight:700;font-size:.88rem;margin-bottom:2px;color:#1e1b4b;}
.toast-msg{font-size:.8rem;color:#6b7280;line-height:1.4;}
.toast-close{background:none;border:none;cursor:pointer;color:#9ca3af;font-size:14px;padding:0;flex-shrink:0;}
.toast-progress{position:absolute;bottom:0;left:0;height:3px;background:currentColor;opacity:.25;animation:toastProgress var(--dur,4s) linear forwards;}
.toast-success .toast-progress{color:#10b981;}.toast-error .toast-progress{color:#ef4444;}.toast-warning .toast-progress{color:#f59e0b;}
@keyframes toastIn{from{opacity:0;transform:translateX(40px) scale(.94);}to{opacity:1;transform:translateX(0) scale(1);}}
@keyframes toastOut{from{opacity:1;transform:translateX(0) scale(1);}to{opacity:0;transform:translateX(40px) scale(.94);}}
@keyframes toastProgress{from{width:100%;}to{width:0%;}}

/* ── Modals ──────────────────────────────────── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(15,10,40,.55);z-index:9000;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.modal-overlay.open{display:flex!important;}
@keyframes modalIn{from{opacity:0;transform:scale(.92) translateY(20px);}to{opacity:1;transform:scale(1) translateY(0);}}

/* Confirm */
.confirm-box{background:#fff;border-radius:20px;padding:2rem;width:100%;max-width:400px;box-shadow:0 24px 64px rgba(0,0,0,.22);animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);text-align:center;}
.confirm-icon{width:64px;height:64px;border-radius:50%;background:#fee2e2;color:#dc2626;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 1.2rem;}
.confirm-title{font-size:1.1rem;font-weight:700;color:#1e1b4b;margin-bottom:.5rem;}
.confirm-msg{font-size:.875rem;color:#6b7280;margin-bottom:1.5rem;line-height:1.5;}
.confirm-actions{display:flex;gap:10px;justify-content:center;}
.btn-confirm-cancel{padding:9px 22px;border-radius:10px;border:1.5px solid #e5e7eb;background:#fff;color:#374151;font-weight:600;font-size:.875rem;cursor:pointer;}
.btn-confirm-delete{padding:9px 22px;border-radius:10px;border:none;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-weight:600;font-size:.875rem;cursor:pointer;box-shadow:0 4px 12px rgba(239,68,68,.35);}

/* Detail modal */
.detail-modal-box{background:#fff;border-radius:20px;width:100%;max-width:820px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.22);animation:modalIn .3s cubic-bezier(.34,1.56,.64,1);}
.detail-header{background:linear-gradient(135deg,#a855f7,#7c3aed);padding:1.6rem 2rem;color:#fff;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;border-radius:20px 20px 0 0;}
.detail-badge{display:inline-block;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);border-radius:50px;font-size:.75rem;font-weight:600;padding:3px 12px;margin-bottom:.5rem;}
.detail-title{font-size:1.2rem;font-weight:800;margin:0;line-height:1.3;}
.detail-subtitle{font-size:.82rem;opacity:.8;margin-top:4px;}
.detail-close-btn{background:rgba(255,255,255,.15);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.detail-body{padding:1.6rem 2rem;}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.2rem;}
.detail-card{background:#f8f7ff;border-radius:12px;padding:12px 14px;border:1px solid #ede9fe;}
.detail-card-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#7c3aed;margin-bottom:4px;display:flex;align-items:center;gap:5px;}
.detail-card-value{font-size:.88rem;color:#1e1b4b;font-weight:500;line-height:1.5;}
.detail-full{background:#f8f7ff;border-radius:12px;padding:14px 16px;border:1px solid #ede9fe;margin-bottom:12px;}
.detail-full:last-child{margin-bottom:0;}

/* ── Article cards ───────────────────────────── */
.article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
}
.article-card {
    background: #fff;
    border-radius: 18px;
    border: 1px solid #ede9fe;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(139,92,246,.08);
    transition: transform .2s, box-shadow .2s;
    display: flex;
    flex-direction: column;
}
.article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(139,92,246,.18);
}
.article-card-header {
    background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
    padding: 18px 20px 14px;
    position: relative;
}
.article-cat-badge {
    display: inline-block;
    background: rgba(255,255,255,.22);
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50px;
    font-size: .7rem;
    font-weight: 700;
    color: #fff;
    padding: 3px 12px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: .5px;
}
.article-card-title {
    font-size: .95rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.35;
    margin: 0;
    cursor: pointer;
    border-bottom: 1.5px dashed rgba(255,255,255,.4);
    display: inline;
    transition: opacity .15s;
}
.article-card-title:hover { opacity: .85; }
.article-card-body { padding: 16px 18px; flex: 1; }
.article-excerpt {
    font-size: .8rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}
.article-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, #a855f7, #7c3aed);
    display: flex; align-items: center; justify-content: center;
    font-size: .8rem; font-weight: 700; color: #fff;
    flex-shrink: 0;
}
.article-author-info { flex: 1; }
.article-author-name { font-size: .78rem; font-weight: 700; color: #1e1b4b; }
.article-date { font-size: .7rem; color: #9ca3af; }
.article-card-footer {
    padding: 10px 18px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f3f4f6;
}
.article-likes {
    display: flex; align-items: center; gap: 5px;
    font-size: .78rem; font-weight: 700; color: #ef4444;
}
.article-actions { display: flex; gap: 6px; }

/* ── Category filter pills ───────────────────── */
.cat-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.cat-pill {
    padding: 5px 14px; border-radius: 50px;
    font-size: .75rem; font-weight: 700;
    background: #f3f4f6; color: #6b7280;
    border: 1.5px solid transparent;
    cursor: pointer; transition: all .2s;
}
.cat-pill:hover, .cat-pill.active {
    background: #ede9fe; color: #5b21b6;
    border-color: #c4b5fd;
}
.cat-pill.active { background: #7c3aed; color: #fff; border-color: #7c3aed; }

/* ── Form validation ─────────────────────────── */
.form-control.is-valid, textarea.is-valid, select.is-valid { border-color:#10b981!important;box-shadow:0 0 0 3px rgba(16,185,129,.12)!important; }
.form-control.is-invalid, textarea.is-invalid, select.is-invalid { border-color:#ef4444!important;box-shadow:0 0 0 3px rgba(239,68,68,.12)!important;animation:shake .35s ease; }
@keyframes shake{0%,100%{transform:translateX(0);}20%{transform:translateX(-5px);}40%{transform:translateX(5px);}60%{transform:translateX(-4px);}80%{transform:translateX(4px);}}
.field-error{font-size:.75rem;color:#ef4444;margin-top:4px;display:flex;align-items:center;gap:4px;}
.req::after{content:' *';color:#ef4444;font-size:.8rem;}
.btn-purple .spinner{width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;display:inline-block;vertical-align:middle;margin-right:6px;}
@keyframes spin{to{transform:rotate(360deg);}}
</style>
{% endblock %}

{% block body %}

{# ── Toasts ─────────────────────────────────────── #}
<div id="toast-container"></div>

{# ── Confirm delete modal ──────────────────────── #}
<div class="modal-overlay" id="confirmModal">
    <div class="confirm-box">
        <div class="confirm-icon"><i class="fas fa-trash-alt"></i></div>
        <div class="confirm-title">Supprimer cet article ?</div>
        <div class="confirm-msg">Cette action est <strong>irréversible</strong>. L'article sera définitivement supprimé.</div>
        <div class="confirm-actions">
            <button class="btn-confirm-cancel" id="confirmCancel"><i class="fas fa-times me-1"></i>Annuler</button>
            <button class="btn-confirm-delete" id="confirmOk"><i class="fas fa-trash me-1"></i>Supprimer</button>
        </div>
    </div>
</div>

{# ── Detail modal ──────────────────────────────── #}
<div class="modal-overlay" id="detailModal">
    <div class="detail-modal-box">
        <div class="detail-header">
            <div style="flex:1">
                <div class="detail-badge" id="d-categorie"></div>
                <div class="detail-title" id="d-titre"></div>
                <div class="detail-subtitle" id="d-subtitle"></div>
            </div>
            <button class="detail-close-btn" id="closeDetailBtn"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="detail-body">
            <div class="detail-grid">
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-user-pen"></i> Auteur</div>
                    <div class="detail-card-value" id="d-auteur"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-calendar"></i> Date de création</div>
                    <div class="detail-card-value" id="d-date"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-heart"></i> Likes</div>
                    <div class="detail-card-value" id="d-likes"></div>
                </div>
                <div class="detail-card">
                    <div class="detail-card-label"><i class="fas fa-tag"></i> Catégorie</div>
                    <div class="detail-card-value" id="d-cat"></div>
                </div>
            </div>
            <div class="detail-full">
                <div class="detail-card-label"><i class="fas fa-align-left"></i> Contenu complet</div>
                <div class="detail-card-value mt-2" id="d-contenu" style="line-height:1.7;white-space:pre-wrap;"></div>
            </div>
        </div>
    </div>
</div>

{# ── Page header ───────────────────────────────── #}
<div class="page-header">
    <h2><i class="fas fa-newspaper me-2" style="color:var(--purple-500)"></i>Articles Conseillés</h2>
    <p>Gérez les articles et conseils pour les familles d'enfants TSA</p>
</div>

{# ── Stat cards ────────────────────────────────── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">Total articles</div>
                    <div class="stat-value">{{ total|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-newspaper"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> publiés</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">❤️ Total likes</div>
                    <div class="stat-value">{{ totalLikes|default(0) }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-heart"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-arrow-up"></i> appréciations</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">✍️ Auteurs</div>
                    <div class="stat-value">{{ nbAuteurs|default(0) }}</div>
                </div>
                <div class="stat-icon purple"><i class="fas fa-users-pen"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-pen"></i> contributeurs</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <div class="stat-label">🏆 Top catégorie</div>
                    <div class="stat-value" style="font-size:1rem;font-weight:800;">{{ topCat|default('—') }}</div>
                </div>
                <div class="stat-icon pink"><i class="fas fa-star"></i></div>
            </div>
            <div class="stat-change up"><i class="fas fa-fire"></i> la plus active</div>
        </div>
    </div>
</div>

{# ── Formulaire ────────────────────────────────── #}
<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-plus-circle"></i> Nouvel article</span>
        <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
    </div>
    <div class="card-box-body">
        <input type="hidden" id="editId">
        <div class="row g-3" id="articleForm">

            <div class="col-md-8">
                <label class="form-label req">Titre de l'article</label>
                <input type="text" class="form-control" id="titre"
                       placeholder="Ex: Comment accompagner un enfant TSA au quotidien"
                       data-rule="required|min:5">
                <div class="field-error d-none" id="err-titre"></div>
            </div>

            <div class="col-md-4">
                <label class="form-label req">Catégorie</label>
                <select class="form-select" id="categorie" data-rule="required">
                    <option value="">-- Choisir --</option>
                    <option value="Conseils">💡 Conseils</option>
                    <option value="Thérapie">🧠 Thérapie</option>
                    <option value="Famille">👨‍👩‍👧 Famille</option>
                    <option value="Éducation">📚 Éducation</option>
                    <option value="Santé">❤️ Santé</option>
                    <option value="Activités">🎨 Activités</option>
                    <option value="Recherche">🔬 Recherche</option>
                    <option value="Témoignages">💬 Témoignages</option>
                </select>
                <div class="field-error d-none" id="err-categorie"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label req">Auteur</label>
                <input type="text" class="form-control" id="auteur"
                       placeholder="Ex: Dr. Fatma Trabelsi"
                       data-rule="required|min:3">
                <div class="field-error d-none" id="err-auteur"></div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Image auteur</label>
                <div style="display:flex;align-items:center;gap:12px;">
                    {# Avatar preview #}
                    <div id="avatarPreview" style="
                        width:56px;height:56px;border-radius:50%;
                        background:linear-gradient(135deg,#a855f7,#7c3aed);
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.1rem;font-weight:800;color:#fff;
                        flex-shrink:0;overflow:hidden;border:2px solid #ede9fe;">
                        <span id="avatarInitial">?</span>
                        <img id="avatarImg" src="" alt="" style="display:none;width:100%;height:100%;object-fit:cover;">
                    </div>
                    <div style="flex:1;">
                        <label for="auteurImageFile" style="
                            display:flex;align-items:center;gap:8px;
                            padding:8px 16px;border-radius:10px;
                            border:1.5px dashed #c4b5fd;background:#faf5ff;
                            cursor:pointer;font-size:.8rem;color:#5b21b6;
                            font-weight:600;transition:all .2s;"
                            onmouseover="this.style.background='#ede9fe'"
                            onmouseout="this.style.background='#faf5ff'">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span id="uploadLabel">Choisir une image...</span>
                        </label>
                        <input type="file" id="auteurImageFile" accept="image/*"
                               style="display:none;">
                        <input type="hidden" id="auteurImage">
                        <div style="font-size:.7rem;color:#9ca3af;margin-top:4px;">JPG, PNG, GIF — max 2 Mo</div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label req">Contenu</label>
                <textarea class="form-control" id="contenu" rows="5"
                          placeholder="Rédigez le contenu de l'article..."
                          data-rule="required|min:10"
                          oninput="document.getElementById('contenuCount').textContent=this.value.length"></textarea>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:3px;">
                    <div class="field-error d-none" id="err-contenu"></div>
                    <span style="font-size:.72rem;color:#9ca3af;margin-left:auto;"><span id="contenuCount">0</span> caractères</span>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button class="btn-purple" id="saveBtn">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
                <button class="btn-outline-purple" id="cancelBtn">
                    <i class="fas fa-times"></i> Annuler
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Filtres catégories ────────────────────────── #}
<div class="card-box mb-3">
    <div class="card-box-body" style="padding:12px 18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <div class="cat-pills">
                <span class="cat-pill active" data-cat="">🗂️ Tous (<span id="totalCount">{{ total|default(0) }}</span>)</span>
                {% for cat, count in cats|default({}) %}
                <span class="cat-pill" data-cat="{{ cat }}">{{ cat }} ({{ count }})</span>
                {% endfor %}
            </div>
            <input type="text" class="form-control filter-input" id="filterInput" placeholder="🔍 Rechercher...">
        </div>
    </div>
</div>

{# ── Grille d'articles ─────────────────────────── #}
<div class="article-grid" id="articleGrid">
{% for a in articles|default([]) %}
    <div class="article-card"
         data-id="{{ a.id }}"
         data-titre="{{ a.titre|e('html_attr') }}"
         data-contenu="{{ a.contenu|e('html_attr') }}"
         data-categorie="{{ a.categorie|e('html_attr') }}"
         data-auteur="{{ a.auteur|e('html_attr') }}"
         data-auteur-image="{{ a.auteurImage|default('')|e('html_attr') }}"
         data-likes="{{ a.likesCount|default(0) }}"
         data-date="{{ a.dateCreation is not null ? a.dateCreation|date('d/m/Y') : '' }}">

        <div class="article-card-header">
            <div class="article-cat-badge">{{ a.categorie }}</div>
            <div>
                <span class="article-card-title detail-trigger">{{ a.titre }}</span>
            </div>
        </div>

        <div class="article-card-body">
            <p class="article-excerpt">{{ a.contenu }}</p>
            <div class="article-meta">
                {% if a.auteurImage %}
                    <img src="{{ a.auteurImage }}" alt="{{ a.auteur }}" class="article-avatar"
                         style="object-fit:cover;" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                    <div class="article-avatar" style="display:none;">{{ a.auteur|slice(0,1)|upper }}</div>
                {% else %}
                    <div class="article-avatar">{{ a.auteur|slice(0,1)|upper }}</div>
                {% endif %}
                <div class="article-author-info">
                    <div class="article-author-name">{{ a.auteur }}</div>
                    <div class="article-date">
                        <i class="fas fa-calendar fa-xs me-1"></i>
                        {{ a.dateCreation is not null ? a.dateCreation|date('d/m/Y') : '—' }}
                    </div>
                </div>
            </div>
        </div>

        <div class="article-card-footer">
            <div class="article-likes">
                <i class="fas fa-heart"></i>
                {{ a.likesCount|default(0) }} like{{ a.likesCount > 1 ? 's' : '' }}
            </div>
            <div class="article-actions">
                <button class="btn-edit-soft edit-btn" data-id="{{ a.id }}" title="Modifier">
                    <i class="fas fa-edit"></i> Modifier
                </button>
                <button class="btn-danger-soft delete-btn"
                        data-id="{{ a.id }}"
                        data-token="{{ csrf_token('delete' ~ a.id) }}"
                        title="Supprimer">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
    </div>
{% else %}
    <div style="grid-column:1/-1;text-align:center;padding:60px 20px;color:#9ca3af;">
        <i class="fas fa-newspaper fa-3x" style="color:#c4b5fd;display:block;margin-bottom:16px;"></i>
        <div style="font-size:1rem;font-weight:600;margin-bottom:6px;">Aucun article publié</div>
        <div style="font-size:.85rem;">Créez votre premier article avec le formulaire ci-dessus</div>
    </div>
{% endfor %}
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {

    /* ══════════════════════════════════════════════════════════════
       TOAST
    ══════════════════════════════════════════════════════════════ */
    function showToast(type, title, msg, duration=4000) {
        const icons = {success:'fa-check',error:'fa-xmark',warning:'fa-triangle-exclamation'};
        const t = document.createElement('div');
        t.className = `toast toast-${type}`;
        t.style.setProperty('--dur', duration+'ms');
        t.innerHTML = `
            <div class="toast-icon"><i class="fas ${icons[type]}"></i></div>
            <div class="toast-body"><div class="toast-title">${title}</div><div class="toast-msg">${msg}</div></div>
            <button class="toast-close" onclick="this.closest('.toast').remove()"><i class="fas fa-xmark"></i></button>
            <div class="toast-progress"></div>`;
        document.getElementById('toast-container').appendChild(t);
        setTimeout(()=>{t.classList.add('hiding');setTimeout(()=>t.remove(),300);}, duration);
    }

    /* ══════════════════════════════════════════════════════════════
       CONFIRM MODAL
    ══════════════════════════════════════════════════════════════ */
    let _resolve = null;
    function showConfirm() {
        return new Promise(r => { _resolve=r; document.getElementById('confirmModal').classList.add('open'); });
    }
    document.getElementById('confirmCancel').addEventListener('click', ()=>{ document.getElementById('confirmModal').classList.remove('open'); if(_resolve)_resolve(false); });
    document.getElementById('confirmOk').addEventListener('click',     ()=>{ document.getElementById('confirmModal').classList.remove('open'); if(_resolve)_resolve(true); });
    document.getElementById('confirmModal').addEventListener('click', function(e){ if(e.target===this){this.classList.remove('open');if(_resolve)_resolve(false);} });

    /* ══════════════════════════════════════════════════════════════
       DETAIL MODAL
    ══════════════════════════════════════════════════════════════ */
    function openDetail(d) {
        const set = (id,v) => { const el=document.getElementById(id); if(el) el.textContent=v||'—'; };
        set('d-categorie',  d.categorie);
        set('d-titre',      d.titre);
        set('d-subtitle',   `✍️ ${d.auteur} · 📅 ${d.date}`);
        set('d-auteur',     d.auteur);
        set('d-date',       d.date);
        set('d-likes',      `❤️ ${d.likes} like${d.likes > 1 ? 's' : ''}`);
        set('d-cat',        d.categorie);
        set('d-contenu',    d.contenu);
        document.getElementById('detailModal').classList.add('open');
    }

    document.getElementById('closeDetailBtn').addEventListener('click', ()=>document.getElementById('detailModal').classList.remove('open'));
    document.getElementById('detailModal').addEventListener('click', function(e){ if(e.target===this) this.classList.remove('open'); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape'){document.getElementById('detailModal').classList.remove('open');document.getElementById('confirmModal').classList.remove('open');} });

    document.getElementById('articleGrid').addEventListener('click', function(e){
        const trigger = e.target.closest('.detail-trigger');
        if(!trigger) return;
        const card = trigger.closest('.article-card');
        if(card) openDetail(card.dataset);
    });

    /* ══════════════════════════════════════════════════════════════
       VALIDATION
    ══════════════════════════════════════════════════════════════ */
    const RULES = {
        required: v => v.trim()!==''           || 'Ce champ est obligatoire',
        min:      (v,n) => v.trim().length>=+n || `Minimum ${n} caractères requis`,
        email:    v => v===''||/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) || 'Email invalide',
    };

    function validateField(el) {
        const rule = el.dataset.rule; if(!rule) return true;
        const errEl = document.getElementById('err-'+el.id);
        let error = null;
        for(const part of rule.split('|')) {
            const [name,...args] = part.split(':');
            if(!RULES[name]) continue;
            const res = RULES[name](el.value,...args);
            if(res!==true){error=res;break;}
        }
        el.classList.toggle('is-invalid',!!error);
        el.classList.toggle('is-valid',!error&&el.value.trim()!=='');
        if(errEl){
            if(error){errEl.innerHTML=`<i class="fas fa-circle-exclamation"></i> ${error}`;errEl.classList.remove('d-none');}
            else errEl.classList.add('d-none');
        }
        return !error;
    }

    function validateAll() {
        let ok=true, first=null;
        document.querySelectorAll('#articleForm [data-rule]').forEach(el=>{
            if(!validateField(el)){ok=false;if(!first)first=el;}
        });
        if(first){first.scrollIntoView({behavior:'smooth',block:'center'});first.focus();}
        return ok;
    }

    document.querySelectorAll('#articleForm [data-rule]').forEach(el=>{
        el.addEventListener('blur',()=>validateField(el));
        el.addEventListener('input',()=>{if(el.classList.contains('is-invalid'))validateField(el);});
    });

    /* ══════════════════════════════════════════════════════════════
       FILTER — par catégorie + texte
    ══════════════════════════════════════════════════════════════ */
    let activeCat = '';

    function applyFilters() {
        const txt = (document.getElementById('filterInput').value||'').toLowerCase();
        let visible = 0;
        document.querySelectorAll('.article-card').forEach(card => {
            const matchCat = !activeCat || card.dataset.categorie === activeCat;
            const matchTxt = !txt || card.dataset.titre.toLowerCase().includes(txt);
            const show = matchCat && matchTxt;
            card.style.display = show ? '' : 'none';
            if(show) visible++;
        });
        document.getElementById('totalCount').textContent = visible;
    }

    document.querySelectorAll('.cat-pill').forEach(pill => {
        pill.addEventListener('click', function() {
            document.querySelectorAll('.cat-pill').forEach(p=>p.classList.remove('active'));
            this.classList.add('active');
            activeCat = this.dataset.cat;
            applyFilters();
        });
    });

    document.getElementById('filterInput')?.addEventListener('input', applyFilters);

    /* ══════════════════════════════════════════════════════════════
       RESET
    ══════════════════════════════════════════════════════════════ */
    function resetForm() {
        ['editId','titre','categorie','auteur','auteurImage','contenu'].forEach(id=>{
            const el=document.getElementById(id);
            if(el){el.value='';el.classList.remove('is-valid','is-invalid');}
        });
        document.querySelectorAll('.field-error').forEach(e=>e.classList.add('d-none'));
        document.getElementById('contenuCount').textContent='0';
        document.getElementById('formMode').textContent='Mode : Ajout';
        document.getElementById('editId').value='';
        // Reset avatar
        const fileInput = document.getElementById('auteurImageFile');
        if(fileInput) fileInput.value='';
        document.getElementById('uploadLabel').textContent='Choisir une image...';
        updateAvatarPreview(null, null);
    }
    document.getElementById('cancelBtn')?.addEventListener('click', resetForm);

    /* ══════════════════════════════════════════════════════════════
       IMAGE UPLOAD — prévisualisation + base64
    ══════════════════════════════════════════════════════════════ */
    function updateAvatarPreview(src, name) {
        const img     = document.getElementById('avatarImg');
        const initial = document.getElementById('avatarInitial');
        if (src) {
            img.src = src;
            img.style.display = 'block';
            initial.style.display = 'none';
        } else {
            img.style.display = 'none';
            initial.style.display = 'block';
            initial.textContent = name ? name.charAt(0).toUpperCase() : '?';
        }
    }

    // Mise à jour initiale de l'initiale quand on tape le nom
    document.getElementById('auteur')?.addEventListener('input', function() {
        const hasPic = document.getElementById('auteurImg')?.src;
        if (!hasPic) updateAvatarPreview(null, this.value);
    });

    // Quand on choisit un fichier
    document.getElementById('auteurImageFile')?.addEventListener('change', function() {
        const file = this.files[0];
        if (!file) return;

        // Vérif taille max 2 Mo
        if (file.size > 2 * 1024 * 1024) {
            showToast('error', 'Fichier trop volumineux', 'Maximum 2 Mo autorisé.', 4000);
            this.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const base64 = e.target.result;
            // Stocker en base64 dans le champ caché
            document.getElementById('auteurImage').value = base64;
            // Prévisualisation
            updateAvatarPreview(base64, null);
            // Label
            document.getElementById('uploadLabel').textContent = file.name;
        };
        reader.readAsDataURL(file);
    });

    /* ══════════════════════════════════════════════════════════════
       EDIT — charge les données dans le formulaire
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('articleGrid').addEventListener('click', function(e) {
        const btn = e.target.closest('.edit-btn');
        if(!btn) return;
        const card = btn.closest('.article-card');
        const d = card.dataset;
        document.getElementById('editId').value       = d.id;
        document.getElementById('titre').value        = d.titre;
        document.getElementById('categorie').value    = d.categorie;
        document.getElementById('auteur').value       = d.auteur;
        document.getElementById('auteurImage').value   = d.auteurImage||'';
        // Prévisualiser l'image existante
        if(d.auteurImage) {
            updateAvatarPreview(d.auteurImage, null);
            document.getElementById('uploadLabel').textContent = 'Image enregistrée ✓';
        } else {
            updateAvatarPreview(null, d.auteur);
            document.getElementById('uploadLabel').textContent = 'Choisir une image...';
        }
        document.getElementById('contenu').value      = d.contenu;
        document.getElementById('contenuCount').textContent = d.contenu.length;
        document.getElementById('formMode').textContent = 'Mode : Modification';
        document.querySelectorAll('#articleForm [data-rule]').forEach(el=>{
            if(el.value.trim()){el.classList.remove('is-invalid');el.classList.add('is-valid');}
        });
        document.getElementById('titre').scrollIntoView({behavior:'smooth'});
    });

    /* ══════════════════════════════════════════════════════════════
       SAVE
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('saveBtn')?.addEventListener('click', async function() {
        if(!validateAll()){
            showToast('warning','Formulaire incomplet','Corrigez les champs en rouge.');
            return;
        }
        const btn=this, ori=btn.innerHTML;
        btn.disabled=true;
        btn.innerHTML=`<span class="spinner"></span> Enregistrement...`;

        const editId = document.getElementById('editId').value;
        const body = {
            titre:       document.getElementById('titre').value.trim(),
            categorie:   document.getElementById('categorie').value,
            auteur:      document.getElementById('auteur').value.trim(),
            auteurImage: document.getElementById('auteurImage').value.trim()||null,
            contenu:     document.getElementById('contenu').value.trim(),
        };

        const url = editId ? `/admin/article/${editId}/edit` : '/admin/article/new';
        try {
            const res  = await fetch(url, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
            const data = await res.json();
            if(data.success){
                showToast('success', editId?'Article modifié':'Article créé', data.message, 4000);
                setTimeout(()=>location.reload(), 1200);
            } else {
                showToast('error','Erreur serveur', data.message, 5000);
                btn.disabled=false; btn.innerHTML=ori;
            }
        } catch {
            showToast('error','Erreur réseau','Impossible de contacter le serveur.', 5000);
            btn.disabled=false; btn.innerHTML=ori;
        }
    });

    /* ══════════════════════════════════════════════════════════════
       DELETE
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('articleGrid').addEventListener('click', async function(e) {
        const btn = e.target.closest('.delete-btn');
        if(!btn) return;
        const confirmed = await showConfirm();
        if(!confirmed) return;
        const id=btn.dataset.id, token=btn.dataset.token;
        const form=new FormData(); form.append('_token',token);
        try {
            const res  = await fetch(`/admin/article/${id}/delete`,{method:'POST',body:form});
            const data = await res.json();
            if(data.success){
                const card = btn.closest('.article-card');
                card.style.animation='toastOut .3s ease forwards';
                setTimeout(()=>card.remove(),300);
                showToast('success','Supprimé',data.message,3500);
            } else {
                showToast('error','Erreur',data.message,5000);
            }
        } catch {
            showToast('error','Erreur réseau','La suppression a échoué.',5000);
        }
    });

});
</script>
{% endblock %}
