{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const P = { p400:'#a855f7', pink:'#f472b6', indigo:'#818cf8', accent:'#e040fb',
                teal:'#2dd4bf', amber:'#fbbf24', rose:'#fb7185', sky:'#38bdf8' };

    /* ══════════════════════════════════════════════════════════════
       TOAST
    ══════════════════════════════════════════════════════════════ */
    function showToast(type, title, msg, duration = 4000) {
        const icons = { success:'fa-check', error:'fa-xmark', warning:'fa-triangle-exclamation' };
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.style.setProperty('--dur', duration + 'ms');
        toast.innerHTML = `
            <div class="toast-icon"><i class="fas ${icons[type]}"></i></div>
            <div class="toast-body">
                <div class="toast-title">${title}</div>
                <div class="toast-msg">${msg}</div>
            </div>
            <button class="toast-close" onclick="this.closest('.toast').remove()"><i class="fas fa-xmark"></i></button>
            <div class="toast-progress"></div>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.classList.add('hiding');
            setTimeout(() => toast.remove(), 300);
        }, duration);
    }

    /* ══════════════════════════════════════════════════════════════
       CONFIRM MODAL
    ══════════════════════════════════════════════════════════════ */
    let _confirmResolve = null;
    function showConfirm() {
        return new Promise(resolve => {
            _confirmResolve = resolve;
            document.getElementById('confirmModal').classList.add('open');
        });
    }
    document.getElementById('confirmCancel').addEventListener('click', () => {
        document.getElementById('confirmModal').classList.remove('open');
        if (_confirmResolve) _confirmResolve(false);
    });
    document.getElementById('confirmOk').addEventListener('click', () => {
        document.getElementById('confirmModal').classList.remove('open');
        if (_confirmResolve) _confirmResolve(true);
    });
    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) { this.classList.remove('open'); if (_confirmResolve) _confirmResolve(false); }
    });

    /* ══════════════════════════════════════════════════════════════
       DETAIL MODAL
    ══════════════════════════════════════════════════════════════ */
    function niveauPill(val) {
        const map = { faible:['pill-faible','↓ Faible'], moyenne:['pill-moyenne','— Moyenne'], elevee:['pill-elevee','↑ Élevée'] };
        const key = (val||'').toLowerCase().trim();
        const [cls, label] = map[key] || ['pill-unknown', val||'—'];
        return `<span class="detail-niveau-pill ${cls}">${label}</span>`;
    }

    function openDetail(d) {
        const set  = (id, v) => { const el=document.getElementById(id); if(el) el.textContent = v||'—'; };
        const setH = (id, h) => { const el=document.getElementById(id); if(el) el.innerHTML  = h; };
        set('d-type',         d.type);
        set('d-nom',          d.nom);
        set('d-subtitle',     `Cible : ${d.cible||'—'} • ${d.duree||'—'} min • Niveau ${d.niveau||'—'}`);
        set('d-cible',        d.cible);
        set('d-duree',        d.duree ? d.duree+' minutes' : '—');
        set('d-niveau',       d.niveau ? 'Niveau '+d.niveau : '—');
        set('d-interaction',  d.interaction);
        set('d-comportement', d.comportement);
        set('d-adaptation',   d.adaptation);
        set('d-objectif',     d.objectif);
        set('d-description',  d.description);
        set('d-materiel',     d.materiel);
        setH('d-humeur',    niveauPill(d.humeur));
        setH('d-attention', niveauPill(d.attention));
        setH('d-stresse',   niveauPill(d.stresse));
        document.getElementById('detailsModal').classList.add('open');
    }

    document.getElementById('closeDetailsModalBtn').addEventListener('click', () =>
        document.getElementById('detailsModal').classList.remove('open'));
    document.getElementById('detailsModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('open');
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.getElementById('detailsModal').classList.remove('open');
            document.getElementById('confirmModal').classList.remove('open');
        }
    });

    // Délégation sur tbody — fonctionne avec Twig rendu côté serveur
    document.querySelector('#therapieTable tbody').addEventListener('click', function(e) {
        const trigger = e.target.closest('.detail-trigger');
        if (!trigger) return;
        const row = trigger.closest('tr');
        if (row) openDetail(row.dataset);
    });

    /* ══════════════════════════════════════════════════════════════
       RÈGLES DE VALIDATION
       — integer : accepte uniquement les entiers positifs
    ══════════════════════════════════════════════════════════════ */
    const RULES = {
        required: (v)        => v.trim() !== ''               || 'Ce champ est obligatoire',
        min:      (v, n)     => v.trim().length >= +n         || `Minimum ${n} caractères requis`,
        max:      (v, n)     => v.trim().length <= +n         || `Maximum ${n} caractères autorisés`,
        positive: (v)        => +v > 0                        || 'La valeur doit être positive (> 0)',
        range:    (v, mn,mx) => (+v >= +mn && +v <= +mx)      || `Valeur entre ${mn} et ${mx} requise`,
        integer:  (v)        => /^\d+$/.test(v.trim())        || 'Veuillez saisir un nombre entier (sans virgule ni décimale)',
    };

    function validateField(el) {
        const ruleStr = el.dataset.rule;
        if (!ruleStr) return true;
        const val   = el.value;
        const errEl = document.getElementById('err-' + el.id);
        let error   = null;
        for (const part of ruleStr.split('|')) {
            const [name, ...args] = part.split(':');
            if (!RULES[name]) continue;
            const result = RULES[name](val, ...args);
            if (result !== true) { error = result; break; }
        }
        el.classList.toggle('is-invalid', !!error);
        el.classList.toggle('is-valid',   !error && val.trim() !== '');
        if (errEl) {
            if (error) {
                errEl.innerHTML = `<i class="fas fa-circle-exclamation"></i> ${error}`;
                errEl.classList.remove('d-none');
            } else {
                errEl.classList.add('d-none');
            }
        }
        return !error;
    }

    /* ── Validation des pills niveaux ── */
    const niveauFields  = ['niveauxHumeur', 'niveauxAttention', 'niveauxStresse'];
    const niveauLabels  = {
        niveauxHumeur:    'Niveau Humeur',
        niveauxAttention: 'Niveau Attention',
        niveauxStresse:   'Niveau Stress',
    };

    function validateNiveau(id) {
        const val   = document.getElementById(id)?.value || '';
        const wrap  = document.getElementById('wrap-' + id);
        const errEl = document.getElementById('err-' + id);
        const ok    = val.trim() !== '';
        wrap?.classList.toggle('is-invalid', !ok);
        wrap?.classList.toggle('is-valid',    ok);
        if (errEl) {
            if (!ok) {
                errEl.innerHTML = `<i class="fas fa-circle-exclamation"></i> Sélectionnez un niveau pour « ${niveauLabels[id]} »`;
                errEl.classList.remove('d-none');
            } else {
                errEl.classList.add('d-none');
            }
        }
        return ok;
    }

    /* ── validateAll : vérifie champs texte ET pills ── */
    function validateAll() {
        let allValid    = true;
        let firstBad    = null;

        document.querySelectorAll('#therapieForm [data-rule]').forEach(el => {
            const ok = validateField(el);
            if (!ok) { allValid = false; if (!firstBad) firstBad = el; }
        });

        niveauFields.forEach(id => {
            const ok = validateNiveau(id);
            if (!ok) { allValid = false; if (!firstBad) firstBad = document.getElementById('wrap-' + id); }
        });

        if (firstBad) {
            firstBad.scrollIntoView({ behavior:'smooth', block:'center' });
            if (typeof firstBad.focus === 'function') firstBad.focus();
        }
        return allValid;
    }

    // Live validation (champs texte)
    document.querySelectorAll('#therapieForm [data-rule]').forEach(el => {
        el.addEventListener('blur',  () => validateField(el));
        el.addEventListener('input', () => { if (el.classList.contains('is-invalid')) validateField(el); });
    });

    /* ══════════════════════════════════════════════════════════════
       PILLS — click
    ══════════════════════════════════════════════════════════════ */
    function setNiveauPill(targetId, val) {
        const group = document.querySelector(`.niveau-group[data-target="${targetId}"]`);
        if (!group) return;
        group.querySelectorAll('.niveau-pill').forEach(p =>
            p.classList.toggle('active', p.dataset.val === val));
        const hidden = document.getElementById(targetId);
        if (hidden) hidden.value = val || '';
        // Valide immédiatement si une valeur est choisie
        if (val) validateNiveau(targetId);
    }

    document.querySelectorAll('.niveau-group .niveau-pill').forEach(pill => {
        pill.addEventListener('click', function() {
            const targetId = this.closest('.niveau-group').dataset.target;
            const already  = this.classList.contains('active');
            setNiveauPill(targetId, already ? '' : this.dataset.val);
        });
    });

    /* ══════════════════════════════════════════════════════════════
       CHART
    ══════════════════════════════════════════════════════════════ */
    const labels = {{ chartLabels|default([])|json_encode|raw }};
    const values = {{ chartValues|default([])|json_encode|raw }};
    const colors = [P.p400, P.pink, P.indigo, P.accent, P.teal, P.amber, P.rose, P.sky];
    // ── Graphique types d'exercice ─────────────────────────
    new Chart(document.getElementById('therapieChart').getContext('2d'), {
        type: 'doughnut',
        data: { labels, datasets: [{ data:values, backgroundColor:colors.slice(0,labels.length), borderWidth:0, hoverOffset:8 }] },
        options: { plugins: { legend:{ position:'bottom', labels:{ usePointStyle:true, font:{family:'DM Sans',size:11} } } }, cutout:'60%', responsive:true }
    });

    // ── Graphiques niveaux ──────────────────────────────────
    const niveauChartLabels = ['Faible', 'Moyenne', 'Élevée'];
    const niveauColors = {
        bg:     ['rgba(22,163,74,.15)',  'rgba(217,119,6,.15)',  'rgba(225,29,72,.15)'],
        border: ['#16a34a',              '#d97706',              '#e11d48'],
        hover:  ['rgba(22,163,74,.3)',   'rgba(217,119,6,.3)',   'rgba(225,29,72,.3)'],
    };

    function makeNiveauChart(canvasId, data) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: niveauChartLabels,
                datasets: [{
                    data: data,
                    backgroundColor: niveauColors.bg,
                    borderColor:     niveauColors.border,
                    borderWidth: 2,
                    hoverBackgroundColor: niveauColors.hover,
                    hoverOffset: 6,
                }]
            },
            options: {
                cutout: '65%',
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const total = ctx.dataset.data.reduce((a,b)=>a+b,0);
                                const pct   = total > 0 ? Math.round(ctx.parsed/total*100) : 0;
                                return ` ${ctx.label} : ${ctx.parsed} exercice(s) (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    makeNiveauChart('humeurChart',    [{{ humeurStats.faible|default(0) }}, {{ humeurStats.moyenne|default(0) }}, {{ humeurStats.elevee|default(0) }}]);
    makeNiveauChart('attentionChart', [{{ attentionStats.faible|default(0) }}, {{ attentionStats.moyenne|default(0) }}, {{ attentionStats.elevee|default(0) }}]);
    makeNiveauChart('stresseChart',   [{{ stresseStats.faible|default(0) }}, {{ stresseStats.moyenne|default(0) }}, {{ stresseStats.elevee|default(0) }}]);

    // ── Donuts des combinaisons ──────────────────────────────────────
    {% if combinaisons is defined and combinaisons|length > 0 %}
    {% for combi in combinaisons %}
    (function(){
        var ctx = document.getElementById('combiChart{{ loop.index }}');
        if (!ctx) return;
        // Couleurs selon le niveau de chaque indicateur
        var colH = '{{ combi.humeur    == "faible" ? "#bbf7d0" : (combi.humeur    == "moyenne" ? "#fde68a" : "#fecdd3") }}';
        var colA = '{{ combi.attention == "faible" ? "#bbf7d0" : (combi.attention == "moyenne" ? "#fde68a" : "#fecdd3") }}';
        var colS = '{{ combi.stress    == "faible" ? "#bbf7d0" : (combi.stress    == "moyenne" ? "#fde68a" : "#fecdd3") }}';
        var brdH = '{{ combi.humeur    == "faible" ? "#16a34a" : (combi.humeur    == "moyenne" ? "#d97706" : "#e11d48") }}';
        var brdA = '{{ combi.attention == "faible" ? "#16a34a" : (combi.attention == "moyenne" ? "#d97706" : "#e11d48") }}';
        var brdS = '{{ combi.stress    == "faible" ? "#16a34a" : (combi.stress    == "moyenne" ? "#d97706" : "#e11d48") }}';
        new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['😊 Humeur', '🧠 Attention', '⚡ Stress'],
                datasets: [{
                    data: [{{ combi.count }}, {{ combi.count }}, {{ combi.count }}],
                    backgroundColor: [colH, colA, colS],
                    borderColor:     [brdH, brdA, brdS],
                    borderWidth: 2, hoverOffset: 5
                }]
            },
            options: {
                cutout: '62%', responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(c) {
                                var labels = ['Humeur', 'Attention', 'Stress'];
                                var vals   = ['{{ combi.humeur }}','{{ combi.attention }}','{{ combi.stress }}'];
                                var map    = {faible:'↓ Faible', moyenne:'— Moyenne', elevee:'↑ Élevée'};
                                return ' ' + labels[c.dataIndex] + ' : ' + (map[vals[c.dataIndex]] || vals[c.dataIndex]);
                            }
                        }
                    }
                }
            }
        });
    })();
    {% endfor %}
    {% endif %}

    /* ══════════════════════════════════════════════════════════════
       FILTRES NIVEAUX + RECHERCHE TEXTE
    ══════════════════════════════════════════════════════════════ */
    const activeFilters = { humeur: '', attention: '', stresse: '' };

    function applyFilters() {
        const search = (document.getElementById('planFilterInput').value || '').toLowerCase();
        let visible = 0;

        document.querySelectorAll('#therapieTable tbody tr:not(.no-result-row)').forEach(row => {
            const d = row.dataset;
            const matchSearch  = !search || row.textContent.toLowerCase().includes(search);
            const matchHumeur  = !activeFilters.humeur    || (d.humeur    || '').toLowerCase() === activeFilters.humeur;
            const matchAttn    = !activeFilters.attention || (d.attention || '').toLowerCase() === activeFilters.attention;
            const matchStresse = !activeFilters.stresse   || (d.stresse   || '').toLowerCase() === activeFilters.stresse;

            const show = matchSearch && matchHumeur && matchAttn && matchStresse;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const counter = document.getElementById('visibleCount');
        if (counter) counter.textContent = visible;

        let noRow = document.querySelector('#therapieTable tbody .no-result-row');
        if (visible === 0) {
            if (!noRow) {
                noRow = document.createElement('tr');
                noRow.className = 'no-result-row';
                noRow.innerHTML = `<td colspan="7" style="text-align:center;padding:2.5rem 1rem;color:#9ca3af;font-size:.85rem;">
                    <i class="fas fa-filter-circle-xmark" style="font-size:1.6rem;color:#c4b5fd;display:block;margin-bottom:10px;"></i>
                    Aucun exercice ne correspond aux filtres sélectionnés.<br>
                    <button onclick="document.getElementById('resetFilters').click()"
                        style="margin-top:10px;background:none;border:1.5px solid #c4b5fd;color:#7c3aed;
                               border-radius:8px;padding:5px 16px;font-size:.75rem;cursor:pointer;font-weight:600;">
                        <i class="fas fa-rotate-left"></i> Réinitialiser
                    </button>
                </td>`;
                document.querySelector('#therapieTable tbody').appendChild(noRow);
            }
            noRow.style.display = '';
        } else if (noRow) {
            noRow.style.display = 'none';
        }
    }

    // Clic sur les pills de filtre
    document.querySelectorAll('.filter-pill').forEach(pill => {
        pill.addEventListener('click', function() {
            const filterKey = this.dataset.filter;
            const val       = this.dataset.val;
            document.querySelectorAll(`.filter-pill[data-filter="${filterKey}"]`).forEach(p =>
                p.classList.remove('active-all','active-faible','active-moyenne','active-elevee'));
            this.classList.add(val === '' ? 'active-all' : 'active-' + val);
            activeFilters[filterKey] = val;
            applyFilters();
        });
    });

    // Recherche texte
    document.getElementById('planFilterInput')?.addEventListener('input', () => applyFilters());

    // Réinitialiser
    document.getElementById('resetFilters')?.addEventListener('click', () => {
        activeFilters.humeur = activeFilters.attention = activeFilters.stresse = '';
        document.getElementById('planFilterInput').value = '';
        document.querySelectorAll('.filter-pill').forEach(p =>
            p.classList.remove('active-all','active-faible','active-moyenne','active-elevee'));
        document.querySelectorAll('.filter-pill[data-val=""]').forEach(p =>
            p.classList.add('active-all'));
        applyFilters();
    });

    /* ══════════════════════════════════════════════════════════════
       RESET
    ══════════════════════════════════════════════════════════════ */
    function resetForm() {
        ['editId','nomExercice','typeExercice','objectif','description','dureeMin',
         'materiel','adaptationTsa','cible','comportement','interaction','niveau'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.value = ''; el.classList.remove('is-valid','is-invalid'); }
        });
        niveauFields.forEach(id => {
            setNiveauPill(id, '');
            document.getElementById('wrap-'+id)?.classList.remove('is-valid','is-invalid');
            document.getElementById('err-'+id)?.classList.add('d-none');
        });
        document.querySelectorAll('.field-error').forEach(e => e.classList.add('d-none'));
        document.getElementById('formMode').textContent = 'Mode : Ajout';
    }
    document.getElementById('cancelPlanBtn')?.addEventListener('click', resetForm);

    /* ══════════════════════════════════════════════════════════════
       EDIT — charge les données dans le formulaire
       Les pills sont chargées via setNiveauPill → si la valeur
       existe en BDD, le niveau est marqué valide immédiatement.
       Si le champ BDD est vide (donnée manquante), il restera
       invalide et bloquera la sauvegarde.
    ══════════════════════════════════════════════════════════════ */
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const d = this.closest('tr').dataset;
            document.getElementById('editId').value         = d.id;
            document.getElementById('nomExercice').value    = d.nom;
            document.getElementById('typeExercice').value   = d.type;
            document.getElementById('objectif').value       = d.objectif;
            document.getElementById('description').value    = d.description;
            document.getElementById('dureeMin').value       = d.duree;
            document.getElementById('materiel').value       = d.materiel;
            document.getElementById('adaptationTsa').value  = d.adaptation;
            document.getElementById('cible').value          = d.cible;
            document.getElementById('comportement').value   = d.comportement;
            document.getElementById('interaction').value    = d.interaction;
            document.getElementById('niveau').value         = d.niveau;
            document.getElementById('formMode').textContent = 'Mode : Modification';

            // Charge les pills — déclenche validateNiveau si valeur non vide
            setNiveauPill('niveauxHumeur',    d.humeur);
            setNiveauPill('niveauxAttention', d.attention);
            setNiveauPill('niveauxStresse',   d.stresse);

            // Marque les champs texte remplis comme valides
            document.querySelectorAll('#therapieForm [data-rule]').forEach(el => {
                if (el.value.trim() !== '') {
                    el.classList.remove('is-invalid');
                    el.classList.add('is-valid');
                }
            });
            document.getElementById('nomExercice').scrollIntoView({ behavior:'smooth' });
        });
    });

    /* ══════════════════════════════════════════════════════════════
       SAVE — validateAll() bloque si un niveau est vide
    ══════════════════════════════════════════════════════════════ */
    document.getElementById('savePlanBtn')?.addEventListener('click', async function() {
        if (!validateAll()) {
            showToast('warning', 'Formulaire incomplet',
                'Corrigez les champs en rouge. Les niveaux Humeur, Attention et Stress sont obligatoires.');
            return;
        }

        const btn = this;
        const ori = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner"></span> Enregistrement...`;

        const editId = document.getElementById('editId').value;
        const url    = editId ? `/admin/therapie/${editId}/edit` : `/admin/therapie/new`;
        const body   = {
            nomExercice:      document.getElementById('nomExercice').value,
            typeExercice:     document.getElementById('typeExercice').value,
            objectif:         document.getElementById('objectif').value,
            description:      document.getElementById('description').value,
            dureeMin:         document.getElementById('dureeMin').value,
            materiel:         document.getElementById('materiel').value,
            adaptationTsa:    document.getElementById('adaptationTsa').value,
            cible:            document.getElementById('cible').value,
            niveauxHumeur:    document.getElementById('niveauxHumeur').value,
            niveauxAttention: document.getElementById('niveauxAttention').value,
            niveauxStresse:   document.getElementById('niveauxStresse').value,
            comportement:     document.getElementById('comportement').value,
            interaction:      document.getElementById('interaction').value,
            niveau:           document.getElementById('niveau').value,
        };

        try {
            const res  = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
            const data = await res.json();
            if (data.success) {
                showToast('success', editId ? 'Modification réussie' : 'Création réussie', data.message, 4000);
                setTimeout(() => location.reload(), 1200);
            } else {
                showToast('error', 'Erreur serveur', data.message, 5000);
                btn.disabled = false; btn.innerHTML = ori;
            }
        } catch {
            showToast('error', 'Erreur réseau', 'Impossible de contacter le serveur.', 5000);
            btn.disabled = false; btn.innerHTML = ori;
        }
    });

    /* ══════════════════════════════════════════════════════════════
       DELETE
    ══════════════════════════════════════════════════════════════ */
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            const confirmed = await showConfirm();
            if (!confirmed) return;
            const id = this.dataset.id, token = this.dataset.token;
            const form = new FormData(); form.append('_token', token);
            try {
                const res  = await fetch(`/admin/therapie/${id}/delete`, { method:'POST', body:form });
                const data = await res.json();
                if (data.success) {
                    this.closest('tr').style.animation = 'toastOut .3s ease forwards';
                    setTimeout(() => this.closest('tr').remove(), 300);
                    showToast('success', 'Supprimé', data.message, 3500);
                } else {
                    showToast('error', 'Erreur', data.message, 5000);
                }
            } catch {
                showToast('error', 'Erreur réseau', 'La suppression a échoué.', 5000);
            }
        });
    });

});
</script>
{% endblock %}
