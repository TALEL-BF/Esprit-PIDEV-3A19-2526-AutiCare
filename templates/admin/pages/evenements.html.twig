</div>

<!-- Résultats de recherche -->
<div class="mb-2">
    <div id="searchStats" class="text-muted">
        <i class="fas fa-chart-line"></i> 
        <span id="resultCount">0</span> événement(s) trouvé(s)
    </div>
</div>

<!-- TABLEAU DES ÉVÉNEMENTS -->
<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Événements</span>
        <a href="{{ path('admin_evenements_export_pdf') }}" class="btn-outline-purple" style="padding: 6px 15px; text-decoration: none;">
