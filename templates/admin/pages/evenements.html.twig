{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Gestion des Événements{% endblock %}

{% block page_title %}Gestion des Événements{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ========== PALETTE DE COULEURS PASTEL ========== */
:root {
    --pastel-pink: #f8e4f0;
    --pastel-pink-dark: #e8a0c4;
    --pastel-pink-soft: #fce4ec;
    --pastel-blue: #e0f0ff;
    --pastel-blue-dark: #7eb8e0;
    --pastel-green: #e0f5e8;
    --pastel-green-dark: #7ec89e;
    --pastel-yellow: #fff5e0;
    --pastel-yellow-dark: #f5c842;
    --pastel-purple: #f0e4ff;
    --pastel-purple-dark: #b87ef5;
    --pastel-orange: #ffe4e0;
    --pastel-orange-dark: #f5a07e;
    --pastel-mint: #e0fff0;
    --pastel-mint-dark: #7ef5c8;
    --pastel-coral: #ffe0e0;
}

/* ========== FORM ERROR STYLES ========== */
.form-error {
    display: block;
    margin-top: 6px;
    font-size: 0.75rem;
    border-radius: 8px;
    padding: 4px 10px;
    animation: slideDown 0.2s ease;
}

.form-error i {
    margin-right: 6px;
}

.form-error.success-message {
    background: var(--pastel-green);
    color: #2d6a4f;
}

.form-error.error-message {
    background: var(--pastel-coral);
    color: #c92a2a;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-5px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

.is-invalid {
    animation: shake 0.3s ease-in-out;
    border-color: #dc3545 !important;
    border-width: 2px !important;
}

.is-valid {
    border-color: #198754 !important;
    border-width: 2px !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right calc(0.375em + 0.1875rem) center;
    background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    padding-right: calc(1.5em + 0.75rem);
}

/* Field colors */
input#eventTitle.form-control {
    background-color: var(--pastel-pink-soft);
}
select#eventType.form-select {
    background-color: var(--pastel-purple);
}
input#eventLocation.form-control {
    background-color: var(--pastel-blue);
}
input#eventCapacity.form-control {
    background-color: var(--pastel-green);
}
input#eventStartDate.form-control, input#eventEndDate.form-control {
    background-color: var(--pastel-yellow);
}
input#eventStartTime.form-control, input#eventEndTime.form-control {
    background-color: var(--pastel-mint);
}
textarea#eventDescription.form-control {
    background-color: var(--pastel-orange);
}

/* Card styles */
.card-box {
    background: white;
    border-radius: 20px;
    margin-bottom: 24px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.card-box-header {
    padding: 16px 24px;
    border-bottom: 2px solid var(--pastel-pink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    background: linear-gradient(135deg, #fff, var(--pastel-pink-soft));
}

.card-box-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: #1f2937;
    display: flex;
-align-items: center;
    gap: 8px;
}

.card-box-title i {
    color: var(--pastel-purple-dark);
    font-size: 1.3rem;
}

.card-box-body {
    padding: 24px;
}

.btn-purple {
    background: linear-gradient(135deg, var(--pastel-purple-dark), #a78bfa);
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-purple:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
}

.btn-outline-purple {
    background: transparent;
    color: var(--pastel-purple-dark);
    border: 2px solid var(--pastel-purple-dark);
    padding: 8px 22px;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-outline-purple:hover {
    background: var(--pastel-purple);
    transform: translateY(-2px);
}

.btn-edit-soft {
    background: var(--pastel-yellow);
    color: #b45309;
    border: none;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-edit-soft:hover {
    background: var(--pastel-yellow-dark);
    transform: translateY(-1px);
}

.btn-danger-soft {
    background: var(--pastel-pink);
    color: #c92a2a;
    border: none;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-danger-soft:hover {
    background: #f8d4e4;
    transform: translateY(-1px);
}

.form-label {
    font-weight: 600;
    margin-bottom: 6px;
    color: #374151;
}
.form-label i {
    color: var(--pastel-pink-dark);
    margin-right: 5px;
}
.form-label .required-star {
    color: #dc3545;
    margin-left: 4px;
}

.form-control, .form-select {
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    padding: 8px 12px;
    transition: all 0.2s;
    width: 100%;
}

.form-control:focus, .form-select:focus {
    border-color: var(--pastel-purple-dark);
    outline: none;
    box-shadow: 0 0 0 2px rgba(180, 126, 245, 0.2);
}

.form-mode-badge {
    background: var(--pastel-green);
    color: #2d6a4f;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

.table-wrapper {
    overflow-x: auto;
}

.custom-table {
    width: 100%;
    border-collapse: collapse;
}

.custom-table th {
    background: var(--pastel-pink-soft);
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    color: #1f2937;
    border-bottom: 2px solid var(--pastel-pink-dark);
}

.custom-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: middle;
}

.custom-table tr:hover {
    background: var(--pastel-pink-soft);
}

.current-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 5px;
}
.current-image-wrapper {
    margin-top: 10px;
    padding: 15px;
    background: var(--pastel-pink-soft);
    border-radius: 12px;
    border-left: 4px solid var(--pastel-pink-dark);
}

select[multiple] {
    padding: 8px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}
select[multiple] option {
    padding: 8px;
    border-bottom: 1px solid #f3f4f6;
}
select[multiple] option:checked {
    background: var(--pastel-purple-dark) linear-gradient(0deg, var(--pastel-purple-dark) 0%, var(--pastel-purple-dark) 100%);
    color: white;
}

.event-image {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 10px;
}

.event-image-placeholder {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pastel-yellow);
    border-radius: 10px;
    color: var(--pastel-yellow-dark);
}

.alert {
    padding: 12px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    border: none;
}
.alert-success {
    background: var(--pastel-green);
    color: #2d6a4f;
}
.alert-danger {
    background: var(--pastel-pink);
    color: #c92a2a;
}

/* Toast notification */
.toast-notification {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10001;
    min-width: 300px;
    animation: slideInRight 0.3s ease;
}
@keyframes slideInRight {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Popup styles */
.custom-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
}
.custom-popup {
    background: white;
    border-radius: 20px;
    padding: 25px;
    width: 450px;
    max-width: 90%;
    text-align: center;
    animation: fadeIn 0.3s ease;
}
.custom-popup.warning {
    border-top: 5px solid #ef4444;
}
.custom-popup-icon {
    font-size: 60px;
    margin-bottom: 15px;
}
.custom-popup h3 {
    font-size: 24px;
    margin-bottom: 10px;
}
.custom-popup p {
    color: #6b7280;
    margin-bottom: 20px;
}
.custom-popup-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}
.btn-popup-confirm {
    background: #ef4444;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}
.btn-popup-confirm:hover {
    background: #dc2626;
}
.btn-popup-cancel {
    background: #f3f4f6;
    color: #374151;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s;
}
.btn-popup-cancel:hover {
    background: #e5e7eb;
}
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Search & filters */
.search-wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
}
.search-input-wrapper {
    flex: 1;
    position: relative;
}
.search-input-wrapper i {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--pastel-pink-dark);
    font-size: 1rem;
    z-index: 1;
}
.search-input-wrapper input {
    padding-left: 40px !important;
}

.btn-reset {
    background: var(--pastel-pink);
    color: #c92a2a;
    border: none;
    padding: 8px 20px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.2s;
}
.btn-reset:hover {
    background: var(--pastel-pink-dark);
    color: white;
    transform: translateY(-2px);
}

.filters-row {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}
.filter-group {
    flex: 1;
    min-width: 150px;
}
.filter-label {
    font-weight: 600;
    color: #4b5563;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.filter-label i {
    color: var(--pastel-pink-dark);
}
.filter-select {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 8px 12px;
    background: white;
    transition: all 0.2s;
    width: 100%;
}

.active-filters {
    background: var(--pastel-purple);
    padding: 10px 15px;
    border-radius: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 15px;
}
.badge-grey {
    background: rgba(107,114,128,0.1);
    color: #6b7280;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    display: inline-block;
}

#loadingIndicator {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    padding: 20px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    z-index: 9999;
    text-align: center;
}

.form-section-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--pastel-purple-dark);
    margin: 20px 0 15px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--pastel-pink);
    display: flex;
    align-items: center;
    gap: 8px;
}
.form-section-title:first-of-type {
    margin-top: 0;
}
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h2><i class="fas fa-calendar-alt me-2" style="color:var(--pastel-purple-dark)"></i>Gestion des Événements</h2>
    <p>Gérer les événements, ateliers et conférences</p>
</div>

<!-- FORMULAIRE AJOUT/MODIFICATION -->
<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-plus-circle"></i> Ajouter / Modifier un Événement</span>
        <span class="form-mode-badge" id="formMode">Mode : Ajout</span>
    </div>
    <div class="card-box-body">
        <form method="POST" id="eventForm" enctype="multipart/form-data" novalidate>
            <input type="hidden" id="eventId" name="eventId" value="">
            
            <!-- INFORMATIONS PRINCIPALES -->
            <div class="form-section-title">
                <i class="fas fa-info-circle"></i> INFORMATIONS PRINCIPALES
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-heading"></i> Titre <span class="required-star">*</span></label>
                    <input type="text" class="form-control" id="eventTitle" name="eventTitle" placeholder="Ex: Atelier peinture sensorielle">
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-tag"></i> Type d'événement <span class="required-star">*</span></label>
                    <select class="form-select" id="eventType" name="eventType">
                        <option value="">Sélectionner un type</option>
                        <option value="Atelier">🎨 Atelier</option>
                        <option value="Conférence">🎤 Conférence</option>
                        <option value="Sortie">🚶 Sortie</option>
                        <option value="Formation">📚 Formation</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-map-marker-alt"></i> Lieu <span class="required-star">*</span></label>
                    <input type="text" class="form-control" id="eventLocation" name="eventLocation" placeholder="Adresse ou lieu en ligne">
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-users"></i> Capacité max <span class="required-star">*</span></label>
                    <input type="number" class="form-control" id="eventCapacity" name="eventCapacity" placeholder="Nombre de participants">
                </div>
            </div>
            
            <!-- DESCRIPTION -->
            <div class="form-section-title">
                <i class="fas fa-align-left"></i> DESCRIPTION
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label"><i class="fas fa-file-alt"></i> Description <span class="required-star">*</span></label>
                    <textarea class="form-control" id="eventDescription" name="eventDescription" rows="3" placeholder="Description complète de l'événement..."></textarea>
                </div>
            </div>
            
            <!-- DATE & HEURE -->
            <div class="form-section-title">
                <i class="fas fa-calendar-clock"></i> DATE & HEURE
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-calendar-day"></i> Date début <span class="required-star">*</span></label>
                    <input type="date" class="form-control" id="eventStartDate" name="eventStartDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-clock"></i> Heure début <span class="required-star">*</span></label>
                    <input type="time" class="form-control" id="eventStartTime" name="eventStartTime">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-calendar-day"></i> Date fin</label>
                    <input type="date" class="form-control" id="eventEndDate" name="eventEndDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-clock"></i> Heure fin</label>
                    <input type="time" class="form-control" id="eventEndTime" name="eventEndTime">
                </div>
            </div>
            
            <!-- STATUT & IMAGE -->
            <div class="form-section-title">
                <i class="fas fa-cog"></i> STATUT & IMAGE
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-flag-checkered"></i> Statut</label>
                    <select class="form-select" id="eventStatus" name="eventStatus">
                        <option value="planifie">📅 Planifié</option>
                        <option value="ouvert">🔓 Ouvert aux inscriptions</option>
                        <option value="complet">✅ Complet</option>
                        <option value="annule">❌ Annulé</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-image"></i> Image <span class="required-star" id="imageRequiredStar">*</span></label>
                    <input type="file" class="form-control" id="eventImage" name="eventImage" accept="image/*">
                    <small class="text-muted"><i class="fas fa-info-circle"></i> Formats acceptés : JPG, PNG (max 2MB)</small>
                </div>
                
                <!-- APERÇU DE L'IMAGE EXISTANTE -->
                <div class="col-12" id="currentImageContainer" style="display: none;">
                    <label class="form-label"><i class="fas fa-image"></i> Image actuelle :</label>
                    <div class="current-image-wrapper">
                        <img id="currentImagePreview" src="" alt="Image actuelle" class="current-image">
                        <div class="mt-2">
                            <i class="fas fa-file-image"></i>
                            <span id="currentImageName" class="badge-grey"></span>
                        </div>
                        <div class="mt-2">
                            <div class="input-group" style="max-width: 100%;">
                                <input type="text" id="currentImagePath" class="form-control" readonly style="background: #f3f4f6; font-size: 0.75rem;">
                                <button class="btn-outline-purple" type="button" onclick="copyImagePath()">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle"></i> 
                            Laissez le champ "Choisir un fichier" vide pour conserver cette image
                        </small>
                    </div>
                </div>
            </div>
            
        
            
            <div class="row g-3 mt-2">
                <div class="col-12 d-flex gap-2">
                    <button class="btn-purple" type="button" onclick="showConfirmPopup()"><i class="fas fa-save"></i> Enregistrer</button>
                    <button class="btn-outline-purple" id="cancelEventBtn" type="button"><i class="fas fa-times"></i> Annuler</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- RECHERCHE INTELLIGENTE -->
<div class="card-box mb-4">
    <div class="card-box-body">
        <label class="filter-label">
            <i class="fas fa-search"></i> Recherche intelligente
        </label>
        <div class="search-wrapper">
            <div class="search-input-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" 
                       class="form-control" 
                       id="smartSearch" 
                       name="smartSearch" 
                       placeholder="Rechercher par titre, description, lieu..."
                       onkeyup="loadEvents()">
            </div>
            <button class="btn-reset" type="button" onclick="resetSearch()">
                <i class="fas fa-trash-alt"></i> Réinitialiser
            </button>
        </div>
       
    </div>
</div>

<!-- FILTRES -->
<div class="filters-row">
    <div class="filter-group">
        <label class="filter-label">
            <i class="fas fa-tag"></i> Type d'événement
        </label>
        <select class="form-select filter-select" id="filterType" onchange="loadEvents()">
            <option value="tous">Tous les types</option>
            <option value="Atelier">🎨 Atelier</option>
            <option value="Conférence">🎤 Conférence</option>
            <option value="Sortie">🚶 Sortie</option>
            <option value="Formation">📚 Formation</option>
        </select>
    </div>
    <div class="filter-group">
        <label class="filter-label">
            <i class="fas fa-flag-checkered"></i> Statut
        </label>
        <select class="form-select filter-select" id="filterStatus" onchange="loadEvents()">
            <option value="tous">Tous les statuts</option>
            <option value="planifie">📅 Planifié</option>
            <option value="ouvert">🔓 Ouvert</option>
            <option value="complet">✅ Complet</option>
            <option value="annule">❌ Annulé</option>
        </select>
    </div>
    <div class="filter-group">
        <label class="filter-label">
            <i class="fas fa-calendar-week"></i> Période
        </label>
        <select class="form-select filter-select" id="filterPeriod" onchange="loadEvents()">
            <option value="toutes">Toutes les dates</option>
            <option value="upcoming">À venir</option>
            <option value="past">Passés</option>
            <option value="this_month">Ce mois-ci</option>
            <option value="next_month">Mois prochain</option>
        </select>
    </div>
    <div class="filter-group">
        <label class="filter-label">
            <i class="fas fa-sort-amount-down"></i> Trier par
        </label>
        <select class="form-select filter-select" id="filterSort" onchange="loadEvents()">
            <option value="date_desc">📅 Date (plus récente)</option>
            <option value="date_asc">📅 Date (plus ancienne)</option>
            <option value="titre_asc">📝 Titre (A → Z)</option>
            <option value="titre_desc">📝 Titre (Z → A)</option>
            <option value="capacity_desc">👥 Capacité (max → min)</option>
        </select>
    </div>
</div>

<!-- Filtres actifs -->
<div id="activeFiltersContainer" style="display: none;">
    <div class="active-filters">
        <span class="text-muted me-2"><i class="fas fa-filter"></i> Filtres actifs :</span>
