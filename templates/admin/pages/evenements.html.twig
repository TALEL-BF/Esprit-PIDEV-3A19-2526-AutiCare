// ========== EVENT CRUD OPERATIONS ==========
function attachEventButtons() {
    document.querySelectorAll('.edit-event').forEach(btn => {
        btn.removeEventListener('click', handleEventEditClick);
        btn.addEventListener('click', handleEventEditClick);
    });
    
    document.querySelectorAll('.delete-event').forEach(btn => {
        btn.removeEventListener('click', handleEventDeleteClick);
        btn.addEventListener('click', handleEventDeleteClick);
    });
}

function handleEventEditClick(e) {
    const id = e.currentTarget.getAttribute('data-id');
    loadEventForEdit(id);
}
// ========== LOAD EVENT FOR EDIT ==========
function loadEventForEdit(id) {
    // Check for AI suggestion from sessionStorage
    const suggestField = sessionStorage.getItem('ai_suggest_field');
    const suggestValue = sessionStorage.getItem('ai_suggest_value');
    const suggestPoints = sessionStorage.getItem('ai_suggest_points');
    
    showTempMessage('Chargement de l\'événement...', 'info');
    
    fetch(`/admin/evenements/get/${id}`, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success && data.event) {
            const event = data.event;
            
            // Fill all form fields
            document.getElementById('eventId').value = event.idEvent;
            document.getElementById('eventTitle').value = event.titre || '';
            document.getElementById('eventDescription').value = event.description || '';
            document.getElementById('eventType').value = event.typeEvent || '';
            document.getElementById('eventLocation').value = event.lieu || '';
            document.getElementById('eventCapacity').value = event.maxParticipant || '';
            document.getElementById('eventStartDate').value = event.dateDebut || '';
            document.getElementById('eventStartTime').value = event.heureDebut || '';
            document.getElementById('eventEndDate').value = event.dateFin || '';
            document.getElementById('eventEndTime').value = event.heureFin || '';
            document.getElementById('eventStatus').value = event.status || 'planifie';
            
            // Handle image
            if (event.image && event.image !== '') {
                const currentImageContainer = document.getElementById('currentImageContainer');
                const currentImagePreview = document.getElementById('currentImagePreview');
                const currentImageName = document.getElementById('currentImageName');
                const currentImagePath = document.getElementById('currentImagePath');
                
                let imageFullPath = event.image;
                if (!imageFullPath.startsWith('/') && !imageFullPath.startsWith('http')) {
                    if (imageFullPath.includes('uploads/')) {
                        imageFullPath = '/' + imageFullPath;
                    } else {
                        imageFullPath = '/uploads/events/' + imageFullPath;
                    }
                }
                
                if (currentImagePreview) {
                    currentImagePreview.src = imageFullPath;
                    currentImagePreview.style.display = 'block';
                }
                if (currentImageName) {
                    const fileName = event.image.split('/').pop();
                    currentImageName.textContent = fileName;
                }
                if (currentImagePath) {
                    currentImagePath.value = imageFullPath;
                }
                if (currentImageContainer) {
                    currentImageContainer.style.display = 'block';
                }
                const requiredStar = document.getElementById('imageRequiredStar');
                if (requiredStar) requiredStar.style.display = 'none';
            }
            
            // ========== APPLY SUGGESTIONS ==========
            if (suggestField && suggestValue && suggestField !== 'null' && suggestValue !== 'null') {
                if (suggestField === 'multiple') {
                    // Apply multiple suggestions one by one
                    const multipleSuggestions = JSON.parse(suggestValue);
                    applyMultipleSuggestionsToForm(multipleSuggestions);
                } else {
                    // Apply single suggestion
                    setTimeout(() => {
                        applySuggestionToForm(suggestField, suggestValue, suggestPoints);
                    }, 500);
                }
            }
            
            // Update form mode badge
            const formMode = document.getElementById('formMode');
            if (formMode) {
                if (suggestField && suggestField !== 'null') {
                    formMode.innerHTML = `Mode : Modification <i class="fas fa-edit"></i> <span style="background: #fef3c7; color: #f59e0b; padding: 2px 8px; border-radius: 20px; margin-left: 8px;">✨ Suggestion IA</span>`;
                } else {
                    formMode.innerHTML = `Mode : Modification <i class="fas fa-edit"></i>`;
                }
            }
            
            clearValidationErrors();
            
            // Scroll to form
            document.querySelector('.card-box').scrollIntoView({ behavior: 'smooth', block: 'start' });
            
            showTempMessage('✅ Événement chargé avec succès', 'success');
            
            // Clear session storage after processing
            setTimeout(() => {
                sessionStorage.removeItem('ai_suggest_field');
                sessionStorage.removeItem('ai_suggest_value');
                sessionStorage.removeItem('ai_suggest_points');
                sessionStorage.removeItem('ai_suggest_eventId');
                sessionStorage.removeItem('ai_processing_done');
            }, 10000);
            
        } else {
            showTempMessage('❌ Erreur: Événement non trouvé', 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showTempMessage('❌ Erreur réseau lors du chargement', 'danger');
    });
}
// Apply multiple suggestions one after another with animation
function applyMultipleSuggestionsToForm(suggestions) {
    let currentIndex = 0;
    
    function applyNext() {
        if (currentIndex >= suggestions.length) {
            showTempMessage(`✅ ${suggestions.length} suggestion(s) appliquées avec succès !`, 'success');
            return;
        }
        
        const suggestion = suggestions[currentIndex];
        const fieldMap = {
            'capacite': 'eventCapacity',
            'type': 'eventType',
            'description': 'eventDescription',
            'titre': 'eventTitle',
            'maxParticipant': 'eventCapacity'
        };
        
        const elementId = fieldMap[suggestion.field];
        const inputElement = document.getElementById(elementId);
        
        if (inputElement) {
            const oldValue = inputElement.value;
            
            if (oldValue == suggestion.value) {
                currentIndex++;
                applyNext();
                return;
            }
            
            inputElement.classList.add('ai-highlight');
            inputElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // For SELECT elements (eventType)
            if (inputElement.tagName === 'SELECT') {
                let optionFound = false;
                let matchedValue = null;
                
                for (let i = 0; i < inputElement.options.length; i++) {
                    if (inputElement.options[i].value === suggestion.value) {
                        matchedValue = inputElement.options[i].value;
                        optionFound = true;
                        break;
                    }
                }
                
                if (optionFound) {
                    setTimeout(() => {
                        inputElement.value = matchedValue;
                        const changeEvent = new Event('change', { bubbles: true });
                        inputElement.dispatchEvent(changeEvent);
                        const newDisplayText = inputElement.options[inputElement.selectedIndex]?.textContent || matchedValue;
                        showTempMessage(`✨ ${getFieldName(suggestion.field)} : ${oldValue} → ${newDisplayText} (+${suggestion.points} points)`, 'success');
                        inputElement.classList.remove('ai-highlight');
                        currentIndex++;
                        setTimeout(applyNext, 800);
                    }, 500);
                } else {
                    showAddTypeConfirmPopup(suggestion.value, inputElement, suggestion.field, oldValue, suggestion.points);
                    inputElement.classList.remove('ai-highlight');
                    return;
                }
            }
            // For NUMBER inputs
            else if (inputElement.type === 'number') {
                setTimeout(() => {
                    const startValue = parseInt(oldValue) || 0;
                    const endValue = parseInt(suggestion.value) || 0;
                    const duration = 500;
                    const startTime = performance.now();
                    
                    function animateNumber(currentTime) {
                        const elapsed = currentTime - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const currentValue = Math.round(startValue + (endValue - startValue) * progress);
                        inputElement.value = currentValue;
                        
                        if (progress < 1) {
                            requestAnimationFrame(animateNumber);
                        } else {
                            inputElement.value = endValue;
                            const inputEvent = new Event('input', { bubbles: true });
                            inputElement.dispatchEvent(inputEvent);
                            if (typeof validateField === 'function') {
                                validateField(inputElement, false);
                            }
                            showTempMessage(`✨ ${getFieldName(suggestion.field)} : ${oldValue} → ${suggestion.value} (+${suggestion.points} points)`, 'success');
                            inputElement.classList.remove('ai-highlight');
                            currentIndex++;
                            setTimeout(applyNext, 800);
                        }
                    }
                    requestAnimationFrame(animateNumber);
                }, 100);
            }
            // For TEXT inputs and TEXTAREA
            else {
                // Special handling for description - simplified toast message
                if (suggestion.field === 'description') {
                    inputElement.value = '';
                    let index = 0;
                    const text = suggestion.value.toString();
                    const typingInterval = setInterval(() => {
                        if (index < text.length) {
                            inputElement.value += text[index];
                            index++;
                        } else {
                            clearInterval(typingInterval);
                            if (typeof validateField === 'function') {
                                validateField(inputElement, false);
                            }
                            const inputEvent = new Event('input', { bubbles: true });
                            inputElement.dispatchEvent(inputEvent);
                            showTempMessage(`✨ ${getFieldName(suggestion.field)} mise à jour (+${suggestion.points} points)`, 'success');
                            inputElement.classList.remove('ai-highlight');
                            currentIndex++;
                            setTimeout(applyNext, 800);
                        }
                    }, 30);
                } else {
                    inputElement.value = '';
                    let index = 0;
                    const text = suggestion.value.toString();
                    const typingInterval = setInterval(() => {
                        if (index < text.length) {
                            inputElement.value += text[index];
                            index++;
                        } else {
                            clearInterval(typingInterval);
                            if (typeof validateField === 'function') {
                                validateField(inputElement, false);
                            }
                            const inputEvent = new Event('input', { bubbles: true });
                            inputElement.dispatchEvent(inputEvent);
                            showTempMessage(`✨ ${getFieldName(suggestion.field)} : ${oldValue} → ${suggestion.value} (+${suggestion.points} points)`, 'success');
                            inputElement.classList.remove('ai-highlight');
                            currentIndex++;
                            setTimeout(applyNext, 800);
                        }
                    }, 50);
                }
            }
            
            setTimeout(() => {
                inputElement.classList.remove('ai-highlight');
            }, 2000);
        } else {
            console.warn(`Element not found: ${elementId} for field ${suggestion.field}`);
            currentIndex++;
            applyNext();
        }
    }
    
    applyNext();
}
function applySuggestionToForm(field, value, points) {
    const fieldMap = {
        'capacite': 'eventCapacity',
        'type': 'eventType',
        'description': 'eventDescription',
        'titre': 'eventTitle',
        'maxParticipant': 'eventCapacity'
    };
    
    const elementId = fieldMap[field];
    const inputElement = document.getElementById(elementId);
    
    if (inputElement) {
        const oldValue = inputElement.value;
        
        // Skip if value is the same
        if (oldValue == value) {
            showTempMessage(`ℹ️ ${getFieldName(field)} est déjà à ${value}`, 'info');
            return;
        }
        
        // Highlight
        inputElement.classList.add('ai-highlight');
        inputElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        // For SELECT elements (eventType)
        if (inputElement.tagName === 'SELECT') {
            let optionFound = false;
            let matchedValue = null;
            let matchedText = null;
            
            for (let i = 0; i < inputElement.options.length; i++) {
                if (inputElement.options[i].value === value) {
                    matchedValue = inputElement.options[i].value;
                    matchedText = inputElement.options[i].textContent;
                    optionFound = true;
                    break;
                }
            }
            
            if (!optionFound) {
                showAddTypeConfirmPopup(value, inputElement, field, oldValue, points);
                inputElement.classList.remove('ai-highlight');
                return;
            }
            
            setTimeout(() => {
                inputElement.value = matchedValue;
                const changeEvent = new Event('change', { bubbles: true });
                inputElement.dispatchEvent(changeEvent);
                showTempMessage(`✨ ${getFieldName(field)} : ${oldValue} → ${matchedText} ${points ? `(+${points} points)` : ''}`, 'success');
                inputElement.classList.remove('ai-highlight');
            }, 500);
        }
        // For NUMBER inputs (eventCapacity)
        else if (inputElement.type === 'number') {
            setTimeout(() => {
                const startValue = parseInt(oldValue) || 0;
                const endValue = parseInt(value) || 0;
                const duration = 500;
                const startTime = performance.now();
                
                function animateNumber(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const currentValue = Math.round(startValue + (endValue - startValue) * progress);
                    inputElement.value = currentValue;
                    
                    if (progress < 1) {
                        requestAnimationFrame(animateNumber);
                    } else {
                        inputElement.value = endValue;
                        const inputEvent = new Event('input', { bubbles: true });
                        inputElement.dispatchEvent(inputEvent);
                        if (typeof validateField === 'function') {
                            validateField(inputElement, false);
                        }
                        showTempMessage(`✨ ${getFieldName(field)} : ${oldValue} → ${value} ${points ? `(+${points} points)` : ''}`, 'success');
                        inputElement.classList.remove('ai-highlight');
                    }
                }
                requestAnimationFrame(animateNumber);
            }, 100);
        }
        // For TEXT inputs and TEXTAREA
        else {
            // Special handling for description - simplified toast message
            if (field === 'description') {
                inputElement.value = '';
                let index = 0;
                const text = value.toString();
                const typingInterval = setInterval(() => {
                    if (index < text.length) {
                        inputElement.value += text[index];
                        index++;
                    } else {
                        clearInterval(typingInterval);
                        if (typeof validateField === 'function') {
                            validateField(inputElement, false);
                        }
                        const inputEvent = new Event('input', { bubbles: true });
                        inputElement.dispatchEvent(inputEvent);
                        // Simplified message for description
                        showTempMessage(`✨ ${getFieldName(field)} mise à jour ${points ? `(+${points} points)` : ''}`, 'success');
                        inputElement.classList.remove('ai-highlight');
                    }
                }, 30);
            } else {
                // For title and other text fields - show full before/after
                inputElement.value = '';
                let index = 0;
                const text = value.toString();
                const typingInterval = setInterval(() => {
                    if (index < text.length) {
                        inputElement.value += text[index];
                        index++;
                    } else {
                        clearInterval(typingInterval);
                        if (typeof validateField === 'function') {
                            validateField(inputElement, false);
                        }
                        const inputEvent = new Event('input', { bubbles: true });
                        inputElement.dispatchEvent(inputEvent);
                        showTempMessage(`✨ ${getFieldName(field)} : ${oldValue} → ${value} ${points ? `(+${points} points)` : ''}`, 'success');
                        inputElement.classList.remove('ai-highlight');
                    }
                }, 50);
            }
        }
        
        setTimeout(() => {
            inputElement.classList.remove('ai-highlight');
        }, 2000);
    } else {
        console.warn(`Element not found: ${elementId} for field ${field}`);
        showTempMessage(`⚠️ Champ ${getFieldName(field)} non trouvé`, 'warning');
    }
}

// Show confirmation popup to add new event type
function showAddTypeConfirmPopup(newType, inputElement, field, oldValue, points) {
    console.log('showAddTypeConfirmPopup called with:', newType);
    
    let overlay = document.getElementById('addTypeOverlay');
    if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'addTypeOverlay';
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10001;
        `;
        document.body.appendChild(overlay);
    }
    
    overlay.innerHTML = `
        <div style="background: white; border-radius: 24px; padding: 25px; width: 400px; max-width: 90%; text-align: center; animation: slideDown 0.3s ease;">
            <div style="font-size: 48px; margin-bottom: 15px;">🤔</div>
            <h3 style="margin: 0 0 10px 0; color: #1f2937;">Nouveau type d'événement</h3>
            <p style="margin: 0 0 10px 0; color: #6b7280;">
                Le type "<strong style="color: #a855f7;">${escapeHtml(newType)}</strong>" n'existe pas encore.
            </p>
            <p style="margin: 0 0 20px 0; color: #6b7280; font-size: 0.9rem;">
                Voulez-vous l'ajouter à la liste ?
            </p>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button id="confirmAddTypeBtn" style="background: linear-gradient(135deg, #a855f7, #e879f9); color: white; border: none; padding: 10px 24px; border-radius: 40px; cursor: pointer; font-weight: 600;">
                    ✅ Oui, ajouter
                </button>
                <button id="cancelAddTypeBtn" style="background: #f3f4f6; color: #374151; border: none; padding: 10px 24px; border-radius: 40px; cursor: pointer; font-weight: 600;">
                    ❌ Non, ignorer
                </button>
            </div>
        </div>
    `;
    
    overlay.style.display = 'flex';
    
    document.getElementById('confirmAddTypeBtn').onclick = function() {
        addNewEventType(newType, inputElement, field, oldValue, points);
        overlay.remove();
    };
    
    document.getElementById('cancelAddTypeBtn').onclick = function() {
        overlay.remove();
        showTempMessage(`💡 Suggestion ignorée pour "${newType}"`, 'info');
        inputElement.classList.remove('ai-highlight');
    };
    
    overlay.onclick = function(e) {
        if (e.target === overlay) {
            overlay.remove();
            inputElement.classList.remove('ai-highlight');
        }
    };
}


// Add new event type to database and select it
function addNewEventType(newType, inputElement, field, oldValue, points) {
    console.log('addNewEventType called with:', newType);
    showTempMessage('📝 Ajout du nouveau type...', 'info');
    
    fetch('/admin/evenements/add-event-type', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ type: newType })
    })
    .then(response => response.json())
    .then(data => {
        console.log('Response:', data);
        if (data.success) {
            let emoji = '📌';
            const typeLower = newType.toLowerCase();
            if (typeLower.includes('atelier')) emoji = '🎨';
            else if (typeLower.includes('conférence')) emoji = '🎤';
            else if (typeLower.includes('sortie')) emoji = '🚶';
            else if (typeLower.includes('formation')) emoji = '📚';
            else if (typeLower.includes('en ligne') || typeLower.includes('web')) emoji = '💻';
            
            const newOption = document.createElement('option');
            newOption.value = newType;
            newOption.textContent = `${emoji} ${newType}`;
            inputElement.appendChild(newOption);
            
            inputElement.value = newType;
            const changeEvent = new Event('change', { bubbles: true });
            inputElement.dispatchEvent(changeEvent);
            
            showTempMessage(`✨ Nouveau type "${newType}" ajouté et sélectionné ! ${points ? `(+${points} points)` : ''}`, 'success');
            inputElement.classList.remove('ai-highlight');
        } else {
            showTempMessage(`⚠️ Impossible d'ajouter le type "${newType}"`, 'warning');
            inputElement.classList.remove('ai-highlight');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showTempMessage(`⚠️ Erreur lors de l'ajout du type`, 'warning');
        inputElement.classList.remove('ai-highlight');
    });
}
