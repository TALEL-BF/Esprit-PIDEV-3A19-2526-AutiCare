</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ========== VARIABLES ==========
let pendingDeleteId = null;
let pendingDeleteRow = null;
let pendingDeleteTitle = null;

// ========== UTILITY FUNCTIONS ==========
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function showTempMessage(message, type) {
    const toast = document.createElement('div');
    toast.className = `alert alert-${type} toast-notification`;
    toast.innerHTML = `
        <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
        ${message}
        <button type="button" class="btn-close float-end" onclick="this.parentElement.remove()">&times;</button>
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

function copyImagePath() {
    const pathInput = document.getElementById('currentImagePath');
    if (pathInput && pathInput.value) {
        pathInput.select();
        document.execCommand('copy');
        showTempMessage('✅ Chemin copié !', 'success');
    }
}

// ========== VALIDATION RULES ==========
const validationRules = {
    eventTitle: {
        required: true,
        minLength: 3,
        maxLength: 100,
        message: 'Le titre doit contenir entre 3 et 100 caractères'
    },
    eventDescription: {
        required: true,
        minLength: 10,
        maxLength: 500,
        message: 'La description doit contenir entre 10 et 500 caractères'
    },
    eventLocation: {
        required: true,
        minLength: 2,
        maxLength: 200,
        message: 'Le lieu doit contenir entre 2 et 200 caractères'
    },
    eventCapacity: {
        required: true,
        minValue: 1,
        maxValue: 10000,
        message: 'La capacité doit être entre 1 et 10,000 participants'
    },
    eventType: {
        required: true,
        message: 'Veuillez sélectionner un type d\'événement'
    },
    eventStartDate: {
        required: true,
        message: 'La date de début est obligatoire'
    },
    eventStartTime: {
        required: true,
        message: 'L\'heure de début est obligatoire'
    }
};

// ========== FIELD VALIDATION FUNCTIONS ==========
function showFieldMessage(inputId, message, isValid) {
    let errorDiv = document.getElementById(`${inputId}_error`);
    if (!errorDiv) {
        const input = document.getElementById(inputId);
        if (input && input.parentNode) {
            errorDiv = document.createElement('div');
            errorDiv.id = `${inputId}_error`;
            errorDiv.className = 'form-error';
            input.parentNode.appendChild(errorDiv);
        }
    }
    if (errorDiv) {
        errorDiv.innerHTML = `<i class="fas ${isValid ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
        errorDiv.className = `form-error ${isValid ? 'success-message' : 'error-message'}`;
        errorDiv.style.display = 'block';
    }
}

function hideFieldMessage(inputId) {
    const errorDiv = document.getElementById(`${inputId}_error`);
    if (errorDiv) errorDiv.style.display = 'none';
}

function validateField(input, isBlur = false) {
    const fieldName = input.id;
    const rules = validationRules[fieldName];
    if (!rules) return true;
    
    const value = input.value.trim();
    let isValid = true;
    let errorMessage = '';
    
    if (rules.required && !value) {
        isValid = false;
        errorMessage = rules.message;
    }
    else if (value) {
        if (rules.minLength && value.length < rules.minLength) {
            isValid = false;
            errorMessage = rules.message;
        }
        else if (rules.maxLength && value.length > rules.maxLength) {
            isValid = false;
            errorMessage = rules.message;
        }
        else if (rules.minValue && parseFloat(value) < rules.minValue) {
            isValid = false;
            errorMessage = rules.message;
        }
        else if (rules.maxValue && parseFloat(value) > rules.maxValue) {
            isValid = false;
            errorMessage = rules.message;
        }
        else {
            errorMessage = '✓ Champ valide';
        }
    }
    
    if (!isValid) {
        showFieldMessage(fieldName, errorMessage, false);
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
    } 
    else if (value.length > 0 || (rules.required && value)) {
        if (!isBlur) {
            showFieldMessage(fieldName, errorMessage, true);
            input.classList.add('is-valid');
            input.classList.remove('is-invalid');
        } else {
            hideFieldMessage(fieldName);
            input.classList.remove('is-invalid', 'is-valid');
        }
    } 
    else {
        hideFieldMessage(fieldName);
        input.classList.remove('is-invalid', 'is-valid');
    }
    
    return isValid;
}

// ========== DATE VALIDATION ==========
function validateDates() {
    const startDate = document.getElementById('eventStartDate').value;
    const endDate = document.getElementById('eventEndDate').value;
    const startTime = document.getElementById('eventStartTime').value;
    const endTime = document.getElementById('eventEndTime').value;
    
    let isValid = true;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    if (startDate) {
        const startDateObj = new Date(startDate);
        if (startDateObj < today) {
            showFieldMessage('eventStartDate', '❌ La date de début ne peut pas être dans le passé', false);
            document.getElementById('eventStartDate').classList.add('is-invalid');
            isValid = false;
        } else {
            hideFieldMessage('eventStartDate');
            document.getElementById('eventStartDate').classList.remove('is-invalid');
            document.getElementById('eventStartDate').classList.add('is-valid');
        }
    }
    
    if (endDate) {
        const endDateObj = new Date(endDate);
        if (endDateObj < today) {
            showFieldMessage('eventEndDate', '❌ La date de fin ne peut pas être dans le passé', false);
            document.getElementById('eventEndDate').classList.add('is-invalid');
            isValid = false;
        } else {
            hideFieldMessage('eventEndDate');
            document.getElementById('eventEndDate').classList.remove('is-invalid');
            if (endDate) document.getElementById('eventEndDate').classList.add('is-valid');
        }
    }
    
    if (startDate && endDate) {
        const startDateObj = new Date(startDate);
        const endDateObj = new Date(endDate);
        if (endDateObj < startDateObj) {
            showFieldMessage('eventEndDate', '❌ La date de fin doit être après la date de début', false);
            document.getElementById('eventEndDate').classList.add('is-invalid');
            isValid = false;
        }
    }
    
    if (startDate && endDate && startDate === endDate && startTime && endTime) {
        if (endTime <= startTime) {
            showFieldMessage('eventEndTime', '❌ L\'heure de fin doit être après l\'heure de début pour le même jour', false);
            document.getElementById('eventEndTime').classList.add('is-invalid');
            isValid = false;
        } else {
            hideFieldMessage('eventEndTime');
            document.getElementById('eventEndTime').classList.remove('is-invalid');
            document.getElementById('eventEndTime').classList.add('is-valid');
        }
    }
    
    if (startTime && !startTime.match(/^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/)) {
        showFieldMessage('eventStartTime', '❌ Format d\'heure invalide', false);
        document.getElementById('eventStartTime').classList.add('is-invalid');
        isValid = false;
    } else if (startTime) {
        hideFieldMessage('eventStartTime');
        document.getElementById('eventStartTime').classList.remove('is-invalid');
        document.getElementById('eventStartTime').classList.add('is-valid');
    }
    
    return isValid;
}

// ========== IMAGE VALIDATION ==========
function validateImageFile(isBlur = false) {
    const imageInput = document.getElementById('eventImage');
    const currentImageContainer = document.getElementById('currentImageContainer');
    const eventId = document.getElementById('eventId').value;
    const isEditMode = eventId && eventId !== '';
    const hasExistingImage = currentImageContainer && currentImageContainer.style.display === 'block';
    
    let errorDiv = document.getElementById('imageError');
    if (!errorDiv && imageInput) {
        const newErrorDiv = document.createElement('div');
        newErrorDiv.id = 'imageError';
        newErrorDiv.className = 'form-error';
        imageInput.parentNode.appendChild(newErrorDiv);
        errorDiv = document.getElementById('imageError');
    }
    
    if (isEditMode && hasExistingImage) {
        if (errorDiv) errorDiv.style.display = 'none';
        if (imageInput) {
            imageInput.classList.remove('is-invalid', 'is-valid');
        }
        const requiredStar = document.getElementById('imageRequiredStar');
        if (requiredStar) requiredStar.style.display = 'none';
        return true;
    }
    
    const requiredStar = document.getElementById('imageRequiredStar');
    if (requiredStar) requiredStar.style.display = 'inline';
    
    if (!imageInput || !imageInput.files || imageInput.files.length === 0) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ❌ Une image est obligatoire pour l'événement`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        if (imageInput) {
            imageInput.classList.add('is-invalid');
            imageInput.classList.remove('is-valid');
        }
        return false;
    }
    
    const file = imageInput.files[0];
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
    const maxSize = 2 * 1024 * 1024;
    
    if (!allowedTypes.includes(file.type)) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> Format non supporté. Utilisez JPG, PNG ou GIF.`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        imageInput.classList.add('is-invalid');
        imageInput.classList.remove('is-valid');
        return false;
    }
    
    if (file.size > maxSize) {
        if (errorDiv) {
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> L'image ne doit pas dépasser 2MB. (${(file.size / 1024 / 1024).toFixed(2)}MB)`;
            errorDiv.className = 'form-error error-message';
            errorDiv.style.display = 'block';
        }
        imageInput.classList.add('is-invalid');
        imageInput.classList.remove('is-valid');
        return false;
    }
    
    if (errorDiv) {
        errorDiv.innerHTML = `<i class="fas fa-check-circle"></i> ✓ Image valide (${(file.size / 1024).toFixed(0)}KB)`;
        errorDiv.className = 'form-error success-message';
        errorDiv.style.display = 'block';
    }
    if (!isBlur) {
        imageInput.classList.add('is-valid');
        imageInput.classList.remove('is-invalid');
    }
    return true;
}

// ========== COMPLETE FORM VALIDATION ==========
function validateFormForSubmit() {
    let isValid = true;
    
    const fieldsToValidate = ['eventTitle', 'eventDescription', 'eventLocation', 'eventCapacity', 'eventType', 'eventStartDate', 'eventStartTime'];
    for (const fieldId of fieldsToValidate) {
        const input = document.getElementById(fieldId);
        if (input && !validateField(input, false)) {
            isValid = false;
        }
    }
    
    if (!validateDates()) {
        isValid = false;
    }
    
    const eventId = document.getElementById('eventId').value;
    const isEditMode = eventId && eventId !== '';
    const hasExistingImage = document.getElementById('currentImageContainer')?.style.display === 'block';
    
    if (!isEditMode || !hasExistingImage) {
        if (!validateImageFile(false)) {
            isValid = false;
        }
    }
    
    return isValid;
}

// ========== CLEAR VALIDATION ==========
function clearValidationErrors() {
    const feedbackMessages = document.querySelectorAll('.form-error');
    feedbackMessages.forEach(msg => msg.remove());
    
    const invalidInputs = document.querySelectorAll('.is-invalid, .is-valid');
    invalidInputs.forEach(input => {
        input.classList.remove('is-invalid', 'is-valid');
    });
}

// ========== RESET FORM ==========
function resetEventForm() {
    document.getElementById('eventForm').reset();
    document.getElementById('eventId').value = '';
    document.getElementById('formMode').textContent = 'Mode : Ajout';
    
    clearValidationErrors();
    
    const imageInput = document.getElementById('eventImage');
    if (imageInput) {
        imageInput.value = '';
        imageInput.classList.remove('is-invalid', 'is-valid');
    }
    
    const errorDiv = document.getElementById('imageError');
    if (errorDiv) {
        errorDiv.style.display = 'none';
        errorDiv.innerHTML = '';
    }
    
    const imageContainer = document.getElementById('currentImageContainer');
    if (imageContainer) {
        imageContainer.style.display = 'none';
        const imagePreview = document.getElementById('currentImagePreview');
        const imageNameSpan = document.getElementById('currentImageName');
        const imagePathInput = document.getElementById('currentImagePath');
        if (imagePreview) imagePreview.src = '';
        if (imageNameSpan) imageNameSpan.textContent = '';
        if (imagePathInput) imagePathInput.value = '';
    }
    
    const requiredStar = document.getElementById('imageRequiredStar');
    if (requiredStar) requiredStar.style.display = 'inline';
}

// ========== LOAD EVENTS ==========
function loadEvents() {
    const searchTerm = document.getElementById('smartSearch')?.value || '';
    const type = document.getElementById('filterType')?.value || 'tous';
    const status = document.getElementById('filterStatus')?.value || 'tous';
    const period = document.getElementById('filterPeriod')?.value || 'toutes';
    const sortBy = document.getElementById('filterSort')?.value || 'date_desc';
    
    const loadingIndicator = document.getElementById('loadingIndicator');
    const tableBody = document.getElementById('eventTableBody');
    
    if (loadingIndicator) loadingIndicator.style.display = 'block';
    
    const formData = new URLSearchParams();
    formData.append('search', searchTerm);
    formData.append('type', type);
    formData.append('status', status);
    formData.append('period', period);
    formData.append('sortBy', sortBy);
    
    fetch('{{ path('admin_evenements_search') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: formData.toString()
    })
    .then(response => response.json())
    .then(data => {
        const resultCount = document.getElementById('resultCount');
        if (resultCount) resultCount.textContent = data.total || 0;
        
        if (tableBody) {
            if (!data.events || data.events.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 40px;">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted">Aucun événement trouvé</p>
                            <small>Essayez d'autres critères</small>
                        </td>
                    </tr>
                `;
            } else {
                tableBody.innerHTML = data.events.map((event, index) => {
                    let statusBadge = '';
                    switch(event.status) {
                        case 'planifie': statusBadge = '<span class="badge-grey" style="background:#fff5e0; color:#b45309;">📅 Planifié</span>'; break;
                        case 'ouvert': statusBadge = '<span class="badge-grey" style="background:#e0f5e8; color:#2d6a4f;">🔓 Ouvert</span>'; break;
                        case 'complet': statusBadge = '<span class="badge-grey" style="background:#f8e4f0; color:#c92a2a;">✅ Complet</span>'; break;
                        case 'annule': statusBadge = '<span class="badge-grey" style="background:#e5e7eb; color:#6b7280;">❌ Annulé</span>'; break;
                        default: statusBadge = '<span class="badge-grey">' + event.status + '</span>';
                    }
                    
                    const dateTimeStr = event.dateDebut ? 
                        `${event.dateDebut} à ${event.heureDebut || '--:--'}` : 
                        'Date non définie';
                    
                    return `
                        <tr>
                            <td>${index + 1}</td>
                         
<td>
    ${event.imagePath && event.imagePath !== '' ? 
        `<img src="${event.imagePath}" alt="${event.titre}" class="event-image" style="width:50px;height:50px;object-fit:cover;border-radius:10px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'event-image-placeholder\'><i class=\'fas fa-calendar-alt\'></i></div>'">` : 
        `<div class="event-image-placeholder"><i class="fas fa-calendar-alt"></i></div>`
    }
</td>
                            <td><strong>${escapeHtml(event.titre)}</strong><br><small>${escapeHtml(event.description ? event.description.substring(0, 50) : '')}</small></td>
                            <td><span class="badge-grey">${escapeHtml(event.typeEvent || 'Non défini')}</span></td>
                            <td>${dateTimeStr}</td>
                            <td>${escapeHtml(event.lieu || '-')}</td>
                            <td><strong>${(event.maxParticipant || 0).toLocaleString()}</strong></td>
                            <td>${statusBadge}</td>
                            <td><span class="badge-grey"><i class="fas fa-handshake"></i> ${event.sponsorCount || 0}</span></td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-event" data-id="${event.idEvent}"><i class="fas fa-edit"></i> Modifier</button>
                                <button class="btn-danger-soft delete-event" data-id="${event.idEvent}"><i class="fas fa-trash"></i> Supprimer</button>
                            </td>
                        </tr>
                    `;
                }).join('');
                
                attachEventButtons();
            }
        }
        
        updateActiveFilters(type, status, period, sortBy, searchTerm);
        
        if (loadingIndicator) loadingIndicator.style.display = 'none';
    })
    .catch(error => {
        console.error('Erreur:', error);
        if (loadingIndicator) loadingIndicator.style.display = 'none';
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="10" style="text-align: center; color: red; padding: 40px;">
                        <i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>
                        Erreur lors du chargement des données
                    </td>
                </tr>
            `;
        }
    });
}

function updateActiveFilters(type, status, period, sortBy, search) {
    const container = document.getElementById('activeFiltersContainer');
    const listElement = document.getElementById('activeFiltersList');
    
    const activeFilters = [];
    
    if (type && type !== 'tous') activeFilters.push(`<span class="badge-grey"><i class="fas fa-tag"></i> Type: ${type}</span>`);
    if (status && status !== 'tous') activeFilters.push(`<span class="badge-grey"><i class="fas fa-flag"></i> Statut: ${status}</span>`);
    if (period && period !== 'toutes') {
        const periodLabels = {
            'upcoming': 'À venir',
            'past': 'Passés',
            'this_month': 'Ce mois-ci',
            'next_month': 'Mois prochain'
        };
        activeFilters.push(`<span class="badge-grey"><i class="fas fa-calendar"></i> Période: ${periodLabels[period] || period}</span>`);
    }
    if (sortBy && sortBy !== 'date_desc') {
        const sortLabels = {
            'date_asc': 'Tri: Date ancienne',
            'titre_asc': 'Tri: Titre A→Z',
            'titre_desc': 'Tri: Titre Z→A',
            'capacity_desc': 'Tri: Capacité max'
        };
        activeFilters.push(`<span class="badge-grey"><i class="fas fa-sort"></i> ${sortLabels[sortBy] || sortBy}</span>`);
    }
    if (search && search.trim() !== '') activeFilters.push(`<span class="badge-grey"><i class="fas fa-search"></i> Recherche: "${escapeHtml(search)}"</span>`);
    
    if (activeFilters.length > 0) {
        container.style.display = 'block';
        listElement.innerHTML = activeFilters.join(' ');
    } else {
        container.style.display = 'none';
    }
}

// ========== RESET FUNCTIONS ==========
function resetSearch() {
    document.getElementById('smartSearch').value = '';
    loadEvents();
}

function resetAllFilters() {
    const filterType = document.getElementById('filterType');
    const filterStatus = document.getElementById('filterStatus');
    const filterPeriod = document.getElementById('filterPeriod');
    const filterSort = document.getElementById('filterSort');
    const smartSearch = document.getElementById('smartSearch');
    
    if (filterType) filterType.value = 'tous';
    if (filterStatus) filterStatus.value = 'tous';
    if (filterPeriod) filterPeriod.value = 'toutes';
    if (filterSort) filterSort.value = 'date_desc';
    if (smartSearch) smartSearch.value = '';
    
    loadEvents();
}

// ========== EVENT CRUD OPERATIONS ==========
function attachEventButtons() {
    document.querySelectorAll('.edit-event').forEach(btn => {
        btn.removeEventListener('click', handleEventEditClick);
        btn.addEventListener('click', handleEventEditClick);
    });
    
    document.querySelectorAll('.delete-event').forEach(btn => {
        btn.removeEventListener('click', handleEventDeleteClick);
        btn.addEventListener('click', handleEventDeleteClick);
    });
}

function handleEventEditClick(e) {
    const id = e.currentTarget.getAttribute('data-id');
    loadEventForEdit(id);
}
// ========== LOAD EVENT FOR EDIT ==========
function loadEventForEdit(id) {
    showTempMessage('Chargement de l\'événement...', 'info');
    
    fetch(`/admin/evenements/get/${id}`, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success && data.event) {
            const event = data.event;
            
            // Remplir le formulaire
            document.getElementById('eventId').value = event.idEvent;
            document.getElementById('eventTitle').value = event.titre || '';
            document.getElementById('eventDescription').value = event.description || '';
            document.getElementById('eventType').value = event.typeEvent || '';
            document.getElementById('eventLocation').value = event.lieu || '';
            document.getElementById('eventCapacity').value = event.maxParticipant || '';
            document.getElementById('eventStartDate').value = event.dateDebut || '';
            document.getElementById('eventStartTime').value = event.heureDebut || '';
            document.getElementById('eventEndDate').value = event.dateFin || '';
            document.getElementById('eventEndTime').value = event.heureFin || '';
            document.getElementById('eventStatus').value = event.status || 'planifie';
            
            // AFFICHER L'IMAGE EXISTANTE
            if (event.image && event.image !== '') {
                const currentImageContainer = document.getElementById('currentImageContainer');
                const currentImagePreview = document.getElementById('currentImagePreview');
                const currentImageName = document.getElementById('currentImageName');
                const currentImagePath = document.getElementById('currentImagePath');
                
                // Construire le chemin correct de l'image
                let imageFullPath = event.image;
                if (!imageFullPath.startsWith('/') && !imageFullPath.startsWith('http')) {
                    imageFullPath = '/uploads/events/' + imageFullPath;
                }
                
                if (currentImagePreview) currentImagePreview.src = imageFullPath;
                if (currentImageName) currentImageName.textContent = event.image;
                if (currentImagePath) currentImagePath.value = imageFullPath;
                if (currentImageContainer) currentImageContainer.style.display = 'block';
            } else {
                document.getElementById('currentImageContainer').style.display = 'none';
            }
            
            // Changer le mode du formulaire
            document.getElementById('formMode').innerHTML = `Mode : Modification <i class="fas fa-edit"></i>`;
            
            // Cacher l'étoile rouge pour l'image (optionnel en modification)
            const requiredStar = document.getElementById('imageRequiredStar');
            if (requiredStar) requiredStar.style.display = 'none';
            
            // Supprimer les messages d'erreur existants
            clearValidationErrors();
            
            // Scroller vers le formulaire
            document.querySelector('.card-box').scrollIntoView({ behavior: 'smooth', block: 'start' });
            
            showTempMessage('Événement chargé pour modification', 'success');
        } else {
            showTempMessage('Erreur lors du chargement de l\'événement', 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showTempMessage('Erreur réseau lors du chargement', 'danger');
    });
}

function handleEventDeleteClick(e) {
    const id = e.currentTarget.getAttribute('data-id');
    const row = e.currentTarget.closest('tr');
    const title = row.querySelector('td:nth-child(3) strong').textContent;
    
    pendingDeleteId = id;
    pendingDeleteRow = row;
    pendingDeleteTitle = title;  // ← ICI title est bien défini
    
    document.getElementById('deleteMessage').innerHTML = `Êtes-vous sûr de vouloir supprimer <strong>"${title}"</strong> ?<br>Cette action est irréversible.`;
    document.getElementById('deleteConfirmPopup').style.display = 'flex';
}

function loadEvents() {
    const searchTerm = document.getElementById('smartSearch')?.value || '';
    const type = document.getElementById('filterType')?.value || 'tous';
    const status = document.getElementById('filterStatus')?.value || 'tous';
    const period = document.getElementById('filterPeriod')?.value || 'toutes';
    const sortBy = document.getElementById('filterSort')?.value || 'date_desc';
    
    const loadingIndicator = document.getElementById('loadingIndicator');
    const tableBody = document.getElementById('eventTableBody');
    
    if (loadingIndicator) loadingIndicator.style.display = 'block';
    
    const formData = new URLSearchParams();
    formData.append('search', searchTerm);
    formData.append('type', type);
    formData.append('status', status);
    formData.append('period', period);
    formData.append('sortBy', sortBy);
    
    fetch('{{ path('admin_evenements_search') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: formData.toString()
    })
    .then(response => response.json())
    .then(data => {
        const resultCount = document.getElementById('resultCount');
        if (resultCount) resultCount.textContent = data.total || 0;
        
        if (tableBody) {
            if (!data.events || data.events.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="10" style="text-align: center; padding: 40px;">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted">Aucun événement trouvé</p>
                            <small>Essayez d'autres critères</small>
                        </td>
                    </tr>
                `;
            } else {
                tableBody.innerHTML = data.events.map((event, index) => {
                    let statusBadge = '';
                    switch(event.status) {
                        case 'planifie': statusBadge = '<span class="badge-grey" style="background:#fff5e0; color:#b45309;">📅 Planifié</span>'; break;
                        case 'ouvert': statusBadge = '<span class="badge-grey" style="background:#e0f5e8; color:#2d6a4f;">🔓 Ouvert</span>'; break;
                        case 'complet': statusBadge = '<span class="badge-grey" style="background:#f8e4f0; color:#c92a2a;">✅ Complet</span>'; break;
                        case 'annule': statusBadge = '<span class="badge-grey" style="background:#e5e7eb; color:#6b7280;">❌ Annulé</span>'; break;
                        default: statusBadge = '<span class="badge-grey">' + event.status + '</span>';
                    }
                    
                    const dateTimeStr = event.dateDebut ? 
                        `${event.dateDebut} à ${event.heureDebut || '--:--'}` : 
                        'Date non définie';
                    
                    //  CORRECTION IMAGE - Utiliser event.imagePath directement
                    let imageHtml = '';
                    if (event.imagePath && event.imagePath !== '') {
                        imageHtml = `<img src="${event.imagePath}" alt="${event.titre}" class="event-image" style="width:50px;height:50px;object-fit:cover;border-radius:10px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'event-image-placeholder\'><i class=\'fas fa-calendar-alt\'></i></div>'">`;
                    } else if (event.image && event.image !== '') {
                        imageHtml = `<img src="/uploads/events/${event.image}" alt="${event.titre}" class="event-image" style="width:50px;height:50px;object-fit:cover;border-radius:10px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'event-image-placeholder\'><i class=\'fas fa-calendar-alt\'></i></div>'">`;
                    } else {
                        imageHtml = `<div class="event-image-placeholder"><i class="fas fa-calendar-alt"></i></div>`;
                    }
                    
                    return `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${imageHtml}</td>
                            <td><strong>${escapeHtml(event.titre)}</strong><br><small>${escapeHtml(event.description ? event.description.substring(0, 50) : '')}</small></td>
                            <td><span class="badge-grey">${escapeHtml(event.typeEvent || 'Non défini')}</span></td>
                            <td>${dateTimeStr}</td>
                            <td>${escapeHtml(event.lieu || '-')}</td>
                            <td><strong>${(event.maxParticipant || 0).toLocaleString()}</strong></td>
                            <td>${statusBadge}</td>
                            <td><span class="badge-grey"><i class="fas fa-handshake"></i> ${event.sponsorCount || 0}</span></td>
                            <td>
                                <button class="btn-edit-soft me-1 edit-event" data-id="${event.idEvent}"><i class="fas fa-edit"></i> Modifier</button>
                                <button class="btn-danger-soft delete-event" data-id="${event.idEvent}"><i class="fas fa-trash"></i> Supprimer</button>
                            </td>
                        </tr>
                    `;
                }).join('');
                
                attachEventButtons();
            }
        }
        
        updateActiveFilters(type, status, period, sortBy, searchTerm);
        
        if (loadingIndicator) loadingIndicator.style.display = 'none';
    })
    .catch(error => {
        console.error('Erreur:', error);
        if (loadingIndicator) loadingIndicator.style.display = 'none';
        if (tableBody) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="10" style="text-align: center; color: red; padding: 40px;">
                        <i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>
                        Erreur lors du chargement des données
                    </td>
                </tr>
            `;
        }
    });
}
// ========== POPUP FUNCTIONS ==========
function showConfirmPopup() {
    if (!validateFormForSubmit()) {
        showTempMessage('Veuillez corriger les erreurs dans le formulaire', 'danger');
        return;
    }
    
    const eventTitle = document.getElementById('eventTitle').value;
    if (!eventTitle) {
        showTempMessage('Veuillez remplir le titre de l\'événement', 'danger');
        return;
    }
    document.getElementById('confirmPopup').style.display = 'flex';
}

function closePopup() {
    document.getElementById('confirmPopup').style.display = 'none';
}

function closeDeletePopup() {
    document.getElementById('deleteConfirmPopup').style.display = 'none';
    pendingDeleteId = null;
    pendingDeleteRow = null;
    pendingDeleteTitle = null;
}

function submitEventForm() {
    closePopup();
    
    if (!validateFormForSubmit()) {
        showTempMessage('Veuillez corriger les erreurs dans le formulaire', 'danger');
        return;
    }
    
    const form = document.getElementById('eventForm');
    const formData = new FormData(form);
    const eventId = document.getElementById('eventId').value;
    const isEditMode = eventId && eventId !== '';
    const url = isEditMode ? '{{ path('admin_evenements_update') }}' : '{{ path('admin_evenements_add') }}';
    
    showTempMessage('Enregistrement en cours...', 'info');
    
    fetch(url, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showTempMessage(data.message || (isEditMode ? '✅ Événement modifié avec succès !' : '✅ Événement ajouté avec succès !'), 'success');
            resetEventForm();
            loadEvents();
        } else if (data.errors) {
            let errorHtml = '';
            for (const error of data.errors) {
                errorHtml += `<div class="alert alert-danger mb-2"><i class="fas fa-exclamation-circle"></i> ${escapeHtml(error)}</div>`;
            }
            const formContainer = document.querySelector('.card-box-body');
            const existingAlert = formContainer.querySelector('.alert-danger');
            if (existingAlert) existingAlert.remove();
            formContainer.insertAdjacentHTML('afterbegin', errorHtml);
            showTempMessage('Veuillez corriger les erreurs', 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showTempMessage('Erreur lors de l\'enregistrement', 'danger');
    });
}

// ========== DELETE EVENT ==========
// ========== DELETE EVENT ==========
document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
    if (pendingDeleteId) {
        // Sauvegarder le titre localement avant la suppression
        const titleToDelete = pendingDeleteTitle;
        
        fetch('{{ path('admin_evenements_delete') }}', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id: pendingDeleteId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeDeletePopup();
                // Utiliser la variable sauvegardée
                showTempMessage(`✅ "${titleToDelete}" a été supprimé avec succès !`, 'success');
                loadEvents();
                resetEventForm();
            } else {
                showTempMessage('❌ Erreur: ' + (data.error || 'Impossible de supprimer cet événement'), 'danger');
                closeDeletePopup();
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            showTempMessage('Erreur lors de la suppression', 'danger');
            closeDeletePopup();
        });
    }
});

// ========== INITIALIZATION ==========
document.addEventListener('DOMContentLoaded', function() {
    const fieldsToValidate = ['eventTitle', 'eventDescription', 'eventLocation', 'eventCapacity', 'eventType', 'eventStartDate', 'eventStartTime'];
    
    fieldsToValidate.forEach(fieldId => {
        const input = document.getElementById(fieldId);
        if (input) {
            if (!document.getElementById(`${fieldId}_error`)) {
                const errorDiv = document.createElement('div');
                errorDiv.id = `${fieldId}_error`;
                errorDiv.className = 'form-error';
                input.parentNode.appendChild(errorDiv);
            }
            
            input.addEventListener('focus', function() { validateField(this, false); });
            input.addEventListener('input', function() { validateField(this, false); });
            input.addEventListener('blur', function() { validateField(this, true); });
        }
    });
    
    const dateFields = ['eventStartDate', 'eventEndDate', 'eventStartTime', 'eventEndTime'];
    dateFields.forEach(fieldId => {
        const input = document.getElementById(fieldId);
        if (input) {
            if (!document.getElementById(`${fieldId}_error`)) {
                const errorDiv = document.createElement('div');
                errorDiv.id = `${fieldId}_error`;
                errorDiv.className = 'form-error';
                input.parentNode.appendChild(errorDiv);
            }
            
            input.addEventListener('change', function() { validateDates(); });
            input.addEventListener('input', function() { validateDates(); });
        }
    });
    
    const imageInput = document.getElementById('eventImage');
    if (imageInput) {
        if (!document.getElementById('imageError')) {
            const errorDiv = document.createElement('div');
            errorDiv.id = 'imageError';
            errorDiv.className = 'form-error';
            imageInput.parentNode.appendChild(errorDiv);
        }
        
        imageInput.addEventListener('change', function() { validateImageFile(false); });
    }
    
    let searchTimeout;
    const smartSearch = document.getElementById('smartSearch');
    if (smartSearch) {
        smartSearch.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { loadEvents(); }, 300);
        });
    }
    
    const filters = ['filterType', 'filterStatus', 'filterPeriod', 'filterSort'];
    filters.forEach(filterId => {
        const element = document.getElementById(filterId);
        if (element) {
            element.addEventListener('change', function() { loadEvents(); });
        }
    });
    
    document.getElementById('cancelEventBtn')?.addEventListener('click', function() {
        resetEventForm();
        showTempMessage('Formulaire réinitialisé', 'success');
    });
    
    loadEvents();
});
</script>
{% endblock %}