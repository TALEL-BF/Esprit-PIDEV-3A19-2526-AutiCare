}


// ========== POPUP FUNCTIONS ==========
function showConfirmPopup() {
    if (!validateFormForSubmit()) {
        showTempMessage('Veuillez corriger les erreurs dans le formulaire', 'danger');
        return;
    }
    
    const eventTitle = document.getElementById('eventTitle').value;
    if (!eventTitle) {
        showTempMessage('Veuillez remplir le titre de l\'événement', 'danger');
        return;
    }
    document.getElementById('confirmPopup').style.display = 'flex';
}

function closePopup() {
    document.getElementById('confirmPopup').style.display = 'none';
}

function closeDeletePopup() {
    document.getElementById('deleteConfirmPopup').style.display = 'none';
    pendingDeleteId = null;
    pendingDeleteRow = null;
    pendingDeleteTitle = null;
}

function submitEventForm() {
    closePopup();
    
    if (!validateFormForSubmit()) {
        showTempMessage('Veuillez corriger les erreurs dans le formulaire', 'danger');
        return;
    }
    
    const form = document.getElementById('eventForm');
    const formData = new FormData(form);
    const eventId = document.getElementById('eventId').value;
    const isEditMode = eventId && eventId !== '';
    const url = isEditMode ? '{{ path('admin_evenements_update') }}' : '{{ path('admin_evenements_add') }}';
    
    showTempMessage('Enregistrement en cours...', 'info');
    
    fetch(url, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showTempMessage(data.message || (isEditMode ? '✅ Événement modifié avec succès !' : '✅ Événement ajouté avec succès !'), 'success');
            resetEventForm();
            loadEvents();
        } else if (data.errors) {
            let errorHtml = '';
            for (const error of data.errors) {
                errorHtml += `<div class="alert alert-danger mb-2"><i class="fas fa-exclamation-circle"></i> ${escapeHtml(error)}</div>`;
            }
            const formContainer = document.querySelector('.card-box-body');
            const existingAlert = formContainer.querySelector('.alert-danger');
            if (existingAlert) existingAlert.remove();
            formContainer.insertAdjacentHTML('afterbegin', errorHtml);
            showTempMessage('Veuillez corriger les erreurs', 'danger');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showTempMessage('Erreur lors de l\'enregistrement', 'danger');
    });
}

// ========== DELETE EVENT ==========
// ========== DELETE EVENT ==========
document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
    if (pendingDeleteId) {
        // Sauvegarder le titre localement avant la suppression
        const titleToDelete = pendingDeleteTitle;
        
        fetch('{{ path('admin_evenements_delete') }}', {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id: pendingDeleteId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeDeletePopup();
                // Utiliser la variable sauvegardée
                showTempMessage(`✅ "${titleToDelete}" a été supprimé avec succès !`, 'success');
                loadEvents();
                resetEventForm();
            } else {
                showTempMessage('❌ Erreur: ' + (data.error || 'Impossible de supprimer cet événement'), 'danger');
                closeDeletePopup();
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            showTempMessage('Erreur lors de la suppression', 'danger');
            closeDeletePopup();
        });
    }
});

// ========== INITIALIZATION ==========
document.addEventListener('DOMContentLoaded', function() {
    const fieldsToValidate = ['eventTitle', 'eventDescription', 'eventLocation', 'eventCapacity', 'eventType', 'eventStartDate', 'eventStartTime'];
    
    fieldsToValidate.forEach(fieldId => {
        const input = document.getElementById(fieldId);
        if (input) {
            if (!document.getElementById(`${fieldId}_error`)) {
                const errorDiv = document.createElement('div');
                errorDiv.id = `${fieldId}_error`;
                errorDiv.className = 'form-error';
                input.parentNode.appendChild(errorDiv);
            }
            
            input.addEventListener('focus', function() { validateField(this, false); });
            input.addEventListener('input', function() { validateField(this, false); });
            input.addEventListener('blur', function() { validateField(this, true); });
        }
    });
    
    const dateFields = ['eventStartDate', 'eventEndDate', 'eventStartTime', 'eventEndTime'];
    dateFields.forEach(fieldId => {
        const input = document.getElementById(fieldId);
        if (input) {
            if (!document.getElementById(`${fieldId}_error`)) {
                const errorDiv = document.createElement('div');
                errorDiv.id = `${fieldId}_error`;
                errorDiv.className = 'form-error';
                input.parentNode.appendChild(errorDiv);
            }
            
            input.addEventListener('change', function() { validateDates(); });
            input.addEventListener('input', function() { validateDates(); });
        }
    });
    
    const imageInput = document.getElementById('eventImage');
    if (imageInput) {
        if (!document.getElementById('imageError')) {
            const errorDiv = document.createElement('div');
            errorDiv.id = 'imageError';
            errorDiv.className = 'form-error';
            imageInput.parentNode.appendChild(errorDiv);
        }
        
        imageInput.addEventListener('change', function() { validateImageFile(false); });
    }
    
    let searchTimeout;
    const smartSearch = document.getElementById('smartSearch');
    if (smartSearch) {
        smartSearch.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { loadEvents(); }, 300);
        });
    }
    
    const filters = ['filterType', 'filterStatus', 'filterPeriod', 'filterSort'];
    filters.forEach(filterId => {
        const element = document.getElementById(filterId);
        if (element) {
            element.addEventListener('change', function() { loadEvents(); });
        }
    });
    
    document.getElementById('cancelEventBtn')?.addEventListener('click', function() {
        resetEventForm();
        showTempMessage('Formulaire réinitialisé', 'success');
    });
    
    loadEvents();
});
// ========== AI SUGGESTION HANDLER ==========
// Check if coming from AI suggestion
function checkForAISuggestion() {
    const urlParams = new URLSearchParams(window.location.search);
    const suggestField = urlParams.get('suggest_field');
    const suggestValue = urlParams.get('suggest_value');
    const suggestPoints = urlParams.get('suggest_points');
    const suggestOriginal = urlParams.get('suggest_original');
    
    if (suggestField && suggestValue) {
        // Map field names to element IDs
        const fieldMap = {
            'capacite': 'eventCapacity',
            'type': 'eventType',
            'description': 'eventDescription',
            'titre': 'eventTitle'
        };
        
        const elementId = fieldMap[suggestField];
        const inputElement = document.getElementById(elementId);
        
        if (inputElement) {
            const oldValue = inputElement.value;
            
            // Create and show banner
            let banner = document.getElementById('aiSuggestionBanner');
            if (!banner) {
                banner = document.createElement('div');
                banner.id = 'aiSuggestionBanner';
                banner.className = 'ai-suggestion-banner';
                const formHeader = document.querySelector('.card-box-header');
                if (formHeader) {
                    formHeader.parentNode.insertBefore(banner, formHeader.nextSibling);
                }
            }
            
            banner.innerHTML = `
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="fas fa-magic fa-2x" style="color: #f59e0b;"></i>
                    <div style="flex: 1;">
                        <strong>✨ Suggestion IA appliquée</strong>
                        <p style="margin: 0; font-size: 0.85rem;">
                            ${getFieldName(suggestField)} : 
                            <span style="text-decoration: line-through; opacity: 0.7;">${escapeHtml(oldValue)}</span>
                            <span class="ai-change-arrow"> → </span>
                            <strong style="color: #f59e0b;">${escapeHtml(suggestValue)}</strong>
                            ${suggestPoints ? `<span style="background: #dcfce7; padding: 2px 8px; border-radius: 20px; margin-left: 10px;">+${suggestPoints} points</span>` : ''}
                        </p>
                    </div>
                    <button onclick="this.parentElement.parentElement.classList.remove('show')" style="background: none; border: none; cursor: pointer;">✕</button>
                </div>
            `;
            banner.classList.add('show');
            
            // Highlight the field
            inputElement.classList.add('ai-highlight');
            
            // ANIMATION: Type the new value
            const originalValue = inputElement.value;
            
            if (inputElement.tagName === 'SELECT') {
                // For select, just change value with visual feedback
                setTimeout(() => {
                    inputElement.value = suggestValue;
                    inputElement.style.transition = 'all 0.3s';
                    showAIToast(`✅ ${getFieldName(suggestField)} modifié : ${originalValue} → ${suggestValue}`);
                }, 500);
            } else if (inputElement.tagName === 'TEXTAREA') {
                // For textarea, show typing effect
                inputElement.value = '';
                let index = 0;
                const text = suggestValue;
                const typingInterval = setInterval(() => {
                    if (index < text.length) {
                        inputElement.value += text[index];
                        index++;
                    } else {
                        clearInterval(typingInterval);
                        showAIToast(`✅ ${getFieldName(suggestField)} mis à jour !`);
                        // Trigger validation
                        validateField(inputElement, false);
                    }
                }, 30);
            } else {
                // For input fields, type it
                inputElement.value = '';
                let index = 0;
                const text = suggestValue.toString();
                const typingInterval = setInterval(() => {
                    if (index < text.length) {
                        inputElement.value += text[index];
                        index++;
                    } else {
                        clearInterval(typingInterval);
                        showAIToast(`✅ ${getFieldName(suggestField)} : ${originalValue} → ${suggestValue} ${suggestPoints ? `(+${suggestPoints} points)` : ''}`);
                        // Trigger validation
                        validateField(inputElement, false);
                    }
                }, 50);
            }
            
            // Remove highlight after animation
            setTimeout(() => {
                inputElement.classList.remove('ai-highlight');
            }, 3000);
            
            // Also update the form mode badge to show it's AI-enhanced
            const formMode = document.getElementById('formMode');
            if (formMode && !formMode.innerHTML.includes('IA')) {
                formMode.innerHTML = `Mode : Modification <i class="fas fa-edit"></i> <span style="background: #fef3c7; color: #f59e0b; padding: 2px 8px; border-radius: 20px; margin-left: 8px;">✨ Suggestion IA</span>`;
            }
        }
    }
}

function getFieldName(field) {
    const names = {
        'capacite': 'Capacité',
        'type': 'Type d\'événement',
        'description': 'Description',
        'titre': 'Titre',
        'maxParticipant': 'Capacité'
    };
    return names[field] || field;
}

function showAIToast(message) {
    const toast = document.createElement('div');
    toast.className = 'ai-toast';
    toast.innerHTML = `<i class="fas fa-robot"></i> ${message}`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
}

// Call this when page loads
document.addEventListener('DOMContentLoaded', function() {
    checkForAISuggestion();
});
</script>
