{# templates/admin/pages/dashboard.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard - AutiCare{% endblock %}

{% block page_title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h1 class="mb-3">
                        <i class="fas fa-chart-line"></i> 
                        Bienvenue {{ user.prenom }} {{ user.nom }} !
                    </h1>
                    <p class="mb-0">Vous êtes connecté en tant qu'administrateur</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Utilisateurs</h5>
                    <p class="card-text">Gérer tous les utilisateurs</p>
                    <a href="{{ path('admin_users') }}" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Rôles</h5>
                    <p class="card-text">Gérer les rôles et permissions</p>
                    <a href="{{ path('admin_users_roles') }}" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-book-open fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Cours</h5>
                    <p class="card-text">Gérer les cours</p>
                    <a href="{{ path('admin_cours') }}" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Informations de connexion</h5>
                </div>
                <div class="card-body">
                    <p><strong>Email:</strong> {{ user.email }}</p>
                    <p><strong>Rôle:</strong> {{ user.role }}</p>
                    <p><strong>Status:</strong> {{ user.status }}</p>
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_logout') }}" class="btn btn-danger">
                        <i class="fas fa-sign-out-alt"></i> Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}