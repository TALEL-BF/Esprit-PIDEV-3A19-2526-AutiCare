<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; margin: 0; padding: 10px; }
        .header { border-bottom: 2px solid #4f46e5; padding-bottom: 15px; margin-bottom: 25px; display: table; width: 100%; }
        .logo { font-size: 26px; font-weight: bold; color: #4f46e5; display: table-cell; }
        .date { text-align: right; font-size: 11px; color: #6b7280; display: table-cell; vertical-align: bottom; }
        
        h1 { color: #111827; font-size: 22px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        /* Statistics Section */
        .stats-grid { width: 100%; margin-bottom: 30px; border-spacing: 10px; border-collapse: separate; margin-left: -10px; }
        .stat-card { background: #f5f3ff; border: 1px solid #ddd6fe; border-radius: 8px; padding: 12px; text-align: center; width: 25%; }
        .stat-label { font-size: 10px; color: #6d28d9; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; }
        .stat-value { font-size: 18px; font-weight: 800; color: #4c1d95; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th { background: #4f46e5; color: #ffffff; text-align: left; padding: 10px 8px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        td { padding: 10px 8px; font-size: 10px; border-bottom: 1px solid #e5e7eb; color: #374151; }
        tr:nth-child(even) { background-color: #f9fafb; }
        
        .footer { position: fixed; bottom: 0; left: 0; right: 0; text-align: center; font-size: 9px; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">AutiCare Guardian</div>
        <div class="date">Rapport généré le: {{ "now"|date("d/m/Y H:i") }}</div>
    </div>

    <h1>{{ title }}</h1>

    {% if stats is defined and stats|length > 0 %}
    <table class="stats-grid">
        <tr>
            {% for label, value in stats %}
            <td class="stat-card">
                <div class="stat-label">{{ label }}</div>
                <div class="stat-value">{{ value }}</div>
            </td>
            {% endfor %}
        </tr>
    </table>
    {% endif %}

    <table>
        <thead>
            <tr>
                {% for heading in headings %}
                    <th>{{ heading }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in data %}
                <tr>
                    {% for cell in row %}
                        <td>{{ cell|raw }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        © {{ "now"|date("Y") }} AutiCare - Solution d'accompagnement pour l'autisme.
    </div>
</body>
</html>
