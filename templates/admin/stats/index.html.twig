{# templates/admin/stats/index.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord pédagogique - AutiCare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --mauve: #7c3aed;
            --mauve-light: #f3e8ff;
            --mauve-dark: #5b21b6;
            --rose: #db2777;
            --rose-light: #fce7f3;
            --rose-dark: #be185d;
            --lavender: #c4b5fd;
            --success: #10b981;
            --warning: #f59e0b;
            --info: #3b82f6;
            --orange: #f97316;
            --teal: #14b8a6;
        }

        .dashboard-container {
            padding: 20px;
            background: #faf9fe;
            min-height: 100vh;
        }

        /* Section bienvenue */
        .welcome-section {
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            border-radius: 30px;
            padding: 30px;
            margin-bottom: 30px;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .welcome-section::before {
            content: '📚';
            position: absolute;
            right: 20px;
            bottom: 10px;
            font-size: 100px;
            opacity: 0.1;
        }

        .welcome-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .welcome-subtitle {
            font-size: 1rem;
            opacity: 0.9;
        }

        /* Cartes stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 24px;
            padding: 20px;
            transition: all 0.3s ease;
            border: 1px solid var(--lavender);
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(124, 58, 237, 0.15);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--mauve), var(--rose));
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 15px;
        }

        .stat-icon.mauve { background: var(--mauve-light); color: var(--mauve); }
        .stat-icon.rose { background: var(--rose-light); color: var(--rose); }
        .stat-icon.success { background: #d1fae5; color: var(--success); }
        .stat-icon.warning { background: #fef3c7; color: var(--warning); }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #6b7280;
        }

        .stat-trend {
            font-size: 0.7rem;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
        }

        .trend-up { color: var(--success); }
        .trend-down { color: var(--rose); }

        /* Sections principales */
        .section-card {
            background: white;
            border-radius: 24px;
            padding: 25px;
            margin-bottom: 25px;
            border: 1px solid var(--lavender);
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--mauve);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--lavender);
        }

        /* Chart containers */
        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
            margin: 20px 0;
        }

        .chart-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 25px;
        }

        /* ========== TOP 3 COURS ========== */
        .top-cours-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .top-cours-item {
            background: linear-gradient(135deg, var(--mauve-light), var(--rose-light));
            border-radius: 20px;
            padding: 15px 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .top-cours-item:hover {
            transform: translateX(8px);
            box-shadow: 0 8px 25px rgba(124, 58, 237, 0.2);
        }

        .top-cours-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 6px;
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            border-radius: 3px;
        }

        .top-cours-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 12px;
        }

        .top-cours-rank {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            font-weight: 800;
            color: white;
            box-shadow: 0 4px 10px rgba(124, 58, 237, 0.3);
        }

        .top-cours-rank.gold { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
        .top-cours-rank.silver { background: linear-gradient(135deg, #94a3b8, #cbd5e1); }
        .top-cours-rank.bronze { background: linear-gradient(135deg, #b45309, #d97706); }

        .top-cours-title {
            flex: 1;
            font-size: 1.2rem;
            font-weight: 700;
            color: #1f2937;
        }

        .top-cours-badge {
            background: white;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--mauve);
        }

        .top-cours-stats {
            display: flex;
            gap: 25px;
            margin-left: 60px;
        }

        .top-cours-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.7);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
        }

        .top-cours-stat i {
            font-size: 0.9rem;
        }

        .top-cours-stat.mots i { color: var(--mauve); }
        .top-cours-stat.images i { color: var(--rose); }
        .top-cours-stat.quiz i { color: var(--success); }

        .top-cours-stat-value {
            font-weight: 800;
            color: #1f2937;
        }

        .top-cours-stat-label {
            color: #6b7280;
            font-size: 0.7rem;
        }

        /* ========== STATISTIQUES STYLE SIMPLE ========== */
        .statistics-section {
            margin-bottom: 25px;
        }

        .statistics-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #9ca3af;
            letter-spacing: 2px;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .statistics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .statistics-item {
            background: white;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            border: 1px solid var(--lavender);
            transition: all 0.3s ease;
        }

        .statistics-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(124, 58, 237, 0.1);
            border-color: var(--mauve);
        }

        .statistics-icon {
            width: 50px;
            height: 50px;
            background: var(--mauve-light);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            font-size: 1.5rem;
            color: var(--mauve);
        }

        .statistics-number {
            font-size: 2rem;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 5px;
        }

        .statistics-text {
            font-size: 0.85rem;
            color: #6b7280;
        }

        /* Progression bars */
        .progress-item {
            margin-bottom: 20px;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

        .progress-bar-container {
            background: #e5e7eb;
            border-radius: 10px;
            height: 8px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease;
        }

        .progress-fill.mauve { background: linear-gradient(90deg, var(--mauve), var(--lavender)); }
        .progress-fill.rose { background: linear-gradient(90deg, var(--rose), #f9a8d4); }
        .progress-fill.success { background: linear-gradient(90deg, var(--success), #34d399); }

        /* Quiz stats */
        .quiz-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .quiz-stat-item {
            text-align: center;
            padding: 15px;
            background: var(--mauve-light);
            border-radius: 20px;
        }

        .quiz-stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--mauve);
        }

        /* Recommandations */
        .recommendations-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .recommendation-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: #fef3c7;
            border-radius: 16px;
            border-left: 4px solid var(--warning);
        }

        .recommendation-icon {
            width: 40px;
            height: 40px;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .recommendation-text {
            flex: 1;
            font-size: 0.9rem;
            color: #1f2937;
        }

        .recommendation-action {
            color: var(--warning);
            font-weight: 600;
            font-size: 0.8rem;
        }

        .badge-info {
            display: inline-block;
            background: var(--mauve-light);
            color: var(--mauve);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        @media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .quiz-stats { grid-template-columns: 1fr; }
            .chart-row { grid-template-columns: 1fr; }
            .top-cours-stats { flex-wrap: wrap; margin-left: 0; margin-top: 10px; }
            .top-cours-header { flex-wrap: wrap; }
            .statistics-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    {# Section bienvenue #}
    <div class="welcome-section">
        <div class="welcome-title">
            👋 Bonjour, Administrateur !
        </div>
        <div class="welcome-subtitle">
            Voici l'état de votre plateforme pédagogique. {{ totalCours|default(0) }} cours disponibles.
        </div>
    </div>

    {# Cartes principales #}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon mauve">
                <i class="fas fa-book-open"></i>
            </div>
            <div class="stat-value">{{ totalCours|default(0) }}</div>
            <div class="stat-label">Cours disponibles</div>
            <div class="stat-trend">
                <span class="trend-up"><i class="fas fa-check-circle"></i> Programme actif</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon rose">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div class="stat-value">{{ tauxCompletionGlobal|default(0) }}%</div>
            <div class="stat-label">Taux de complétion</div>
            <div class="stat-trend">
                <span class="trend-up"><i class="fas fa-chart-line"></i> Cours avec quiz</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-star"></i>
            </div>
            <div class="stat-value">{{ scoreMoyenGlobal|default(0) }}%</div>
            <div class="stat-label">Score moyen aux quiz</div>
            <div class="stat-trend">
                <span class="trend-up"><i class="fas fa-smile"></i> En progression</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-value">{{ totalMinutesApprentissage|default(0) }}</div>
            <div class="stat-label">Minutes d'apprentissage</div>
            <div class="stat-trend">
                <span class="trend-up"><i class="fas fa-fire"></i> Estimé</span>
            </div>
        </div>
    </div>

    {# GRAPHIQUES CHART.JS #}
    <div class="chart-row">
        <div class="section-card">
            <div class="section-title">
                <i class="fas fa-chart-pie" style="color: var(--rose);"></i>
                Répartition par type de cours
            </div>
            <div class="chart-container">
                <canvas id="typeChart"></canvas>
            </div>
        </div>

        <div class="section-card">
            <div class="section-title">
                <i class="fas fa-chart-bar" style="color: var(--mauve);"></i>
                Répartition par niveau
            </div>
            <div class="chart-container">
                <canvas id="niveauChart"></canvas>
            </div>
        </div>
    </div>

    {# TOP 3 DES COURS #}
    <div class="section-card">
        <div class="section-title">
            <i class="fas fa-trophy" style="color: var(--rose);"></i>
            🏆 Top 3 des cours les plus complets
        </div>
        <div class="top-cours-container">
            {% for cours in topCours|default([])|slice(0, 3) %}
            <div class="top-cours-item">
                <div class="top-cours-header">
                    <div class="top-cours-rank 
                        {% if loop.index == 1 %}gold
                        {% elseif loop.index == 2 %}silver
                        {% elseif loop.index == 3 %}bronze
                        {% endif %}">
                        {{ loop.index }}
                    </div>
                    <div class="top-cours-title">{{ cours.titre }}</div>
                    <div class="top-cours-badge">
                        <i class="fas fa-star"></i> Top {{ loop.index }}
                    </div>
                </div>
                <div class="top-cours-stats">
                    <div class="top-cours-stat mots">
                        <i class="fas fa-font"></i>
                        <span class="top-cours-stat-value">{{ cours.nbMots|default(0) }}</span>
                        <span class="top-cours-stat-label">mots</span>
                    </div>
                    <div class="top-cours-stat images">
                        <i class="fas fa-image"></i>
                        <span class="top-cours-stat-value">{{ cours.nbImages|default(0) }}</span>
                        <span class="top-cours-stat-label">images</span>
                    </div>
                    <div class="top-cours-stat quiz">
                        <i class="fas fa-question-circle"></i>
                        <span class="top-cours-stat-value">{{ cours.nbEvaluations|default(0) }}</span>
                        <span class="top-cours-stat-label">quiz</span>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="text-muted text-center py-4">Aucune donnée disponible</div>
            {% endfor %}
        </div>
    </div>

    {# SECTION STATISTIQUES #}
    <div class="statistics-section">
        <div class="statistics-title">
            <i class="fas fa-chart-simple me-2"></i> STATISTIQUES
        </div>
        <div class="statistics-grid">
            <div class="statistics-item">
                <div class="statistics-icon">
                    <i class="fas fa-font"></i>
                </div>
                <div class="statistics-number">{{ totalMots|default(0) }}</div>
                <div class="statistics-text">Mots à apprendre</div>
            </div>
            <div class="statistics-item">
                <div class="statistics-icon">
                    <i class="fas fa-image"></i>
                </div>
                <div class="statistics-number">{{ totalImages|default(0) }}</div>
                <div class="statistics-text">Images associées</div>
            </div>
            <div class="statistics-item">
                <div class="statistics-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="statistics-number">{{ (totalMots|default(0) * 2 + totalImages|default(0) * 0.5)|round }}</div>
                <div class="statistics-text">Minutes d'apprentissage</div>
            </div>
            <div class="statistics-item">
                <div class="statistics-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <div class="statistics-number">{{ (totalMots|default(0) * 5)|default(0) }}</div>
                <div class="statistics-text">Points de progression</div>
            </div>
        </div>
    </div>

    {# Indicateurs pédagogiques #}
    <div class="row">
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="fas fa-chart-line" style="color: var(--mauve);"></i>
                    📈 Indicateurs pédagogiques
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>📚 Cours avec évaluations</span>
                        <span><strong>{{ tauxCompletionGlobal|default(0) }}%</strong></span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill mauve" style="width: {{ tauxCompletionGlobal|default(0) }}%"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>⭐ Réussite aux quiz (score ≥ 70%)</span>
                        <span><strong>{{ tauxReussiteQuiz|default(0) }}%</strong></span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill rose" style="width: {{ tauxReussiteQuiz|default(0) }}%"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>🎯 Objectif pédagogique global</span>
                        <span><strong>{{ objectifPedagogique|default(0) }}%</strong></span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill success" style="width: {{ objectifPedagogique|default(0) }}%"></div>
                    </div>
                </div>
                <div class="mt-3 text-center text-muted small">
                    <i class="fas fa-info-circle"></i> Objectif : 80% de réussite pour valider le parcours
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="fas fa-chart-simple" style="color: var(--rose);"></i>
                    📊 Distribution des scores
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>🔴 0-40% (À renforcer)</span>
                        <span>{{ pourcentageFaible|default(0) }}%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill" style="width: {{ pourcentageFaible|default(0) }}%; background: #ef4444;"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>🟠 40-70% (En progression)</span>
                        <span>{{ pourcentageMoyen|default(0) }}%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill" style="width: {{ pourcentageMoyen|default(0) }}%; background: #f59e0b;"></div>
                    </div>
                </div>
                <div class="progress-item">
                    <div class="progress-header">
                        <span>🟢 70-100% (Excellent)</span>
                        <span>{{ pourcentageExcellent|default(0) }}%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-fill" style="width: {{ pourcentageExcellent|default(0) }}%; background: #10b981;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Statistiques des quiz #}
    <div class="section-card">
        <div class="section-title">
            <i class="fas fa-question-circle" style="color: var(--rose);"></i>
            📊 Performance des évaluations
        </div>
        <div class="quiz-stats">
            <div class="quiz-stat-item">
                <div class="quiz-stat-value">{{ totalQuizRealises|default(0) }}</div>
                <div class="quiz-stat-label">Quiz réalisés</div>
            </div>
            <div class="quiz-stat-item">
                <div class="quiz-stat-value">{{ meilleurScore|default(0) }}%</div>
                <div class="quiz-stat-label">Meilleur score</div>
            </div>
            <div class="quiz-stat-item">
                <div class="quiz-stat-value">{{ tentativesMoyennes|default(0) }}</div>
                <div class="quiz-stat-label">Quiz par cours (moy.)</div>
            </div>
        </div>
    </div>

    {# Recommandations intelligentes #}
    <div class="section-card">
        <div class="section-title">
            <i class="fas fa-lightbulb" style="color: var(--warning);"></i>
            💡 Recommandations pédagogiques
        </div>
        <div class="recommendations-list">
            {% for reco in recommandations|default([]) %}
            <div class="recommendation-item">
                <div class="recommendation-icon">{{ reco.icone|default('📌') }}</div>
                <div class="recommendation-text">{{ reco.message }}</div>
                <div class="recommendation-action">{{ reco.action|default('À vérifier') }}</div>
            </div>
            {% else %}
            <div class="recommendation-item">
                <div class="recommendation-icon">✅</div>
                <div class="recommendation-text">Tout va bien ! Continuez à enrichir vos cours.</div>
                <div class="recommendation-action">Bravo !</div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# Réalisations de la plateforme #}
    <div class="section-card">
        <div class="section-title">
            <i class="fas fa-medal" style="color: var(--rose);"></i>
            🎖️ Réalisations de la plateforme
        </div>
        <div class="row text-center">
            <div class="col-md-3 col-6 mb-3">
                <i class="fas fa-book" style="font-size: 2rem; color: var(--mauve);"></i>
                <div class="small mt-1">{{ totalCours|default(0) }} cours</div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <i class="fas fa-tags" style="font-size: 2rem; color: var(--rose);"></i>
                <div class="small mt-1">{{ totalMots|default(0) }} mots</div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <i class="fas fa-image" style="font-size: 2rem; color: var(--lavender);"></i>
                <div class="small mt-1">{{ totalImages|default(0) }} images</div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <i class="fas fa-question-circle" style="font-size: 2rem; color: var(--success);"></i>
                <div class="small mt-1">{{ totalQuestions|default(0) }} questions</div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // Données PHP vers JavaScript
    const typeStats = {{ typeStats|default({})|json_encode|raw }};
    const niveauStats = {{ niveauStats|default({})|json_encode|raw }};
    
    // 1. Graphique des types de cours (Camembert)
    const typeCtx = document.getElementById('typeChart').getContext('2d');
    new Chart(typeCtx, {
        type: 'doughnut',
        data: {
            labels: ['Académique', 'Social', 'Motricité', 'Langage'],
            datasets: [{
                data: [
                    typeStats['Académique'] || 0,
                    typeStats['Social'] || 0,
                    typeStats['Motricité'] || 0,
                    typeStats['Langage'] || 0
                ],
                backgroundColor: ['#7c3aed', '#db2777', '#c4b5fd', '#f3e8ff'],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { font: { size: 11 } } },
                tooltip: { callbacks: { label: function(context) { return context.label + ': ' + context.raw + ' cours'; } } }
            },
            cutout: '60%'
        }
    });
    
    // 2. Graphique des niveaux (Barres)
    const niveauCtx = document.getElementById('niveauChart').getContext('2d');
    new Chart(niveauCtx, {
        type: 'bar',
        data: {
            labels: ['Débutant', 'Intermédiaire', 'Avancé'],
            datasets: [{
                label: 'Nombre de cours',
                data: [
                    niveauStats['Débutant'] || 0,
                    niveauStats['Intermédiaire'] || 0,
                    niveauStats['Avancé'] || 0
                ],
                backgroundColor: ['#7c3aed', '#c4b5fd', '#db2777'],
                borderRadius: 8,
                barPercentage: 0.6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: function(context) { return context.raw + ' cours'; } } }
            },
            scales: {
                y: { beginAtZero: true, title: { display: true, text: 'Nombre de cours', font: { size: 11 } }, grid: { color: '#e5e7eb' } },
                x: { title: { display: true, text: 'Niveau', font: { size: 11 } }, grid: { display: false } }
            }
        }
    });
    
});
</script>
{% endblock %}