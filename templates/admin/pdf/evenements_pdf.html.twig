<meta charset="UTF-8">
<title>AutiCare — Événements</title>
<style>
    body {
        font-family: helvetica, arial, sans-serif;
        font-size: 11px;
        color: #1a0540;
        background: #ffffff;
        margin: 0;
        padding: 0;
    }

    /* ── HERO HEADER ── */
    .hero-table { width: 100%; border-collapse: collapse; }
    .hero-bg { background-color: #2d1060; }
    .hero-left-cell { padding: 28px 24px 28px 32px; width: 60%; vertical-align: middle; }
    .hero-right-cell { padding: 28px 32px 28px 24px; width: 40%; vertical-align: middle; text-align: right; }

    .brand-name {
        font-size: 34px;
        font-weight: bold;
        color: #ffffff;
        letter-spacing: -1px;
        line-height: 1;
        margin: 0;
    }

    .brand-puzzle {
        display: inline-block;
        font-size: 30px;
        margin-right: 8px;
        vertical-align: middle;
    }

    .brand-tagline {
        font-size: 8px;
        color: #c084fc;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-top: 7px;
    }

    .export-label {
        font-size: 7.5px;
        color: #9d7ee0;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .export-date {
        font-size: 10.5px;
        color: #e2d9f3;
        font-weight: normal;
    }

    /* ── ACCENT STRIPE ── */
    .stripe-table { width: 100%; border-collapse: collapse; }
    .stripe-purple { background-color: #7c3aed; height: 5px; }
    .stripe-teal   { background-color: #0d9e75; height: 5px; }
    .stripe-rose   { background-color: #e0427c; height: 5px; }
    .stripe-amber  { background-color: #d97706; height: 5px; }

    /* ── STATS ROW ── */
    .stats-table { width: 100%; border-collapse: collapse; margin: 0; }
    .stat-cell { width: 25%; padding: 22px 20px 18px; text-align: left; vertical-align: top; }
    .stat-cell-purple { background-color: #f5f0ff; border-right: 1px solid #ede9fe; border-bottom: 2px solid #ede9fe; }
    .stat-cell-teal   { background-color: #f0fdf9; border-right: 1px solid #d1fae5; border-bottom: 2px solid #d1fae5; }
    .stat-cell-rose   { background-color: #fff0f5; border-right: 1px solid #fce7f3; border-bottom: 2px solid #fce7f3; }
    .stat-cell-amber  { background-color: #fffbeb; border-bottom: 2px solid #fef3c7; }

    .stat-num { font-size: 42px; font-weight: bold; line-height: 1; margin-bottom: 5px; }
    .stat-num-purple { color: #6d28d9; }
    .stat-num-teal   { color: #0f766e; }
    .stat-num-rose   { color: #be185d; }
    .stat-num-amber  { color: #b45309; }

    .stat-label { font-size: 8px; font-weight: bold; letter-spacing: 1.5px; text-transform: uppercase; }
    .stat-label-purple { color: #7c3aed; }
    .stat-label-teal   { color: #0d9488; }
    .stat-label-rose   { color: #be185d; }
    .stat-label-amber  { color: #b45309; }

    /* ── BODY AREA ── */
    .body-wrap { padding: 28px 32px 40px; background: #ffffff; }

    /* ── FILTER BAR ── */
    .filter-wrap {
        background-color: #faf5ff;
        border: 1px solid #e9d5ff;
        border-left: 4px solid #7c3aed;
        padding: 10px 16px;
        margin-bottom: 26px;
    }
    .filter-title {
        font-size: 7.5px; font-weight: bold;
        color: #7c3aed; letter-spacing: 2px;
        text-transform: uppercase; margin-bottom: 6px;
    }
    .filter-pills { font-size: 0; }
    .fpill {
        display: inline-block;
        background-color: #ffffff;
        border: 1px solid #ddd6fe;
        padding: 3px 10px;
        margin-right: 6px; margin-top: 2px;
        font-size: 9px; font-weight: bold; color: #5b21b6;
    }

    /* ── SECTION HEADING ── */
    .sec-head-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
    .sec-head-icon-cell { width: 36px; vertical-align: middle; padding-right: 10px; }
    .sec-head-icon {
        width: 34px; height: 34px;
        background-color: #7c3aed;
        text-align: center;
        vertical-align: middle;
        font-size: 16px;
        line-height: 34px;
        display: block;
    }
    .sec-head-title-cell { vertical-align: middle; }
    .sec-head-title { font-size: 17px; font-weight: bold; color: #2d1060; }
    .sec-head-badge-cell { vertical-align: middle; text-align: right; width: 110px; }
    .sec-badge {
        display: inline-block;
        background-color: #7c3aed;
        color: #ffffff;
        padding: 4px 14px;
        font-size: 9px; font-weight: bold;
        letter-spacing: .5px;
    }

    /* ── TABLE ── */
    .events-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #ede9fe;
    }

    .events-table thead tr {
        background-color: #2d1060;
    }

    .events-table th {
        padding: 11px 12px;
        font-size: 7.5px; font-weight: bold;
        text-transform: uppercase; letter-spacing: 1.8px;
        color: #c084fc; text-align: left;
        white-space: nowrap;
    }

    .events-table tbody tr.row-even { background-color: #fdfcff; }
    .events-table tbody tr.row-odd  { background-color: #ffffff; }

    .events-table td {
        padding: 11px 12px;
        vertical-align: middle;
        border-bottom: 1px solid #f3f0ff;
    }

    .events-table tbody tr:last-child td { border-bottom: none; }

    /* Row number badge */
    .rn {
        display: inline-block;
        width: 26px; height: 26px;
        background-color: #ede9fe;
        border: 1px solid #c4b5fd;
        font-size: 9px; font-weight: bold; color: #6d28d9;
        text-align: center; line-height: 26px;
    }

    .ev-name { font-size: 10.5px; font-weight: bold; color: #1a0540; margin-bottom: 3px; }
    .ev-desc { font-size: 8.5px; color: #a78bfa; }

    .dv { font-size: 10px; font-weight: bold; color: #1a0540; }
    .tv { font-size: 10px; color: #9ca3af; }
    .lv { font-size: 9.5px; color: #4b5563; }
    .cv { font-size: 11px; font-weight: bold; color: #1a0540; text-align: center; display: block; }

    /* Badges */
    .badge {
        display: inline-block;
        padding: 3px 9px;
        font-size: 8px; font-weight: bold;
        white-space: nowrap;
    }
    .b-dot {
        display: inline-block;
        width: 6px; height: 6px;
        margin-right: 4px;
        vertical-align: middle;
    }
    .b-type { background-color: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; }
    .b-plan { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .b-open { background-color: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .b-full { background-color: #ffe4e6; color: #9f1239; border: 1px solid #fda4af; }
    .b-canc { background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    /* Empty state */
    .empty-td {
        text-align: center; padding: 50px 20px;
        font-size: 12px; color: #a78bfa;
    }

    /* ── FOOTER ── */
    .footer-table { width: 100%; border-collapse: collapse; }
    .footer-bg { background-color: #2d1060; }
    .footer-left { padding: 18px 20px 18px 32px; vertical-align: middle; width: 70%; }
    .footer-right { padding: 18px 32px 18px 20px; vertical-align: middle; text-align: right; width: 30%; }
    .footer-brand { font-size: 9.5px; font-weight: bold; color: #c084fc; }
    .footer-sub   { font-size: 8px; color: #7c3aed; margin-top: 3px; }
    .footer-pill  {
        display: inline-block;
        background-color: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 5px 16px;
        font-size: 9px; font-weight: bold; color: #e9d5ff;
        letter-spacing: .5px;
    }

    /* ── TOP RULE ── */
    .top-rule-table { width: 100%; border-collapse: collapse; }
</style>
</head>
