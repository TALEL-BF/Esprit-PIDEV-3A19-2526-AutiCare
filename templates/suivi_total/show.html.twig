{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Détail du suivi{% endblock %}
{% block page_title %}Jeu — Détail du suivi{% endblock %}

{% block body %}
<div class="page-header">
    <h2><i class="fas fa-eye me-2" style="color:var(--purple-500)"></i>Détail du suivi</h2>
    <p>Consulter les informations du suivi sélectionné</p>
</div>

<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-info-circle"></i> Informations</span>
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table">
                <tbody>
                    <tr>
                        <th style="width: 260px;">ID</th>
                        <td>{{ suivi_total.id }}</td>
                    </tr>
                    <tr>
                        <th>Id enfant</th>
                        <td>{{ suivi_total.enfantId }}</td>
                    </tr>
                    <tr>
                        <th>Moyenne</th>
                        <td>{{ suivi_total.moyenne }}</td>
                    </tr>
                    <tr>
                        <th>Niveau</th>
                        <td>{{ suivi_total.niveauJeu ? suivi_total.niveauJeu.libelle : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Remarque</th>
                        <td>{{ suivi_total.remarque ?: '-' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a href="{{ path('app_suivi_total_index') }}" class="btn-outline-purple text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour
    </a>
    <a href="{{ path('app_suivi_total_edit', {'id': suivi_total.id}) }}" class="btn-purple text-decoration-none">
        <i class="fas fa-pen me-1"></i> Modifier
    </a>
    {% include 'suivi_total/_delete_form.html.twig' with {suivi_total: suivi_total} %}
</div>
{% endblock %}