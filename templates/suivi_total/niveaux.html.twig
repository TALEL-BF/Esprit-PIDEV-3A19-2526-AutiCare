{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Niveaux par enfant{% endblock %}
{% block page_title %}Jeu — Niveaux par enfant{% endblock %}

{% block body %}
<div class="page-header">
    <h2><i class="fas fa-layer-group me-2" style="color:var(--purple-500)"></i>Niveaux par enfant</h2>
    <p>Liste des identifiants enfant et du niveau de jeu correspondant.</p>
</div>

<div class="card-box mb-4">
    <div class="card-box-header d-flex justify-content-between align-items-center">
        <span class="card-box-title"><i class="fas fa-list"></i> Niveau enfant</span>
        <a href="{{ path('app_suivi_total_index') }}" class="btn-outline-purple text-decoration-none" title="Retour au tableau des suivis">
            <i class="fas fa-arrow-left"></i>
        </a>
    </div>

    <div class="card-box-body">
        <div class="table-wrapper">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ID enfant</th>
                        <th>NIVEAU</th>
                    </tr>
                </thead>
                <tbody>
                {% for record in records %}
                    <tr>
                        <td>{{ record.enfantId }}</td>
                        <td>{{ record.niveau ?: '-' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
