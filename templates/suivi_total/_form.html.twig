{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="row g-3">
    <div class="col-md-6">
        {{ form_label(form.enfantId, 'Id enfant', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.enfantId, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 1'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.enfantId) }}</div>
    </div>

    <div class="col-md-6">
        {{ form_label(form.moyenne, 'Moyenne', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.moyenne, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 12.50'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.moyenne) }}</div>
    </div>

    <div class="col-12">
        <label class="form-label">Niveau</label>
        <input type="text" class="form-control" value="Calculé automatiquement selon la moyenne" disabled>
        <small class="text-muted">Le niveau sera attribué automatiquement après l’enregistrement.</small>
    </div>

    <div class="col-12">
        {{ form_label(form.remarque, 'Remarque', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.remarque, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Remarque facultative...'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.remarque) }}</div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <button class="btn-purple">
        <i class="fas fa-save me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>

    <a href="{{ path('app_suivi_total_index') }}" class="btn-outline-purple text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour
    </a>
</div>

{{ form_end(form) }}