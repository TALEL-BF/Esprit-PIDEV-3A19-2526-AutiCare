{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Suivis Totaux{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.dashboard-header {
    margin-bottom: 40px;
}

.dashboard-title {
    font-size: 2rem;
    font-weight: 700;
    color: #8b5cf6;
    margin-bottom: 5px;
}

.dashboard-subtitle {
    font-size: 1rem;
    color: #999;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-content h3 {
    font-size: 0.85rem;
    color: #999;
    margin-bottom: 8px;
    font-weight: 500;
}

.stat-number {
    font-size: 1.8rem;
    font-weight: 700;
    color: #8b5cf6;
}

.stat-trend {
    font-size: 0.8rem;
    color: #10b981;
    margin-top: 5px;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.icon-purple { background: #e9d5ff; }
.icon-pink { background: #fbcfe8; }
.icon-blue { background: #dbeafe; }
.icon-green { background: #dcfce7; }

.form-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    margin-bottom: 40px;
}

.form-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f0f0f0;
}

.form-section-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: #333;
}

.form-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
}

.form-wrapper {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
    font-size: 0.9rem;
}

.form-group input,
.form-group textarea,
.form-group select {
    padding: 12px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
}

.chart-placeholder {
    background: linear-gradient(135deg, #f5f5f5 0%, #efefef 100%);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chart-container {
    position: relative;
    height: 300px;
    width: 100%;
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.btn-primary {
    background: #8b5cf6;
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: #7c3aed;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
}

.btn-secondary {
    background: white;
    color: #999;
    padding: 12px 24px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-secondary:hover {
    border-color: #999;
}

.table-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f0f0f0;
}

.suivi-table {
    width: 100%;
    border-collapse: collapse;
}

.suivi-table th {
    background: #f9f5ff;
    padding: 15px;
    text-align: left;
    font-weight: 600;
    color: #8b5cf6;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.suivi-table td {
    padding: 15px;
    border-bottom: 1px solid #f0f0f0;
    color: #333;
}

.suivi-table tbody tr:hover {
    background: #f9f5ff;
}

.progress-bar {
    position: relative;
    width: 100px;
    height: 24px;
    background: #f0f0f0;
    border-radius: 12px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #8b5cf6 0%, #a78bfa 100%);
    width: 0%;
    transition: width 1s ease-out;
}

.progress-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #333;
    font-size: 0.75rem;
    font-weight: 600;
}

.action-buttons-table {
    display: flex;
    gap: 8px;
}

.btn-table {
    padding: 6px 12px;
    border: 1px solid #e9d5ff;
    background: white;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.8rem;
    text-decoration: none;
    color: #8b5cf6;
}

.btn-table:hover {
    background: #f9f5ff;
    border-color: #8b5cf6;
}

.search-bar {
    margin-bottom: 20px;
}

.search-bar input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.95rem;
}

.search-bar input::placeholder {
    color: #999;
}

.empty-state {
    text-align: center;
    padding: 40px;
    color: #999;
}

.empty-icon {
    font-size: 3rem;
    margin-bottom: 15px;
}

.empty-title {
    font-size: 1.1rem;
    color: #333;
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    .form-content {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}
    
            <div class="stat-trend">↑ Moyenne</div>
        </div>
        <div class="stat-icon icon-pink">📈</div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <h3>Score Maximum</h3>
            <div class="stat-number">
                {% set maxScore = 0 %}
                {% for st in suivi_totals %}
                    {% if st.moyenneGenerale and st.moyenneGenerale > maxScore %}
                        {% set maxScore = st.moyenneGenerale %}
                    {% endif %}
                {% endfor %}
                {{ maxScore|number_format(1, ',', ' ') }}
            </div>
            <div class="stat-trend">↑ Meilleur</div>
        </div>
        <div class="stat-icon icon-blue">⭐</div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <h3>Niveaux Utilisés</h3>
            <div class="stat-number">
                {% set niveauxUsed = [] %}
                {% for st in suivi_totals %}
                    {% if st.niveauJeu and st.niveauJeu.id not in niveauxUsed %}
                        {% set niveauxUsed = niveauxUsed|merge([st.niveauJeu.id]) %}
                    {% endif %}
                {% endfor %}
                {{ niveauxUsed|length }}
            </div>
            <div class="stat-trend">↑ en cours</div>
        </div>
        <div class="stat-icon icon-green">🎮</div>
    </div>
// ...existing code...
{% endblock %}

<div class="form-section">
    <div class="form-section-header">
        <span>ℹ️</span>
        <div>
            <h2 class="form-section-title">Ajouter / Modifier un Suivi</h2>
            <small style="color: #999;">Mode: Ajout</small>
        </div>
    </div>

    <div class="form-content">
        <div class="form-wrapper">
            {{ form_start(form) }}

            <div class="form-group">
                {{ form_label(form.enfantId, 'ID Enfant') }}
                {{ form_widget(form.enfantId) }}
            </div>

            {# Duplicate rendering of noteCours removed to prevent Twig exception #}

            <div class="form-group">
                {{ form_label(form.noteConsultation, 'Note de Consultation') }}
                {{ form_widget(form.noteConsultation) }}
            </div>

            <div class="form-group">
                {{ form_label(form.remarque, 'Remarque') }}
                {{ form_widget(form.remarque) }}
            </div>

            <div class="form-group">
                {{ form_label(form.moyenne, 'Moyenne Générale') }}
                {{ form_widget(form.moyenne) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">💾 Enregistrer</button>
                <a href="{{ path('app_suivi_total_index') }}" class="btn-secondary">✕ Annuler</a>
            </div>

            {{ form_end(form) }}
        </div>

        <div class="chart-placeholder">
            <div class="chart-container">
                <canvas id="progressChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card-box">
    <div class="card-box-header" style="display:flex;justify-content:space-between;align-items:center;">
        <span class="card-box-title"><i class="fas fa-list"></i> Liste des Suivis Totaux</span>
        <input type="text" class="form-control filter-input" id="suiviFilterInput" placeholder="Filtrer..." style="max-width:200px;">
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table" id="suiviTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Enfant</th>
                        <th>Moyenne</th>
                        <th>Remarque</th>
                        <th>Niveau</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for suivi in suivi_totals %}
                        <tr>
                            <td>{{ suivi.id }}</td>
                            <td>Enfant #{{ suivi.enfantId }}</td>
                            <td>
                                <span class="badge-status badge-active">{{ suivi.moyenneGenerale|default('-') }}</span>
                            </td>
                            <td>{{ suivi.remarque|default('-') }}</td>
                            <td>{{ suivi.niveauJeu ? suivi.niveauJeu.libelle : '-' }}</td>
                            <td>
                                <a href="{{ path('app_suivi_total_edit', {'id': suivi.id}) }}" class="btn-edit-soft me-1">Modifier</a>
                                <a href="{{ path('app_suivi_total_delete', {'id': suivi.id}) }}" class="btn-danger-soft">Supprimer</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-state">Aucun suivi trouvé</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

