{% extends 'base.html.twig' %}

{% block title %}AutiCare - Analyse d'émotion 🧠😊{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Nunito', 'Segoe UI', sans-serif;
        }

        .emotion-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Carte principale */
        .main-card {
            background: white;
            border-radius: 50px;
            padding: 40px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            text-align: center;
        }

        .title {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            font-family: 'Baloo 2', cursive;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
        }

        /* Zone webcam */
        .webcam-area {
            background: #1a1a2e;
            border-radius: 30px;
            padding: 20px;
            margin-bottom: 20px;
            position: relative;
        }

        video, canvas {
            border-radius: 20px;
            width: 100%;
            max-width: 640px;
            height: auto;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        /* Émotions */
        .emotions-grid {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 30px 0;
            flex-wrap: wrap;
        }

        .emotion-badge {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 20px;
            background: #f8f9fa;
            border-radius: 60px;
            transition: all 0.3s;
            cursor: pointer;
        }

        .emotion-badge:hover {
            transform: translateY(-5px);
            background: #f0e6ff;
        }

        .emotion-emoji {
            font-size: 2rem;
        }

        .emotion-name {
            font-size: 0.8rem;
            font-weight: bold;
            color: #555;
        }

        /* Boutons */
        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 20px 0;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Baloo 2', cursive;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(102,126,234,0.4);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #34d399);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #f97316);
            color: white;
        }

        /* Résultat */
        .result-card {
            background: linear-gradient(135deg, #f5f0ff, #ffffff);
            border-radius: 30px;
            padding: 25px;
            margin-top: 20px;
            border: 2px solid #e0d4ff;
            display: none;
        }

        .result-emoji {
            font-size: 5rem;
            animation: bounce 0.5s ease;
        }

        .result-text {
            font-size: 2rem;
            font-weight: bold;
            color: #7c3aed;
            margin: 10px 0;
        }

        .confidence-bar {
            background: #e0d4ff;
            border-radius: 20px;
            height: 20px;
            width: 100%;
            max-width: 300px;
            margin: 10px auto;
            overflow: hidden;
        }

        .confidence-fill {
            background: linear-gradient(135deg, #667eea, #764ba2);
            height: 100%;
            width: 0%;
            border-radius: 20px;
            transition: width 0.5s ease;
        }

        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }

        /* Historique */
        .history-section {
            margin-top: 30px;
            padding: 20px;
            background: rgba(255,255,255,0.9);
            border-radius: 30px;
        }

        .history-title {
            font-size: 1.2rem;
            font-weight: bold;
            color: #7c3aed;
            margin-bottom: 15px;
        }

        .history-list {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .history-item {
            background: #f0e6ff;
            padding: 8px 15px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

        .status {
            font-size: 0.8rem;
            color: #888;
            margin-top: 15px;
        }

        /* Bouton retour */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 10px 20px;
            border-radius: 50px;
            text-decoration: none;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .back-btn:hover {
            background: rgba(255,255,255,0.3);
            transform: translateX(-5px);
        }

        @media (max-width: 768px) {
            .main-card { padding: 20px; }
            .title { font-size: 1.8rem; }
            .result-text { font-size: 1.5rem; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="emotion-container">
    <a href="{{ path('app_events') }}" class="back-btn">
        ← Retour aux événements
    </a>

    <div class="main-card">
        <h1 class="title">🧠 Analyse d'Émotion</h1>
        <p class="subtitle">Prends une photo et découvre ton émotion !</p>

        <!-- Zone webcam -->
        <div class="webcam-area">
            <video id="video" width="640" height="480" autoplay muted></video>
            <canvas id="canvas" width="640" height="480" style="display: none;"></canvas>
        </div>

        <!-- Émotions de référence -->
        <div class="emotions-grid">
            <div class="emotion-badge"><span class="emotion-emoji">😊</span><span class="emotion-name">Joie</span></div>
            <div class="emotion-badge"><span class="emotion-emoji">😢</span><span class="emotion-name">Tristesse</span></div>
            <div class="emotion-badge"><span class="emotion-emoji">😠</span><span class="emotion-name">Colère</span></div>
            <div class="emotion-badge"><span class="emotion-emoji">😲</span><span class="emotion-name">Surprise</span></div>
            <div class="emotion-badge"><span class="emotion-emoji">😨</span><span class="emotion-name">Peur</span></div>
            <div class="emotion-badge"><span class="emotion-emoji">😐</span><span class="emotion-name">Neutre</span></div>
        </div>

        <!-- Boutons -->
        <div class="btn-group">
            <button class="btn btn-primary" id="startCameraBtn">📷 Activer la webcam</button>
            <button class="btn btn-success" id="captureBtn" disabled>📸 Prendre la photo</button>
            <button class="btn btn-danger" id="stopCameraBtn">⏹ Arrêter</button>
        </div>

        <!-- Résultat -->
        <div id="resultCard" class="result-card">
            <div class="result-emoji" id="resultEmoji">😊</div>
            <div class="result-text" id="resultText">Joie</div>
            <div class="confidence-bar">
                <div class="confidence-fill" id="confidenceFill"></div>
            </div>
            <p id="confidenceText" style="color:#666;">Confiance: 85%</p>
        </div>

        <!-- Historique -->
        <div class="history-section">
            <div class="history-title">📜 Historique des analyses</div>
            <div class="history-list" id="historyList">
                <div class="history-item">Aucune analyse encore</div>
            </div>
        </div>

        <div class="status" id="status">✅ Prêt - Active la webcam</div>
    </div>
</div>

<script>
    // Éléments DOM
    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const startBtn = document.getElementById('startCameraBtn');
    const captureBtn = document.getElementById('captureBtn');
    const stopBtn = document.getElementById('stopCameraBtn');
    const resultCard = document.getElementById('resultCard');
    const resultEmoji = document.getElementById('resultEmoji');
    const resultText = document.getElementById('resultText');
    const confidenceFill = document.getElementById('confidenceFill');
    const confidenceText = document.getElementById('confidenceText');
    const statusDiv = document.getElementById('status');
    const historyList = document.getElementById('historyList');

    let stream = null;
    let history = [];

    // Mapping émotions
    const emotionMap = {
        '😊 Joie': { emoji: '😊', text: 'Joie', color: '#fbbf24' },
        '😢 Tristesse': { emoji: '😢', text: 'Tristesse', color: '#60a5fa' },
        '😲 Surprise': { emoji: '😲', text: 'Surprise', color: '#f97316' },
        '😠 Colère': { emoji: '😠', text: 'Colère', color: '#ef4444' },
        '😨 Peur': { emoji: '😨', text: 'Peur', color: '#8b5cf6' },
        '🤢 Dégout': { emoji: '🤢', text: 'Dégout', color: '#10b981' },
        '😐 Neutre': { emoji: '😐', text: 'Neutre', color: '#9ca3af' }
    };

    // Démarrer la webcam
    startBtn.addEventListener('click', async () => {
        try {
            stream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = stream;
            captureBtn.disabled = false;
            startBtn.disabled = true;
            stopBtn.disabled = false;
            statusDiv.innerHTML = '✅ Webcam activée - Prêt à capturer';
            statusDiv.style.color = '#10b981';
        } catch (err) {
            console.error(err);
            statusDiv.innerHTML = '❌ Impossible d\'accéder à la webcam';
            statusDiv.style.color = '#ef4444';
        }
    });

    // Arrêter la webcam
    stopBtn.addEventListener('click', () => {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
            video.srcObject = null;
            stream = null;
        }
        captureBtn.disabled = true;
        startBtn.disabled = false;
        stopBtn.disabled = true;
        statusDiv.innerHTML = '✅ Webcam arrêtée - Clique sur "Activer" pour recommencer';
        statusDiv.style.color = '#888';
    });

    // Capturer et analyser
    captureBtn.addEventListener('click', async () => {
        if (!stream) {
            statusDiv.innerHTML = '❌ Active d\'abord la webcam';
            return;
        }

        // Capture
        const context = canvas.getContext('2d');
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        context.drawImage(video, 0, 0, canvas.width, canvas.height);

        // Animation flash
        const flash = document.createElement('div');
        flash.style.position = 'fixed';
        flash.style.top = 0;
        flash.style.left = 0;
        flash.style.width = '100%';
        flash.style.height = '100%';
        flash.style.backgroundColor = 'white';
        flash.style.opacity = 0.5;
        flash.style.zIndex = 9999;
        flash.style.pointerEvents = 'none';
        document.body.appendChild(flash);
        setTimeout(() => flash.remove(), 200);

        // Préparer l'image
        const imageData = canvas.toDataURL('image/jpeg').split(',')[1];

        // UI pendant l'analyse
        captureBtn.disabled = true;
        captureBtn.innerHTML = '⏳ Analyse en cours...';
        statusDiv.innerHTML = '🧠 Analyse en cours...';
        statusDiv.style.color = '#f59e0b';

        try {
            // Appel au serveur Flask
            const response = await fetch('http://localhost:5000/analyze', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ image: imageData })
            });

            if (!response.ok) throw new Error('Erreur serveur');

            const data = await response.json();
            console.log('Résultat:', data);

            const emotionInfo = emotionMap[data.emotion] || { emoji: '🤔', text: data.emotion, color: '#a855f7' };
            const confidence = Math.round(data.confidence * 100);

            // Afficher résultat
            resultEmoji.textContent = emotionInfo.emoji;
            resultText.textContent = emotionInfo.text;
            confidenceFill.style.width = `${confidence}%`;
            confidenceText.textContent = `Confiance: ${confidence}%`;
            resultCard.style.display = 'block';

            // Ajouter à l'historique
            addToHistory(emotionInfo.emoji, emotionInfo.text, confidence);

            statusDiv.innerHTML = `✅ Émotion détectée : ${emotionInfo.text} (${confidence}%)`;
            statusDiv.style.color = '#10b981';

            // Animation sur le résultat
            resultEmoji.style.animation = 'none';
            setTimeout(() => resultEmoji.style.animation = 'bounce 0.5s ease', 10);

        } catch (error) {
            console.error('Erreur:', error);
            statusDiv.innerHTML = '❌ Erreur de connexion au serveur Flask. Vérifie qu\'il tourne sur localhost:5000';
            statusDiv.style.color = '#ef4444';
            alert('⚠️ Le serveur d\'analyse n\'est pas accessible.\n\nVérifie que le serveur Flask tourne sur http://localhost:5000');
        } finally {
            captureBtn.disabled = false;
            captureBtn.innerHTML = '📸 Prendre la photo';
        }
    });

    // Ajouter à l'historique
    function addToHistory(emoji, text, confidence) {
        history.unshift({ emoji, text, confidence, date: new Date() });
        if (history.length > 5) history.pop();

        updateHistoryDisplay();
    }

    function updateHistoryDisplay() {
        if (history.length === 0) {
            historyList.innerHTML = '<div class="history-item">Aucune analyse encore</div>';
            return;
        }

        historyList.innerHTML = history.map(item => `
            <div class="history-item">
                ${item.emoji} ${item.text} (${item.confidence}%)
            </div>
        `).join('');
    }

    // Désactiver capture au départ
    captureBtn.disabled = true;
    stopBtn.disabled = true;
</script>
{% endblock %}