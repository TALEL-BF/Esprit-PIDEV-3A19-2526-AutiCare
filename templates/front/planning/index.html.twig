{# templates/front/planning/index.html.twig #}
{% extends 'base.html.twig' %}

{% set current_page_title = page_title|default('Planning') %}
{% set current_page_subtitle = page_subtitle|default('Consultez les creneaux disponibles.') %}

{% block title %}AutiCare - {{ current_page_title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary: #4d65f9;
            --secondary: #ff4880;
            --course: #4d65f9;
            --psychology: #ff4880;
        }

        body {
            background: #f8f9ff;
        }

        .day-tab {
            background: white;
            border-radius: 60px;
            padding: 6px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            display: inline-flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .day-btn {
            padding: 12px 28px;
            border-radius: 50px;
            border: none;
            background: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            color: #6c757d;
        }

        .day-btn:hover {
            background: rgba(77,101,249,0.1);
            color: var(--primary);
        }

        .day-btn.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 15px rgba(77,101,249,0.3);
        }

        .schedule-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            height: 100%;
            border: 1px solid rgba(77,101,249,0.1);
        }

        .schedule-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(77,101,249,0.15);
            border-color: var(--primary);
        }

        .time-badge {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .session-type {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .session-type.cours {
            background: rgba(77,101,249,0.1);
            color: var(--primary);
        }

        .session-type.psychologue {
            background: rgba(255,72,128,0.1);
            color: var(--secondary);
        }

        .therapist-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            background: rgba(77,101,249,0.1);
        }

        .session-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .action-btn {
            border-radius: 30px;
            padding: 9px 16px;
            font-size: 0.82rem;
            font-weight: 700;
            border: 1px solid transparent;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 1;
            white-space: nowrap;
        }

        .action-btn-join {
            background: #fff;
            border-color: var(--primary);
            color: var(--primary);
        }

        .action-btn-join:hover {
            background: var(--primary);
            color: #fff;
            transform: translateY(-1px);
        }

        .action-btn-disabled {
            background: #f3f4f6;
            border-color: #e5e7eb;
            color: #6b7280;
            pointer-events: none;
            cursor: not-allowed;
        }

        .action-pill-disabled {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 13px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            color: #6b7280;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            transition: 0.2s;
            border: 1px solid rgba(77,101,249,0.1);
        }

        .stat-card:hover {
            border-color: var(--primary);
            transform: translateY(-3px);
        }

        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

        .legend-dot.cours { background: var(--primary); }
        .legend-dot.psychologue { background: var(--secondary); }

        .today-highlight {
            background: linear-gradient(135deg, rgba(77,101,249,0.05), rgba(255,72,128,0.05));
            border-left: 4px solid var(--primary);
        }

        .filter-section {
            background: white;
            border-radius: 60px;
            padding: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            border: 1px solid rgba(77,101,249,0.1);
        }
        
        .page-header {
            background: linear-gradient(135deg, #4d65f9 0%, #ff4880 100%);
            padding: 60px 0;
        }

        .page-header .display-3 {
            letter-spacing: 0.2px;
            font-weight: 700;
        }
        
        .btn-border-radius {
            border-radius: 50px !important;
        }
        .btn-gradient {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #fff !important;
            border: none;
            border-radius: 30px;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(77,101,249,0.15);
            padding: 8px 22px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
            transition: all 0.3s;
        }
        .btn-gradient:hover, .btn-gradient:focus {
            filter: brightness(1.08) saturate(1.2);
            box-shadow: 0 8px 24px rgba(77,101,249,0.22);
            color: #fff !important;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="container-fluid page-header py-5">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white mb-3 wow fadeInDown">{{ current_page_title }}</h1>
            <p class="text-white opacity-75 mb-3 wow fadeInUp" data-wow-delay="0.1s">{{ current_page_subtitle }}</p>
            <nav aria-label="breadcrumb" class="wow fadeInUp" data-wow-delay="0.2s">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item text-secondary active">{{ current_page_title }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="container-fluid py-4 bg-light wow fadeInUp" data-wow-delay="0.05s">
        <div class="container">
            <div class="row g-3">
                {% for stat in stats %}
                <div class="col-md-3 wow fadeInUp" data-wow-delay="0.{{ loop.index }}s">
                    <div class="stat-card">
                        <i class="{{ stat.icon }} fa-2x text-{{ stat.color }} mb-2"></i>
                        <h3 class="fw-bold mb-0">{{ stat.value }}</h3>
                        <p class="text-muted mb-0">{{ stat.label }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Legend & Filter -->
    <div class="container-fluid py-4 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container">
            <div class="filter-section d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex gap-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot cours"></span>
                        <span class="small">Cours éducatifs</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot psychologue"></span>
                        <span class="small">Rendez-vous psychologue</span>
                    </div>
                </div>
                <div class="position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="searchSession" class="form-control ps-5 pe-4" placeholder="Rechercher un professeur..." style="border-radius: 40px; border: 1px solid #e0e0e0; min-width: 220px;">
                </div>
            </div>
        </div>
    </div>

    <!-- Day Tabs -->
    <div class="container-fluid py-3 wow fadeInUp" data-wow-delay="0.15s">
        <div class="container">
            <div class="d-flex justify-content-center">
                <div class="day-tab">
                    <button class="day-btn" data-day="Dimanche">📅 Dimanche</button>
                    <button class="day-btn" data-day="Lundi">📅 Lundi</button>
                    <button class="day-btn" data-day="Mardi">📅 Mardi</button>
                    <button class="day-btn" data-day="Mercredi">📅 Mercredi</button>
                    <button class="day-btn" data-day="Jeudi">📅 Jeudi</button>
                    <button class="day-btn" data-day="Vendredi">📅 Vendredi</button>
                    <button class="day-btn" data-day="Samedi">📅 Samedi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedule Grid -->
    <div class="container-fluid py-4 wow fadeInUp" data-wow-delay="0.2s">
        <div class="container">
            <div id="scheduleContainer" class="row g-4">
                <!-- Schedule will be populated by JS -->
            </div>
            <div id="noSessions" class="text-center py-5 d-none">
                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Aucun element programme</h5>
                <p class="text-muted">Aucun creneau n'est disponible pour ce jour. Consultez les autres jours.</p>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="container-fluid py-5 bg-light">
        <div class="container py-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <div class="bg-white rounded-4 p-4 shadow-sm">
                        <h4 class="text-primary mb-3"><i class="fas fa-info-circle me-2"></i> Comment ça marche ?</h4>
                        <div class="d-flex gap-3 mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; flex-shrink:0;">
                                <i class="fas fa-mouse-pointer text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">1. Choisissez votre créneau</h6>
                                <p class="text-muted small mb-0">Sélectionnez le jour et l'horaire qui vous convient dans le planning</p>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; flex-shrink:0;">
                                <i class="fas fa-link text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">2. Ouvrez le lien de réunion</h6>
                                <p class="text-muted small mb-0">Cliquez sur Rejoindre la réunion au moment prévu de la séance</p>
            
                <div class="col-lg-6">
                    <div class="bg-primary rounded-4 p-4 text-white text-center">
                        <i class="fas fa-headset fa-3x text-secondary mb-3"></i>
                        <h4 class="text-white mb-2">Besoin d'aide ?</h4>
                        <p class="opacity-75 mb-3">Notre équipe est à votre disposition pour vous aider à organiser vos séances</p>
                        <a href="#" class="btn btn-light btn-border-radius px-4">Nous contacter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Sessions data from PHP
        const sessions = {{ sessions|json_encode|raw }};
        const allowedDays = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        const currentUserId = {{ app.user ? app.user.id : 'null' }};
        const latestSeanceNotification = {{ (latest_seance_notification is defined and latest_seance_notification) ? latest_seance_notification|json_encode|raw : 'null' }};

        function showLatestSeanceNotification() {
            if (!latestSeanceNotification || !window.notify) {
                return;
            }

            const storageKey = 'auticare_last_seen_seance_notification';
            const lastSeenId = localStorage.getItem(storageKey);

            if (lastSeenId === latestSeanceNotification.id) {
                return;
            }

            window.notify.show({
                type: latestSeanceNotification.type || 'info',
                icon: latestSeanceNotification.icon || 'ℹ️',
                title: latestSeanceNotification.title,
                message: latestSeanceNotification.message,
                duration: latestSeanceNotification.duration || 60000,
                dismissible: true,
            });

            localStorage.setItem(storageKey, latestSeanceNotification.id);
        }
        
        function getCurrentDay() {
            const days = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
            return days[new Date().getDay()];
        }

        function renderSchedule(selectedDay, searchTerm = '') {
            let filteredSessions = sessions.filter(s => allowedDays.includes(s.day) && s.day === selectedDay);
            if (searchTerm) {
                filteredSessions = filteredSessions.filter(s =>
                    s.therapist.toLowerCase().includes(searchTerm) ||
                    s.title.toLowerCase().includes(searchTerm) ||
                    s.specialty.toLowerCase().includes(searchTerm)
                );
            }
            filteredSessions.sort((a, b) => parseInt(a.time.split('h')[0]) - parseInt(b.time.split('h')[0]));

            const container = document.getElementById('scheduleContainer');
            const noSessionsDiv = document.getElementById('noSessions');

            if (filteredSessions.length === 0) {
                noSessionsDiv.classList.remove('d-none');
                container.innerHTML = '';
                return;
            }
            noSessionsDiv.classList.add('d-none');

            const isToday = selectedDay === getCurrentDay();
            container.innerHTML = filteredSessions.map(session => `
                <div class="col-md-6 col-lg-4">
                    <div class="schedule-card ${isToday ? 'today-highlight' : ''}">
                        <div class="p-4">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="therapist-avatar">${session.icon}</div>
                                    <div>
                                        <h6 class="fw-bold mb-0">${session.therapist}</h6>
                                        <p class="small text-muted mb-0">${session.specialty}</p>
                                    </div>
                                </div>
                                <span class="session-type ${session.type === 'cours' ? 'cours' : 'psychologue'}">
                                    ${session.type === 'cours' ? '<i class="fas fa-book-open me-1"></i> Cours' : '<i class="fas fa-heart me-1"></i> Psychologue'}
                                </span>
                            </div>
                            <div class="mb-3">
                                <span class="time-badge"><i class="far fa-clock me-1"></i> ${session.time}</span>
                                <span class="badge bg-light text-dark ms-2">${session.level}</span>
                            </div>
                            <h5 class="fw-bold mb-2">${session.title}</h5>
                            <p class="text-muted small mb-3">${session.description}</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-video text-primary"></i>
                                    <span class="small text-muted">Visioconférence</span>
                                </div>
                                ${session.available
                                    ? (session.zoomJoinUrl
                                        ? `<div class="session-actions">
                                            <a href="${currentUserId !== null && Number(currentUserId) === Number(session.professorId) && session.zoomStartUrl ? session.zoomStartUrl : session.zoomJoinUrl}"
                                               target="_blank" rel="noopener noreferrer"
                                               class="btn-gradient">
                                                <i class="far fa-clock"></i> ${currentUserId !== null && Number(currentUserId) === Number(session.professorId) ? 'Lancer la réunion' : 'Rejoindre la réunion'}
                                            </a>
                                        </div>`
                                        : `<div class="session-actions"><span class="action-btn action-btn-disabled"><i class="fas fa-link-slash"></i> Lien indisponible</span></div>`)
                                    : `<span class="action-pill-disabled"><i class="fas fa-clock"></i> Indisponible</span>`
                                }
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        let currentDay = "Lundi";
        let currentSearch = '';

        document.querySelectorAll('.day-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentDay = this.dataset.day;
                renderSchedule(currentDay, currentSearch);
            });
        });

        document.getElementById('searchSession').addEventListener('input', function (e) {
            currentSearch = e.target.value.toLowerCase();
            renderSchedule(currentDay, currentSearch);
        });

        // Initialisation : activer le jour actuel
        const today = getCurrentDay();
        currentDay = (today !== 'Dimanche') ? today : 'Lundi';
        document.querySelectorAll('.day-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.day === currentDay);
        });
        renderSchedule(currentDay);
        showLatestSeanceNotification();
    </script>
{% endblock %}