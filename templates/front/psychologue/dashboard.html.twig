{% extends "base.html.twig" %}

{% block title %}Psychologue Dashboard - AutiCare{% endblock %}

{% block page_title %}Dashboard Psychologue{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="welcome-card" style="background: linear-gradient(135deg, #9b59b6, #8e44ad);">
        <h2>Bienvenue, Dr. {{ app.user.prenom }} {{ app.user.nom }} !</h2>
        <p>Espace Psychologue - Suivez vos patients</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-week"></i><h4>Emploi du temps</h4><p>Planning</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-check"></i><h4>Rendez-vous</h4><p>Gérer les RDV</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-notes-medical"></i><h4>Suivi thérapeutique</h4><p>Progression</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-brain"></i><h4>Thérapies</h4><p>Plans thérapeutiques</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-newspaper"></i><h4>Articles & Conseils</h4><p>Ressources</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-alt"></i><h4>Événements</h4><p>Conférences</p></div></div>
    </div>
</div>
{% endblock %}