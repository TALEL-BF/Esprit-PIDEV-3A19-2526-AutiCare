{% extends 'base.html.twig' %}

{% block title %}Espace Psychologue - AutiCare{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card bg-info text-white p-4 mb-4 shadow">
                <h1><i class="fas fa-brain"></i> Espace Psychologue</h1>
                <p class="mb-0">Bienvenue Dr. <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong></p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-user-friends fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Mes Patients</h5>
                    <p class="card-text text-muted">Liste des patients</p>
                    <a href="#" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-calendar-week fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Séances</h5>
                    <p class="card-text text-muted">Gérer les séances</p>
                    <a href="#" class="btn btn-success">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-chart-line fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Évaluations</h5>
                    <p class="card-text text-muted">Suivi des progrès</p>
                    <a href="#" class="btn btn-warning">Analyser</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}