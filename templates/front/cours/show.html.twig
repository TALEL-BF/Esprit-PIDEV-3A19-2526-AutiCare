{# templates/front/cours/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}AutiCare – {{ cours.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --sun:      #FFD93D;
            --sky:      #6BCB77;
            --ocean:    #4D96FF;
            --coral:    #FF6B6B;
            --lavender: #C77DFF;
            --peach:    #FF9A3C;
            --mint:     #2EC4B6;
            --rose:     #FF6FA8;
            --bg:       #FFFBF4;
            --dark:     #1E2A3B;
        }

        * { box-sizing: border-box; }
        body { background: var(--bg); font-family: 'Nunito', sans-serif; }

        /* ══ TOP HERO ══ */
        .course-hero {
            background: linear-gradient(150deg, #5a288c 0%, #9b6bff 50%, #c77dff 100%);
            padding: 2.5rem 0 0;
            position: relative;
            overflow: hidden;
            border-bottom: 4px dashed rgba(255,158,207,0.35);
        }
        .course-hero::before {
            content: '';
            position: absolute; inset: 0;
            background-image:
                radial-gradient(circle at 5%  30%, rgba(255,105,180,0.18) 0%, transparent 35%),
                radial-gradient(circle at 95% 10%, rgba(255,255,255,0.10) 0%, transparent 35%),
                radial-gradient(circle at 50% 90%, rgba(183,148,244,0.20) 0%, transparent 30%);
            pointer-events: none;
        }

        .course-hero-inner {
            position: relative; z-index: 2;
            padding-bottom: 2.5rem;
        }

        .bc-link { color: rgba(255,255,255,0.70); font-size: 0.85rem; font-weight: 700; text-decoration: none; transition: color 0.2s; }
        .bc-link:hover { color: #fff; }
        .bc-sep { margin: 0 8px; color: rgba(255,255,255,0.40); }
        .bc-current { color: rgba(255,255,255,0.95); font-size: 0.85rem; font-weight: 700; }

        .course-type-pill {
            display: inline-flex; align-items: center; gap: 6px;
            font-family: 'Baloo 2', cursive; font-size: 0.78rem; font-weight: 800;
            padding: 5px 15px; border-radius: 30px;
            text-transform: uppercase; letter-spacing: 0.05em;
            margin-bottom: 1rem;
        }
        .type-Académique { background: #EBF5FF; color: var(--ocean); }
        .type-Social     { background: #EBFFEE; color: #2EA043; }
        .type-Motricité  { background: #FFF0EB; color: var(--coral); }
        .type-Langage    { background: #F5EBFF; color: var(--lavender); }
        .type-default    { background: #F5F5F5; color: #777; }

        .course-main-title {
            font-family: 'Baloo 2', cursive;
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 800;
            color: #fff;
            line-height: 1.15;
            margin-bottom: 0.7rem;
            text-shadow: 0 3px 18px rgba(0,0,0,0.2);
        }
        .course-main-desc {
            font-size: 1rem;
            color: rgba(255,255,255,0.85);
            line-height: 1.65;
            max-width: 560px;
            margin-bottom: 1.4rem;
        }

        .info-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1.6rem; }
        .info-chip {
            display: inline-flex; align-items: center; gap: 7px;
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(8px);
            padding: 9px 18px; border-radius: 50px;
            font-family: 'Nunito', sans-serif; font-size: 0.85rem; font-weight: 800;
            color: #fff;
            border: 2px solid rgba(255,255,255,0.30);
        }
        .chip-level  { border-color: rgba(255,217,61,0.6); }
        .chip-time   { border-color: rgba(107,203,119,0.6); }
        .chip-words  { border-color: rgba(255,158,207,0.6); }

        .course-hero-img-wrap {
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 16px 50px rgba(0,0,0,0.14);
            border: 4px solid white;
            aspect-ratio: 4/3;
            background: linear-gradient(135deg, #E8F4FF, #F5EBFF);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .course-hero-img-wrap img {
            width: 100%; height: 100%; object-fit: cover;
        }
        .hero-img-emoji {
            font-size: 7rem;
            animation: float-em 3s ease-in-out infinite;
            filter: drop-shadow(0 8px 16px rgba(0,0,0,0.12));
        }
        @keyframes float-em {
            0%,100% { transform: translateY(0) rotate(-5deg); }
            50%      { transform: translateY(-14px) rotate(5deg); }
        }

        .btn-back {
            display: inline-flex; align-items: center; gap: 7px;
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(8px);
            color: #fff;
            font-family: 'Baloo 2', cursive; font-size: 0.9rem; font-weight: 700;
            padding: 9px 20px; border-radius: 40px;
            text-decoration: none;
            border: 2px solid rgba(255,255,255,0.35);
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .btn-back:hover { transform: translateX(-4px) scale(1.04); background: rgba(255,255,255,0.28); color: #fff; }

        /* ══ CONTENT SECTION ══ */
        .content-section {
            background: linear-gradient(180deg, #F4F9FF 0%, var(--bg) 100%);
            padding: 3.5rem 0 5rem;
        }

        /* Description du cours */
        .course-description-card {
            background: white;
            border-radius: 28px;
            padding: 2rem;
            margin-bottom: 2.5rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            border: 2px solid rgba(155,107,255,0.12);
            text-align: center;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }
        .course-description-card h2 {
            font-family: 'Baloo 2', cursive;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .course-description-card p {
            font-size: 1rem;
            line-height: 1.7;
            color: #555;
            margin-bottom: 0;
        }

        /* Section Mots à apprendre */
        .mots-section-title {
            text-align: center;
            margin-bottom: 2rem;
        }
        .mots-section-title h2 {
            font-family: 'Baloo 2', cursive;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--dark);
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(135deg, #ff69b4, #9b6bff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        /* Grille des mots style design image */
        .mots-grid-design {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 0 auto 3rem auto;
        }

        .mot-item-design {
            background: white;
            border-radius: 24px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 8px 25px rgba(0,0,0,0.06);
            border: 2px solid rgba(155,107,255,0.12);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .mot-item-design:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(155,107,255,0.15);
            border-color: rgba(155,107,255,0.25);
        }

        /* ── Carousel image mot ── */
        .mot-carousel {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 18px;
            overflow: hidden;
            background: linear-gradient(135deg, #f5e8ff, #ffe8f4);
            margin-bottom: 1rem;
        }
        .mot-carousel-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        .mot-carousel-slide {
            flex: 0 0 100%;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .mot-carousel-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: zoom-in;
            border-radius: 18px;
        }
        .mot-carousel-emoji {
            font-size: 4.5rem;
        }
        .mot-carousel-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(6px);
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: 800;
            color: #7c3aed;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(0,0,0,0.14);
            transition: background 0.2s, transform 0.2s;
            z-index: 3;
        }
        .mot-carousel-btn:hover { background: #fff; transform: translateY(-50%) scale(1.1); }
        .mot-carousel-btn.prev { left: 8px; }
        .mot-carousel-btn.next { right: 8px; }
        .mot-carousel-dots {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 5px;
            z-index: 3;
        }
        .mot-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,0.5);
            border: 1.5px solid rgba(255,255,255,0.8);
            transition: background 0.2s, transform 0.2s;
            cursor: pointer;
        }
        .mot-dot.active {
            background: #fff;
            transform: scale(1.3);
        }
        .mot-img-count {
            position: absolute;
            top: 9px;
            right: 9px;
            background: rgba(124,58,237,0.85);
            color: #fff;
            font-family: 'Baloo 2', cursive;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 2px 9px;
            border-radius: 20px;
            z-index: 3;
            backdrop-filter: blur(4px);
        }

        .mot-item-design h3 {
            font-family: 'Baloo 2', cursive;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--dark);
            margin: 0.5rem 0 0;
        }
        .mot-item-design p {
            font-size: 0.85rem;
            color: #888;
            margin-top: 0.25rem;
            margin-bottom: 0;
        }

        /* Section évaluation */
        .evaluation-section {
            text-align: center;
            margin-top: 2rem;
            padding: 2rem;
            background: linear-gradient(135deg, #f8f4ff, #fff8f0);
            border-radius: 32px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }
        .evaluation-section h3 {
            font-family: 'Baloo 2', cursive;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 1rem;
        }
        .btn-quiz {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(135deg, #4D96FF, #C77DFF);
            color: white;
            font-family: 'Baloo 2', cursive;
            font-size: 1.2rem;
            font-weight: 800;
            padding: 14px 40px;
            border-radius: 60px;
            text-decoration: none;
            box-shadow: 0 8px 25px rgba(77,150,255,0.35);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: none;
            cursor: pointer;
        }
        .btn-quiz:hover {
            transform: scale(1.05) translateY(-3px);
            box-shadow: 0 12px 35px rgba(77,150,255,0.45);
        }
        .btn-quiz-disabled {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(135deg, #b0b0b0, #d0d0d0);
            color: white;
            font-family: 'Baloo 2', cursive;
            font-size: 1.2rem;
            font-weight: 800;
            padding: 14px 40px;
            border-radius: 60px;
            text-decoration: none;
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* Empty state */
        .empty-state {
            background: white;
            border-radius: 32px;
            padding: 3rem;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.07);
            border: 2px solid #F0F0F0;
            max-width: 600px;
            margin: 0 auto;
        }
        .empty-state-icon { font-size: 4rem; margin-bottom: 1rem; }
        .empty-state-title { font-family: 'Baloo 2', cursive; font-size: 1.4rem; font-weight: 800; color: #555; margin-bottom: 0.5rem; }
        .empty-state-text { color: #888; font-size: 0.9rem; }

        /* Sidebar */
        .sidebar-card {
            background: white;
            border-radius: 24px;
            padding: 1.5rem;
            box-shadow: 0 6px 24px rgba(0,0,0,0.08);
            border: 2px solid #F0F0F0;
            margin-bottom: 1.2rem;
        }
        .sidebar-card-title {
            font-family: 'Baloo 2', cursive;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .sidebar-stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            border-bottom: 1.5px dashed #F0F0F0;
        }
        .sidebar-stat-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .sidebar-stat-label {
            font-size: 0.82rem;
            font-weight: 700;
            color: #888;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .sidebar-stat-value {
            font-family: 'Baloo 2', cursive;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .niveau-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }
        .dot-Débutant      { background: #6BCB77; }
        .dot-Intermédiaire { background: #FFD93D; }
        .dot-Avancé        { background: #FF6B6B; }

        /* ══ PDF EXPORT BUTTON ══ */
        .btn-pdf-export {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, #ff6b6b, #ff9a3c, #ffd93d);
            background-size: 200% 200%;
            animation: pdf-gradient 3s ease infinite;
            color: white;
            font-family: 'Baloo 2', cursive;
            font-size: 0.95rem;
            font-weight: 800;
            padding: 11px 24px;
            border-radius: 50px;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(255,107,107,0.4);
            transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s;
            position: relative;
            overflow: hidden;
        }
        @keyframes pdf-gradient {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .btn-pdf-export::before {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
        }
        .btn-pdf-export:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 12px 30px rgba(255,107,107,0.5);
            color: white;
        }
        .btn-pdf-export:active { transform: scale(0.97); }
        .btn-pdf-export .pdf-icon {
            font-size: 1.15rem;
            animation: pdf-bounce 1.5s ease-in-out infinite;
        }
        @keyframes pdf-bounce {
            0%,100% { transform: translateY(0); }
            50%     { transform: translateY(-4px); }
        }
        .btn-pdf-export.loading {
            pointer-events: none;
            opacity: 0.8;
        }
        .btn-pdf-export.loading .pdf-icon {
            animation: pdf-spin 0.8s linear infinite;
        }
        @keyframes pdf-spin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .mots-grid-design {
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 20px;
            }
            .mot-item-design h3 {
                font-size: 1.2rem;
            }
            .btn-quiz, .btn-quiz-disabled {
                font-size: 1rem;
                padding: 12px 30px;
            }
        }
        @media (max-width: 480px) {
            .mots-grid-design {
                grid-template-columns: 1fr;
                gap: 16px;
            }
        }
    </style>
{% endblock %}

{% block body %}

    {% set emojis  = {'Académique': '📚', 'Social': '🤝', 'Motricité': '🏃', 'Langage': '💬'} %}
    {% set emoji   = emojis[cours.typeCours] ?? '🎓' %}
    {% set typeClass = 'type-' ~ cours.typeCours %}
    {% set motsCount = cours.getMotsCount() %}

    <!-- HERO -->
    <div class="course-hero">
        <div class="course-hero-inner">
            <div class="container">
                <div class="mb-3">
                    <a href="{{ path('app_home') }}" class="bc-link">🏠 Accueil</a>
                    <span class="bc-sep">›</span>
                    <a href="{{ path('app_cours') }}" class="bc-link">Cours</a>
                    <span class="bc-sep">›</span>
                    <span class="bc-current">{{ cours.titre }}</span>
                </div>

                <div class="row align-items-center g-4">
                    <div class="col-lg-7 col-md-6">
                        <span class="course-type-pill {{ typeClass }}">{{ emoji }} {{ cours.typeCours }}</span>
                        <h1 class="course-main-title">{{ cours.titre }}</h1>
                        <p class="course-main-desc">{{ cours.description|slice(0, 150) ~ (cours.description|length > 150 ? '...' : '') }}</p>
                        <div class="info-chips">
                            <span class="info-chip chip-level">📊 <strong>{{ cours.niveau }}</strong></span>
                            <span class="info-chip chip-time">⏱ <strong>{{ cours.duree }} min</strong></span>
                            {% if motsCount > 0 %}
                            <span class="info-chip chip-words">🔤 <strong>{{ motsCount }} mot{{ motsCount > 1 ? 's' : '' }}</strong></span>
                            {% endif %}
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <a href="{{ path('app_cours') }}" class="btn-back">← Retour aux cours</a>
                            <button class="btn-pdf-export" id="btnExportPdf">
                                <span class="pdf-icon">📄</span>
                                <span class="pdf-label">Exporter en PDF</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-5 col-md-6">
                        <div class="course-hero-img-wrap">
                            {% if cours.image %}
                                <img src="/uploads/images/{{ cours.image }}" alt="{{ cours.titre }}">
                            {% else %}
                                <span class="hero-img-emoji">{{ emoji }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content-section">
        <div class="container">

            <!-- Description complète du cours -->
            <div class="course-description-card">
                <h2>
                    <span>📖</span>
                    Description du cours
                    <span>✨</span>
                </h2>
                <p>{{ cours.description }}</p>
            </div>

            {% if motsCount > 0 %}

                <!-- Section Mots à apprendre -->
                <div class="mots-section-title">
                    <h2>
                        <span>🐾</span>
                        Mots à apprendre
                        <span>📚</span>
                    </h2>
                </div>

                {% set wordEmojis = ['🐶', '🦁', '🦒', '🐘', '🐒', '🦓', '🐪', '🐅', '🐳', '🐋'] %}

                <!-- Grille des mots avec images associées -->
                <div class="mots-grid-design">
                    {% for entry in motsWithImages %}
                        {% set mot = entry.nom|trim %}
                        {% if mot %}
                            {% set images = entry.toutes_images %}
                            {% set imgCount = images|length %}

                            <div class="mot-item-design">

                                {# ── Carousel ── #}
                                <div class="mot-carousel" data-index="{{ loop.index0 }}">

                                    {% if imgCount > 1 %}
                                        <span class="mot-img-count">{{ imgCount }} 🖼</span>
                                    {% endif %}

                                    <div class="mot-carousel-track">
                                        {% if imgCount > 0 %}
                                            {% for img in images %}
                                                <div class="mot-carousel-slide">
                                                    <img src="/uploads/images/{{ img|trim }}"
                                                         alt="{{ mot }}"
                                                         class="lightbox-trigger"
                                                         data-src="/uploads/images/{{ img|trim }}">
                                                </div>
                                            {% endfor %}
                                        {% else %}
                                            <div class="mot-carousel-slide">
                                                <span class="mot-carousel-emoji">
                                                    {{ wordEmojis[loop.index0 % wordEmojis|length] }}
                                                </span>
                                            </div>
                                        {% endif %}
                                    </div>

                                    {% if imgCount > 1 %}
                                        <button class="mot-carousel-btn prev" aria-label="Précédent">‹</button>
                                        <button class="mot-carousel-btn next" aria-label="Suivant">›</button>
                                        <div class="mot-carousel-dots">
                                            {% for i in 0..(imgCount - 1) %}
                                                <span class="mot-dot {{ i == 0 ? 'active' : '' }}" data-slide="{{ i }}"></span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                </div>

                                <h3>{{ mot|upper }}</h3>
                                {% if imgCount > 0 %}
                                    <p>{{ imgCount }} image{{ imgCount > 1 ? 's' : '' }}</p>
                                {% else %}
                                    <p>Aucune image</p>
                                {% endif %}

                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

            {% else %}
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <div class="empty-state-title">Aucun mot dans ce cours</div>
                    <div class="empty-state-text">Le contenu sera bientôt ajouté.</div>
                </div>
            {% endif %}

            <!-- Section Évaluation du cours -->
            <div class="evaluation-section">
                <h3>
                    <span>📝</span>
                    Évaluation du cours
                    <span>⭐</span>
                </h3>
                {% if hasQuiz %}
                    <p style="color:#666; font-size:0.95rem; margin-bottom:1.2rem;">
                        {{ evaluations|length }} question{{ evaluations|length > 1 ? 's' : '' }} t'attend{{ evaluations|length > 1 ? 'ent' : '' }} !
                    </p>
