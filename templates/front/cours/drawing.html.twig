            saveToHistory();
            showNotification('⭐ Une jolie étoile !');
        },
        heart2: () => {
            drawHeart(canvas.width/2, canvas.height/2, 30);
            saveToHistory();
            showNotification('❤️ Un beau cœur !');
        },
        moon: () => {
            ctx.beginPath();
            ctx.ellipse(canvas.width/2, canvas.height/2 - 20, 35, 35, 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.fillStyle = 'white';
            ctx.fillRect(canvas.width/2 - 20, canvas.height/2 - 40, 50, 50);
