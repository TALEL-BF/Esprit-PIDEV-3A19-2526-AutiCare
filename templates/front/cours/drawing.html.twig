    function addAnimal(type, x, y) {
        animals.push({ type: type, x: x, y: y, size: 100 });
        saveToHistory();
        redrawEverything();
        showNotification(`🐾 ${getAnimalName(type)} apparaît ! Tu peux le déplacer !`);
        createStars();
    }
    
    function getAnimalName(type) {
        const names = { cat: 'Chat', dog: 'Chien', bird: 'Oiseau', fish: 'Poisson', butterfly: 'Papillon', rabbit: 'Lapin', frog: 'Grenouille', bee: 'Abeille', owl: 'Hibou', penguin: 'Pingouin' };
        return names[type] || 'Animal';
    }
    
    function selectAnimal(index) {
        selectedAnimalIndex = index;
        const controls = document.getElementById('animalControls');
        if (selectedAnimalIndex >= 0) {
            controls.style.display = 'flex';
            document.querySelectorAll('.animal-btn').forEach(btn => btn.classList.remove('selected'));
        } else {
            controls.style.display = 'none';
            isResizingMode = false;
        }
        redrawEverything();
    }
    
    function deleteSelectedAnimal() {
        if (selectedAnimalIndex >= 0) {
            animals.splice(selectedAnimalIndex, 1);
            selectedAnimalIndex = -1;
            isResizingMode = false;
            redrawEverything();
            showNotification('🗑️ Animal supprimé !');
            document.getElementById('animalControls').style.display = 'none';
        }
    }
    
    function getAnimalAt(x, y) {
        for (let i = animals.length - 1; i >= 0; i--) {
            const animal = animals[i];
            const dx = x - animal.x;
            const dy = y - animal.y;
            const distance = Math.sqrt(dx*dx + dy*dy);
            if (distance < animal.size / 1.5) return i;
        }
        return -1;
    }
    
    function handleCanvasMouseDown(e) {
        const pos = getMousePos(canvas, e);
        
        if (isResizingMode && selectedAnimalIndex >= 0) {
            resizeStartX = pos.x;
            resizeStartY = pos.y;
            resizeStartSize = animals[selectedAnimalIndex].size;
            return;
        }
        
        const animalIndex = getAnimalAt(pos.x, pos.y);
        if (animalIndex >= 0) {
            selectAnimal(animalIndex);
            isDraggingAnimal = true;
            const animal = animals[animalIndex];
            dragOffsetX = pos.x - animal.x;
            dragOffsetY = pos.y - animal.y;
            canvas.style.cursor = 'grabbing';
            return;
        } else {
            selectAnimal(-1);
            startDrawing(e);
        }
    }
    
    function handleCanvasMouseMove(e) {
        const pos = getMousePos(canvas, e);
        
        if (isResizingMode && selectedAnimalIndex >= 0 && resizeStartX !== 0) {
            const delta = (pos.x - resizeStartX + pos.y - resizeStartY) / 2;
            let newSize = Math.max(50, Math.min(200, resizeStartSize + delta));
            animals[selectedAnimalIndex].size = newSize;
            redrawEverything();
            return;
        }
        
        if (isDraggingAnimal && selectedAnimalIndex >= 0) {
            animals[selectedAnimalIndex].x = pos.x - dragOffsetX;
            animals[selectedAnimalIndex].y = pos.y - dragOffsetY;
            redrawEverything();
            return;
        }
        
        const animalIndex = getAnimalAt(pos.x, pos.y);
        if (animalIndex >= 0) {
            canvas.style.cursor = 'grab';
        } else {
            canvas.style.cursor = 'crosshair';
        }
        
        if (drawing && !isDraggingAnimal && !isResizingMode) {
            draw(e);
        }
    }
    
    function handleCanvasMouseUp(e) {
        if (isDraggingAnimal && selectedAnimalIndex >= 0) {
            isDraggingAnimal = false;
            saveToHistory();
            canvas.style.cursor = 'crosshair';
            showNotification('✨ Animal déplacé !');
            createStars();
        }
        if (isResizingMode && resizeStartX !== 0) {
            resizeStartX = 0;
            saveToHistory();
            showNotification('📏 Animal redimensionné !');
        }
        stopDrawing();
    }
    
    function getMousePos(canvas, evt) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        let clientX, clientY;
        if (evt.touches) {
            clientX = evt.touches[0].clientX;
            clientY = evt.touches[0].clientY;
        } else {
            clientX = evt.clientX;
            clientY = evt.clientY;
        }
        return {
            x: (clientX - rect.left) * scaleX,
            y: (clientY - rect.top) * scaleY
        };
    }
    
    function startDrawing(e) {
        if (isDraggingAnimal || isResizingMode) return;
        drawing = true;
        const pos = getMousePos(canvas, e);
        lastX = pos.x;
        lastY = pos.y;
        
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        if (currentTool === 'rainbow') {
            currentColor = `hsl(${Math.random() * 360}, 70%, 60%)`;
            ctx.strokeStyle = currentColor;
        } else if (currentTool === 'eraser') {
            ctx.strokeStyle = 'white';
        } else if (currentTool === 'star') {
            drawStar(lastX, lastY, currentSize * 2);
            saveToHistory();
            return;
        } else if (currentTool === 'heart') {
            drawHeart(lastX, lastY, currentSize);
            saveToHistory();
            return;
        } else {
            ctx.strokeStyle = currentColor;
        }
        ctx.lineWidth = currentSize;
        ctx.lineTo(lastX, lastY);
        ctx.stroke();
    }
    
    function draw(e) {
        if (!drawing || isDraggingAnimal || isResizingMode) return;
        const pos = getMousePos(canvas, e);
        const currentX = pos.x;
        const currentY = pos.y;
        
        if (currentTool === 'star') {
            drawStar(currentX, currentY, currentSize * 2);
            lastX = currentX;
            lastY = currentY;
            return;
        } else if (currentTool === 'heart') {
            drawHeart(currentX, currentY, currentSize);
            lastX = currentX;
            lastY = currentY;
            return;
        }
        
        if (currentTool === 'rainbow') {
            currentColor = `hsl(${Math.random() * 360}, 70%, 60%)`;
            ctx.strokeStyle = currentColor;
        } else if (currentTool === 'eraser') {
            ctx.strokeStyle = 'white';
        } else {
            ctx.strokeStyle = currentColor;
        }
        
        ctx.lineWidth = currentSize;
        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(currentX, currentY);
        ctx.stroke();
        
        lastX = currentX;
        lastY = currentY;
    }
    
    function stopDrawing() {
        if (drawing) {
            drawing = false;
            saveToHistory();
            strokeCount++;
            document.getElementById('strokeCount').textContent = strokeCount;
        }
    }
    
    function drawStar(x, y, size) {
        ctx.save();
        ctx.translate(x, y);
        ctx.beginPath();
        const spikes = 5;
        const outerRadius = size;
        const innerRadius = size / 2;
        for (let i = 0; i < spikes * 2; i++) {
            const radius = i % 2 === 0 ? outerRadius : innerRadius;
            const angle = (Math.PI * 2 * i) / (spikes * 2) - Math.PI / 2;
            const xPos = radius * Math.cos(angle);
            const yPos = radius * Math.sin(angle);
            if (i === 0) ctx.moveTo(xPos, yPos);
            else ctx.lineTo(xPos, yPos);
        }
        ctx.closePath();
        ctx.strokeStyle = currentTool === 'eraser' ? 'white' : currentColor;
        ctx.lineWidth = currentSize;
        ctx.stroke();
        ctx.restore();
    }
    
    function drawHeart(x, y, size) {
        ctx.save();
        ctx.translate(x, y);
        ctx.beginPath();
        const scale = size / 20;
        ctx.moveTo(0, scale * 10);
        ctx.bezierCurveTo(-scale * 20, -scale * 10, -scale * 30, scale * 20, 0, scale * 35);
        ctx.bezierCurveTo(scale * 30, scale * 20, scale * 20, -scale * 10, 0, scale * 10);
        ctx.strokeStyle = currentTool === 'eraser' ? 'white' : currentColor;
        ctx.lineWidth = currentSize;
        ctx.stroke();
        ctx.restore();
    }
    
