{% extends 'base.html.twig' %}

{% block title %}AutiCare - Espace de dessin magique pour enfants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --mauve: #9b6bff;
            --mauve-light: #b794f4;
            --rose: #ff69b4;
            --rose-light: #ff9ecf;
            --lavender: #c77dff;
            --violet: #a855f7;
            --dark: #1e2a3b;
            --bg: #faf5ff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #D5B8FF, #E8D5FF);
            font-family: 'Nunito', sans-serif;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        @keyframes pulseGlow {
            0%, 100% { 
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(155,107,255,0.7);
            }
            50% { 
                transform: scale(1.05);
                box-shadow: 0 0 20px 5px rgba(155,107,255,0.5);
            }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            25% { transform: translateY(-10px) rotate(-5deg); }
            75% { transform: translateY(10px) rotate(5deg); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        @keyframes confettiFall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }

        @keyframes starTwinkle {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(0.5); }
        }

        .drawing-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .drawing-header {
            background: rgba(255,255,255,0.95);
            margin-bottom: 20px;
            padding: 20px 30px;
            border-radius: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border: 2px solid var(--violet);
            animation: bounce 2s ease-in-out infinite;
        }

        .back-btn {
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
        }

        .back-btn:hover {
            transform: translateX(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            animation: shake 0.3s ease;
        }

        .header-title {
            text-align: center;
        }

        .header-title h1 {
            font-family: 'Baloo 2', cursive;
            font-size: 32px;
            color: var(--dark);
            margin: 0;
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-title p {
            color: #666;
            font-size: 14px;
            margin: 5px 0 0;
        }

        .header-emoji {
            font-size: 50px;
            animation: float 3s ease-in-out infinite;
        }

        .tools-panel {
            background: rgba(255,255,255,0.95);
            margin-bottom: 20px;
            padding: 25px;
            border-radius: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border: 2px solid var(--violet);
        }

        .tools-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

        .tools-row:last-child {
            margin-bottom: 0;
        }

        .tool-group {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #F5E6FF;
            padding: 10px 20px;
            border-radius: 40px;
            flex-wrap: wrap;
            transition: all 0.3s;
        }

        .tool-group:hover {
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .tool-label {
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            color: var(--violet);
            font-size: 14px;
        }

        #colorPicker {
            width: 50px;
            height: 40px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            background: transparent;
            transition: transform 0.2s;
        }

        #colorPicker:hover {
            transform: scale(1.1);
        }

        .color-presets {
            display: flex;
            gap: 8px;
        }

        .color-preset {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s;
            border: 2px solid white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .color-preset:hover {
            transform: scale(1.2);
        }

        .brush-slider {
            width: 150px;
        }

        .tool-btn {
            background: white;
            border: 2px solid var(--violet);
            padding: 8px 15px;
            border-radius: 25px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tool-btn:hover {
            transform: scale(1.1);
        }

        .tool-btn.active {
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            border-color: transparent;
        }

        .action-btn {
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .action-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

        .shape-btn {
            background: #FFF9C4;
            border: 2px solid #FFA726;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 20px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .shape-btn:hover {
            transform: scale(1.15) rotate(5deg);
            background: #FFE082;
        }

        .canvas-area {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            gap: 20px;
            flex-wrap: wrap;
        }

        .canvas-wrapper {
            background: white;
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: 5px solid var(--violet);
            display: inline-block;
            overflow: auto;
            max-width: 100%;
            position: relative;
            transition: all 0.3s;
        }

        .canvas-wrapper:hover {
            transform: scale(1.01);
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        }

        canvas {
            display: block;
            border-radius: 25px;
            cursor: crosshair;
            width: 100%;
            height: auto;
        }

        canvas.dragging-animal {
            cursor: grabbing;
        }

        .extra-tools {
            background: rgba(255,255,255,0.95);
            padding: 15px;
            border-radius: 30px;
            border: 2px solid var(--violet);
            display: flex;
            flex-direction: column;
            gap: 15px;
            transition: all 0.3s;
        }

        .extra-tools:hover {
            transform: scale(1.02);
        }

        .extra-tools-title {
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            color: var(--violet);
            text-align: center;
            font-size: 14px;
        }

        .extra-tools-buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .extra-btn {
            background: #F5E6FF;
            border: none;
            padding: 10px 15px;
            border-radius: 20px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
        }

        .extra-btn:hover {
            background: var(--mauve-light);
            color: white;
            transform: scale(1.05) translateX(5px);
        }

        .animals-panel {
            background: rgba(255,255,255,0.95);
            margin-bottom: 20px;
            padding: 20px;
            border-radius: 30px;
            border: 2px solid var(--violet);
        }

        .animals-title {
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            color: var(--violet);
            text-align: center;
            font-size: 18px;
            margin-bottom: 15px;
        }

        .animals-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
        }

        .animal-btn {
            background: linear-gradient(135deg, #FFF9C4, #FFE082);
            border: 2px solid #FFA726;
            padding: 12px 18px;
            border-radius: 50px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
        }

        .animal-btn:hover {
            transform: scale(1.1);
            background: linear-gradient(135deg, #FFE082, #FFD54F);
        }

        .animal-btn.selected {
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            border-color: transparent;
            animation: pulseGlow 0.5s ease;
        }

        .animal-controls {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px dashed var(--violet);
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .control-btn {
            background: #F5E6FF;
            border: none;
            padding: 8px 15px;
            border-radius: 25px;
            font-family: 'Baloo 2', cursive;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .control-btn:hover {
            background: var(--mauve-light);
            color: white;
            transform: scale(1.05);
        }

        .message-bar {
            background: #F5E6FF;
            margin-bottom: 20px;
            padding: 15px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            border: 2px solid var(--violet);
        }

        .message-icon {
            font-size: 30px;
        }

        .message-text {
            font-family: 'Baloo 2', cursive;
            font-size: 16px;
            color: var(--violet);
            font-weight: bold;
        }

        .floating-notification {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            padding: 12px 24px;
            border-radius: 50px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            z-index: 1000;
            animation: slideUp 0.3s ease, fadeOut 0.3s ease 2s forwards;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                visibility: hidden;
            }
        }

        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            position: absolute;
            animation: confettiFall 3s linear forwards;
            z-index: 1000;
            pointer-events: none;
        }

        .star-animation {
            position: fixed;
            font-size: 20px;
            animation: starTwinkle 1s ease-out forwards;
            pointer-events: none;
            z-index: 1000;
        }

        .stroke-counter {
            background: rgba(255,255,255,0.9);
            padding: 8px 15px;
            border-radius: 20px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            color: var(--violet);
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .camera-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        .camera-modal.active {
            display: flex;
        }

        .camera-container {
            background: white;
            border-radius: 40px;
            padding: 25px;
            text-align: center;
            border: 5px solid var(--violet);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            max-width: 90vw;
            max-height: 90vh;
            overflow-y: auto;
        }

        .camera-container h3 {
            font-family: 'Baloo 2', cursive;
            color: var(--violet);
            margin-bottom: 15px;
            font-size: 24px;
        }

        .video-wrapper {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 15px;
            background: #333;
            min-width: 300px;
            min-height: 200px;
        }

        #cameraVideo {
            width: 100%;
            max-width: 640px;
            border-radius: 20px;
            background: #333;
            transform: scaleX(-1);
        }

        #cameraCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .camera-controls {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 15px;
        }

        .cam-btn {
            background: linear-gradient(135deg, var(--mauve), var(--violet));
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 30px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .cam-btn:hover {
            transform: scale(1.05);
        }

        .cam-btn.stop {
            background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
        }

        .air-drawing-status {
            background: #F5E6FF;
            padding: 10px;
            border-radius: 20px;
            margin-top: 15px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            color: var(--violet);
        }

        .camera-btn {
            background: linear-gradient(135deg, #ff6b9d, var(--rose));
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-family: 'Baloo 2', cursive;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            color: white;
        }

        .camera-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Mode tactile pour mobile */
        @media (max-width: 768px) {
            .drawing-container {
                padding: 10px;
            }
            .drawing-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
            .header-title h1 {
                font-size: 22px;
            }
            .header-emoji {
                font-size: 35px;
            }
            .tool-group {
                justify-content: center;
                width: 100%;
            }
            .tools-row {
                flex-direction: column;
            }
            .tool-btn, .action-btn {
                font-size: 12px;
                padding: 6px 12px;
            }
            .extra-tools {
                width: 100%;
                flex-direction: row;
                flex-wrap: wrap;
            }
            .extra-tools-buttons {
                flex-direction: row;
                flex-wrap: wrap;
            }
            .animal-btn {
                padding: 8px 12px;
                font-size: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="drawing-container">
    <div class="drawing-header">
        <button class="back-btn" onclick="window.location.href='{{ path('app_cours') }}'">
            <i class="fas fa-arrow-left"></i> Retour aux cours
        </button>
        <div class="header-title">
            <h1><i class="fas fa-paintbrush"></i> Espace de dessin magique</h1>
            <p>Laisse libre cours à ton imagination !</p>
        </div>
        <div class="header-emoji">
            <i class="fas fa-star"></i>
            <i class="fas fa-heart"></i>
            <i class="fas fa-smile-wink"></i>
        </div>
    </div>
    
    <div class="tools-panel">
        <div class="tools-row">
            <div class="tool-group">
                <span class="tool-label"><i class="fas fa-palette"></i> Couleur:</span>
                <input type="color" id="colorPicker" value="#9b6bff">
                <div class="color-presets">
                    <div class="color-preset" style="background: #9b6bff;" data-color="#9b6bff"></div>
                    <div class="color-preset" style="background: #ff69b4;" data-color="#ff69b4"></div>
                    <div class="color-preset" style="background: #ff4444;" data-color="#ff4444"></div>
                    <div class="color-preset" style="background: #4CAF50;" data-color="#4CAF50"></div>
                    <div class="color-preset" style="background: #2196F3;" data-color="#2196F3"></div>
                    <div class="color-preset" style="background: #FF9800;" data-color="#FF9800"></div>
                    <div class="color-preset" style="background: #000000;" data-color="#000000"></div>
                </div>
            </div>
            <div class="tool-group">
                <span class="tool-label"><i class="fas fa-paintbrush"></i> Taille:</span>
                <input type="range" id="brushSize" min="1" max="50" value="10" class="brush-slider">
                <span id="sizeValue" style="font-weight: bold; min-width: 30px;">10</span>
            </div>
            <div class="tool-group">
                <button class="camera-btn" id="cameraBtn">
                    <i class="fas fa-camera"></i> ✋ Air Drawing
                </button>
            </div>
        </div>
        
        <div class="tools-row">
            <div class="tool-group">
                <span class="tool-label"><i class="fas fa-tools"></i> Outils:</span>
                <button class="tool-btn active" data-tool="pencil"><i class="fas fa-pencil-alt"></i> Crayon</button>
                <button class="tool-btn" data-tool="eraser"><i class="fas fa-eraser"></i> Gomme</button>
                <button class="tool-btn" data-tool="star"><i class="fas fa-star"></i> Étoile</button>
                <button class="tool-btn" data-tool="heart"><i class="fas fa-heart"></i> Cœur</button>
                <button class="tool-btn" data-tool="rainbow"><i class="fas fa-rainbow"></i> Arc-en-ciel</button>
            </div>
        </div>
        
        <div class="tools-row">
            <div class="tool-group">
                <span class="tool-label"><i class="fas fa-magic"></i> Actions:</span>
                <button class="action-btn" id="clearCanvas"><i class="fas fa-trash-alt"></i> Effacer tout</button>
                <button class="action-btn" id="saveCanvas"><i class="fas fa-save"></i> Sauvegarder</button>
                <button class="action-btn" id="undoBtn"><i class="fas fa-undo-alt"></i> Annuler</button>
                <button class="action-btn" id="redoBtn"><i class="fas fa-redo-alt"></i> Refaire</button>
                <button class="action-btn" id="downloadCanvas"><i class="fas fa-download"></i> Télécharger</button>
            </div>
        </div>
        
        <div class="tools-row">
            <div class="tool-group">
                <span class="tool-label"><i class="fas fa-shapes"></i> Formes magiques:</span>
                <button class="shape-btn" data-shape="circle">⭕</button>
                <button class="shape-btn" data-shape="square">⬛</button>
                <button class="shape-btn" data-shape="triangle">🔺</button>
                <button class="shape-btn" data-shape="sun">☀️</button>
                <button class="shape-btn" data-shape="cloud">☁️</button>
                <button class="shape-btn" data-shape="flower">🌸</button>
                <button class="shape-btn" data-shape="star2">⭐</button>
                <button class="shape-btn" data-shape="heart2">❤️</button>
                <button class="shape-btn" data-shape="moon">🌙</button>
                <button class="shape-btn" data-shape="tree">🌲</button>
            </div>
        </div>
    </div>
    
    <div class="animals-panel">
        <div class="animals-title">
            <i class="fas fa-paw"></i> Animaux magiques (clique et déplace-les !) <i class="fas fa-paw"></i>
        </div>
        <div class="animals-grid">
            <button class="animal-btn" data-animal="cat"><i class="fas fa-cat"></i> Chat</button>
            <button class="animal-btn" data-animal="dog"><i class="fas fa-dog"></i> Chien</button>
            <button class="animal-btn" data-animal="bird"><i class="fas fa-dove"></i> Oiseau</button>
            <button class="animal-btn" data-animal="fish"><i class="fas fa-fish"></i> Poisson</button>
            <button class="animal-btn" data-animal="butterfly"><i class="fas fa-butterfly"></i> Papillon</button>
            <button class="animal-btn" data-animal="rabbit"><i class="fas fa-rabbit"></i> Lapin</button>
            <button class="animal-btn" data-animal="frog"><i class="fas fa-frog"></i> Grenouille</button>
            <button class="animal-btn" data-animal="bee"><i class="fas fa-bug"></i> Abeille</button>
            <button class="animal-btn" data-animal="owl"><i class="fas fa-owl"></i> Hibou</button>
            <button class="animal-btn" data-animal="penguin"><i class="fas fa-penguin"></i> Pingouin</button>
        </div>
        <div class="animal-controls" id="animalControls" style="display: none;">
            <button class="control-btn" id="deleteAnimalBtn"><i class="fas fa-trash-alt"></i> Supprimer</button>
            <button class="control-btn" id="resizeAnimalBtn"><i class="fas fa-expand-alt"></i> Redimensionner</button>
            <button class="control-btn" id="cancelSelectBtn"><i class="fas fa-times"></i> Annuler</button>
        </div>
    </div>
    
    <div class="canvas-area">
        <div class="canvas-wrapper">
            <canvas id="drawingCanvas" width="900" height="550"></canvas>
        </div>
        
        <div class="extra-tools">
            <div class="extra-tools-title">
                <i class="fas fa-crown"></i> Super outils
            </div>
            <div class="extra-tools-buttons">
                <button class="extra-btn" id="fillCanvasBtn"><i class="fas fa-fill-drip"></i> Remplir tout</button>
                <button class="extra-btn" id="rainbowBgBtn"><i class="fas fa-rainbow"></i> Fond arc-en-ciel</button>
                <button class="extra-btn" id="sparkleBtn"><i class="fas fa-sparkles"></i> Paillettes</button>
                <button class="extra-btn" id="confettiBtn"><i class="fas fa-confetti"></i> Confettis</button>
                <button class="extra-btn" id="starsBtn"><i class="fas fa-star"></i> Étoiles</button>
            </div>
            <div class="stroke-counter">
                <i class="fas fa-chart-line"></i> Traits: <span id="strokeCount">0</span>
            </div>
        </div>
    </div>
    
    <div class="message-bar">
        <div class="message-icon">🎉</div>
        <div class="message-text">Amuse-toi bien ! Dessine ce que tu veux avec de belles couleurs !</div>
        <div class="message-icon">✨</div>
    </div>
</div>

<div id="cameraModal" class="camera-modal">
    <div class="camera-container">
        <h3><i class="fas fa-hand-peace"></i> Air Drawing - Dessine avec ton doigt !</h3>
        <div class="video-wrapper">
            <video id="cameraVideo" autoplay playsinline></video>
            <canvas id="cameraCanvas"></canvas>
        </div>
        <div class="camera-controls">
            <button class="cam-btn" id="startAirDrawingBtn"><i class="fas fa-play"></i> Commencer à dessiner</button>
            <button class="cam-btn stop" id="stopAirDrawingBtn"><i class="fas fa-stop"></i> Arrêter</button>
            <button class="cam-btn" id="closeCameraBtn"><i class="fas fa-times"></i> Fermer</button>
        </div>
        <div class="air-drawing-status" id="airDrawingStatus">
            ☝️ <b>Index seul levé</b> = dessiner &nbsp;|&nbsp; ✌️ <b>Index + majeur</b> = lever le stylo
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const canvas = document.getElementById('drawingCanvas');
    const ctx = canvas.getContext('2d');
    
    let drawing = false;
    let currentColor = '#9b6bff';
    let currentSize = 10;
    let currentTool = 'pencil';
    let lastX = 0, lastY = 0;
    let strokeCount = 0;
    
    let animals = [];
    let selectedAnimalIndex = -1;
    let isDraggingAnimal = false;
    let isResizingMode = false;
    let dragOffsetX = 0, dragOffsetY = 0;
    let resizeStartX = 0, resizeStartY = 0;
    let resizeStartSize = 0;
    
    let history = [];
    let historyIndex = -1;
    const MAX_HISTORY = 50;
    
    // ============================================================
    // AIR DRAWING — MediaPipe Hands (API legacy, 100% CDN, stable)
    // Fonctionne sans modules ES, détection 21 landmarks main
    // ============================================================
    let airDrawingEnabled = false;
    let cameraModal = null;
    let cameraVideo = null;
    let cameraCanvas = null;
    let cameraCtx = null;
    let videoStream  = null;
    let lastAirX = null;
    let lastAirY = null;
    let mpHands  = null;
    let mpReady  = false;
    let airAnimId = null;
    let smoothX = null, smoothY = null;
    const AIR_SMOOTH = 0.35;

    // Connexions squelette main
    const HAND_BONES = [
        [0,1],[1,2],[2,3],[3,4],
        [0,5],[5,6],[6,7],[7,8],
        [0,9],[9,10],[10,11],[11,12],
        [0,13],[13,14],[14,15],[15,16],
        [0,17],[17,18],[18,19],[19,20],
        [5,9],[9,13],[13,17]
    ];

    function fingerUp(lm, tip, pip) {
        return lm[tip].y < lm[pip].y;
    }

    function drawSkeleton(lm) {
        // lm = landmarks normalisés [0,1]
        const W = cameraCanvas.width, H = cameraCanvas.height;
        cameraCtx.strokeStyle = 'rgba(155,107,255,0.75)';
        cameraCtx.lineWidth = 2;
        HAND_BONES.forEach(([a,b]) => {
            cameraCtx.beginPath();
            cameraCtx.moveTo(lm[a].x * W, lm[a].y * H);
            cameraCtx.lineTo(lm[b].x * W, lm[b].y * H);
            cameraCtx.stroke();
        });
        lm.forEach((p, i) => {
            cameraCtx.beginPath();
            cameraCtx.arc(p.x * W, p.y * H, i === 8 ? 12 : 4, 0, Math.PI*2);
            cameraCtx.fillStyle = i === 8 ? '#ff69b4' : 'rgba(255,255,255,0.85)';
            cameraCtx.fill();
        });
    }

    function setAirStatus(msg, bg) {
        const s = document.getElementById('airDrawingStatus');
        if (!s) return;
        s.innerHTML = msg;
        s.style.background = bg || '#F5E6FF';
    }

    function processAirHand(lm) {
        // lm = landmarks normalisés [0,1], miroir horizontal déjà appliqué
        const idxUp    = fingerUp(lm, 8, 6);
        const midUp    = fingerUp(lm, 12, 10);
        const penUp    = idxUp && midUp;
        const shouldDraw = idxUp && !midUp;

        // Position du bout de l'index (landmark 8)
        const tipX = lm[8].x;
        const tipY = lm[8].y;
        smoothX = smoothX === null ? tipX : smoothX + AIR_SMOOTH * (tipX - smoothX);
        smoothY = smoothY === null ? tipY : smoothY + AIR_SMOOTH * (tipY - smoothY);

        // Dessiner le curseur sur l'overlay caméra
        const vx = smoothX * cameraCanvas.width;
        const vy = smoothY * cameraCanvas.height;
        cameraCtx.beginPath();
        cameraCtx.arc(vx, vy, 16, 0, Math.PI * 2);
        cameraCtx.fillStyle = penUp ? 'rgba(255,165,0,0.85)' : shouldDraw ? 'rgba(155,107,255,0.9)' : 'rgba(180,180,180,0.6)';
        cameraCtx.fill();
        cameraCtx.strokeStyle = 'white';
        cameraCtx.lineWidth = 3;
        cameraCtx.stroke();

        if (!airDrawingEnabled) return;

        if (penUp) {
            if (lastAirX !== null) {
                saveToHistory();
                strokeCount++;
                document.getElementById('strokeCount').textContent = strokeCount;
                lastAirX = null; lastAirY = null; smoothX = null; smoothY = null;
            }
            setAirStatus('✌️ Stylo levé — baisse le majeur pour dessiner', '#FFE082');
        } else if (shouldDraw) {
            const cx = smoothX * canvas.width;
            const cy = smoothY * canvas.height;
            if (lastAirX !== null) {
                ctx.beginPath();
                ctx.moveTo(lastAirX, lastAirY);
                ctx.lineTo(cx, cy);
                ctx.strokeStyle = currentTool === 'rainbow'
                    ? 'hsl(' + (Math.random() * 360) + ',70%,60%)'
                    : currentTool === 'eraser' ? 'white' : currentColor;
                ctx.lineWidth = currentSize;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();
            }
            lastAirX = cx; lastAirY = cy;
            setAirStatus('🎨 Dessin en cours... ✨', '#C8E6C9');
        } else {
            if (lastAirX !== null) {
                saveToHistory();
                strokeCount++;
                document.getElementById('strokeCount').textContent = strokeCount;
                lastAirX = null; lastAirY = null;
            }
            setAirStatus('👆 Lève l\'index seul pour dessiner !');
        }
    }

    async function loadScript(src) {
        return new Promise((resolve, reject) => {
            if (document.querySelector('script[src="' + src + '"]')) { resolve(); return; }
            const s = document.createElement('script');
            s.src = src;
            s.crossOrigin = 'anonymous';
            s.onload = resolve;
            s.onerror = () => reject(new Error('Echec chargement: ' + src));
            document.head.appendChild(s);
        });
    }

    async function initAirDrawing() {
        cameraModal  = document.getElementById('cameraModal');
        cameraVideo  = document.getElementById('cameraVideo');
        cameraCanvas = document.getElementById('cameraCanvas');
        if (!cameraModal || !cameraVideo || !cameraCanvas) {
            showNotification('❌ Éléments caméra introuvables'); return;
        }
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            showNotification('⚠️ Caméra non supportée sur ce navigateur'); return;
        }
        cameraCtx = cameraCanvas.getContext('2d');
        mpReady = false;

        setAirStatus('📷 Démarrage de la caméra...');

        // 1. Caméra
        try {
            videoStream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' }
            });
            cameraVideo.srcObject = videoStream;
            await new Promise((res, rej) => {
                cameraVideo.onloadedmetadata = res;
                setTimeout(() => rej(new Error('timeout caméra')), 8000);
            });
            await cameraVideo.play();
            cameraCanvas.width  = cameraVideo.videoWidth  || 640;
            cameraCanvas.height = cameraVideo.videoHeight || 480;
            cameraVideo.style.width    = '100%';
            cameraCanvas.style.width   = '100%';
            cameraCanvas.style.height  = 'auto';
        } catch (err) {
            const msg = err.name === 'NotAllowedError'
                ? '⚠️ Autorise la caméra dans ton navigateur !'
                : '⚠️ Caméra inaccessible : ' + err.message;
            showNotification(msg); setAirStatus(msg); return;
        }

        // 2. Charger MediaPipe Hands (API legacy, stable avec script tag)
        setAirStatus('⏳ Chargement du modèle IA (peut prendre 10-20s)...');
        try {
            await loadScript('https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js');
            await loadScript('https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js');
            await loadScript('https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js');
        } catch (e) {
            setAirStatus('❌ Erreur chargement MediaPipe : ' + e.message);
            showNotification('❌ ' + e.message);
            return;
        }

        if (!window.Hands) {
            setAirStatus('❌ Bibliothèque Hands non disponible');
            showNotification('❌ MediaPipe Hands non chargé');
            return;
        }

        // 3. Initialiser MediaPipe Hands
        setAirStatus('🧠 Initialisation du détecteur de main...');
        try {
            mpHands = new window.Hands({
                locateFile: (file) => 'https://cdn.jsdelivr.net/npm/@mediapipe/hands/' + file
            });
            mpHands.setOptions({
                maxNumHands: 1,
                modelComplexity: 1,
                minDetectionConfidence: 0.7,
                minTrackingConfidence: 0.6
            });

            mpHands.onResults((results) => {
                if (!cameraCtx) return;
                cameraCtx.clearRect(0, 0, cameraCanvas.width, cameraCanvas.height);

                if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
                    if (lastAirX !== null) {
                        saveToHistory();
                        strokeCount++;
                        document.getElementById('strokeCount').textContent = strokeCount;
                        lastAirX = null; lastAirY = null; smoothX = null; smoothY = null;
                    }
                    if (airDrawingEnabled) setAirStatus('👋 Montre ta main à la caméra !');
                    return;
                }

                const lmRaw = results.multiHandLandmarks[0];
                // Miroir horizontal : la vidéo est scaleX(-1) en CSS
                const lm = lmRaw.map(p => ({ x: 1 - p.x, y: p.y, z: p.z }));

                drawSkeleton(lm);
                processAirHand(lm);
            });

            // Boucle de traitement via requestAnimationFrame
            let sending = false;
            async function sendFrame() {
                airAnimId = requestAnimationFrame(sendFrame);
                if (!mpHands || !cameraVideo || cameraVideo.paused || cameraVideo.ended || sending) return;
                if (cameraVideo.readyState < 2) return;
                sending = true;
                try { await mpHands.send({ image: cameraVideo }); } catch(e) {}
                sending = false;
            }

            await mpHands.initialize();
            mpReady = true;
            setAirStatus('✅ Prêt ! Clique "Commencer" puis lève l\'index.', '#C8E6C9');
            showNotification('✋ Détecteur de main prêt !');
            sendFrame();

        } catch (e) {
            console.error('MediaPipe Hands error:', e);
            setAirStatus('❌ Erreur initialisation : ' + e.message);
            showNotification('❌ Erreur : ' + e.message);
        }
    }

    function startAirDrawing() {
        if (!mpReady) { showNotification('⏳ Attends que le modèle soit prêt...'); return; }
        airDrawingEnabled = true;
        lastAirX = null; lastAirY = null; smoothX = null; smoothY = null;
        showNotification('✏️ Index levé = dessiner | Deux doigts = pause');
        const s = document.getElementById('airDrawingStatus');
        if (s) { s.innerHTML = '👆 Lève l\'index pour commencer !'; s.style.background = '#C8E6C9'; }
    }

    function stopAirDrawing() {
        airDrawingEnabled = false;
        lastAirX = null; lastAirY = null; smoothX = null; smoothY = null;
        if (cameraCtx) cameraCtx.clearRect(0, 0, cameraCanvas.width, cameraCanvas.height);
        const s = document.getElementById('airDrawingStatus');
        if (s) { s.innerHTML = '⏸️ Pause — Clique "Commencer" pour reprendre'; s.style.background = '#F5E6FF'; }
        showNotification('⏸️ Air Drawing en pause');
    }

    function closeCamera() {
        airDrawingEnabled = false; mpReady = false;
        if (airAnimId)  { cancelAnimationFrame(airAnimId); airAnimId = null; }
        if (mpHands)    { try { mpHands.close(); } catch(e){} mpHands = null; }
        if (videoStream){ videoStream.getTracks().forEach(t => t.stop()); videoStream = null; }
        if (cameraModal) cameraModal.classList.remove('active');
        lastAirX = null; lastAirY = null; smoothX = null; smoothY = null;
        showNotification('📷 Caméra fermée');
    }

    function openCameraModal() {
        cameraModal = document.getElementById('cameraModal');
        if (cameraModal) { cameraModal.classList.add('active'); initAirDrawing(); }
        else showNotification('❌ Modal caméra introuvable');
    }
    
    function initCanvas() {
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        saveToHistory();
        redrawEverything();
    }
    
    function saveToHistory() {
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        if (historyIndex < history.length - 1) {
            history = history.slice(0, historyIndex + 1);
        }
        history.push(imageData);
        if (history.length > MAX_HISTORY) history.shift();
        historyIndex = history.length - 1;
    }
    
    function restoreFromHistory() {
        if (historyIndex >= 0) {
            const imageData = history[historyIndex];
            ctx.putImageData(imageData, 0, 0);
        }
    }
    
    function redrawEverything() {
        if (historyIndex >= 0) {
            const imageData = history[historyIndex];
            ctx.putImageData(imageData, 0, 0);
        }
        drawAllAnimals();
    }
    
    function undo() {
        if (historyIndex > 0) {
            historyIndex--;
            restoreFromHistory();
            drawAllAnimals();
            showNotification('↩️ Annulé !');
        } else {
            showNotification('⚠️ Plus rien à annuler !');
        }
    }
    
    function redo() {
        if (historyIndex < history.length - 1) {
            historyIndex++;
            restoreFromHistory();
            drawAllAnimals();
            showNotification('↪️ Rétabli !');
        } else {
            showNotification('⚠️ Plus rien à refaire !');
        }
    }
    
    function drawAllAnimals() {
        animals.forEach((animal, index) => {
            drawAnimalOnCanvas(animal.type, animal.x, animal.y, animal.size, index === selectedAnimalIndex);
        });
    }
    
    function drawAnimalOnCanvas(type, x, y, size, isSelected = false) {
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(size / 100, size / 100);
        
        if (isSelected) {
            ctx.shadowBlur = 15;
            ctx.shadowColor = '#9b6bff';
            ctx.beginPath();
            ctx.ellipse(0, 0, 55, 55, 0, 0, Math.PI * 2);
            ctx.strokeStyle = '#9b6bff';
            ctx.lineWidth = 3;
            ctx.setLineDash([5, 5]);
            ctx.stroke();
            ctx.setLineDash([]);
        }
        
        ctx.strokeStyle = '#333';
        ctx.fillStyle = currentColor;
        ctx.lineWidth = 2;
        
        switch(type) {
            case 'cat': drawCatShape(); break;
            case 'dog': drawDogShape(); break;
            case 'bird': drawBirdShape(); break;
            case 'fish': drawFishShape(); break;
            case 'butterfly': drawButterflyShape(); break;
            case 'rabbit': drawRabbitShape(); break;
            case 'frog': drawFrogShape(); break;
            case 'bee': drawBeeShape(); break;
            case 'owl': drawOwlShape(); break;
            case 'penguin': drawPenguinShape(); break;
        }
        
        ctx.restore();
    }
    
    function drawCatShape() {
        ctx.beginPath();
        ctx.arc(0, 0, 30, 0, Math.PI * 2);
        ctx.fillStyle = '#FFB74D';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-25, -20);
        ctx.lineTo(-35, -45);
        ctx.lineTo(-15, -30);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(25, -20);
        ctx.lineTo(35, -45);
        ctx.lineTo(15, -30);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(-12, -8, 5, 0, Math.PI * 2);
        ctx.fillStyle = 'white';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(12, -8, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(-12, -8, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#333';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(12, -8, 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.fillStyle = '#E91E63';
        ctx.ellipse(0, 2, 4, 3, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-15, 2);
        ctx.lineTo(-30, -2);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-15, 5);
        ctx.lineTo(-30, 8);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(15, 2);
        ctx.lineTo(30, -2);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(15, 5);
        ctx.lineTo(30, 8);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(0, 10, 12, 0.1, Math.PI - 0.1);
        ctx.stroke();
    }
    
    function drawDogShape() {
        ctx.beginPath();
        ctx.ellipse(0, 0, 35, 30, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#D7A86E';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(-22, -15, 12, 22, -0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(22, -15, 12, 22, 0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(-12, -5, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'white';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(12, -5, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(-12, -5, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#333';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(12, -5, 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(0, 5, 8, 6, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#333';
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(0, 14, 6, 8, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#FF6B6B';
        ctx.fill();
    }
    
    function drawBirdShape() {
        ctx.beginPath();
        ctx.ellipse(0, 0, 22, 18, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#4FC3F7';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(22, -8, 14, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(34, -8);
        ctx.lineTo(46, -5);
        ctx.lineTo(34, -3);
        ctx.fillStyle = '#FF9800';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(26, -12, 3, 0, Math.PI * 2);
        ctx.fillStyle = 'white';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(27, -12, 1.5, 0, Math.PI * 2);
        ctx.fillStyle = '#333';
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(-12, -5, 18, 10, -0.5, 0, Math.PI * 2);
        ctx.fillStyle = '#29B6F6';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-20, -5);
        ctx.lineTo(-35, -15);
        ctx.lineTo(-30, 0);
        ctx.fill();
    }
    
    function drawFishShape() {
        ctx.beginPath();
        ctx.ellipse(0, 0, 30, 18, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#FF7043';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-25, 0);
        ctx.lineTo(-40, -12);
        ctx.lineTo(-40, 12);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(12, -5, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'white';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(14, -5, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#333';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(18, 2, 5, -0.3, 0.3);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-5, -12);
        ctx.lineTo(5, -20);
        ctx.lineTo(15, -12);
        ctx.fill();
    }
    
    function drawButterflyShape() {
        ctx.beginPath();
        ctx.ellipse(-18, -8, 18, 24, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = '#CE93D8';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(18, -8, 18, 24, 0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(-12, 10, 14, 16, 0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(12, 10, 14, 16, -0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(0, 0, 6, 30, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#6D4C41';
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-3, -15);
        ctx.quadraticCurveTo(-15, -30, -8, -35);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(3, -15);
        ctx.quadraticCurveTo(15, -30, 8, -35);
        ctx.stroke();
    }
    
    function drawRabbitShape() {
        ctx.beginPath();
        ctx.ellipse(0, 5, 22, 24, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#E1BEE7';
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(-10, -25, 10, 28, -0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(10, -25, 10, 28, 0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(-10, -25, 5, 20, -0.2, 0, Math.PI * 2);
        ctx.fillStyle = '#F8BBD0';
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(10, -25, 5, 20, 0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
