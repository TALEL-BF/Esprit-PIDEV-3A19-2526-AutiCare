        },
        square: () => {
            ctx.strokeStyle = currentColor;
            ctx.lineWidth = currentSize;
            ctx.strokeRect(canvas.width/2 - 50, canvas.height/2 - 50, 100, 100);
            saveToHistory();
            showNotification('⬛ Beau carré !');
        },
        triangle: () => {
            ctx.beginPath();
            ctx.moveTo(canvas.width/2, canvas.height/2 - 100);
            ctx.lineTo(canvas.width/2 - 100, canvas.height/2 + 50);
            ctx.lineTo(canvas.width/2 + 100, canvas.height/2 + 50);
            ctx.closePath();
            ctx.stroke();
            saveToHistory();
            showNotification('🔺 Super triangle !');
        },
        sun: () => {
            ctx.beginPath();
            ctx.arc(canvas.width/2, canvas.height/2, 40, 0, Math.PI * 2);
            ctx.stroke();
            for (let i = 0; i < 8; i++) {
                const angle = i * Math.PI / 4;
                const x1 = canvas.width/2 + 50 * Math.cos(angle);
                const y1 = canvas.height/2 + 50 * Math.sin(angle);
                const x2 = canvas.width/2 + 70 * Math.cos(angle);
                const y2 = canvas.height/2 + 70 * Math.sin(angle);
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            }
            saveToHistory();
            showNotification('☀️ Il fait soleil !');
        },
        cloud: () => {
            ctx.beginPath();
            ctx.ellipse(canvas.width/2 - 50, canvas.height/2, 40, 30, 0, 0, Math.PI * 2);
            ctx.ellipse(canvas.width/2, canvas.height/2 - 10, 45, 35, 0, 0, Math.PI * 2);
            ctx.ellipse(canvas.width/2 + 50, canvas.height/2, 40, 30, 0, 0, Math.PI * 2);
            ctx.stroke();
            saveToHistory();
            showNotification('☁️ Un joli nuage !');
        },
        flower: () => {
            for (let i = 0; i < 5; i++) {
                const angle = i * 2 * Math.PI / 5;
                const x = canvas.width/2 + 40 * Math.cos(angle);
                const y = canvas.height/2 + 40 * Math.sin(angle);
                ctx.beginPath();
                ctx.ellipse(x, y, 15, 15, 0, 0, Math.PI * 2);
                ctx.stroke();
            }
            ctx.beginPath();
            ctx.ellipse(canvas.width/2, canvas.height/2, 15, 15, 0, 0, Math.PI * 2);
            ctx.stroke();
            saveToHistory();
            showNotification('🌸 Une belle fleur !');
        },
        star2: () => {
