        tree: () => {
            ctx.beginPath();
            ctx.rect(canvas.width/2 - 10, canvas.height/2 + 20, 20, 80);
            ctx.stroke();
            ctx.beginPath();
            ctx.ellipse(canvas.width/2 - 20, canvas.height/2 - 30, 40, 40, 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.beginPath();
            ctx.ellipse(canvas.width/2, canvas.height/2 - 50, 30, 30, 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.beginPath();
            ctx.ellipse(canvas.width/2 - 40, canvas.height/2 - 10, 30, 30, 0, 0, Math.PI * 2);
            ctx.stroke();
            saveToHistory();
            showNotification('🌲 Un bel arbre !');
        }
    };
    
    document.querySelectorAll('.shape-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const shape = btn.dataset.shape;
            if (shapes[shape]) {
                shapes[shape]();
                strokeCount++;
                document.getElementById('strokeCount').textContent = strokeCount;
            }
        });
    });
    
    document.querySelectorAll('.animal-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const animalType = btn.dataset.animal;
            addAnimal(animalType, canvas.width/2, canvas.height/2);
            strokeCount++;
            document.getElementById('strokeCount').textContent = strokeCount;
        });
    });
    
    initCanvas();
})();
</script>
{% endblock %}