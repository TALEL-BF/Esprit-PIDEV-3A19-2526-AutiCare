{# templates/front/cours/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}AutiCare - Nos Cours Éducatifs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --mauve:    #9b6bff;
            --mauve-light: #b794f4;
            --rose:     #ff69b4;
            --rose-light: #ff9ecf;
            --lavender: #c77dff;
            --violet:   #a855f7;
            --peach:    #ff9a3c;
            --mint:     #2ec4b6;
            --sun:      #ffd93d;
            --dark:     #1e2a3b;
            --bg:       #faf5ff;
        }

        * { box-sizing: border-box; }
        body { background: var(--bg); font-family: 'Nunito', sans-serif; }

      
        .hero-banner {
            position: relative;
            min-height: 440px;
            display: flex;
            align-items: center;
            overflow: hidden;

            /* ── Image de fond : remplace l'URL par ton chemin réel ── */
            background-image: url('/img/bg/cours-hero.jpg');
            background-size: cover;
            background-position: center top;
            background-attachment: fixed;   /* parallax doux */
        }

        /* Overlay entièrement mauve (plus de rose) */
        .hero-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                105deg,
                rgba(96, 22, 169, 0.85) 0%,
                rgba(155, 107, 255, 0.75) 55%,
                rgba(155, 107, 255, 0.65) 100%
            );
            z-index: 1;
        }

        /* Motif de points décoratifs par-dessus l'overlay */
        .hero-banner::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
            background-size: 28px 28px;
            z-index: 1;
            pointer-events: none;
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            width: 100%;
            padding: 3.5rem 0 3rem;
        }

        /* Breadcrumb sur photo */
        .hero-bc a  { color: rgba(255,255,255,0.70); font-size:.82rem; font-weight:700; text-decoration:none; transition:color .2s; }
        .hero-bc a:hover { color:#fff; }
        .hero-bc .sep    { color: rgba(255,255,255,0.40); margin: 0 7px; }
        .hero-bc .cur    { color: rgba(255,255,255,0.95); font-size:.82rem; font-weight:700; }

        /* Titre hero */
        .hero-title {
            font-family: 'Baloo 2', cursive;
            font-size: clamp(2.1rem, 5vw, 3.4rem);
            font-weight: 800;
            color: #fff;
            line-height: 1.12;
            margin-bottom: .7rem;
            text-shadow: 0 3px 18px rgba(0,0,0,0.35);
        }
        /* Cours Éducatifs en rose uniquement */
        .hero-title .accent {
            background: linear-gradient(135deg, var(--rose), var(--rose-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: 1.05rem;
            color: rgba(255,255,255,0.82);
            font-weight: 600;
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 1.6rem;
            text-shadow: 0 1px 6px rgba(0,0,0,0.2);
        }

        /* Stat pills sur le hero */
        .hero-stats { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
        .hero-stat {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255,255,255,0.25);
            color: #fff;
            padding: 9px 20px;
            border-radius: 50px;
            font-family: 'Baloo 2', cursive;
            font-size: .88rem;
            font-weight: 700;
            transition: background .2s;
        }
        .hero-stat:hover { background: rgba(255,255,255,0.25); }
        .hero-stat .hs-num {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--rose-light);
        }

        /* Bouton Espace Dessin dans le hero */
        .hero-drawing-btn {
            background: linear-gradient(135deg, #ee59d0, #bd1fa8);
            color: white;
            border: none;
            padding: 9px 20px;
            border-radius: 50px;
            font-family: 'Baloo 2', cursive;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(255,68,68,0.3);
            white-space: nowrap;
            text-decoration: none;
        }
        .hero-drawing-btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 20px rgba(255,68,68,0.4);
            background: linear-gradient(135deg, #FF8888, #FF6666);
            color: white;
            text-decoration: none;
        }

        /* Mascot flottante côté droit */
        .hero-mascot-wrap {
            text-align: center;
            position: relative;
        }
        .hero-mascot-bubble {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }
        .hero-mascot-icon {
            font-size: 6rem;
            animation: float-mascot 3s ease-in-out infinite;
            filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
        }
        @keyframes float-mascot {
            0%,100% { transform: translateY(0) rotate(-6deg) scale(1); }
            50%      { transform: translateY(-18px) rotate(6deg) scale(1.05); }
        }
        .hero-mascot-label {
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(8px);
            border: 1.5px solid rgba(255,255,255,0.28);
            color: #fff;
            font-family: 'Baloo 2', cursive;
            font-size: .88rem;
            font-weight: 700;
            padding: 7px 20px;
            border-radius: 30px;
        }

        /* Deco stars */
        .hdeco {
            position: absolute; z-index: 2;
            pointer-events: none;
            animation: twinkle 2.5s ease-in-out infinite;
        }
        @keyframes twinkle {
            0%,100% { opacity:1; transform:scale(1); }
            50%      { opacity:.3; transform:scale(.65); }
        }
        .hdeco-1 { top:14%; left:14%; font-size:1.6rem; animation-delay:.0s; }
        .hdeco-2 { bottom:18%; left:8%; font-size:1.2rem; animation-delay:.7s; }
        .hdeco-3 { top:20%; right:10%; font-size:1.4rem; animation-delay:1.4s; }
        .hdeco-4 { bottom:12%; right:16%; font-size:1rem; animation-delay:.3s; }

        /* Wave bottom */
        .hero-wave {
            position: absolute;
            bottom: -2px; left: 0; right: 0;
            z-index: 2;
            line-height: 0;
        }
        .hero-wave svg { display: block; width: 100%; }

        /* ══════════════════════════════
           FILTER BAR
        ══════════════════════════════ */
        .filter-sticky {
            position: sticky;
            top: 0;
            z-index: 200;
            background: rgba(250,245,255,0.96);
            backdrop-filter: blur(12px);
            border-bottom: 2px solid rgba(155,107,255,0.12);
            padding: 12px 0;
        }
        .filter-bar {
            background: #fff;
            border-radius: 20px;
            padding: 12px 18px;
            box-shadow: 0 4px 22px rgba(0,0,0,0.07);
            display: flex; flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            justify-content: space-between;
            border: 2px solid rgba(155,107,255,0.10);
        }
        .filter-pills { display: flex; flex-wrap: wrap; gap: 7px; }

        .f-pill {
            font-family: 'Baloo 2', cursive;
            font-size: .88rem; font-weight: 700;
            padding: 7px 16px;
            border-radius: 40px;
            border: 2px solid transparent;
            background: #f3e8ff;
            color: #7c3aed;
            cursor: pointer;
            transition: all .22s cubic-bezier(.34,1.56,.64,1);
            user-select: none;
        }
        .f-pill:hover { transform: scale(1.07); box-shadow: 0 4px 12px rgba(0,0,0,.09); }
        .f-pill.active { color: #fff; box-shadow: 0 5px 16px rgba(0,0,0,.13); transform: scale(1.07); }
        .f-pill[data-filter="all"].active        { background: linear-gradient(135deg, var(--mauve), var(--lavender)); }
        .f-pill[data-filter="Académique"].active  { background: linear-gradient(135deg, var(--mauve), var(--mauve-light)); }
        .f-pill[data-filter="Social"].active      { background: linear-gradient(135deg, var(--rose), var(--rose-light)); }
        .f-pill[data-filter="Motricité"].active   { background: linear-gradient(135deg, var(--lavender), var(--violet)); }
        .f-pill[data-filter="Langage"].active     { background: linear-gradient(135deg, var(--rose), var(--mauve)); }

        .search-wrap { position: relative; display: flex; gap: 10px; align-items: center; }
        .search-wrap i {
            position: absolute; left: 13px;
            top: 50%; transform: translateY(-50%);
            color: #aaa; font-size: .85rem;
        }
        #searchCourse {
            font-family: 'Nunito', sans-serif; font-size: .88rem; font-weight: 600;
            padding: 9px 16px 9px 36px;
            border-radius: 40px;
            border: 2px solid #e9d5ff;
            background: #faf5ff;
            outline: none; min-width: 200px;
            transition: all .2s;
        }
        #searchCourse:focus {
            border-color: var(--mauve);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(155,107,255,.12);
        }

        /* Bouton IA génération */
        .btn-ia-generate {
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            color: white;
            border: none;
            padding: 9px 20px;
            border-radius: 40px;
            font-family: 'Baloo 2', cursive;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(155,107,255,0.3);
            white-space: nowrap;
        }
        .btn-ia-generate:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 20px rgba(155,107,255,0.4);
            background: linear-gradient(135deg, var(--mauve-light), var(--rose-light));
        }
        .btn-ia-generate:active {
            transform: translateY(0);
        }

        /* Modal IA - Grand format Mauve/Rose */
        .ia-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        .ia-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .ia-modal {
            background: linear-gradient(135deg, #fff, #faf5ff);
            border-radius: 40px;
            max-width: 800px;
            width: 90%;
            max-height: 85vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(155,107,255,0.3);
            animation: modalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: 2px solid rgba(155,107,255,0.2);
        }
        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-60px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .ia-modal-header {
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            color: white;
            padding: 25px 30px;
            border-radius: 40px 40px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ia-modal-header h3 {
            margin: 0;
            font-family: 'Baloo 2', cursive;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .ia-close {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            font-size: 32px;
            cursor: pointer;
            transition: all 0.2s;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ia-close:hover {
            background: rgba(255,255,255,0.3);
            transform: rotate(90deg);
        }
        .ia-modal-body {
            padding: 30px;
        }
        .ia-prompt-area {
            margin-bottom: 25px;
        }
        .ia-prompt-area label {
            font-family: 'Baloo 2', cursive;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 10px;
            display: block;
            font-size: 1.1rem;
        }
        .ia-prompt-area textarea {
            width: 100%;
            padding: 15px;
            border: 2px solid #e9d5ff;
            border-radius: 20px;
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            resize: vertical;
            transition: all 0.2s;
            background: #fff;
        }
        .ia-prompt-area textarea:focus {
            outline: none;
            border-color: var(--mauve);
            box-shadow: 0 0 0 4px rgba(155,107,255,0.15);
        }
        
        .ia-generate-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--mauve), var(--rose));
            color: white;
            border: none;
            padding: 14px;
            border-radius: 30px;
            font-family: 'Baloo 2', cursive;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .ia-generate-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(155,107,255,0.4);
            background: linear-gradient(135deg, var(--mauve-light), var(--rose-light));
        }
        .ia-generate-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .ia-loading {
            text-align: center;
            padding: 50px;
            background: linear-gradient(135deg, #faf5ff, #fff);
            border-radius: 25px;
            margin-top: 20px;
        }
        .ia-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #f3e8ff;
            border-top-color: var(--rose);
            border-right-color: var(--mauve);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .ia-loading p {
            font-family: 'Baloo 2', cursive;
            font-size: 1rem;
            color: var(--mauve);
        }
        .ia-result {
            text-align: center;
            background: linear-gradient(135deg, #faf5ff, #fff);
            border-radius: 25px;
            padding: 25px;
            margin-top: 20px;
            animation: fadeInUp 0.5s ease;
        }
        .ia-result img {
            max-width: 100%;
            max-height: 400px;
            border-radius: 20px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(155,107,255,0.2);
            border: 3px solid white;
        }
        .ia-result-buttons {
            display: flex;
            gap: 15px;
        }
        .ia-use-btn, .ia-regenerate-btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-family: 'Baloo 2', cursive;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .ia-use-btn {
            background: linear-gradient(135deg, var(--mauve), var(--lavender));
            color: white;
        }
        .ia-regenerate-btn {
            background: linear-gradient(135deg, var(--rose), var(--rose-light));
            color: white;
        }
        .ia-use-btn:hover, .ia-regenerate-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

        /* ══════════════════════════════
           COURSES SECTION
        ══════════════════════════════ */
        .courses-section {
            background: var(--bg);
            padding: 2.8rem 0 5rem;
            min-height: 60vh;
        }

        .section-heading {
            font-family: 'Baloo 2', cursive;
            font-size: 1.5rem; font-weight: 800;
            color: var(--dark);
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 1.8rem;
        }
        .section-heading::after {
            content: '';
            flex: 1; height: 3px; border-radius: 4px;
            background: linear-gradient(to right, rgba(130, 89, 219, 0.45), transparent);
        }

        /* ══ COURSE CARD — redesign ══ */
        .course-card {
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 6px 28px rgba(30,42,59,.09);
            display: flex; flex-direction: column;
            height: 100%;
            border: 2.5px solid #f3e8ff;
            transition:
                transform .35s cubic-bezier(.34,1.56,.64,1),
                box-shadow .35s ease,
                border-color .2s;
            cursor: pointer;
        }
        .course-card:hover {
            transform: translateY(-10px) scale(1.015);
            box-shadow: 0 24px 56px rgba(30,42,59,.14);
        }
        .course-card[data-color="1"]:hover { border-color: var(--mauve);    box-shadow: 0 24px 50px rgba(155,107,255,.18); }
        .course-card[data-color="2"]:hover { border-color: var(--rose);      box-shadow: 0 24px 50px rgba(255,105,180,.18); }
        .course-card[data-color="3"]:hover { border-color: var(--lavender);    box-shadow: 0 24px 50px rgba(199,125,255,.18); }
        .course-card[data-color="4"]:hover { border-color: var(--violet); box-shadow: 0 24px 50px rgba(168,85,247,.18); }
        .course-card[data-color="5"]:hover { border-color: var(--rose-light);     box-shadow: 0 24px 50px rgba(255,158,207,.18); }
        .course-card[data-color="6"]:hover { border-color: var(--mauve-light);     box-shadow: 0 24px 50px rgba(183,148,244,.18); }

        /* ── Card image zone ── */
        .card-img-zone {
            height: 185px;
            position: relative;
            overflow: hidden;
            display: flex; align-items: center; justify-content: center;
        }
        /* Backgrounds colorés dégradés mauve/rose */
        .card-img-zone[data-bg="1"] { background: linear-gradient(145deg, #f3e8ff, #e9d5ff); }
        .card-img-zone[data-bg="2"] { background: linear-gradient(145deg, #fce7f3, #fbcfe8); }
        .card-img-zone[data-bg="3"] { background: linear-gradient(145deg, #ede9fe, #ddd6fe); }
        .card-img-zone[data-bg="4"] { background: linear-gradient(145deg, #fae8ff, #f3e8ff); }
        .card-img-zone[data-bg="5"] { background: linear-gradient(145deg, #fce7f3, #f5d0fe); }
        .card-img-zone[data-bg="6"] { background: linear-gradient(145deg, #e9d5ff, #fae8ff); }

        /* Barre colorée en haut de la card */
        .card-img-zone::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
            z-index: 4;
        }
        .course-card[data-color="1"] .card-img-zone::before { background: var(--mauve); }
        .course-card[data-color="2"] .card-img-zone::before { background: var(--rose); }
        .course-card[data-color="3"] .card-img-zone::before { background: var(--lavender); }
        .course-card[data-color="4"] .card-img-zone::before { background: var(--violet); }
        .course-card[data-color="5"] .card-img-zone::before { background: var(--rose-light); }
        .course-card[data-color="6"] .card-img-zone::before { background: var(--mauve-light); }

        /* Blobs déco dans la zone image */
        .img-blob {
            position: absolute;
            border-radius: 50%;
            opacity: .22;
            pointer-events: none;
        }
        .img-blob-1 { width:110px; height:110px; top:-30px; right:-30px; }
        .img-blob-2 { width:70px;  height:70px;  bottom:-24px; left:16px; }
        .course-card[data-color="1"] .img-blob { background: var(--mauve); }
        .course-card[data-color="2"] .img-blob { background: var(--rose); }
        .course-card[data-color="3"] .img-blob { background: var(--lavender); }
        .course-card[data-color="4"] .img-blob { background: var(--violet); }
        .course-card[data-color="5"] .img-blob { background: var(--rose-light); }
        .course-card[data-color="6"] .img-blob { background: var(--mauve-light); }

        /* Photo du cours */
        .card-img-zone img {
            width: 100%; height: 100%;
            object-fit: cover;
            transition: transform .45s ease;
        }
        .course-card:hover .card-img-zone img { transform: scale(1.06); }

        /* Emoji fallback */
        .card-emoji {
            font-size: 5.2rem;
            filter: drop-shadow(0 4px 12px rgba(0,0,0,.12));
            animation: floatEmoji 3.5s ease-in-out infinite;
            user-select: none; position: relative; z-index: 2;
        }
        @keyframes floatEmoji {
            0%,100% { transform: translateY(0) rotate(-4deg); }
            50%      { transform: translateY(-11px) rotate(4deg); }
        }
        .course-item:nth-child(2) .card-emoji { animation-delay: .5s; }
        .course-item:nth-child(3) .card-emoji { animation-delay: 1s; }
        .course-item:nth-child(4) .card-emoji { animation-delay: 1.5s; }
        .course-item:nth-child(5) .card-emoji { animation-delay: 2s; }
        .course-item:nth-child(6) .card-emoji { animation-delay: 2.5s; }

        /* Niveau badge */
        .niveau-badge {
            position: absolute; top: 14px; right: 14px;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(6px);
            padding: 5px 13px; border-radius: 30px;
            font-family: 'Baloo 2', cursive;
            font-size: .74rem; font-weight: 800;
            z-index: 3;
            box-shadow: 0 3px 10px rgba(0,0,0,.10);
        }
        .course-card[data-color="1"] .niveau-badge { color: var(--mauve); border: 1.5px solid #e9d5ff; }
        .course-card[data-color="2"] .niveau-badge { color: var(--rose); border: 1.5px solid #fbcfe8; }
        .course-card[data-color="3"] .niveau-badge { color: var(--lavender); border: 1.5px solid #ddd6fe; }
        .course-card[data-color="4"] .niveau-badge { color: var(--violet); border: 1.5px solid #f3e8ff; }
        .course-card[data-color="5"] .niveau-badge { color: var(--rose-light); border: 1.5px solid #fce7f3; }
        .course-card[data-color="6"] .niveau-badge { color: var(--mauve-light); border: 1.5px solid #e9d5ff; }

        /* Mots count */
        .mots-bubble {
            position: absolute; bottom: 12px; left: 12px;
            background: rgba(255,255,255,.88);
            backdrop-filter: blur(6px);
            padding: 4px 12px; border-radius: 20px;
            font-family: 'Baloo 2', cursive;
            font-size: .72rem; font-weight: 800; color: #444;
            z-index: 3;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        /* ── Card body ── */
        .card-body-inner {
            padding: 1.25rem 1.4rem 1.4rem;
            flex: 1; display: flex; flex-direction: column;
        }

        /* Type tag */
        .card-type-tag {
            display: inline-flex; align-items: center; gap: 5px;
            font-family: 'Baloo 2', cursive;
            font-size: .7rem; font-weight: 800;
            padding: 4px 12px; border-radius: 20px;
            margin-bottom: .65rem;
            width: fit-content;
            text-transform: uppercase; letter-spacing: .05em;
        }
        .tag-Académique { background: #f3e8ff; color: var(--mauve); }
        .tag-Social     { background: #fce7f3; color: var(--rose); }
        .tag-Motricité  { background: #ede9fe; color: var(--lavender); }
        .tag-Langage    { background: #fae8ff; color: var(--violet); }
        .tag-default    { background: #f1f5f9; color: #475569; }

        /* Title */
        .card-title {
            font-family: 'Baloo 2', cursive;
            font-size: 1.15rem; font-weight: 800;
            color: var(--dark);
            margin-bottom: .35rem; line-height: 1.25;
        }

        /* Desc */
        .card-desc {
            font-size: .85rem; color: #64748b;
            line-height: 1.6; margin-bottom: .9rem; flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Stats */
        .card-stats { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 1rem; }
        .stat-chip {
            display: inline-flex; align-items: center; gap: 4px;
            font-family: 'Nunito', sans-serif;
            font-size: .74rem; font-weight: 800;
            padding: 4px 11px; border-radius: 50px;
        }
        .chip-duree  { background: #f3e8ff; color: var(--mauve); border: 1.5px solid #e9d5ff; }
        .chip-mots   { background: #fce7f3; color: var(--rose); border: 1.5px solid #fbcfe8; }

        /* ── CTA button ── */
        .btn-start {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%; padding: .82rem;
            border: none; border-radius: 16px;
            font-family: 'Baloo 2', cursive;
            font-size: .98rem; font-weight: 800;
            color: #fff; text-decoration: none;
            cursor: pointer; margin-top: auto;
            transition: all .25s cubic-bezier(.34,1.56,.64,1);
            position: relative; overflow: hidden;
        }
        .btn-start::after {
            content: ''; position: absolute; inset: 0;
            background: rgba(255,255,255,.14);
            opacity: 0; transition: opacity .2s;
        }
        .btn-start:hover::after { opacity: 1; }
        .btn-start:hover { transform: scale(1.03) translateY(-2px); color: #fff; }

        .course-card[data-color="1"] .btn-start { background: linear-gradient(135deg, var(--mauve), var(--mauve-light)); box-shadow:0 6px 18px rgba(155,107,255,.35); }
        .course-card[data-color="2"] .btn-start { background: linear-gradient(135deg, var(--rose), var(--rose-light)); box-shadow:0 6px 18px rgba(255,105,180,.35); }
        .course-card[data-color="3"] .btn-start { background: linear-gradient(135deg, var(--lavender), var(--violet)); box-shadow:0 6px 18px rgba(199,125,255,.35); }
        .course-card[data-color="4"] .btn-start { background: linear-gradient(135deg, var(--violet), var(--mauve)); box-shadow:0 6px 18px rgba(168,85,247,.35); }
        .course-card[data-color="5"] .btn-start { background: linear-gradient(135deg, var(--rose-light), var(--lavender)); box-shadow:0 6px 18px rgba(255,158,207,.35); }
        .course-card[data-color="6"] .btn-start { background: linear-gradient(135deg, var(--mauve-light), var(--rose)); box-shadow:0 6px 18px rgba(183,148,244,.35); }

        .btn-icon { font-size: 1.15rem; transition: transform .3s; }
        .btn-start:hover .btn-icon { transform: translateX(5px) scale(1.2); }

        /* ── Card animate in ── */
        @keyframes cardIn {
            from { opacity:0; transform: translateY(28px) scale(.96); }
            to   { opacity:1; transform: translateY(0) scale(1); }
        }
        .course-item { animation: cardIn .5s ease both; }
        .course-item:nth-child(1) { animation-delay:.05s; }
        .course-item:nth-child(2) { animation-delay:.12s; }
        .course-item:nth-child(3) { animation-delay:.19s; }
        .course-item:nth-child(4) { animation-delay:.26s; }
        .course-item:nth-child(5) { animation-delay:.33s; }
        .course-item:nth-child(6) { animation-delay:.40s; }
        .course-item:nth-child(7) { animation-delay:.47s; }
        .course-item:nth-child(8) { animation-delay:.54s; }
        .course-item:nth-child(9) { animation-delay:.60s; }

        /* ── Empty state ── */
        .empty-state { text-align:center; padding:4rem 0; animation:fadeIn .5s ease; }
        .empty-icon { font-size:4.5rem; display:block; margin-bottom:1rem; animation:floatEmoji 2.5s ease-in-out infinite; }
        @keyframes fadeIn { from{opacity:0} to{opacity:1} }

        /* ══════════════════════════════
           PAGINATION
        ══════════════════════════════ */
        .pagination-wrap {
            padding: 2.5rem 0 1rem;
        }
        .pagination-mauve {
            gap: 6px;
            flex-wrap: wrap;
        }
        .pagination-mauve .page-item .page-link {
            font-family: 'Baloo 2', cursive;
            font-weight: 700;
            font-size: .92rem;
            color: var(--mauve);
            border: 2px solid #e9d5ff;
            border-radius: 50px !important;
            padding: 8px 18px;
            background: #fff;
            transition: all .22s cubic-bezier(.34,1.56,.64,1);
            box-shadow: 0 2px 8px rgba(155,107,255,.06);
            line-height: 1.4;
        }
        .pagination-mauve .page-item .page-link:hover {
            background: #f3e8ff;
            border-color: var(--mauve);
            transform: translateY(-2px) scale(1.08);
            box-shadow: 0 5px 15px rgba(155,107,255,.18);
            color: var(--violet);
        }
        .pagination-mauve .page-item.active .page-link {
            background: linear-gradient(135deg, var(--mauve), var(--lavender));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 5px 18px rgba(155,107,255,.40);
            transform: scale(1.1);
        }
        .pagination-mauve .page-item.disabled .page-link {
            color: #ccc;
            border-color: #f0e6ff;
            background: #faf5ff;
            pointer-events: none;
        }
        /* Info pagination */
        .pagination-info {
            font-family: 'Nunito', sans-serif;
            font-size: .84rem;
            font-weight: 700;
            color: #888;
            text-align: center;
            margin-top: .75rem;
        }
        .pagination-info span {
            color: var(--mauve);
            font-weight: 800;
        }

        /* ══ Responsive ══ */
        @media (max-width: 768px) {
            .hero-mascot-wrap { display: none; }
            .hero-banner { background-attachment: scroll; }
            .btn-ia-generate span { display: none; }
            .btn-ia-generate { padding: 9px 15px; }
            .hero-drawing-btn span { display: none; }
            .hero-drawing-btn { padding: 9px 15px; }
            .ia-modal { max-width: 95%; }
            .ia-modal-header h3 { font-size: 1.3rem; }
            .pagination-mauve .page-item .page-link { padding: 7px 13px; font-size: .82rem; }
        }
    </style>
{% endblock %}

{% block body %}

    <!-- ══════════════════════════════════════
         HERO — PHOTO DE FOND
    ══════════════════════════════════════ -->
    <div class="hero-banner">

        {# ── Décorations étoilées ── #}
        <span class="hdeco hdeco-1">⭐</span>
        <span class="hdeco hdeco-2">✨</span>
        <span class="hdeco hdeco-3">🌟</span>
        <span class="hdeco hdeco-4">💫</span>

        <div class="hero-inner">
            <div class="container">
                <div class="row align-items-center g-4">

                    {# ── Texte ── #}
                    <div class="col-lg-7 col-md-8">

                        {# Breadcrumb blanc #}
                        <div class="hero-bc mb-3">
                            <a href="{{ path('app_home') }}">🏠 Accueil</a>
                            <span class="sep">›</span>
                            <span class="cur">Nos Cours</span>
                        </div>

                        <h1 class="hero-title">
                            Nos <span class="accent">Cours Éducatifs</span> 🎒
                        </h1>
                        <p class="hero-sub">
                            Des parcours fun et adaptés, conçus spécialement<br>
                            pour chaque enfant. Apprendre ensemble, à son rythme ! 🌈
                        </p>

                        <div class="hero-stats">
                            <div class="hero-stat">
                                {# Utilise totalCours pour afficher le total réel, pas juste la page courante #}
                                📚 <span class="hs-num">{{ totalCours }}</span> cours disponibles
                            </div>
                            <div class="hero-stat">
                                🎯 <span class="hs-num">4</span> catégories
                            </div>
                            <a href="{{ path('app_drawing') }}" class="hero-drawing-btn">
                                🎨 <span>Espace dessin</span>
                            </a>
                        </div>
                    </div>

                    {# ── Mascotte ── #}
                    <div class="col-lg-5 col-md-4 hero-mascot-wrap">
                        <div class="hero-mascot-bubble">
                            <span class="hero-mascot-icon">🖊️📏📚🎨</span>
                            <span class="hero-mascot-label">Prêt à apprendre ? C'est parti !</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        {# ── Vague de transition vers le filtre ── #}
        <div class="hero-wave">
            <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M0,40 C240,70 480,10 720,40 C960,70 1200,10 1440,40 L1440,60 L0,60 Z"
                      fill="#FAF5FF"/>
            </svg>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         FILTRE STICKY
    ══════════════════════════════════════ -->
    <div class="filter-sticky">
        <div class="container">
            <div class="filter-bar">
                <div class="filter-pills">
                    <button class="f-pill active" data-filter="all">🌈 Tous</button>
                    <button class="f-pill" data-filter="Académique">📚 Académique</button>
                    <button class="f-pill" data-filter="Social">🤝 Social</button>
                    <button class="f-pill" data-filter="Motricité">🤸 Motricité</button>
                    <button class="f-pill" data-filter="Langage">💬 Langage</button>
                </div>
                <div class="search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchCourse" placeholder="Chercher un cours...">
                    <button type="button" class="btn-ia-generate" id="iaGenerateBtn">
                        <i class="fas fa-magic"></i>
                        <span>Générer avec IA</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal IA - Grand format Mauve/Rose (sans choix de mode) -->
    <div id="iaModal" class="ia-modal-overlay">
        <div class="ia-modal">
            <div class="ia-modal-header">
                <h3>
                    <i class="fas fa-robot"></i> 
                    Générateur d'Images IA
                </h3>
                <button class="ia-close" id="iaCloseBtn">&times;</button>
            </div>
            <div class="ia-modal-body">
                <div class="ia-prompt-area">
                    <label>🎨 Décrivez l'image à générer</label>
                    <textarea id="iaPrompt" rows="4" placeholder="Ex: Un enfant qui lit un livre, dessin animé, coloré, style enfantin, fond blanc..."></textarea>
                    <small style="color: var(--mauve); display: block; margin-top: 8px;">
                        💡 Astuce: Ajoutez "dessin animé", "coloré", "style enfantin" pour de meilleurs résultats
                    </small>
                </div>
                
                <button type="button" id="iaGenerateImageBtn" class="ia-generate-btn">
                    <i class="fas fa-magic"></i> Générer l'image (HD)
                </button>
                
                <div id="iaLoading" class="ia-loading" style="display: none;">
                    <div class="ia-spinner"></div>
                    <p>✨ Génération en cours, veuillez patienter... ✨</p>
                </div>
                
                <div id="iaResult" class="ia-result" style="display: none;">
                    <img id="iaGeneratedImage" src="" alt="Image générée">
                    <div class="ia-result-buttons">
                        <button type="button" id="iaUseImageBtn" class="ia-use-btn">
                            <i class="fas fa-download"></i> Télécharger l'image
                        </button>
                        <button type="button" id="iaRegenerateBtn" class="ia-regenerate-btn">
                            <i class="fas fa-sync-alt"></i> Régénérer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         GRILLE DES COURS
    ══════════════════════════════════════ -->
    <div class="courses-section">
        <div class="container">

            <div class="section-heading">✨ Découvrez nos cours</div>

            <div class="row g-4" id="coursesContainer">
                {% for cours in courses %}
                    {% set ci = (loop.index0 % 6) + 1 %}
                    {% set emojis = {'Académique':'📚','Social':'🤝','Motricité':'🏃','Langage':'💬'} %}
                    {% set emoji  = emojis[cours.typeCours] ?? '🎓' %}
                    {% set mc     = cours.mots ? (cours.mots|split(';')|length) : 0 %}

                    <div class="col-sm-6 col-lg-4 course-item" data-category="{{ cours.typeCours }}">
                        <div class="course-card" data-color="{{ ci }}">

                            {# ── Zone image ── #}
                            <div class="card-img-zone" data-bg="{{ ci }}">
                                <div class="img-blob img-blob-1"></div>
                                <div class="img-blob img-blob-2"></div>

                                {% if cours.image %}
                                    <img src="/uploads/images/{{ cours.image }}" alt="{{ cours.titre }}">
                                {% else %}
                                    <span class="card-emoji">{{ emoji }}</span>
                                {% endif %}

                                <span class="niveau-badge">📊 {{ cours.niveau }}</span>
                                {% if mc > 0 %}
                                    <span class="mots-bubble">🔤 {{ mc }} mots</span>
                                {% endif %}
                            </div>

                            {# ── Corps ── #}
                            <div class="card-body-inner">
                                <span class="card-type-tag tag-{{ cours.typeCours }}">{{ emoji }} {{ cours.typeCours }}</span>
                                <h3 class="card-title">{{ cours.titre }}</h3>
                                <p class="card-desc">{{ cours.description }}</p>
                                <div class="card-stats">
                                    <span class="stat-chip chip-duree">⏱ {{ cours.duree }} min</span>
                                    {% if mc > 0 %}
                                        <span class="stat-chip chip-mots">🔤 {{ mc }} mots</span>
                                    {% endif %}
                                </div>
                                <a href="{{ path('app_cours_show', {'id': cours.idCours}) }}" class="btn-start">
                                    <span>Commencer</span>
                                    <span class="btn-icon">🚀</span>
                                </a>
                            </div>

                        </div>
                    </div>
                {% else %}
                    <div class="col-12 empty-state">
                        <span class="empty-icon">📭</span>
                        <h5 style="font-family:'Baloo 2',cursive;font-weight:800;color:#444;">Aucun cours disponible</h5>
                        <p style="color:#888;">Les cours arrivent bientôt, reste à l'affût ! 🌟</p>
                    </div>
                {% endfor %}
            </div>

            {# ══════════════════════════════
               PAGINATION - Version modifiée pour KnpPaginatorBundle
            ══════════════════════════════ #}
            {% if courses.pageCount > 1 %}
            <div class="pagination-wrap d-flex justify-content-center">
                <div>
                    <nav aria-label="Pagination des cours">
                        <ul class="pagination pagination-mauve justify-content-center">

                            {# ── Première page ── #}
                            {% if courses.currentPageNumber > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_cours', app.request.query.all|merge({'page': 1})) }}" title="Première page">
                                        «
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_cours', app.request.query.all|merge({'page': courses.currentPageNumber - 1})) }}" aria-label="Précédent">
                                        ‹
                                    </a>
                                </li>
                            {% else %}
                                <li class="page-item disabled">
                                    <span class="page-link">«</span>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">‹</span>
                                </li>
                            {% endif %}

                            {# ── Numéros de pages (fenêtre glissante de 5 pages) ── #}
                            {% set currentPage = courses.currentPageNumber %}
                            {% set totalPages  = courses.pageCount %}
                            {% set startPage   = max(1, currentPage - 2) %}
                            {% set endPage     = min(totalPages, currentPage + 2) %}

                            {# Affiche "..." au début si nécessaire #}
                            {% if startPage > 1 %}
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            {% endif %}

                            {% for i in startPage..endPage %}
                                <li class="page-item {% if i == currentPage %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_cours', app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                                </li>
                            {% endfor %}

                            {# Affiche "..." à la fin si nécessaire #}
                            {% if endPage < totalPages %}
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            {% endif %}

                            {# ── Dernière page ── #}
                            {% if courses.currentPageNumber < courses.pageCount %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_cours', app.request.query.all|merge({'page': courses.currentPageNumber + 1})) }}" aria-label="Suivant">
                                        ›
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_cours', app.request.query.all|merge({'page': courses.pageCount})) }}" title="Dernière page">
                                        »
                                    </a>
                                </li>
                            {% else %}
                                <li class="page-item disabled">
                                    <span class="page-link">›</span>
                                </li>
                                <li class="page-item disabled">
                                    <span class="page-link">»</span>
                                </li>
                            {% endif %}

                        </ul>
                    </nav>

                    {# Info : page X sur Y #}
                    <p class="pagination-info">
                        Page <span>{{ courses.currentPageNumber }}</span> sur <span>{{ courses.pageCount }}</span>
                        — <span>{{ courses.totalItemCount }}</span> cours au total
                    </p>
                </div>
            </div>
            {% endif %}

            {# No results (filtre JS) #}
            <div id="noResults" class="empty-state d-none">
                <span class="empty-icon">🔍</span>
                <h5 style="font-family:'Baloo 2',cursive;font-weight:800;color:#444;">Aucun résultat</h5>
                <p style="color:#888;">Essaie un autre mot ou change le filtre.</p>
            </div>

        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        document.querySelectorAll('.f-pill').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.f-pill').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                applyFilters();
            });
        });

        document.getElementById('searchCourse').addEventListener('input', applyFilters);

        function applyFilters() {
            const filter  = document.querySelector('.f-pill.active')?.dataset.filter || 'all';
            const term    = document.getElementById('searchCourse').value.toLowerCase();
            const items   = document.querySelectorAll('.course-item');
            let visible   = 0;

            items.forEach(item => {
                const catOk  = filter === 'all' || item.dataset.category === filter;
                const title  = item.querySelector('.card-title').textContent.toLowerCase();
                const desc   = item.querySelector('.card-desc').textContent.toLowerCase();
                const termOk = !term || title.includes(term) || desc.includes(term);

                if (catOk && termOk) { item.style.display = ''; visible++; }
                else                 { item.style.display = 'none'; }
            });

            document.getElementById('noResults').classList.toggle('d-none', visible > 0);
        }
    })();

    // IA Image Generator - Mode Standard HD uniquement
    (function() {
        const modal = document.getElementById('iaModal');
        const openBtn = document.getElementById('iaGenerateBtn');
        const closeBtn = document.getElementById('iaCloseBtn');
        const generateBtn = document.getElementById('iaGenerateImageBtn');
        const promptInput = document.getElementById('iaPrompt');
        const loadingDiv = document.getElementById('iaLoading');
        const resultDiv = document.getElementById('iaResult');
        const generatedImage = document.getElementById('iaGeneratedImage');
        const useImageBtn = document.getElementById('iaUseImageBtn');
        const regenerateBtn = document.getElementById('iaRegenerateBtn');
        
        let currentImageUrl = null;
        let currentFilename = null;
        
        // Open modal
        if (openBtn) {
            openBtn.addEventListener('click', () => {
                modal.classList.add('active');
                promptInput.value = '';
                resultDiv.style.display = 'none';
                loadingDiv.style.display = 'none';
            });
        }
        
        // Close modal
        closeBtn.addEventListener('click', () => {
            modal.classList.remove('active');
        });
        
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.remove('active');
            }
        });
        
        // Generate image (mode standard HD uniquement)
        generateBtn.addEventListener('click', async () => {
            const prompt = promptInput.value.trim();
            
            if (prompt.length < 3) {
                alert('Veuillez décrire l\'image à générer (minimum 3 caractères)');
                return;
            }
            
            loadingDiv.style.display = 'block';
            resultDiv.style.display = 'none';
            generateBtn.disabled = true;
            
            try {
                const formData = new FormData();
                formData.append('prompt', prompt);
                formData.append('mode', 'standard'); // Mode HD uniquement
                
                const response = await fetch('/admin/image/generate', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (data.success) {
                    currentImageUrl = data.imageUrl;
                    currentFilename = data.filename;
                    generatedImage.src = currentImageUrl;
                    resultDiv.style.display = 'block';
                    resultDiv.style.animation = 'none';
                    resultDiv.offsetHeight;
                    resultDiv.style.animation = 'fadeInUp 0.5s ease';
                } else {
                    alert('Erreur: ' + (data.error || 'Génération échouée'));
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Erreur lors de la génération de l\'image');
            } finally {
                loadingDiv.style.display = 'none';
                generateBtn.disabled = false;
            }
        });
        
        // Download image
        useImageBtn.addEventListener('click', () => {
            if (currentImageUrl) {
                const link = document.createElement('a');
                link.href = currentImageUrl;
                link.download = currentFilename || 'ia-generated-image.png';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                
                // Notification de succès
                const notification = document.createElement('div');
                notification.style.position = 'fixed';
                notification.style.bottom = '20px';
                notification.style.right = '20px';
                notification.style.background = 'linear-gradient(135deg, var(--mauve), var(--rose))';
                notification.style.color = 'white';
                notification.style.padding = '12px 24px';
                notification.style.borderRadius = '25px';
                notification.style.fontFamily = 'Baloo 2, cursive';
                notification.style.fontWeight = 'bold';
                notification.style.zIndex = '1001';
                notification.style.boxShadow = '0 4px 15px rgba(0,0,0,0.2)';
                notification.innerHTML = '✅ Image téléchargée avec succès!';
                document.body.appendChild(notification);
                setTimeout(() => notification.remove(), 3000);
            }
        });
        
        // Regenerate
        regenerateBtn.addEventListener('click', () => {
            generateBtn.click();
        });
        
        // Animation CSS additionnelle
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        `;
        document.head.appendChild(style);
    })();
    </script>
    
{% endblock %}