{% extends "base.html.twig" %}

{% block title %}Professeur Dashboard - AutiCare{% endblock %}

{% block page_title %}Dashboard Professeur{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="welcome-card" style="background: linear-gradient(135deg, #9b59b6, #8e44ad);">
        <h2>Bienvenue, {{ app.user.prenom }} {{ app.user.nom }} !</h2>
        <p>Espace Professeur - Gérez vos cours et élèves</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-book-open"></i><h4>Gestion des cours</h4><p>Créer des cours</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-tasks"></i><h4>Évaluations</h4><p>Suivre les résultats</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-gamepad"></i><h4>Jeux pédagogiques</h4><p>Activités ludiques</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-week"></i><h4>Emploi du temps</h4><p>Planning</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-clock"></i><h4>Séances</h4><p>Gérer les séances</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-alt"></i><h4>Événements</h4><p>Conférences</p></div></div>
    </div>
</div>
{% endblock %}