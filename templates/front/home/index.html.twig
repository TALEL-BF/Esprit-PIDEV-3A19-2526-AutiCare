{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.btn-play').click(function() {
                var videoSrc = $(this).data('src');
                $('#video').attr('src', videoSrc);
            });
            $('#videoModal').on('hidden.bs.modal', function() {
                $('#video').attr('src', '');
            });
        });

        // Animation des compteurs avec Intersection Observer
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const counters = entry.target.querySelectorAll('.counter');
                    counters.forEach(counter => {
                        animateCounter(counter);
                    });
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Observer la section des statistiques
        const statsSection = document.querySelector('.container-fluid.py-5.position-relative.overflow-hidden');
        if (statsSection) {
            observer.observe(statsSection);
        }

        function animateCounter(counter) {
            const target = parseInt(counter.getAttribute('data-target'));
            const duration = 2000; // 2 secondes
            const step = target / (duration / 16); // 60 FPS
            let current = 0;

            const timer = setInterval(() => {
                current += step;
                if (current >= target) {
                    counter.textContent = target.toLocaleString();
                    clearInterval(timer);
                } else {
                    counter.textContent = Math.floor(current).toLocaleString();
                }
            }, 16);
        }

        // Animation WOW.js pour les éléments
        new WOW().init();

        // Particules flottantes interactives
        document.addEventListener('mousemove', (e) => {
            const particles = document.querySelectorAll('.floating-particle');
            particles.forEach((particle, index) => {
                const speed = (index + 1) * 0.5;
                const x = (e.clientX * speed) / 100;
                const y = (e.clientY * speed) / 100;
                particle.style.transform = `translate(${x}px, ${y}px)`;
            });
        });
    </script>
{% endblock %}