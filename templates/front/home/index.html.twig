{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.btn-play').click(function() {
                var videoSrc = $(this).data('src');
                $('#video').attr('src', videoSrc);
            });
            $('#videoModal').on('hidden.bs.modal', function() {
                $('#video').attr('src', '');
            });
        });
    </script>
{% endblock %}