{# templates/front/jeux/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}AutiCare - Jeux Éducatifs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-card {
            border-radius: 20px;
            overflow: hidden;
            transition: 0.3s;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            height: 100%;
        }
        .game-card:hover { 
            transform: translateY(-8px); 
            box-shadow: 0 20px 50px rgba(77,101,249,0.25); 
        }
        .game-icon {
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            position: relative;
        }
        .age-badge {
            position: absolute;
            top: 15px; left: 15px;
            background: white;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 0.75rem;
            font-weight: 700;
            color: #333;
        }
        .difficulty-dots {
            display: flex; gap: 4px;
        }
        .difficulty-dots span {
            width: 10px; height: 10px; border-radius: 50%;
            background: #eee;
        }
        .difficulty-dots span.active { background: var(--bs-primary); }
        .btn-border-radius {
            border-radius: 50px !important;
        }
        .bg-opacity-10 {
            --bs-bg-opacity: 0.1;
        }
        .bg-primary.bg-opacity-10 { background-color: rgba(77,101,249,0.1) !important; }
        .bg-secondary.bg-opacity-10 { background-color: rgba(255,72,128,0.1) !important; }
        .bg-success.bg-opacity-10 { background-color: rgba(76,175,80,0.1) !important; }
        .bg-warning.bg-opacity-10 { background-color: rgba(255,152,0,0.1) !important; }
        .bg-info.bg-opacity-10 { background-color: rgba(33,150,243,0.1) !important; }
        .page-header {
            background: linear-gradient(135deg, #4d65f9 0%, #ff4880 100%);
            padding: 60px 0;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="container-fluid page-header py-5">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white wow fadeInDown">Jeux Éducatifs</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item text-secondary active">Jeux</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Benefits -->
    <div class="container-fluid bg-primary py-5 wow fadeIn">
        <div class="container py-3">
            <div class="row g-4 text-white text-center">
                <div class="col-6 col-lg-3">
                    <i class="fas fa-smile fa-2x text-secondary mb-2"></i>
                    <h5>Apprentissage ludique</h5>
                    <p class="opacity-75 small mb-0">Apprendre en s'amusant sans pression</p>
                </div>
                <div class="col-6 col-lg-3">
                    <i class="fas fa-child fa-2x text-secondary mb-2"></i>
                    <h5>Adapté à chaque âge</h5>
                    <p class="opacity-75 small mb-0">De 3 à 18 ans et plus</p>
                </div>
                <div class="col-6 col-lg-3">
                    <i class="fas fa-chart-line fa-2x text-secondary mb-2"></i>
                    <h5>Suivi de progression</h5>
                    <p class="opacity-75 small mb-0">Tableau de bord parent/thérapeute</p>
                </div>
                <div class="col-6 col-lg-3">
                    <i class="fas fa-shield-alt fa-2x text-secondary mb-2"></i>
                    <h5>Environnement sécurisé</h5>
                    <p class="opacity-75 small mb-0">Sans publicité, sans pression</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Games Grid -->
    <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="text-center mx-auto mb-5 wow fadeInUp" style="max-width:700px">
                <div class="bg-secondary text-primary rounded d-inline-block px-3 mb-3" style="border-radius:25% 10% !important">
                    <small>Notre catalogue</small>
                </div>
                <h1 class="display-5">Jeux conçus avec des spécialistes TSA</h1>
            </div>

            <!-- Category Tabs -->
            <div class="d-flex gap-2 flex-wrap justify-content-center mb-5" id="categoryFilters">
                {% for category in categories %}
                    <button class="btn btn-{{ loop.first ? 'primary' : 'outline-primary' }} btn-border-radius {{ loop.first ? 'text-white' : '' }} category-btn" data-category="{{ category|lower }}">
                        {{ category }}
                    </button>
                {% endfor %}
            </div>

            <div class="row g-4" id="gamesContainer">
                {% for game in games %}
                <div class="col-md-6 col-lg-4 wow fadeInUp game-item" data-category="{{ game.category|lower }}" data-wow-delay="0.{{ loop.index }}s">
                    <div class="game-card bg-white">
                        <div class="game-icon" style="background:{{ game.gradient }}">
                            {{ game.icon }}
                            <div class="age-badge">{{ game.age }}</div>
                        </div>
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-{{ game.category_color }} bg-opacity-10 text-{{ game.category_color }}">{{ game.category }}</span>
                                <div class="difficulty-dots">
                                    {% for i in 1..3 %}
                                        <span class="{% if i <= game.difficulty %}active{% endif %}"></span>
                                    {% endfor %}
                                </div>
                            </div>
                            <h5 class="fw-bold mb-2 d-flex align-items-center justify-content-between">
                                {{ game.title }}
                                <i class="fas fa-volume-up speak-btn-global" 
                                   onclick="AutiCareSpeech.speak('{{ game.title }}. {{ game.description|escape('js') }}')" 
                                   title="Écouter"></i>
                            </h5>
                            <p class="text-muted small mb-3">{{ game.description }}</p>
                            <div class="d-flex gap-2">
                                <a href="#" class="btn btn-primary btn-border-radius text-white flex-fill">
                                    <i class="fas fa-play me-1"></i> Jouer
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-border-radius">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- CTA to sign up -->
            <div class="text-center mt-5">
                <div class="bg-light rounded-4 p-5 wow fadeInUp">
                    <i class="fas fa-gamepad fa-3x text-primary mb-3"></i>
                    <h3 class="text-primary mb-2">Accédez à tous nos jeux gratuitement !</h3>
                    <p class="text-muted mb-4">Créez un compte pour débloquer l'ensemble du catalogue et suivre la progression.</p>
                    <a href="#" class="btn btn-primary btn-border-radius py-3 px-5 text-white">
                        <i class="fas fa-user-plus me-2"></i> S'inscrire gratuitement
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Filtrage par catégorie
        const categoryBtns = document.querySelectorAll('.category-btn');
        const gameItems = document.querySelectorAll('.game-item');
        
        categoryBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const category = this.dataset.category;
                
                // Mise à jour des styles des boutons
                categoryBtns.forEach(b => {
                    if (b.dataset.category === category && category !== 'tous') {
                        b.classList.remove('btn-outline-primary');
                        b.classList.add('btn-primary', 'text-white');
                    } else if (category === 'tous' && b.dataset.category === 'tous') {
                        b.classList.remove('btn-outline-primary');
                        b.classList.add('btn-primary', 'text-white');
                    } else {
                        b.classList.remove('btn-primary', 'text-white');
                        b.classList.add('btn-outline-primary');
                    }
                });
                
                // Filtrage des jeux
                gameItems.forEach(item => {
                    const itemCategory = item.dataset.category;
                    if (category === 'tous' || itemCategory === category) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    </script>
{% endblock %}