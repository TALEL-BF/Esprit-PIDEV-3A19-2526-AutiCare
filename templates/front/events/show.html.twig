                <span class="analysis-sep">•</span>
                <div class="analysis-item"><span class="analysis-emoji">🪑</span><span class="analysis-text">Assis</span></div>
                <span class="analysis-sep">•</span>
                <div class="analysis-item"><span class="stars">⭐⭐⭐</span><span class="analysis-text">Excellent</span></div>
                <span class="analysis-sep">•</span>
