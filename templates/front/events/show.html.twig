            </div>
        </div>

        <div class="hero-wave">
            <svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M0,80 
                         C80,80 100,50 140,50 
                         C160,50 180,60 200,60 
                         C220,60 240,40 270,40 
                         C300,40 320,60 340,60 
                         C360,60 380,50 400,55 
                         C420,55 440,70 470,70 
                         C500,70 520,50 550,50 
                         C580,50 600,65 620,65 
                         C650,65 670,45 700,45 
                         C730,45 750,60 770,60 
                         C790,60 810,50 840,55 
                         C860,55 880,70 910,70 
                         C940,70 960,50 990,50 
                         C1020,50 1040,65 1060,65 
                         C1080,65 1100,55 1130,55 
                         C1150,55 1170,40 1200,40 
                         C1230,40 1250,60 1270,60 
                         C1290,60 1310,50 1340,50 
                         C1370,50 1390,60 1440,60 
                         L1440,120 L0,120 Z" 
                      fill="#FAF5FF"/>
            </svg>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="event-page">

        <div class="main-card">
            <div class="two-columns-layout">

                <!-- LEFT COLUMN: Image → Description below -->
                <div class="col-left">
                 <div class="image-container">
    {% if event.image %}
