                    </div>
                    <div class="time-box">
                        <span class="time-number" id="minutesBox">00</span>
                        <span class="time-label">Minutes</span>
                    </div>
                    <div class="time-box">
                        <span class="time-number" id="secondsBox">00</span>
                        <span class="time-label">Secondes</span>
                    </div>
                </div>

                <button class="hero-join-btn" id="joinBtnHero" {% if event.status == 'complet' or event.status == 'annule' %}disabled{% endif %}>
