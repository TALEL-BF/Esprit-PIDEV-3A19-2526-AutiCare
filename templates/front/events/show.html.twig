                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-icon" style="font-size:2rem;">⏰</div>
                                <div class="info-content">
                                    <div class="info-label-small">Heure enchantée</div>
                                    <div class="info-value-large">{{ event.heureDebut|date('H:i') }} - {{ event.heureFin|date('H:i') }}</div>
                                </div>
                            </div>
