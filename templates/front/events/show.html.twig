                {% endif %}
            </div>
        </div>

    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // DYNAMIC COUNTDOWN TIMER
        const eventDateStr = "{{ event.dateDebut|date('Y-m-d') }}";
        const eventTimeStr = "{{ event.heureDebut|date('H:i:s') }}";
        const eventDateTime = new Date(eventDateStr + 'T' + eventTimeStr);

        function pad(n) { return String(n).padStart(2, '0'); }

        function updateBoxedTimer() {
            const now  = new Date();
            const diff = eventDateTime - now;

            if (diff <= 0) {
                ['daysBox','hoursBox','minutesBox','secondsBox'].forEach(id => {
                    document.getElementById(id).textContent = '00';
                });
                return;
            }

            const days    = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('daysBox').textContent    = pad(days);
            document.getElementById('hoursBox').textContent   = pad(hours);
            document.getElementById('minutesBox').textContent = pad(minutes);
            document.getElementById('secondsBox').textContent = pad(seconds);
        }

        updateBoxedTimer();
        setInterval(updateBoxedTimer, 1000);

        // Buttons
        document.getElementById('joinBtnHero')?.addEventListener('click', function() {
            if (!this.disabled) alert('🎉✨ Félicitations ! ✨🎉\n\nTu es inscrit(e) à cette aventure magique !\nTu recevras bientôt un email de confirmation.\n\n🌟 On a hâte de te voir ! 🌟');
        });

        document.getElementById('registerBtn')?.addEventListener('click', function() {
            alert('🎉✨ Félicitations ! ✨🎉\n\nTu es inscrit(e) à cette aventure magique !\nTu recevras bientôt un email de confirmation.\n\n🌟 On a hâte de te voir ! 🌟');
        });

        document.getElementById('rapportIABtn')?.addEventListener('click', function() {
            alert('💡🧩 CONSEILS IA PERSONNALISÉS 🧩💡\n\n✨ Recommandations pour cet événement :\n\n🔇 Environnement calme adapté\n🧘 Charge sensorielle faible\n👥 Âge recommandé: 5-10 ans\n🪑 Activité assise confortable\n\n🌟 Une expérience parfaitement adaptée pour votre enfant !');
        });

        document.getElementById('viewParticipantsBtn')?.addEventListener('click', function() {
            alert('👥 LISTE DES PARTICIPANTS 👥\n\n📊 Statistiques :\n• 15 personnes inscrites\n• 8 enfants\n• 7 accompagnateurs\n\n✨ Une belle communauté bienveillante !');
        });

        document.getElementById('analyzeBtn')?.addEventListener('click', function() {
            alert('🔍 ANALYSE DÉTAILLÉE DE L\'ÉVÉNEMENT 🔍\n\n📊 Niveau sonore: Calme\n🧘 Charge sensorielle: Faible\n👥 Âge recommandé: 5-10 ans\n🪑 Niveau d\'activité: Assis\n⭐ Recommandation: Excellent\n\n✨ Cet événement est parfaitement adapté aux enfants autistes !');
        });
    </script>
{% endblock %}
