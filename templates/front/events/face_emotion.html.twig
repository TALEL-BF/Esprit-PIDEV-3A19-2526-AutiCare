        /* Emotion row */
        .emo-row { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; background:white; border:1px solid #e9d5ff; border-radius:24px; padding:15px; margin-bottom:18px; }
        .emo-item { display:flex; flex-direction:column; align-items:center; gap:6px; cursor:pointer; transition:all .2s; }
        .emo-item:hover { transform:translateY(-4px); }
        .emo-circle { width:55px; height:55px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:26px; border:2px solid; background:white; transition:all .2s; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
        .emo-circle.joy      { border-color:#fbbf24; }
        .emo-circle.sad      { border-color:#60a5fa; }
        .emo-circle.anger    { border-color:#f87171; }
        .emo-circle.surprise { border-color:#c084fc; }
        .emo-name { font-family:'Baloo 2',cursive; font-size:.7rem; font-weight:800; color:#6b7280; }

        /* Nav buttons */
        .nav-row { display:flex; justify-content:center; gap:12px; margin-bottom: 20px; }
        .nav-btn { border-radius:999px; padding:8px 28px; font-family:'Baloo 2',cursive; font-size:.85rem; font-weight:800; cursor:pointer; border:none; transition:all .2s; }
        .nav-btn:hover:not(:disabled) { transform:translateY(-1px); }
        .nav-btn:disabled { opacity:.4; cursor:not-allowed; }
        .nav-outline { background:transparent; color:#7c3aed; border:1.5px solid #7c3aed !important; }
        .nav-outline:hover:not(:disabled) { background:#7c3aed; color:white; }
        .nav-primary { background:linear-gradient(135deg,#8b5cf6,#ec4899); color:white; }

        /* New story button row */
        .new-story-row {
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }
        .btn-new-story {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 10px 30px;
            font-family: 'Baloo 2', cursive;
            font-size: 0.9rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(245,158,11,0.3);
        }
        .btn-new-story:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(245,158,11,0.4);
        }

        /* READY CARD (appears after 8 seconds) */
        .ready-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(8px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            visibility: hidden;
            opacity: 0;
            transition: all 0.3s ease;
        }
        .ready-overlay.show {
            visibility: visible;
            opacity: 1;
        }
        .ready-card {
            background: white;
            border-radius: 60px;
            padding: 35px 45px;
            text-align: center;
            max-width: 420px;
            width: 90%;
            border: 4px solid #c084fc;
            box-shadow: 0 25px 50px rgba(139,92,246,0.3);
            animation: cardPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes cardPop {
            from { transform: scale(0.7); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .ready-emoji { font-size: 4rem; display: block; margin-bottom: 15px; }
        .ready-title { font-family: 'Baloo 2', cursive; font-size: 2rem; font-weight: 900; color: #7c3aed; margin-bottom: 10px; }
        .ready-text { font-size: 1rem; color: #6b7280; margin-bottom: 25px; }
        .ready-btn {
            background: linear-gradient(135deg, #8b5cf6, #ec4899);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 40px;
            font-family: 'Baloo 2', cursive;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
        }
        .ready-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(139,92,246,0.4);
        }

        /* Countdown overlay (3 seconds before game) */
        .game-countdown {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(255,255,255,0.95);
            border-radius: 80px;
            padding: 30px 50px;
            text-align: center;
            z-index: 1001;
            visibility: hidden;
            opacity: 0;
            transition: all 0.2s;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            border: 3px solid #c084fc;
        }
        .game-countdown.show {
            visibility: visible;
            opacity: 1;
        }
        .game-countdown-number {
            font-family: 'Baloo 2', cursive;
            font-size: 5rem;
            font-weight: 900;
            background: linear-gradient(135deg, #8b5cf6, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .game-countdown-text {
            font-family: 'Baloo 2', cursive;
            font-size: 1rem;
            color: #7c3aed;
        }

        /* Success popup */
        .popup-wrap { position:fixed; inset:0; background:rgba(0,0,0,0.4); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; z-index:1100; opacity:0; visibility:hidden; transition:all .3s; }
        .popup-wrap.show { opacity:1; visibility:visible; }
        .popup { background:white; border-radius:40px; padding:25px; max-width:350px; width:90%; text-align:center; transform:scale(.9); transition:transform .3s; border:1px solid #e9d5ff; }
        .popup-wrap.show .popup { transform:scale(1); animation:popBounce 0.3s ease-out; }
        @keyframes popBounce { 0% { transform: scale(0.8); opacity: 0; } 50% { transform: scale(1.02); } 100% { transform: scale(1); opacity: 1; } }
        .popup-icon { font-size:50px; margin-bottom:10px; }
        .popup-title { font-family:'Baloo 2',cursive; font-size:1.6rem; font-weight:900; color:#7c3aed; }
        .popup-stars { font-size:1.2rem; letter-spacing:4px; margin:8px 0; color:#fbbf24; }
        .popup-desc { font-size:.85rem; color:#4b5563; background:#faf5ff; border-radius:18px; padding:12px; margin:12px 0; }
        .popup-btn { background:linear-gradient(135deg,#8b5cf6,#ec4899); color:white; border:none; border-radius:999px; padding:10px 35px; font-family:'Baloo 2',cursive; font-size:.9rem; font-weight:800; cursor:pointer; }

        /* Wrong toast */
        .wrong-toast { position:fixed; bottom:25px; left:50%; transform:translateX(-50%); background:#fef2f2; border:1px solid #fca5a5; color:#dc2626; padding:8px 20px; border-radius:50px; font-family:'Baloo 2',cursive; font-size:.8rem; font-weight:800; z-index:2000; animation:toastFade 2.5s ease forwards; }
        @keyframes toastFade { 0%{opacity:0;transform:translateX(-50%) translateY(10px)} 15%{opacity:1;transform:translateX(-50%) translateY(0)} 80%{opacity:1} 100%{opacity:0;transform:translateX(-50%) translateY(-10px)} }

        @media (max-width: 768px) {
            .main { padding: 20px 16px 60px; }
            .mascot { display: none; }
            .stats-grid { gap: 10px; }
            .stat-value { font-size: 1.3rem; }
            .timer-display-small { font-size: 1.3rem; }
            .ready-card { padding: 25px 30px; }
            .ready-title { font-size: 1.5rem; }
        }
    </style>
{% endblock %}

