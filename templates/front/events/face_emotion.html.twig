{% extends 'base.html.twig' %}

{% block title %}The Mirror - {{ event.titre }} ✨🪞{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800;900&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 50%, #fae8ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }
        /* Grandes étoiles animées en arrière-plan */
        /* Hero mascot bubble - style comme voice_recommendation */


.hero-mascot-bubble {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0px;  /* ← Met à 0px */
    text-decoration: none;
}

.hero-mascot-label {
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(255,255,255,0.28);
    color: #fff;
    font-family: 'Baloo 2', cursive;
    font-size: 0.8rem;  /* ← Réduit un peu la taille */
    font-weight: 700;
    padding: 5px 15px;  /* ← Réduit le padding */
    border-radius: 30px;
    white-space: nowrap;
    margin-top: -5px;  /* ← Remonte la bulle vers l'image */
}

.hero-mascot-icon {
    font-size: 6rem;
    animation: float-mascot 3s ease-in-out infinite;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
}

@keyframes float-mascot {
    0%,100% { transform: translateY(0) rotate(-6deg) scale(1); }
    50%      { transform: translateY(-18px) rotate(6deg) scale(1.05); }
}

.hero-mascot-label {
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(255,255,255,0.28);
    color: #fff;
    font-family: 'Baloo 2', cursive;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 7px 20px;
    border-radius: 30px;
    white-space: nowrap;
   
}
.hero-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
}

.big-star {
    position: absolute;
    color: rgba(255, 255, 255, 0.7);
    font-size: 3rem;
    animation: starFloat 6s ease-in-out infinite;
    text-shadow: 0 0 10px rgba(255,255,255,0.5);
}

.big-star:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; font-size: 4rem; }
.big-star:nth-child(2) { top: 60%; left: 15%; animation-delay: 1s; font-size: 3rem; }
.big-star:nth-child(3) { top: 20%; right: 10%; animation-delay: 2s; font-size: 5rem; }
.big-star:nth-child(4) { bottom: 15%; right: 20%; animation-delay: 0.5s; font-size: 3.5rem; }
.big-star:nth-child(5) { top: 45%; left: 25%; animation-delay: 1.5s; font-size: 2.5rem; }
.big-star:nth-child(6) { bottom: 40%; left: 60%; animation-delay: 2.5s; font-size: 4rem; }
.big-star:nth-child(7) { top: 75%; right: 40%; animation-delay: 0.8s; font-size: 3rem; }
.big-star:nth-child(8) { top: 15%; left: 45%; animation-delay: 1.8s; font-size: 2rem; }
.big-star:nth-child(9) { bottom: 10%; left: 35%; animation-delay: 3s; font-size: 3.5rem; }
.big-star:nth-child(10) { top: 50%; right: 50%; animation-delay: 2.2s; font-size: 2.8rem; }

@keyframes starFloat {
    0%, 100% {
        transform: translateY(0) rotate(0deg);
        opacity: 0.7;
    }
    50% {
        transform: translateY(-25px) rotate(10deg);
        opacity: 1;
    }
}
        /* Breadcrumb (bc) - comme dans show */
.bc {
    margin-bottom: 1rem;
}
.bc a {
    color: rgba(76, 29, 149, 0.7);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
}
.bc a:hover {
    color: #6d28d9;
    transform: translateX(3px);
    display: inline-block;
}
.bc .sep {
    color: rgba(76, 29, 149, 0.5);
    margin: 0 8px;
}
.bc .cur {
    color: #6d28d9;
    font-size: 0.85rem;
    font-weight: 800;
}

/* Hero title - comme dans show */
.hero-title {
    font-family: 'Baloo 2', cursive;
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    font-weight: 800;
    color: white;
    line-height: 1.2;
    margin-bottom: 1rem;
    animation: fadeInUp 0.8s ease;
    text-shadow: 0 3px 18px rgba(0,0,0,0.35);
}

.hero-title .accent {
    background: linear-gradient(135deg, #ff69b4, #ff9ecf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Hero sub - comme dans show */
.hero-sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.85);
    font-weight: 600;
    max-width: 550px;
    line-height: 1.5;
    margin-bottom: 2rem;
    animation: fadeInUp 0.8s ease 0.1s backwards;
    text-shadow: 0 1px 6px rgba(0,0,0,0.2);
}

/* Animation fadeInUp */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Hero pills - comme dans show */
.hero-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    animation: fadeInUp 0.8s ease 0.2s backwards;
}

.hpill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: white;
    padding: 5px 15px;
    border-radius: 999px;
    font-family: 'Baloo 2', cursive;
    font-size: .75rem;
    font-weight: 700;
}

.hpill .n {
    color: #ffc0db;
    font-size: 0.9rem;
    font-weight: 900;
}

/* Hero bear - comme dans show */
.hero-bear {
    text-align: center;
    animation: fadeInUp 0.8s ease 0.3s backwards;
}

.bear-image {
    width: 160px;
    height: auto;
    filter: drop-shadow(0 0 15px rgba(255,255,255,0.3));
    animation: bearFloat 3s ease-in-out infinite;
    transition: all 0.3s ease;
    cursor: pointer;
}

.bear-image:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 25px rgba(255,255,255,0.5));
}

@keyframes bearFloat {
    0%, 100% {
        transform: translateY(0) rotate(-2deg);
    }
    50% {
        transform: translateY(-10px) rotate(2deg);
    }
}

.bear-label {
    display: inline-block;
    margin-top: 8px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: white;
    font-family: 'Baloo 2', cursive;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 30px;
}

/* Hero wave - comme dans show */
.hero-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    z-index: 2;
    line-height: 0;
}

.hero-wave svg {
    display: block;
    width: 100%;
}

        /* ========== SHOOTING STARS BACKGROUND ========== */
        .shooting-stars-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        .shooting-star-bg {
            position: absolute;
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, rgba(139,92,246,0.5), rgba(192,132,252,0.2), transparent);
            border-radius: 999px;
            opacity: 0;
            animation: shootStarBg 4s linear infinite;
        }
        @keyframes shootStarBg {
            0% { transform: translateX(0) translateY(0) rotate(35deg); opacity: 0; width: 0px; }
            10% { opacity: 0.5; width: 80px; }
            70% { opacity: 0.5; width: 80px; }
            100% { transform: translateX(-300px) translateY(200px) rotate(35deg); opacity: 0; width: 0px; }
        }

        /* Floating elements */
        .float-cosmos {
            position: fixed; inset: 0;
            pointer-events: none; z-index: 0; overflow: hidden;
        }
        .fc { position: absolute; font-size: 1.3rem; opacity: 0.15; animation: fcFloat 12s ease-in-out infinite; }
        @keyframes fcFloat {
            0%,100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }

        /* Side mascots */
        .mascot {
            position: fixed; top: 50%;
            font-size: 2rem; line-height: 1;
            z-index: 2; pointer-events: none;
            filter: drop-shadow(0 0 8px rgba(139,92,246,0.2));
            opacity: 0.6;
        }
        .mascot-l { left: 14px; animation: mascotL 5s ease-in-out infinite; transform: translateY(-50%); }
        .mascot-r { right: 14px; animation: mascotR 5s ease-in-out infinite; transform: translateY(-50%); }
        @keyframes mascotL { 0%,100% { transform: translateY(-50%) rotate(-3deg); } 50% { transform: translateY(-55%) rotate(3deg); } }
        @keyframes mascotR { 0%,100% { transform: translateY(-50%) rotate(3deg); } 50% { transform: translateY(-55%) rotate(-3deg); } }

