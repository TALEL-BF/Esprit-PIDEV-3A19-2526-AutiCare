<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1"></script>
<script>
// ========== SHOOTING STARS BACKGROUND ==========
function createShootingStarsBg() {
    const container = document.getElementById('shootingStarsBg');
    for (let i = 0; i < 10; i++) {
        const star = document.createElement('div');
        star.className = 'shooting-star-bg';
        star.style.top = Math.random() * 80 + 10 + '%';
        star.style.left = Math.random() * 70 + 20 + '%';
        star.style.animationDelay = Math.random() * 10 + 's';
        star.style.animationDuration = Math.random() * 3 + 3 + 's';
        container.appendChild(star);
    }
}
createShootingStarsBg();

// ========== SOUND EFFECTS ==========
function playBeep(frequency, duration, volume = 0.25) {
    try {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        oscillator.frequency.value = frequency;
        gainNode.gain.value = volume;
        oscillator.start();
        gainNode.gain.exponentialRampToValueAtTime(0.00001, audioContext.currentTime + duration);
        oscillator.stop(audioContext.currentTime + duration);
        setTimeout(() => audioContext.close(), duration * 1000);
    } catch(e) { console.log('Audio not supported'); }
}

function playCountdownSound(number) {
    switch(number) {
        case 3: playBeep(440, 0.25, 0.25); break;
        case 2: playBeep(523.25, 0.25, 0.3); break;
        case 1: playBeep(659.25, 0.25, 0.35); break;
        case 'go': playBeep(880, 0.5, 0.4); setTimeout(() => playBeep(1046.5, 0.3, 0.35), 150); break;
    }
}

// ========== GAME STATE ==========
let histoireActuelle = {{ histoire_actuelle }};
let etapeActuelle    = {{ etape_actuelle }};
let score            = {{ score }};
let totalEtapes      = {{ total_etapes }};
let totalHistoires   = {{ total_histoires }};
let etapes           = {{ etapes|json_encode|raw }};

let gameTimerInterval = null;
let gameTimeSeconds = 300;
let isGameActive = false;
let isGameStarted = false;

let stream = null;
let isRunning = false;
let detectionInterval = null;

// DOM elements
const video = document.getElementById('cameraView');
const canvas = document.getElementById('canvas');
const startBtn = document.getElementById('startBtn');
const stopBtn = document.getElementById('stopBtn');
const captureBtn = document.getElementById('captureBtn');
const prevStepBtn = document.getElementById('prevStepBtn');
const nextStepBtn = document.getElementById('nextStepBtn');
const statusLabel = document.getElementById('statusLabel');
const detectedLabel = document.getElementById('detectedLabel');
const liveBadge = document.getElementById('liveBadge');
const storyText = document.getElementById('storyText');
const targetEmoDiv = document.getElementById('targetEmotion');
const stepInd = document.getElementById('stepInd');
const storyNum = document.getElementById('storyNum');
const heroScore = document.getElementById('heroScore');
const emotionPopup = document.getElementById('emotionPopup');
const popupIcon = document.getElementById('popupIcon');
const popupTitle = document.getElementById('popupTitle');
const popupDesc = document.getElementById('popupDescription');
const closePopupBtn = document.getElementById('closePopupBtn');

// Stats elements
const progressFillSmall = document.getElementById('progressFillSmall');
const progressPercent = document.getElementById('progressPercent');
const stepText = document.getElementById('stepText');
const statScore = document.getElementById('statScore');
const statTimer = document.getElementById('statTimer');
const emotionsDone = document.getElementById('emotionsDone');

// Ready card elements
const readyOverlay = document.getElementById('readyOverlay');
const readyBtn = document.getElementById('readyBtn');

// Game countdown elements
const gameCountdown = document.getElementById('gameCountdown');
const gameCountdownNumber = document.getElementById('gameCountdownNumber');

// New story elements
const newStoryRow = document.getElementById('newStoryRow');
const newStoryBtn = document.getElementById('newStoryBtn');

const emotionIcons = { 
    'Joie':'😊',
    'Tristesse':'😢', 
    'Colère':'😠',
    'Surprise':'😲',
    'Peur':'😨',
    'Dégout':'🤢'
};

// ========== UI FUNCTIONS ==========
function updateUI() {
    if (etapeActuelle < etapes.length) {
        storyText.innerHTML = etapes[etapeActuelle].texte;
        targetEmoDiv.innerHTML = etapes[etapeActuelle].emotion;
        stepInd.innerHTML = `🎯 Défi ${etapeActuelle+1}/${etapes.length}`;
        prevStepBtn.disabled = (etapeActuelle === 0);
        nextStepBtn.disabled = false;
    }
    const max = totalEtapes;
    const progressPercentValue = Math.round((score / max) * 100);
    progressFillSmall.style.width = `${progressPercentValue}%`;
    progressPercent.innerHTML = `${progressPercentValue}%`;
    stepText.innerHTML = `Défi ${etapeActuelle+1}/${etapes.length}`;
    statScore.innerHTML = score;
    emotionsDone.innerHTML = score;
    heroScore.innerHTML = score;
}

function confettiBlast() {
    if (typeof confetti === 'undefined') return;
    confetti({ particleCount:120, spread:60, origin:{y:.6}, colors:['#8b5cf6','#c084fc','#fbbf24','#ec4899'] });
    setTimeout(() => {
        confetti({ particleCount:40, spread:90, origin:{y:.5,x:.2}, shapes:['star'] });
        confetti({ particleCount:40, spread:90, origin:{y:.5,x:.8}, shapes:['star'] });
    }, 150);
}

function toast(msg) {
    const el = document.createElement('div');
    el.className = 'wrong-toast';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2300);
}

function updateLive(emotion, faceRect) {
    detectedLabel.innerHTML = emotion;
    liveBadge.innerHTML = `<span class="live-dot"></span>${emotion}`;
    if (faceRect && faceRect.width > 0) drawFaceBox(faceRect);
    else clearFaceBox();
}

function drawFaceBox(rect) {
    clearFaceBox();
    const vr = video.getBoundingClientRect();
    const wrap = document.querySelector('.cam-vp');
    if (!wrap || !vr.width) return;
    const sx = vr.width / video.videoWidth;
    const sy = vr.height / video.videoHeight;
    const el = document.createElement('div');
    el.className = 'face-box';
    el.style.cssText = `left:${rect.x*sx}px;top:${rect.y*sy}px;width:${rect.width*sx}px;height:${rect.height*sy}px;`;
    wrap.appendChild(el);
}

function clearFaceBox() {
    document.querySelectorAll('.face-box').forEach(e => e.remove());
}

function showPopup(emotion, explication) {
    popupIcon.innerHTML = emotionIcons[emotion] || '😊';
    popupTitle.innerHTML = emotion + ' !';
    popupDesc.innerHTML = explication;
    emotionPopup.classList.add('show');
    confettiBlast();
}

function closePopup() {
    emotionPopup.classList.remove('show');
}

function startGameTimer() {
    if (gameTimerInterval) clearInterval(gameTimerInterval);
    gameTimeSeconds = 300;
    updateTimerDisplay();
    
    gameTimerInterval = setInterval(() => {
        if (!isGameActive) return;
        if (gameTimeSeconds <= 0) {
            clearInterval(gameTimerInterval);
            gameTimerInterval = null;
            isGameActive = false;
            isGameStarted = false;
            statusLabel.innerHTML = '⏰ Temps écoulé ! Bravo ! ⏰';
            toast('🎉 Félicitations ! Tu as terminé ! 🎉');
            captureBtn.disabled = true;
        } else {
            gameTimeSeconds--;
            updateTimerDisplay();
        }
    }, 1000);
}

function updateTimerDisplay() {
    const minutes = Math.floor(gameTimeSeconds / 60);
    const seconds = gameTimeSeconds % 60;
    statTimer.innerHTML = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    
    const timerCard = document.getElementById('timerCard');
    if (gameTimeSeconds <= 60) {
        timerCard.style.background = 'linear-gradient(135deg, #fee2e2, #fecaca)';
    } else {
        timerCard.style.background = 'white';
    }
}

// ========== COMPLETION SUMMARY ==========
// ========== COMPLETION SUMMARY (smaller + new emotions) ==========
function showCompletionSummary() {
    const finalScore = score;
    const totalPossible = totalEtapes;
    const percentage = Math.round((finalScore / totalPossible) * 100);
    const emotionsLearned = [...new Set(etapes.map(e => e.emotion))];
    
    // Message de félicitations personnalisé
    let growthMessage = "";
    if (percentage === 100) {
        growthMessage = "🎉 Tu es devenu un véritable champion des émotions ! 🎉";
    } else if (percentage >= 70) {
        growthMessage = "🌟 Tu as beaucoup grandi ! Continue comme ça ! 🌟";
    } else {
        growthMessage = "💪 Tu progresses chaque jour ! Tu deviens plus grand(e) ! 💪";
    }
    
    const summaryHTML = `
        <div id="completionModal" class="completion-modal">
            <div class="completion-content">
                <div class="completion-emoji">🏆✨🪞</div>
                <h2 class="completion-title">Félicitations !</h2>
                <p class="completion-subtitle">Tu as terminé ton aventure magique !</p>
                
                <div class="completion-stats">
                    <div class="completion-stat">
                        <span class="stat-emoji">⭐</span>
                        <span class="stat-value">${finalScore}</span>
                        <span class="stat-label">étoiles</span>
                    </div>
                    <div class="completion-stat">
                        <span class="stat-emoji">📊</span>
                        <span class="stat-value">${percentage}%</span>
                        <span class="stat-label">progression</span>
                    </div>
                    <div class="completion-stat">
                        <span class="stat-emoji">🎭</span>
                        <span class="stat-value">${emotionsLearned.length}</span>
                        <span class="stat-label">émotions</span>
                    </div>
                </div>
                
                <div class="completion-emotions">
                    <h3>🎨 Tu as appris ces émotions :</h3>
                    <div class="emotions-summary">
                        ${emotionsLearned.map(e => {
                            let emoji = '😊';
                            if (e === 'Joie') emoji = '😊';
                            else if (e === 'Tristesse') emoji = '😢';
                            else if (e === 'Colère') emoji = '😠';
                            else if (e === 'Surprise') emoji = '😲';
                            else if (e === 'Peur') emoji = '😨';
                            else if (e === 'Dégout') emoji = '🤢';
                            else emoji = '😊';
                            return `<div class="emotion-badge">${emoji} ${e}</div>`;
                        }).join('')}
                    </div>
                </div>
                
                <div class="completion-message">
                    <p>${growthMessage}</p>
                    <p>✨ Le miroir magique est fier de toi ! ✨</p>
                </div>
                
                <button id="closeCompletionBtn" class="completion-close-btn">✨ Continuer ✨</button>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', summaryHTML);
    
    // Styles plus compacts
    const modalStyle = document.createElement('style');
    modalStyle.textContent = `
        .completion-modal {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(6px);
            z-index: 2000; display: flex; align-items: center; justify-content: center;
            animation: fadeInModal 0.3s ease;
        }
        @keyframes fadeInModal { from { opacity: 0; } to { opacity: 1; } }
        .completion-content {
            background: linear-gradient(135deg, #fff, #faf5ff);
            border-radius: 40px; padding: 20px 25px;
            max-width: 420px; width: 90%; text-align: center;
            border: 3px solid #c084fc;
            box-shadow: 0 20px 40px rgba(139,92,246,0.25);
            animation: slideUpModal 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes slideUpModal { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .completion-emoji { font-size: 2.8rem; margin-bottom: 5px; }
        .completion-title { font-family: 'Baloo 2', cursive; font-size: 1.6rem; font-weight: 900; color: #7c3aed; margin-bottom: 2px; }
        .completion-subtitle { font-size: 0.75rem; color: #6b7280; margin-bottom: 15px; }
        .completion-stats { display: flex; justify-content: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
        .completion-stat { background: linear-gradient(135deg, #f3e8ff, #ede9fe); border-radius: 18px; padding: 8px 12px; min-width: 70px; text-align: center; }
        .stat-emoji { font-size: 1.2rem; display: block; margin-bottom: 2px; }
        .stat-value { font-family: 'Baloo 2', cursive; font-size: 1.3rem; font-weight: 900; color: #7c3aed; display: block; }
        .stat-label { font-size: 0.6rem; color: #a78bfa; font-weight: 800; }
        .completion-emotions { background: #faf5ff; border-radius: 18px; padding: 10px 12px; margin-bottom: 15px; }
        .completion-emotions h3 { font-family: 'Baloo 2', cursive; font-size: 0.75rem; color: #7c3aed; margin-bottom: 8px; }
        .emotions-summary { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
        .emotion-badge { background: white; border: 2px solid #c084fc; border-radius: 30px; padding: 4px 10px; font-family: 'Baloo 2', cursive; font-weight: 800; color: #7c3aed; font-size: 0.7rem; }
        .completion-message { background: linear-gradient(135deg, #fdf4ff, #fae8ff); border-radius: 16px; padding: 10px; margin-bottom: 15px; }
        .completion-message p { font-size: 0.7rem; color: #4b5563; margin: 3px 0; }
        .completion-close-btn { background: linear-gradient(135deg, #8b5cf6, #ec4899); color: white; border: none; border-radius: 40px; padding: 8px 25px; font-family: 'Baloo 2', cursive; font-size: 0.85rem; font-weight: 800; cursor: pointer; width: 100%; }
        .completion-close-btn:hover { transform: scale(1.02); }
    `;
    document.head.appendChild(modalStyle);
    
    document.getElementById('closeCompletionBtn').addEventListener('click', () => {
        const modal = document.getElementById('completionModal');
        modal.remove();
    });
    
    confettiBlast();
    setTimeout(() => confettiBlast(), 400);
    setTimeout(() => confettiBlast(), 800);
}
// ========== NEW STORY ==========
async function loadNewStory() {
    toast('📖 Génération d\'une nouvelle histoire magique...');
    try {
        const response = await fetch('/api/emotion/new-story', { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
            etapes = data.etapes;
            totalEtapes = data.total_etapes;
            etapeActuelle = 0;
            score = 0;
            
            const step = data.premiere_etape;
            storyText.innerHTML = step.texte;
            targetEmoDiv.innerHTML = step.emotion;
            stepInd.innerHTML = `🎯 Défi 1/${totalEtapes}`;
            statScore.innerHTML = '0';
            emotionsDone.innerHTML = '0';
            heroScore.innerHTML = '0';
            progressFillSmall.style.width = '0%';
            progressPercent.innerHTML = '0%';
            stepText.innerHTML = `Défi 1/${totalEtapes}`;
            
            isGameActive = true;
            captureBtn.disabled = false;
            nextStepBtn.disabled = false;
            newStoryRow.style.display = 'none';
            
            statusLabel.innerHTML = '✨ Nouvelle aventure ! Capture les émotions ! ✨';
            toast('🌟 Nouvelle histoire générée ! Bonne chance ! 🌟');
        }
    } catch (error) {
        toast('❌ Erreur lors de la génération de la nouvelle histoire');
    }
}

// ========== CAPTURE ==========
async function captureAndAnalyze() {
    if (!isRunning) { toast('Active d\'abord la caméra !'); return; }
    if (!isGameActive) { toast('Le jeu n\'est pas encore commencé !'); return; }
    if (etapeActuelle >= etapes.length) { toast('🎉 Tu as terminé l\'aventure !'); return; }
    
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
    const base64 = canvas.toDataURL('image/jpeg').split(',')[1];
    statusLabel.innerHTML = '🔍 Analyse...';
    
    try {
        const res = await fetch('/api/emotion/capture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: base64 })
        });
        const data = await res.json();
        
        if (data.success === false) { statusLabel.innerHTML = data.message; return; }
        
        if (data.correct) {
            score = data.score;
            updateUI();
            showPopup(data.emotion_attendue, data.explication);
            statusLabel.innerHTML = '🎉 Magique ! Tu as réussi ! 🎉';
            
            setTimeout(async () => {
                const nd = await (await fetch('/api/emotion/next', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nouvelle_histoire: false })
                })).json();
                
                if (nd.game_finished) {
                    statusLabel.innerHTML = '🏆 BRAVO ! Tu as terminé l\'aventure !';
                    captureBtn.disabled = true;
                    nextStepBtn.disabled = true;
                    isGameActive = false;
                    if (gameTimerInterval) clearInterval(gameTimerInterval);
                    showCompletionSummary();
                    newStoryRow.style.display = 'flex';
                } else if (nd.histoire_terminee) {
                    const sd = await (await fetch('/api/emotion/next', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ nouvelle_histoire: true })
                    })).json();
                    if (sd.game_finished) {
                        statusLabel.innerHTML = '🏆 Félicitations ! Aventure terminée !';
                        captureBtn.disabled = true;
                        isGameActive = false;
                        if (gameTimerInterval) clearInterval(gameTimerInterval);
                        showCompletionSummary();
                        newStoryRow.style.display = 'flex';
                    } else if (sd.success) {
                        histoireActuelle = sd.histoire_actuelle;
                        etapeActuelle = sd.etape_actuelle;
                        etapes = sd.etapes;
                        updateUI();
                        statusLabel.innerHTML = `📖 Nouveau chapitre !`;
                    }
                } else if (nd.success) {
                    etapeActuelle = nd.etape_actuelle;
                    storyText.innerHTML = nd.texte;
                    targetEmoDiv.innerHTML = nd.emotion_attendue;
                    stepInd.innerHTML = `🎯 Défi ${etapeActuelle+1}/${etapes.length}`;
                    prevStepBtn.disabled = false;
                    statusLabel.innerHTML = '✅ Prêt pour le prochain défi !';
                }
            }, 1800);
        } else if (data.already_validated) {
            statusLabel.innerHTML = data.message;
        } else {
            toast("Ce n'est pas la bonne émotion ! Essaie encore !");
            statusLabel.innerHTML = data.message;
        }
    } catch (err) {
        statusLabel.innerHTML = '❌ Problème technique... Réessaie !';
    }
}

// ========== CAMERA ==========
async function startCamera() {
    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
        isRunning = true;
        startBtn.disabled = true;
        stopBtn.disabled = false;
        captureBtn.disabled = false;
        statusLabel.innerHTML = '✅ Caméra activée ! 🌟';
        await video.play();
        startRealTimeDetection();
        
        // Show ready card IMMEDIATELY
        if (isRunning && !readyOverlay.classList.contains('show')) {
            readyOverlay.classList.add('show');
        }
        
    } catch {
        statusLabel.innerHTML = '❌ Impossible d\'accéder à la caméra';
    }
}

function stopCamera() {
    if (detectionInterval) { clearInterval(detectionInterval); detectionInterval = null; }
    if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
    video.srcObject = null;
    isRunning = false;
    startBtn.disabled = false;
    stopBtn.disabled = true;
    captureBtn.disabled = true;
    statusLabel.innerHTML = '✅ Caméra arrêtée';
    clearFaceBox();
    detectedLabel.innerHTML = 'En attente...';
    liveBadge.innerHTML = '<span class="live-dot"></span>😐 En attente...';
}

async function startRealTimeDetection() {
    if (detectionInterval) clearInterval(detectionInterval);
    detectionInterval = setInterval(async () => {
        if (!isRunning || !video.videoWidth) return;
        try {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            const base64 = canvas.toDataURL('image/jpeg').split(',')[1];
            const res = await fetch('/api/emotion/detect-live', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ image: base64 })
            });
            const data = await res.json();
            if (data.success && data.face_detected) {
                updateLive(data.emotion, data.face_rect);
            } else {
                clearFaceBox();
                detectedLabel.innerHTML = '👤 Aucun visage';
                liveBadge.innerHTML = '<span class="live-dot"></span>👤 Aucun visage';
            }
        } catch(e) { console.error(e); }
    }, 500);
}

// ========== READY CARD & COUNTDOWN ==========
readyBtn.addEventListener('click', () => {
    readyOverlay.classList.remove('show');
    startGameCountdown();
});

function startGameCountdown() {
    let count = 3;
    gameCountdown.classList.add('show');
    gameCountdownNumber.textContent = count;
    playCountdownSound(3);
    
    const countdownInterval = setInterval(() => {
        count--;
        if (count >= 1) {
            gameCountdownNumber.textContent = count;
            playCountdownSound(count);
        } else if (count === 0) {
            gameCountdownNumber.textContent = 'GO!';
            playCountdownSound('go');
        } else {
            clearInterval(countdownInterval);
            gameCountdown.classList.remove('show');
            isGameActive = true;
            isGameStarted = true;
            startGameTimer();
            statusLabel.innerHTML = '🎮 C\'EST PARTI ! Capture les émotions ! 🎮';
            toast('🎮 Le jeu commence ! Amuse-toi bien ! 🎮');
        }
    }, 1000);
}

// ========== NAVIGATION ==========
async function previousStep() {
    if (!isGameActive && isGameStarted) { toast('Le jeu n\'est pas actif !'); return; }
    if (etapeActuelle <= 0) return;
    const d = await (await fetch('/api/emotion/previous', { method: 'POST', headers: { 'Content-Type': 'application/json' } })).json();
    if (d.success) {
        etapeActuelle = d.etape_actuelle;
        storyText.innerHTML = d.texte;
        targetEmoDiv.innerHTML = d.emotion_attendue;
        stepInd.innerHTML = `🎯 Défi ${etapeActuelle+1}/${etapes.length}`;
        prevStepBtn.disabled = (etapeActuelle === 0);
        statusLabel.innerHTML = '✅ Retour à l\'étape précédente';
        updateUI();
    }
}

async function nextStep() {
    if (!isGameActive && isGameStarted) { toast('Le jeu n\'est pas actif !'); return; }
    if (etapeActuelle >= etapes.length - 1) return;
    const d = await (await fetch('/api/emotion/next', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nouvelle_histoire: false })
    })).json();
    if (d.success && !d.histoire_terminee) {
        etapeActuelle = d.etape_actuelle;
        storyText.innerHTML = d.texte;
        targetEmoDiv.innerHTML = d.emotion_attendue;
        stepInd.innerHTML = `🎯 Défi ${etapeActuelle+1}/${etapes.length}`;
        prevStepBtn.disabled = false;
        if (etapeActuelle === etapes.length - 1) nextStepBtn.disabled = true;
        statusLabel.innerHTML = '✅ Étape suivante';
        updateUI();
    } else if (d.histoire_terminee) {
        statusLabel.innerHTML = '📖 Fin du chapitre ! Capture l\'émotion pour continuer';
    }
}

// ========== EVENT LISTENERS ==========
startBtn.addEventListener('click', startCamera);
stopBtn.addEventListener('click', stopCamera);
captureBtn.addEventListener('click', captureAndAnalyze);
prevStepBtn.addEventListener('click', previousStep);
nextStepBtn.addEventListener('click', nextStep);
closePopupBtn.addEventListener('click', closePopup);
if (newStoryBtn) newStoryBtn.addEventListener('click', loadNewStory);

updateUI();

window.addEventListener('beforeunload', () => {
    if (stream) stream.getTracks().forEach(t => t.stop());
    if (detectionInterval) clearInterval(detectionInterval);
    if (gameTimerInterval) clearInterval(gameTimerInterval);
});
</script>
