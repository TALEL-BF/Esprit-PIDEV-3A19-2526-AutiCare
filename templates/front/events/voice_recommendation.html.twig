{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1"></script>
<script>
    let mediaRecorder = null;
    let audioChunks = [];
    let timerInterval = null;
    let seconds = 0;
    let isRecording = false;
    let mediaStream = null;
    let selectedEmotion = null;

    // Emotion wheel selection
    document.querySelectorAll('.emotion-chip').forEach(chip => {
        chip.addEventListener('click', function() {
            document.querySelectorAll('.emotion-chip').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');
            selectedEmotion = this.dataset.emotion;
        });
    });

    const micButton = document.getElementById('micButton');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const resetBtn = document.getElementById('resetBtn');
    const timerArea = document.getElementById('timerArea');
    const secondsSpan = document.getElementById('seconds');
    const progressFill = document.getElementById('progressFill');
    const loadingArea = document.getElementById('loadingArea');
    const resultsArea = document.getElementById('resultsArea');

    // ============================================
    // FONCTIONS DE BASE
    // ============================================
   function escapeHtml(str) {
    // Si c'est null, undefined, ou pas une string, retourne une chaîne vide
    if (str === null || str === undefined || typeof str !== 'string') {
        return '';
    }
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

    function showError(message) {
        resultsArea.style.display = 'block';
        resultsArea.innerHTML = `<div class="error-message">${escapeHtml(message)}</div>`;
    }

    function getEmotionClass(emotion) {
        const mapping = {
            'joyeux': 'joyeux', 'joyeuse': 'joyeux',
            'triste': 'triste',
            'colere': 'colere', 'colère': 'colere',
            'peur': 'peur', 'anxieux': 'peur', 'anxieuse': 'peur',
            'neutre': 'neutre'
        };
        return mapping[emotion] || 'neutre';
    }

    function getEmotionIcon(emotion) {
        const icons = {
            'joyeux': '😊',
            'triste': '😢',
            'colere': '😠',
            'peur': '😰',
            'neutre': '😐'
        };
        return icons[emotion] || '🤗';
    }

    function getBigEmotionIcon(emotion) {
        const icons = {
            'joyeux': '🎉✨😊',
            'triste': '💧🌧️😢',
            'colere': '⚡🔥😠',
            'peur': '🦋💓😰',
            'neutre': '🌸🍃😐'
        };
        return icons[emotion] || '🌟';
    }

    // ============================================
    // SYSTÈME DE CONFETTIS
    // ============================================
    
    function launchConfetti(emotion) {
        const confettiConfig = {
            'joyeux': {
                colors: ['#FFD700', '#FFA500', '#FF69B4', '#00FF7F', '#FFE4B5', '#FF6347'],
                emojis: ['🎉', '✨', '⭐', '🎊', '🌟', '💛'],
                duration: 3000,
                particleCount: 200
            },
            'triste': {
                colors: ['#87CEEB', '#ADD8E6', '#B0C4DE', '#4682B4', '#5F9EA0', '#00CED1'],
                emojis: ['💧', '🌧️', '🫂', '🤗', '💙', '🕊️'],
                duration: 2500,
                particleCount: 150
            },
            'colere': {
                colors: ['#FF4500', '#FF0000', '#DC143C', '#B22222', '#FF6347', '#FF8C00'],
                emojis: ['⚡', '🔥', '💪', '🎯', '🌋', '⚔️'],
                duration: 2000,
                particleCount: 180
            },
            'peur': {
                colors: ['#9370DB', '#8A2BE2', '#7B68EE', '#9B59B6', '#DDA0DD', '#EE82EE'],
                emojis: ['🦋', '💓', '🌈', '🕯️', '🌟', '🍃'],
                duration: 2800,
                particleCount: 160
            },
            'neutre': {
                colors: ['#98FB98', '#D3D3D3', '#F0E68C', '#E0FFFF', '#FFE4E1', '#F5F5DC'],
                emojis: ['🌸', '🍃', '✨', '💗', '🕊️', '🌼'],
                duration: 2200,
                particleCount: 140
            }
        };
        
        const config = confettiConfig[emotion] || confettiConfig['neutre'];
        
        if (typeof confetti !== 'undefined') {
            // 1. Lancer les confettis colorés
            confetti({
                particleCount: config.particleCount,
                spread: 100,
                origin: { y: 0.6 },
                colors: config.colors,
                startVelocity: 25,
                decay: 0.9,
                ticks: 200
            });
            
            // 2. Ajouter des confettis en forme d'étoiles
            setTimeout(() => {
                confetti({
                    particleCount: 50,
                    spread: 120,
                    origin: { y: 0.5, x: 0.3 },
                    colors: config.colors,
                    startVelocity: 30,
                    shapes: ['star'],
                    scalar: 1.5
                });
                
                confetti({
                    particleCount: 50,
                    spread: 120,
                    origin: { y: 0.5, x: 0.7 },
                    colors: config.colors,
                    startVelocity: 30,
                    shapes: ['star'],
                    scalar: 1.5
                });
            }, 200);
            
            // 3. Pluie de confettis depuis le haut
            setTimeout(() => {
                confetti({
                    particleCount: 100,
                    spread: 180,
                    origin: { y: 0, x: 0.5 },
                    colors: config.colors,
                    startVelocity: 15,
                    angle: 90,
                    gravity: 1.5
                });
            }, 800);
        }
        
        // 4. Afficher un message flottant
        showFloatingEmotionMessage(emotion);
    }
    
    function showFloatingEmotionMessage(emotion) {
        const messages = {
            'joyeux': ['🎉 Youpi ! Tu es joyeux(se) ! 🎊', '✨ Ta joie fait briller le monde ✨', '🌟 Continue à rayonner ! 🌟'],
            'triste': ['🤗 Je suis là pour toi', '💙 Un câlin virtuel pour toi', '🫂 Tout va bien aller'],
            'colere': ['💪 Respire... Tout va bien', '🎯 Transforme cette énergie', '🌋 Calme-toi, je suis là'],
            'peur': ['🦋 Tu es courageux(se)', '💓 Tout va bien se passer', '🌈 Je te protège'],
            'neutre': ['🌸 Profite de ce moment', '🍃 La paix intérieure', '💗 Prends soin de toi']
        };
        
        const msgList = messages[emotion] || messages['neutre'];
        const randomMsg = msgList[Math.floor(Math.random() * msgList.length)];
        
        const floatingMsg = document.createElement('div');
        floatingMsg.textContent = randomMsg;
        floatingMsg.style.position = 'fixed';
        floatingMsg.style.bottom = '20%';
        floatingMsg.style.left = '50%';
        floatingMsg.style.transform = 'translateX(-50%)';
        floatingMsg.style.backgroundColor = 'rgba(255,255,255,0.95)';
        floatingMsg.style.backdropFilter = 'blur(10px)';
        floatingMsg.style.padding = '12px 24px';
        floatingMsg.style.borderRadius = '50px';
        floatingMsg.style.fontFamily = "'Baloo 2', cursive";
        floatingMsg.style.fontWeight = 'bold';
        floatingMsg.style.fontSize = '1.2rem';
        floatingMsg.style.zIndex = '9999';
        floatingMsg.style.boxShadow = '0 8px 25px rgba(0,0,0,0.2)';
        floatingMsg.style.border = '2px solid rgba(255,255,255,0.5)';
        floatingMsg.style.animation = 'floatMessage 2s ease-in-out forwards';
        floatingMsg.style.pointerEvents = 'none';
        
        const colors = {
            'joyeux': '#FFD700',
            'triste': '#87CEEB',
            'colere': '#FF6347',
            'peur': '#9370DB',
            'neutre': '#98FB98'
        };
        floatingMsg.style.borderLeft = `5px solid ${colors[emotion] || '#a78bfa'}`;
        
        document.body.appendChild(floatingMsg);
        
        setTimeout(() => {
            if (floatingMsg && floatingMsg.remove) {
                floatingMsg.remove();
            }
        }, 2000);
    }
    
    function launchFireworks() {
        if (typeof confetti === 'undefined') return;
        
        const duration = 1500;
        const animationEnd = Date.now() + duration;
        const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 1000 };
        
        function randomInRange(min, max) {
            return Math.random() * (max - min) + min;
        }
        
        const interval = setInterval(function() {
            const timeLeft = animationEnd - Date.now();
            if (timeLeft <= 0) {
                return clearInterval(interval);
            }
            
            const particleCount = 50 * (timeLeft / duration);
            confetti({
                ...defaults,
                particleCount,
                origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 },
                colors: ['#FFD700', '#FFA500', '#FF69B4', '#00FF7F']
            });
            confetti({
                ...defaults,
                particleCount,
                origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 },
                colors: ['#FFD700', '#FFA500', '#FF69B4', '#00FF7F']
            });
        }, 250);
    }

    // ============================================
    // DISPLAY RESULTS (définie AVANT d'être utilisée)
    // ============================================
   function displayResults(data) {
    resultsArea.style.display = 'block';
    
    // Forcer les valeurs par défaut
    const emotionText = data.emotion || '😐 Neutre';
    const userText = data.user_text || 'Je ressens quelque chose...';
    const eventsList = data.recommended_events || [];
    
    console.log('Emotion:', emotionText);
    console.log('User text:', userText);
    console.log('Advice reçu:', data.advice);
    
    const emotionClean = String(emotionText).toLowerCase().replace(/[^a-z]/g, '');
    const emotionClass = getEmotionClass(emotionClean);
    
    // Extraire l'émotion pour les confettis
    let emotionKey = 'neutre';
    if (emotionText.includes('Joie') || emotionText.includes('joyeux')) emotionKey = 'joyeux';
    else if (emotionText.includes('Triste') || emotionText.includes('triste')) emotionKey = 'triste';
    else if (emotionText.includes('Colère') || emotionText.includes('colere')) emotionKey = 'colere';
    else if (emotionText.includes('Anxiété') || emotionText.includes('peur')) emotionKey = 'peur';
    
    // LANCER LES CONFETTIS
    launchConfetti(emotionKey);
    if (emotionKey === 'joyeux') {
        setTimeout(() => launchFireworks(), 500);
    }
    
    let html = `
        <div class="emotion-bubble ${emotionClass}">
            <div class="big-emotion-icon">${getBigEmotionIcon(emotionClean)}</div>
            <div style="font-size: 18px; font-weight: 800; font-family: 'Baloo 2', cursive; margin: 8px 0; color: #5b21b6;">
                Je ressens que tu es ${escapeHtml(emotionText)}
            </div>
            <div style="font-style: italic; color: #6b7280; font-size: 14px;">
                "${escapeHtml(userText)}"
            </div>
            <span class="emotion-badge emotion-${emotionClass}">
                ${getEmotionIcon(emotionClean)} ${escapeHtml(emotionText)}
            </span>
        </div>
    `;
    
    // Events section
    html += `<div class="events-list"><strong style="font-size: 16px; color: #5b21b6;">✨ Voici des événements pour accompagner ton émotion :</strong>`;
    
    if (eventsList.length > 0) {
        eventsList.forEach((event) => {
            const eventId = event.id ? '/event/' + event.id : '#';
            const eventTitle = event.title || 'Événement';
            const eventType = event.type || 'Activité';
            const eventDate = event.date || 'Date à venir';
            const eventLocation = event.location || 'Lieu non spécifié';
            const eventEmoji = event.emoji || '📅';
            
            html += `
                <div class="event-card ${emotionClass}" onclick="if('${eventId}' !== '#') window.location.href='${eventId}'">
                    <div class="event-header">
                        <span class="event-emoji">${escapeHtml(eventEmoji)}</span>
                        <span class="event-title">${escapeHtml(eventTitle)}</span>
                        <span class="event-type">${escapeHtml(eventType)}</span>
                    </div>
                    <div class="event-details">
                        <span class="event-detail">📅 ${escapeHtml(eventDate)}</span>
                        <span class="event-detail">📍 ${escapeHtml(eventLocation)}</span>
                    </div>
                </div>
            `;
        });
    } else {
        html += `<p style="color: #9ca3af; padding: 20px; text-align: center;">✨ Aucun événement pour le moment, mais prends soin de toi 💗</p>`;
    }
    
    html += `</div>`;
    
    // ============================================
    // ADVICE SECTION - CORRIGÉE
    // ============================================
    let adviceText = data.advice;
    
    // Vérifier si le conseil est valide
    if (!adviceText || adviceText === 'undefined' || adviceText === 'null' || typeof adviceText !== 'string') {
        // Conseils par défaut selon l'émotion
        const defaultAdvices = {
            'joyeux': 'Continue à rayonner ! Ta joie est contagieuse. 🌟 Profite de chaque instant ! 💛',
            'triste': 'C\'est okay d\'être triste. Un câlin virtuel pour toi 🤗 Tout va bien aller.',
            'colere': 'Ta colère est légitime. Respire profondément. Tu vas y arriver ! 💪',
            'peur': 'La peur nous protège. Tu es plus fort(e) que tes peurs. 🦋',
            'neutre': 'Profite de ce moment de calme. 🌸 Prends soin de toi.'
        };
        adviceText = defaultAdvices[emotionKey] || defaultAdvices['neutre'];
        console.log('Utilisation du conseil par défaut pour:', emotionKey);
    }
    
    // ID unique pour le conseil (pour la lecture vocale)
const adviceId = 'advice_' + Date.now();

html += `
    <div class="advice-card">
        <div class="advice-emoji">🧸</div>
        <div class="advice-title">Un petit conseil pour toi</div>
        <div class="advice-text" id="${adviceId}">${escapeHtml(adviceText)}</div>
        <div style="display: flex; gap: 10px; justify-content: center; margin-top: 15px;">
            <button class="btn-speak" onclick="speakAdvice('${adviceId}')">🔊 Réécouter</button>
            <button class="btn-stop" onclick="stopSpeaking()">🔇 Stop</button>
        </div>
    </div>

    `;
    
autoSpeakAdvice(adviceText);
    
    resultsArea.innerHTML = html;
}

    // ============================================
    // FONCTIONS D'ENREGISTREMENT
    // ============================================
    
    function updateTimerDisplay() {
        secondsSpan.textContent = seconds;
        const percent = (seconds / 15) * 100;
        progressFill.style.width = percent + '%';
    }

    function stopTimer() {
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            if (seconds < 15) {
                seconds++;
                updateTimerDisplay();
                if (seconds === 15) {
                    stopRecording();
                }
            }
        }, 1000);
    }

    async function sendAudioToBackend(audioBlob) {
        const formData = new FormData();
        formData.append('audio', audioBlob, 'recording.webm');
        if (selectedEmotion) {
            formData.append('selected_emotion', selectedEmotion);
        }

        try {
            const response = await fetch('/api/voice/recommend', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();
            loadingArea.style.display = 'none';
            
            if (data.success) {
                displayResults(data);
            } else {
                showError(data.error || '😔 Impossible d\'analyser ton émotion. Réessaie !');
            }
        } catch (error) {
            console.error('Erreur:', error);
            loadingArea.style.display = 'none';
            showError('🌐 Problème de connexion. Vérifie ton réseau.');
        }
    }

    function stopRecording() {
        if (mediaRecorder && isRecording) {
            mediaRecorder.stop();
            isRecording = false;
            stopTimer();
            micButton.classList.remove('recording');
            startBtn.style.display = 'inline-block';
            stopBtn.style.display = 'none';
            timerArea.style.display = 'none';
            loadingArea.style.display = 'block';
        }
    }

    async function startRecording() {
        try {
            console.log('Demande d\'accès au micro...');
            mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
            console.log('Micro autorisé !');
            
            mediaRecorder = new MediaRecorder(mediaStream);
            audioChunks = [];

            mediaRecorder.ondataavailable = (event) => {
                if (event.data.size > 0) {
                    audioChunks.push(event.data);
                }
            };

            mediaRecorder.onstop = () => {
                if (audioChunks.length > 0) {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    sendAudioToBackend(audioBlob);
                } else {
                    loadingArea.style.display = 'none';
                    showError('Aucun son capté. Parle plus fort ! 🗣️');
                }
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }
            };

            mediaRecorder.start(100);
            isRecording = true;
            seconds = 0;
            updateTimerDisplay();
            startTimer();
            
            micButton.classList.add('recording');
            startBtn.style.display = 'none';
            stopBtn.style.display = 'inline-block';
            timerArea.style.display = 'block';
            resultsArea.style.display = 'none';
            loadingArea.style.display = 'none';
            
        } catch (error) {
            console.error('Erreur micro détaillée:', error);
            if (error.name === 'NotAllowedError') {
                showError('🔇 Microphone bloqué ! Clique sur l\'icône 🔒 dans la barre d\'adresse et autorise le microphone.');
            } else if (error.name === 'NotFoundError') {
                showError('🎤 Aucun microphone trouvé. Branche un micro et réessaie.');
            } else {
                showError('🔇 Impossible d\'accéder au microphone. Vérifie les permissions.');
            }
        }
    }

    // ============================================
    // EVENT LISTENERS
    // ============================================
    // ============================================
// SYNTHÈSE VOCALE (lecture du conseil)
// ============================================

let currentUtterance = null;

function speakAdvice(elementId) {
    // Arrêter toute lecture en cours
    if (currentUtterance) {
        window.speechSynthesis.cancel();
    }
    
    // Récupérer le texte du conseil
    const element = document.getElementById(elementId);
    if (!element) return;
    
    const text = element.innerText;
    if (!text) return;
    
    // Créer la synthèse vocale
    currentUtterance = new SpeechSynthesisUtterance(text);
    currentUtterance.lang = 'fr-FR';  // Français
    currentUtterance.rate = 0.9;      // Vitesse un peu plus lente (pour les enfants)
    currentUtterance.pitch = 1.1;      // Voix un peu plus haute
    currentUtterance.volume = 0.8;     // Volume modéré
    
    // Sélectionner une voix féminine si disponible
    window.speechSynthesis.onvoiceschanged = () => {
        const voices = window.speechSynthesis.getVoices();
        const frenchVoice = voices.find(voice => voice.lang === 'fr-FR' && voice.name.includes('Google'));
        if (frenchVoice) {
            currentUtterance.voice = frenchVoice;
        }
    };
    
    // Lire
    window.speechSynthesis.speak(currentUtterance);
}

function stopSpeaking() {
    if (currentUtterance) {
        window.speechSynthesis.cancel();
        currentUtterance = null;
    }
}

// Lecture automatique quand le conseil apparaît
function autoSpeakAdvice(text) {
    // Arrêter toute lecture en cours
    if (currentUtterance) {
        window.speechSynthesis.cancel();
    }
    
    if (!text) return;
    
    currentUtterance = new SpeechSynthesisUtterance(text);
    currentUtterance.lang = 'fr-FR';
    currentUtterance.rate = 0.9;
    currentUtterance.pitch = 1.1;
    currentUtterance.volume = 0.8;
    
    window.speechSynthesis.speak(currentUtterance);
}
    micButton.addEventListener('click', () => {
        if (!isRecording) {
            startRecording();
        } else {
            stopRecording();
        }
    });

    startBtn.addEventListener('click', startRecording);
    stopBtn.addEventListener('click', stopRecording);
    
    resetBtn.addEventListener('click', () => {
        resultsArea.style.display = 'none';
        resultsArea.innerHTML = '';
        loadingArea.style.display = 'none';
        selectedEmotion = null;
        document.querySelectorAll('.emotion-chip').forEach(c => c.classList.remove('selected'));
    });

    // Ajouter les styles d'animation
    const style = document.createElement('style');
    style.textContent = `
        @keyframes floatMessage {
            0% {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            20% {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
            80% {
                opacity: 1;
                transform: translateX(-50%) translateY(-10px);
            }
            100% {
                opacity: 0;
                transform: translateX(-50%) translateY(-30px);
                display: none;
            }
        }
    `;
    document.head.appendChild(style);
</script>
{% endblock %}