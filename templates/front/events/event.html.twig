            filterMarkersByAmbiance(btn.dataset.filter);
        });
    });
}
    function filterMarkersByAmbiance(ambiance) {
        currentFilter = ambiance;
        mapMarkers.forEach(marker => {
            const markerAmbiance = marker.ambiance || 'mod';
            if (ambiance === 'all' || markerAmbiance === ambiance) {
                if (!map.hasLayer(marker)) marker.addTo(map);
            } else {
                if (map.hasLayer(marker)) marker.remove();
            }
        });
        
    }

