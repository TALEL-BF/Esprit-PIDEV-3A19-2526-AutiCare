                                    <p class="card-desc">{{ event.description|slice(0,100) }}{% if event.description|length > 100 %}...{% endif %}</p>
                                   <div class="card-badges">
   
    <span class="badge-group">
        👥 {{ event.maxParticipant <= 15 ? 'Très petit' : (event.maxParticipant <= 30 ? 'Petit' : (event.maxParticipant <= 60 ? 'Moyen' : (event.maxParticipant <= 100 ? 'Grand' : 'Très grand'))) }}
