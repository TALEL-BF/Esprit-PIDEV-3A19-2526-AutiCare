/* Map Filter Bar - Horizontal */
.map-filter-bar {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 500;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border-radius: 50px;
    padding: 6px 12px;
    display: flex;
    gap: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    border: 1px solid rgba(155,107,255,0.2);
}

.map-filter-btn {
    font-family: 'Baloo 2', cursive;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 40px;
    border: none;
    background: #f3e8ff;
    color: #7c3aed;
    cursor: pointer;
    transition: all 0.2s ease;
}

.map-filter-btn:hover {
    transform: scale(1.05);
    background: #e9d5ff;
}

.map-filter-btn.active {
    background: linear-gradient(135deg, #8b5cf6, #a78bfa);
    color: white;
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
}

.map-filter-btn[data-filter="calm"].active { background: linear-gradient(135deg, #10b981, #34d399); color: white; }
.map-filter-btn[data-filter="mod"].active { background: linear-gradient(135deg, #f59e0b, #f97316); color: white; }
.map-filter-btn[data-filter="actif"].active { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }

@media (max-width: 768px) {
    .map-filter-bar { padding: 4px 8px; gap: 4px; }
    .map-filter-btn { padding: 5px 12px; font-size: 0.7rem; }
}
/* ===== LAYERED SIDEBAR ===== */
.panel-layers {
    position: relative;
    height: 100%;
    overflow: hidden;
}

.panel-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateX(100%);
    overflow-y: auto;
    padding: 20px;
    background: white;
    scrollbar-width: thin;
}

.panel-layer.active {
    transform: translateX(0);
    position: relative;
}

