    function drawPreviewRoute(userLat, userLng, eventLat, eventLng) {
        if (previewRoute) { map.removeLayer(previewRoute); }
        previewRoute = L.polyline([[userLat, userLng], [eventLat, eventLng]], {
            color: '#94a3b8', weight: 3, opacity: 0.4, dashArray: '8, 8'
        }).addTo(map);
    }

    function drawRouteOnMap(routeData, type) {
    if (window.routeLayer) { map.removeLayer(window.routeLayer); }
    if (!routeData || !routeData.coordinates || routeData.coordinates.length === 0) return;
    
    const latLngs = routeData.coordinates.map(coord => [coord[1], coord[0]]);
    
    // Style avec pointillés (coupé) pour les DEUX types
    const style = { 
        color: type === 'fast' ? '#3b82f6' : '#10b981',  // bleu pour voiture, vert pour piéton
        weight: 5, 
        opacity: 0.9, 
        dashArray: '12, 12'  // ← LIGNE COUPÉE (pointillés)
    };
    
    window.routeLayer = L.polyline(latLngs, style).addTo(map);
    
    if (window.routeLayer.getBounds && window.routeLayer.getBounds().isValid()) {
        map.fitBounds(window.routeLayer.getBounds(), { padding: [50, 50] });
    }
}

    function selectRoute(type, eventLat, eventLng) {
        activeRouteType = type;
        drawRouteOnMap(type === 'fast' ? currentFastRoute : currentCalmRoute, type);
    }

