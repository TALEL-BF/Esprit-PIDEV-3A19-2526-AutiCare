            </div>
                        <!-- SPLIT LAYOUT: MAP + SIDE PANEL -->
            <div class="map-split-layout" id="splitLayout" style="display: none;">
               <div class="map-wrapper">
    <!-- AJOUTEZ CETTE BARRE DE FILTRES -->
