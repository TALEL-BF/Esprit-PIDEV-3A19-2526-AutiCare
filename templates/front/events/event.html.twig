        window.currentCalmRouteForDrawing = routeData.calm;
        
    } catch (error) {
        console.error('Calmer route error:', error);
        panelDetails.innerHTML = `
            <div style="text-align:center;padding:40px;">
                <div style="font-size: 2rem;">😢</div>
                <div style="color: #ef4444;">Les ours sont fatigués... Réessaie plus tard</div>
                <button onclick="restoreOriginalPanel('${escapeHtml(originalContent.replace(/'/g, "\\'"))}')" class="smart-btn secondary" style="margin-top: 20px;">← Retour</button>
            </div>
        `;
    }
}

// Fonction pour restaurer le panneau original
function restoreOriginalPanel(originalHtml) {
    const panelDetails = document.getElementById('panelDetails');
    panelDetails.innerHTML = originalHtml;
    // Réattacher les événements si nécessaire
}

// Fonction pour dessiner le chemin calme sur la carte
function drawCalmRouteOnMap(eventLat, eventLng) {
    if (window.currentCalmRouteForDrawing && window.currentCalmRouteForDrawing.coordinates) {
        drawRouteOnMap(window.currentCalmRouteForDrawing, 'calm');
        showToast('🌿 Chemin calme affiché sur la carte !', 'success');
    } else {
        showToast('🧸 Le chemin magique n\'est pas encore prêt...', 'error');
    }
}

// Fonction pour réessayer après activation position
function getUserLocationAndRetryCalmerRoute(eventLat, eventLng, eventTitle) {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                userLocation = { lat: position.coords.latitude, lng: position.coords.longitude };
                addUserMarker();
                getCalmerRoute(eventLat, eventLng, eventTitle);
            },
            (error) => {
                showToast('❌ Impossible d\'obtenir ta position', 'error');
            }
        );
    }
}
function requestLocationAndUpdate(eventId) {
    if (askedForLocation && !userLocation) {
        showToast('❌ Localisation refusée', 'error');
        return;
    }
    
    const panelDetails = document.getElementById('panelDetails');
    
    // Vérifier position sauvegardée
    if (localStorage.getItem('userLat') && localStorage.getItem('userLng')) {
        userLocation = {
            lat: parseFloat(localStorage.getItem('userLat')),
            lng: parseFloat(localStorage.getItem('userLng'))
        };
        if (map) {
            addUserMarker();
            map.setView([userLocation.lat, userLocation.lng], 13);
        }
        const event = allMapEvents.find(e => e.id == eventId);
        if (event) updateSidePanel(event);
        return;
    }
    
    askedForLocation = true;
    
    if (panelDetails) {
        panelDetails.innerHTML = `
            <div style="text-align:center;padding:40px;">
                <div style="font-size: 2rem;">📍</div>
                <div style="font-weight: 700; color: #7c3aed; margin-bottom: 10px;">Recherche de ta position...</div>
                <div style="font-size: 0.8rem; color: #64748b;">Cela peut prendre quelques secondes ⏱️</div>
                <div style="margin-top: 15px;"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
        `;
    }
    
    if (navigator.geolocation) {
        // ✅ Ajouter un timeout pour ne pas rester bloqué
        let timeoutId = setTimeout(function() {
            showToast('⏱️ Délai dépassé, utilisation position approximative', 'info');
            useApproximateLocation(eventId);
        }, 8000);
        
        navigator.geolocation.getCurrentPosition(
            function(position) {
                clearTimeout(timeoutId);
                userLocation = { 
                    lat: position.coords.latitude, 
                    lng: position.coords.longitude 
                };
                localStorage.setItem('userLat', userLocation.lat);
                localStorage.setItem('userLng', userLocation.lng);
                showToast('✅ Position trouvée !', 'success');
                
                if (map) {
                    addUserMarker();
                    map.setView([userLocation.lat, userLocation.lng], 13);
                }
                const event = allMapEvents.find(e => e.id == eventId);
                if (event) updateSidePanel(event);
            },
            function(error) {
                clearTimeout(timeoutId);
                console.log('Geolocation error:', error);
                // ✅ Si erreur, utiliser position approximative
                useApproximateLocation(eventId);
            },
            { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
        );
    }
}

// ✅ Nouvelle fonction pour position approximative
function useApproximateLocation(eventId) {
    // Position approximative (centre de Tunis)
    userLocation = { lat: 36.8065, lng: 10.1815 };
    localStorage.setItem('userLat', userLocation.lat);
    localStorage.setItem('userLng', userLocation.lng);
    showToast('📍 Position approximative (Tunis) activée', 'info');
    
    if (map) {
        addUserMarker();
        map.setView([userLocation.lat, userLocation.lng], 12);
    }
    const event = allMapEvents.find(e => e.id == eventId);
    if (event) updateSidePanel(event);
}
function loadSavedLocation() {
    if (localStorage.getItem('userLat') && localStorage.getItem('userLng')) {
        userLocation = {
            lat: parseFloat(localStorage.getItem('userLat')),
            lng: parseFloat(localStorage.getItem('userLng'))
        };
        console.log('📍 Position chargée:', userLocation);
        
        if (map) {
            addUserMarker();
            map.setView([userLocation.lat, userLocation.lng], 13);
        }
        return true;
    }
    return false;
}

 
</script>
{% endblock %}