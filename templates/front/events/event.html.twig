                                    {% elseif event.status == 'annule' %}
                                        <span class="btn-start" style="background:#94a3b8;box-shadow:none;cursor:not-allowed;">
                                            <span>❌ Annulé</span>
                                        </span>
                                    {% else %}
                                        <a href="{{ path('app_event_show', {'id': event.idEvent}) }}" class="btn-start">
                                            <span>Voir détails</span><span class="btn-icon">👀</span>
