// Fonction fallback pour générer des noms de rues
function getGeographicFallbackStreets(fastData) {
    const fallbackStreets = [];
    if (fastData && fastData.route && fastData.route.coordinates) {
        const totalPoints = fastData.route.coordinates.length;
        const step = Math.max(1, Math.floor(totalPoints / 5));
        
        for (let i = 0; i < totalPoints && fallbackStreets.length < 5; i += step) {
            const coord = fastData.route.coordinates[i];
            if (coord && coord[1] && coord[0]) {
                const lat = coord[1];
                const lng = coord[0];
                const directions = ['Nord', 'Est', 'Sud', 'Ouest', 'Centre'];
                const idx = Math.floor(Math.abs(lat + lng) * 10) % directions.length;
                fallbackStreets.push(`Route ${directions[idx]}`);
            }
        }
    }
    
    if (fallbackStreets.length < 3) {
        fallbackStreets.push('Rue Principale', 'Avenue Centrale', 'Boulevard');
    }
    
    return [...new Set(fallbackStreets)];
}


// Fonction fallback pour générer des noms de rues basés sur la géographie
function getGeographicFallbackStreets(fastData) {
    const fallbackStreets = [];
    if (fastData && fastData.route && fastData.route.coordinates) {
        const totalPoints = fastData.route.coordinates.length;
        const step = Math.max(1, Math.floor(totalPoints / 4));
        
        for (let i = 0; i < totalPoints && fallbackStreets.length < 5; i += step) {
            const coord = fastData.route.coordinates[i];
            if (coord && coord[1] && coord[0]) {
                const lat = coord[1];
                const lng = coord[0];
                // Noms basés sur la direction approximative
                const directions = ['Nord', 'Est', 'Sud', 'Ouest', 'Centre'];
                const idx = Math.floor(Math.abs(lat + lng) * 10) % directions.length;
                fallbackStreets.push(`Route ${directions[idx]}`);
            }
        }
    }
    
    // S'assurer qu'on a au moins 3 rues
    if (fallbackStreets.length < 3) {
        fallbackStreets.push('Rue Principale', 'Avenue Centrale', 'Boulevard');
    }
    
    return [...new Set(fallbackStreets)];
}

