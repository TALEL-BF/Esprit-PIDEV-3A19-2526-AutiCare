{# templates/front/therapie/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}AutiCare - Thérapie{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="container-fluid page-header py-5">
        <div class="container text-center py-5">
            <h1 class="display-3 text-white wow fadeInDown">Thérapie</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white">Accueil</a></li>
                    <li class="breadcrumb-item text-secondary active">Thérapie</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Session Types -->
    <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="text-center mx-auto mb-5 wow fadeInUp" style="max-width:700px">
                <div class="bg-secondary text-primary rounded d-inline-block px-3 mb-3" style="border-radius:25% 10% !important">
                    <small>Types de thérapie</small>
                </div>
                <h1 class="display-5">Des approches thérapeutiques spécialisées</h1>
                <p class="text-muted">Toutes nos thérapies sont pratiquées par des spécialistes certifiés en troubles du spectre autistique.</p>
            </div>
            <div class="row g-4">
                {% for therapy in sessionTypes %}
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.{{ loop.index }}s">
                    <div class="session-type-card">
                        <div class="bg-{{ therapy.color }} rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width:80px;height:80px">
                            <i class="fas {{ therapy.icon }} fa-2x text-white"></i>
                        </div>
                        <h4 class="text-primary mb-3">{{ therapy.title }}</h4>
                        <p class="text-muted mb-3">{{ therapy.description }}</p>
                        <div class="d-flex justify-content-center gap-3 mb-4">
                            {% for badge in therapy.badges %}
                                <span class="badge bg-{{ therapy.color }} bg-opacity-10 text-{{ therapy.color }}">{{ badge }}</span>
                            {% endfor %}
                        </div>
                        <a href="#" class="btn btn-primary btn-border-radius text-white px-4">Réserver une séance</a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Therapists -->
    <div class="container-fluid service py-5">
        <div class="container py-5">
            <div class="text-center mx-auto mb-5 wow fadeInUp" style="max-width:700px">
                <div class="bg-secondary text-primary rounded d-inline-block px-3 mb-3" style="border-radius:25% 10% !important">
                    <small>Notre équipe</small>
                </div>
                <h1 class="display-5">Nos Thérapeutes Certifiés</h1>
            </div>
            <div class="row g-4">
                {% for therapist in therapists %}
                <div class="col-md-6 col-lg-3 wow fadeInUp" data-wow-delay="0.{{ loop.index }}s">
                    <div class="therapist-card bg-white p-4 text-center">
                        <div class="therapist-avatar bg-{{ therapist.color }} mb-3" style="color:white; font-size:2rem;">{{ therapist.emoji }}</div>
                        <h5 class="fw-bold text-primary">{{ therapist.name }}</h5>
                        <p class="text-secondary small fw-bold mb-2">{{ therapist.title }}</p>
                        <p class="text-muted small mb-3">{{ therapist.description }}</p>
                        <div class="d-flex justify-content-center gap-2 mb-3">
                            {% for badge in therapist.badges %}
                                <span class="badge bg-{{ therapist.color }} bg-opacity-10 text-{{ therapist.color }} small">{{ badge }}</span>
                            {% endfor %}
                        </div>
                        <a href="#" class="btn btn-outline-primary btn-border-radius btn-sm px-3">Prendre RDV</a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="container-fluid bg-primary py-5 wow fadeIn">
        <div class="container py-3 text-center">
            <h2 class="text-white mb-3">Prêt à commencer votre parcours thérapeutique ?</h2>
            <p class="text-white opacity-75 mb-4">Créez votre compte et réservez une séance d'évaluation gratuite avec l'un de nos spécialistes.</p>
            <a href="#" class="btn btn-secondary btn-border-radius py-3 px-5">
                <i class="fas fa-calendar-check me-2"></i> Réserver une séance gratuite
            </a>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .page-header {
            background: linear-gradient(135deg, #4d65f9 0%, #ff4880 100%);
            padding: 60px 0;
        }
        
        .therapist-card {
            border-radius: 20px;
            overflow: hidden;
            transition: 0.3s;
            box-shadow: 0 5px 30px rgba(0,0,0,0.08);
        }
        .therapist-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 15px 40px rgba(77,101,249,0.2); 
        }
        .therapist-avatar {
            width: 80px; 
            height: 80px;
            border-radius: 50%;
            display: flex; 
            align-items: center; 
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 15px;
        }
        .session-type-card {
            border-radius: 20px;
            border: 2px solid #eee;
            padding: 30px;
            text-align: center;
            transition: 0.3s;
            height: 100%;
        }
        .session-type-card:hover {
            border-color: var(--bs-primary);
            background: rgba(77,101,249,0.03);
            transform: translateY(-5px);
        }
        .btn-border-radius {
            border-radius: 50px !important;
        }
        .bg-opacity-10 {
            --bs-bg-opacity: 0.1;
        }
        .bg-primary.bg-opacity-10 { background-color: rgba(77,101,249,0.1) !important; }
        .bg-secondary.bg-opacity-10 { background-color: rgba(255,72,128,0.1) !important; }
        .bg-success.bg-opacity-10 { background-color: rgba(76,175,80,0.1) !important; }
        .bg-warning.bg-opacity-10 { background-color: rgba(255,152,0,0.1) !important; }
        .bg-info.bg-opacity-10 { background-color: rgba(33,150,243,0.1) !important; }
        .bg-danger.bg-opacity-10 { background-color: rgba(244,67,54,0.1) !important; }
    </style>
{% endblock %}