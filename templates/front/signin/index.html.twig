{# templates/front/signin/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <title>AutiCare - Connexion</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Montserrat:wght@200;400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">

    <style>
        :root {
            --primary: #9b59b6;
            --primary-dark: #8e44ad;
            --primary-light: #af7ac5;
            --secondary: #d2b4de;
            --mauve: #9b59b6;
            --mauve-light: #d7bde2;
            --mauve-dark: #7d3c98;
        }

        .auth-page {
            min-height: 100vh;
            background: linear-gradient(135deg, rgba(155,89,182,0.08) 0%, rgba(155,89,182,0.12) 100%);
            display: flex;
            align-items: center;
            padding: 60px 0;
        }
        .auth-card {
            background: #fff;
            border-radius: 30px;
            box-shadow: 0 20px 60px rgba(155,89,182,0.15);
            overflow: hidden;
        }
        .auth-left {
            background: linear-gradient(160deg, var(--primary) 0%, var(--primary-dark) 100%);
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-height: 500px;
        }
        .auth-left .icon-circle {
            width: 100px;
            height: 100px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
        }
        .auth-right {
            padding: 50px 40px;
        }
        .auth-right .form-control {
            border-radius: 15px;
            padding: 14px 20px;
            border: 2px solid #eee;
            font-size: 15px;
            transition: 0.3s;
        }
        .auth-right .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(155,89,182,0.1);
        }
        .input-icon {
            position: relative;
        }
        .input-icon i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary);
            z-index: 5;
        }
        .input-icon .form-control {
            padding-left: 45px;
        }
        .btn-auth {
            border-radius: 15px;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
            width: 100%;
            border: none;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            transition: 0.3s;
        }
        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(155,89,182,0.4);
        }
        .divider {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 20px 0;
        }
        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #eee;
        }
        .social-btn {
            border: 2px solid #eee;
            border-radius: 12px;
            padding: 10px;
            background: white;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 600;
            color: #444;
            text-decoration: none;
            width: 100%;
        }
        .social-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: translateY(-2px);
        }
        .alert-error {
            background: linear-gradient(135deg, #ff9a9e, #fecfef);
            border: none;
            border-radius: 15px;
            color: #c62828;
            padding: 12px 20px;
            margin-bottom: 20px;
        }
        .alert-success {
            background: linear-gradient(135deg, #d4fc79, #96e6a1);
            border: none;
            border-radius: 15px;
            color: #1e7b1e;
            padding: 12px 20px;
            margin-bottom: 20px;
        }
        .btn-border-radius {
            border-radius: 50px !important;
        }
        .btn-outline-primary {
            border-color: var(--primary);
            color: var(--primary);
        }
        .btn-outline-primary:hover {
            background-color: var(--primary);
            border-color: var(--primary);
        }
        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
        }
        .btn-primary:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
        }
        .text-primary {
            color: var(--primary) !important;
        }
        .text-secondary {
            color: var(--mauve-light) !important;
        }
        .bg-primary {
            background-color: var(--primary) !important;
        }
    </style>
</head>

<body>

    {# Spinner Start #}
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    {# Spinner End #}

    {# Navbar start #}
    <div class="container-fluid border-bottom bg-light position-fixed top-0 start-0 w-100" style="z-index:1000">
        <div class="container px-0">
            <nav class="navbar navbar-light navbar-expand-xl py-2">
                <a href="{{ path('app_home') }}" class="navbar-brand">
                    <h1 class="text-primary display-6 mb-0">Auti<span class="text-secondary">Care</span></h1>
                </a>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="text-muted small">Pas encore inscrit ?</span>
                    <a href="{{ path('app_signup') }}" class="btn btn-primary btn-border-radius px-4 text-white">
                        <i class="fas fa-user-plus me-1"></i> S'inscrire
                    </a>
                </div>
            </nav>
        </div>
    </div>
    {# Navbar End #}

    {# Auth Page #}
    <div class="auth-page" style="padding-top:100px">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10">
                    <div class="auth-card">
                        <div class="row g-0">
                            {# Left Side #}
                            <div class="col-lg-5 d-none d-lg-block">
                                <div class="auth-left h-100">
                                    <div class="icon-circle">
                                        <i class="fas fa-puzzle-piece fa-3x text-white"></i>
                                    </div>
                                    <h2 class="text-white fw-bold mb-3">Bon retour !</h2>
                                    <p class="text-white opacity-75 mb-4">Connectez-vous pour accéder à vos cours, thérapies et jeux éducatifs personnalisés.</p>
                                    <div class="row g-3 w-100">
                                        <div class="col-6">
                                            <div class="bg-white bg-opacity-10 rounded-3 p-3 text-center">
                                                <i class="fas fa-book-open text-white fa-2x mb-2"></i>
                                                <p class="text-white small mb-0">200+ Cours</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-white bg-opacity-10 rounded-3 p-3 text-center">
                                                <i class="fas fa-heart text-white fa-2x mb-2"></i>
                                                <p class="text-white small mb-0">50+ Thérapeutes</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-white bg-opacity-10 rounded-3 p-3 text-center">
                                                <i class="fas fa-gamepad text-white fa-2x mb-2"></i>
                                                <p class="text-white small mb-0">Jeux adaptés</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-white bg-opacity-10 rounded-3 p-3 text-center">
                                                <i class="fas fa-users text-white fa-2x mb-2"></i>
                                                <p class="text-white small mb-0">Communauté</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Right Side #}
                            <div class="col-lg-7">
                                <div class="auth-right">
                                    <div class="mb-4">
                                        <h2 class="fw-bold text-primary mb-1">Connexion</h2>
                                        <p class="text-muted">Accédez à votre espace AutiCare</p>
                                    </div>

                                    {# Affichage des messages flash #}
                                    {% for message in app.flashes('success') %}
                                        <div class="alert-success mb-3">
                                            <i class="fas fa-check-circle me-2"></i>
                                            {{ message }}
                                        </div>
                                    {% endfor %}

                                    {% for message in app.flashes('error') %}
                                        <div class="alert-error mb-3">
                                            <i class="fas fa-exclamation-circle me-2"></i>
                                            {{ message }}
                                        </div>
                                    {% endfor %}

                                    {# Affichage de l'erreur d'authentification #}
                                    {% if error %}
                                        <div class="alert-error">
                                            <i class="fas fa-exclamation-circle me-2"></i>
                                            {{ error.messageKey|trans(error.messageData, 'security') }}
                                        </div>
                                    {% endif %}

                                    {# FORMULAIRE DE CONNEXION #}
                                    <form method="post" action="{{ path('app_signin') }}">
                                        <div class="mb-3">
                                            <label class="form-label fw-600 text-dark">Adresse email</label>
                                            <div class="input-icon">
                                                <i class="fas fa-envelope"></i>
                                                <input
                                                    type="email"
                                                    name="email"
                                                    class="form-control"
                                                    placeholder="votre@email.com"
                                                    value="{{ last_username }}"
                                                    required
                                                    autofocus
                                                >
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label fw-600 text-dark mb-0">Mot de passe</label>
                                                {# LIEN MOT DE PASSE OUBLIÉ CORRIGÉ #}
                                                <a href="{{ path('app_forgot_password') }}" class="text-primary small text-decoration-none">
                                                    Mot de passe oublié ?
                                                </a>
                                            </div>
                                            <div class="input-icon">
                                                <i class="fas fa-lock"></i>
                                                <input
                                                    type="password"
                                                    name="password"
                                                    class="form-control"
                                                    placeholder="••••••••"
                                                    required
                                                >
                                            </div>
                                        </div>

                                        <div class="mb-4 d-flex align-items-center">
                                            <input type="checkbox" name="_remember_me" class="form-check-input me-2" id="remember">
                                            <label for="remember" class="text-muted small">Se souvenir de moi</label>
                                        </div>

                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                        <button class="btn-auth mb-4" type="submit">
                                            <i class="fas fa-sign-in-alt me-2"></i> Se connecter
                                        </button>
                                    </form>

                                    <div class="mb-3">
                                        <a href="#" class="social-btn">
                                            <img src="https://www.google.com/favicon.ico" width="20" alt="Google">
                                            Continuer avec Google
                                        </a>
                                    </div>

                                    <div class="divider">
                                        <span class="text-muted small">ou avec email</span>
                                    </div>

                                    <p class="text-center text-muted">
                                        Pas encore de compte ?
                                        <a href="{{ path('app_signup') }}" class="text-primary fw-bold text-decoration-none">Créer un compte</a>
                                    </p>

                                    <div class="text-center mt-3">
                                        <a href="{{ path('app_home') }}" class="text-muted small text-decoration-none">
                                            <i class="fas fa-arrow-left me-1"></i> Retour à l'accueil
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# JavaScript Libraries #}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        setTimeout(() => {
            document.getElementById('spinner').classList.remove('show');
        }, 500);
    </script>
</body>

</html>