{% extends "base.html.twig" %}

{% block title %}Parent Dashboard - AutiCare{% endblock %}

{% block page_title %}Dashboard Parent{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="welcome-card" style="background: linear-gradient(135deg, #9b59b6, #8e44ad);">
        <h2>Bienvenue, {{ app.user.prenom }} {{ app.user.nom }} !</h2>
        <p>Espace Parent - Suivez la progression de vos enfants</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-week"></i><h4>Emploi du temps</h4><p>Planning</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-book-open"></i><h4>Cours</h4><p>Accès aux cours</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-gamepad"></i><h4>Jeux</h4><p>Jeux éducatifs</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-heartbeat"></i><h4>Suivi thérapeutique</h4><p>Progression</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-calendar-alt"></i><h4>Événements</h4><p>Ateliers</p></div></div>
        <div class="col-md-4"><div class="dashboard-card"><i class="fas fa-newspaper"></i><h4>Articles</h4><p>Conseils</p></div></div>
    </div>
</div>
{% endblock %}