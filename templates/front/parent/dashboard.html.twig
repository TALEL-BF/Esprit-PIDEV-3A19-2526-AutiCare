{% extends 'base.html.twig' %}

{% block title %}Espace Professeur - AutiCare{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card bg-success text-white p-4 mb-4 shadow">
                <h1><i class="fas fa-chalkboard-user"></i> Espace Professeur</h1>
                <p class="mb-0">Bienvenue <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong></p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-book-open fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Mes Cours</h5>
                    <p class="card-text text-muted">Gérer vos cours</p>
                    <a href="#" class="btn btn-primary">Accéder</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-users fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Mes Élèves</h5>
                    <p class="card-text text-muted">Suivre vos élèves</p>
                    <a href="#" class="btn btn-success">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <i class="fas fa-calendar-alt fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Planning</h5>
                    <p class="card-text text-muted">Votre emploi du temps</p>
                    <a href="#" class="btn btn-warning">Consulter</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}