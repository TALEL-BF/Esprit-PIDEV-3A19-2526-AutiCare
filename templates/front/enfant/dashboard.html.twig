{% extends "base.html.twig" %}

{% block title %}Espace Enfant - AutiCare{% endblock %}

{% block page_title %}Mon Espace{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="welcome-card" style="background: linear-gradient(135deg, #9b59b6, #8e44ad);">
        <h2>Bonjour, {{ app.user.prenom }} !</h2>
        <p>Prêt à apprendre et t'amuser ? 🌟</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-book-open"></i>
                <h4>Mes cours</h4>
                <p>Apprendre</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-gamepad"></i>
                <h4>Mes jeux</h4>
                <p>Jouer</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-calendar-week"></i>
                <h4>Emploi du temps</h4>
                <p>Mon planning</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-calendar-alt"></i>
                <h4>Événements</h4>
                <p>À venir</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-trophy"></i>
                <h4>Récompenses</h4>
                <p>Mes trophées</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}