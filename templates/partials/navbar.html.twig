{# templates/partials/navbar.html.twig #}
<div class="container-fluid border-bottom bg-light wow fadeIn" data-wow-delay="0.1s">
    <div class="container topbar bg-primary d-none d-lg-block py-2" style="border-radius: 0 40px">
        <div class="d-flex justify-content-between">
            <div class="top-info ps-2">
                <small class="me-3">
                    <i class="fas fa-map-marker-alt me-2 text-secondary"></i>
                    <a href="#" class="text-white">Tunis, Tunisie</a>
                </small>
                <small class="me-3">
                    <i class="fas fa-envelope me-2 text-secondary"></i>
                    <a href="#" class="text-white">contact@AutiCare.tn</a>
                </small>
            </div>
            <div class="top-link pe-2">
                <a href="#" class="btn btn-light btn-sm-square rounded-circle"><i class="fab fa-facebook-f text-secondary"></i></a>
                <a href="#" class="btn btn-light btn-sm-square rounded-circle"><i class="fab fa-twitter text-secondary"></i></a>
                <a href="#" class="btn btn-light btn-sm-square rounded-circle"><i class="fab fa-instagram text-secondary"></i></a>
                <a href="#" class="btn btn-light btn-sm-square rounded-circle me-0"><i class="fab fa-linkedin-in text-secondary"></i></a>
            </div>
        </div>
    </div>
    <div class="container px-0">
        <nav class="navbar navbar-light navbar-expand-xl py-3">
            <a href="{{ path('app_home') }}" class="navbar-brand">
                <h1 class="text-primary display-6">Auti<span class="text-secondary">Care</span></h1>
            </a>
            <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars text-primary"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav mx-auto">
                    <a href="{{ path('app_home') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">
                        <i class="fas fa-home me-1 text-secondary"></i> Accueil
                    </a>
                    <a href="{{ path('app_cours') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_cours' ? 'active' : '' }}">
                        <i class="fas fa-book-open me-1 text-secondary"></i> Cours
                    </a>
                    <a href="{{ path('app_events') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_events' or app.request.get('_route') == 'app_evenements' ? 'active' : '' }}">
                        <i class="fas fa-calendar-alt me-1 text-secondary"></i> Événements
                    </a>

                    {# 🔥 ESPACE SANTÉ AVEC SOUS-MENU AMÉLIORÉ (CSS inclus) #}
                    {% set sante_active = app.request.get('_route') in ['app_articles', 'app_suivie'] %}
                    <div class="nav-item dropdown d-flex align-items-center">
                        <a href="#"
                           class="nav-link dropdown-toggle d-flex align-items-center {{ sante_active ? 'active' : '' }}"
                           data-bs-toggle="dropdown">
                            <i class="fas fa-notes-medical me-2 text-secondary"></i>
                            Espace Santé
                        </a>
                        <div class="dropdown-menu dropdown-sante border-0 shadow-lg p-0">
                            <div class="dropdown-sante-header">
                                <i class="fas fa-heart-pulse me-2"></i> Espace Santé
                            </div>
                            <div class="dropdown-sante-body">
                                <a href="{{ path('app_articles') }}"
                                   class="dropdown-sante-item {{ app.request.get('_route') == 'app_articles' ? 'active' : '' }}">
                                    <div class="dropdown-sante-icon" style="background:#f0f3ff;">
                                        <i class="fas fa-newspaper" style="color:#4d65f9;"></i>
                                    </div>
                                    <div>
                                        <div class="dropdown-sante-title">Articles & Conseils</div>
                                        <div class="dropdown-sante-sub">Ressources TSA</div>
                                    </div>
                                </a>
                                <div class="dropdown-sante-divider"></div>
                                <a href="{{ path('app_suivie') }}"
                                   class="dropdown-sante-item {{ app.request.get('_route') == 'app_suivie' ? 'active' : '' }}">
                                    <div class="dropdown-sante-icon" style="background:#fdf4ff;">
                                        <i class="fas fa-brain" style="color:#a855f7;"></i>
                                    </div>
                                    <div>
                                        <div class="dropdown-sante-title">Suivi Thérapeutique</div>
                                        <div class="dropdown-sante-sub">Évolution de l'enfant</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <a href="{{ path('app_jeux') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_jeux' ? 'active' : '' }}">
                        <i class="fas fa-gamepad me-1 text-secondary"></i> Jeux
                    </a>
                    <a href="{{ path('app_planning') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_planning' ? 'active' : '' }}">
                        <i class="fas fa-calendar-week me-1 text-secondary"></i> Planning
                    </a>
                    <a href="{{ path('app_contact') }}" class="nav-item nav-link {{ app.request.get('_route') == 'app_contact' ? 'active' : '' }}">
                        <i class="fas fa-envelope me-1 text-secondary"></i> Contact
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="{{ path('app_signin') }}" class="btn btn-outline-primary btn-border-radius px-4">
                        <i class="fas fa-sign-in-alt me-1"></i> Connexion
                    </a>
                    <a href="{{ path('app_signup') }}" class="btn btn-primary btn-border-radius px-4 text-white">
                        <i class="fas fa-user-plus me-1"></i> Inscription
                    </a>
                </div>
            </div>
        </nav>
    </div>
</div>

{# STYLES DÉDIÉS À L'AMÉLIORATION VISUELLE DU SOUS-MENU ESPACE SANTÉ #}
<style>
    /* Amélioration du conteneur principal du sous-menu */
    .dropdown-menu.dropdown-sante {
        min-width: 320px;
        border-radius: 24px;
        border: none;
        padding: 0;
        margin-top: 12px;
        background: #ffffff;
        box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.18), 0 1px 3px rgba(0, 0, 0, 0.05);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    /* En-tête du sous-menu */
    .dropdown-sante-header {
        padding: 16px 20px;
        background: linear-gradient(115deg, #fafcff 0%, #ffffff 100%);
        border-bottom: 1px solid #eef2ff;
        font-weight: 700;
        font-size: 1.05rem;
        color: #0f2b3d;
        letter-spacing: -0.2px;
        display: flex;
        align-items: center;
    }

    .dropdown-sante-header i {
        color: #2c7da0;
        font-size: 1.2rem;
    }

    /* Zone des éléments */
    .dropdown-sante-body {
        padding: 12px;
    }

    /* Chaque ligne du menu */
    .dropdown-sante-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: 18px;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        margin-bottom: 4px;
        background: transparent;
    }

    .dropdown-sante-item:last-child {
        margin-bottom: 0;
    }

    /* Effet au survol */
    .dropdown-sante-item:hover {
        background: #f8fafd;
        transform: translateX(6px);
    }

    /* État actif (page en cours) */
    .dropdown-sante-item.active {
        background: #f0f4fe;
        box-shadow: inset 0 0 0 1px rgba(77, 101, 249, 0.2);
    }

    .dropdown-sante-item.active .dropdown-sante-title {
        color: #1e40af;
    }

    /* Icône */
    .dropdown-sante-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        font-size: 1.35rem;
        transition: transform 0.2s ease;
        flex-shrink: 0;
    }

    .dropdown-sante-item:hover .dropdown-sante-icon {
        transform: scale(1.02);
    }

    /* Titre et sous-titre */
    .dropdown-sante-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: #0c2d3f;
        margin-bottom: 4px;
        line-height: 1.3;
    }

    .dropdown-sante-sub {
        font-size: 0.72rem;
        color: #5b6e8c;
        letter-spacing: 0.2px;
        font-weight: 450;
    }

    /* Séparateur */
    .dropdown-sante-divider {
        height: 1px;
        background: linear-gradient(90deg, #eef2ff, #dce3f0, #eef2ff);
        margin: 8px 12px;
    }

    /* Petit réglage pour l’animation d’ouverture (optionnel, booste l’expérience) */
    .dropdown-menu.dropdown-sante.show {
        animation: dropdownFadeIn 0.2s ease-out;
    }

    @keyframes dropdownFadeIn {
        0% {
            opacity: 0;
            transform: translateY(-8px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Adaptation pour les très petits écrans (optionnel, conserve la lisibilité) */
    @media (max-width: 768px) {
        .dropdown-menu.dropdown-sante {
            min-width: 280px;
        }
        .dropdown-sante-icon {
            width: 42px;
            height: 42px;
            font-size: 1.2rem;
        }
        .dropdown-sante-title {
            font-size: 0.9rem;
        }
        .dropdown-sante-sub {
            font-size: 0.7rem;
        }
    }
</style>