{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Détail du niveau{% endblock %}
{% block page_title %}Jeu — Détail du niveau{% endblock %}

{% block body %}
<div class="page-header">
    <h2><i class="fas fa-eye me-2" style="color:var(--purple-500)"></i>Détail du niveau</h2>
    <p>Consulter les informations du niveau sélectionné</p>
</div>

<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-info-circle"></i> Informations</span>
    </div>
    <div class="card-box-body p-0">
        <div class="table-wrapper">
            <table class="custom-table">
                <tbody>
                    <tr>
                        <th style="width: 260px;">ID</th>
                        <td>{{ niveau_jeu.id }}</td>
                    </tr>
                    <tr>
                        <th>Libellé</th>
                        <td>{{ niveau_jeu.libelle }}</td>
                    </tr>
                    <tr>
                        <th>Min moyenne</th>
                        <td>{{ niveau_jeu.minMoyenne }}</td>
                    </tr>
                    <tr>
                        <th>Max moyenne</th>
                        <td>{{ niveau_jeu.maxMoyenne }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ niveau_jeu.description ?: '-' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a href="{{ path('app_niveau_jeu_index') }}" class="btn-outline-purple text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour
    </a>

    <a href="{{ path('app_niveau_jeu_edit', {'id': niveau_jeu.id}) }}" class="btn-purple text-decoration-none">
        <i class="fas fa-pen me-1"></i> Modifier
    </a>
</div>
{% endblock %}