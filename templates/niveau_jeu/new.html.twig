{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Ajouter un niveau{% endblock %}
{% block page_title %}Jeu — Ajouter un niveau{% endblock %}

{% block body %}
<div class="page-header">
    <h2><i class="fas fa-plus-circle me-2" style="color:var(--purple-500)"></i>Ajouter un niveau</h2>
    <p>Créer un nouveau niveau de difficulté</p>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-layer-group"></i> Nouveau niveau</span>
        <span class="form-mode-badge">Mode : Ajout</span>
    </div>
    <div class="card-box-body">
        {% include 'niveau_jeu/_form.html.twig' with {form: form, button_label: 'Enregistrer'} %}
    </div>
</div>
{% endblock %}