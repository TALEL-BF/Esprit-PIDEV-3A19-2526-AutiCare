{% extends 'admin/base_admin.html.twig' %}

{% block title %}Auticare — Modifier un niveau{% endblock %}
{% block page_title %}Jeu — Modifier un niveau{% endblock %}

{% block body %}
<div class="page-header">
    <h2><i class="fas fa-pen me-2" style="color:var(--purple-500)"></i>Modifier un niveau</h2>
    <p>Mettre à jour les paramètres du niveau</p>
</div>

<div class="card-box mb-4">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-edit"></i> Édition du niveau</span>
        <span class="form-mode-badge">Mode : Modification</span>
    </div>
    <div class="card-box-body">
        {% include 'niveau_jeu/_form.html.twig' with {form: form, button_label: 'Modifier'} %}
    </div>
</div>

<div class="card-box">
    <div class="card-box-header">
        <span class="card-box-title"><i class="fas fa-trash-alt"></i> Suppression</span>
    </div>
    <div class="card-box-body">
        {% include 'niveau_jeu/_delete_form.html.twig' with {niveau_jeu: niveau_jeu} %}
    </div>
</div>
{% endblock %}