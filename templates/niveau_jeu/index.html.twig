{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Niveaux de Jeu{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.dashboard-header {
    margin-bottom: 40px;
}

.dashboard-title {
    font-size: 2rem;
    font-weight: 700;
    color: #8b5cf6;
    margin-bottom: 5px;
}

.dashboard-subtitle {
    font-size: 1rem;
    color: #999;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-content h3 {
    font-size: 0.85rem;
    color: #999;
    margin-bottom: 8px;
    font-weight: 500;
}

.stat-number {
    font-size: 1.8rem;
    font-weight: 700;
    color: #8b5cf6;
}

.stat-trend {
    font-size: 0.8rem;
    color: #10b981;
    margin-top: 5px;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.icon-purple { background: #e9d5ff; }
.icon-pink { background: #fbcfe8; }
.icon-blue { background: #dbeafe; }
.icon-green { background: #dcfce7; }

.form-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    margin-bottom: 40px;
}

.form-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f0f0f0;
}

.form-section-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: #333;
}

.form-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
}

.form-wrapper {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
    font-size: 0.9rem;
}

.form-group input,
.form-group textarea,
.form-group select {
    padding: 12px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
}

.form-group textarea {
    resize: vertical;
    min-height: 100px;
}

.chart-placeholder {
    background: linear-gradient(135deg, #f5f5f5 0%, #efefef 100%);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chart-container {
    position: relative;
    height: 300px;
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.btn-primary {
    background: #8b5cf6;
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: #7c3aed;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
}

.btn-secondary {
    background: white;
    color: #999;
    padding: 12px 24px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-secondary:hover {
    border-color: #999;
}

.table-section {
    background: white;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f0f0f0;
}

.niveau-table {
    width: 100%;
    border-collapse: collapse;
}

.niveau-table th {
    background: #f9f5ff;
    padding: 15px;
    text-align: left;
    font-weight: 600;
    color: #8b5cf6;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.niveau-table td {
    padding: 15px;
    border-bottom: 1px solid #f0f0f0;
    color: #333;
}

.niveau-table tbody tr:hover {
    background: #f9f5ff;
}

.difficulty-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.8rem;
}

.difficulty-facile {
    background: #dbeafe;
    color: #1e40af;
}

.difficulty-moyen {
    background: #fbcfe8;
    color: #831843;
}

.difficulty-difficile {
    background: #fee2e2;
    color: #991b1b;
}

.action-buttons-table {
    display: flex;
    gap: 8px;
}

.btn-table {
    padding: 6px 12px;
    border: 1px solid #e9d5ff;
    background: white;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.8rem;
    text-decoration: none;
    color: #8b5cf6;
}

.btn-table:hover {
    background: #f9f5ff;
    border-color: #8b5cf6;
}

.search-bar {
    margin-bottom: 20px;
}

.search-bar input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 0.95rem;
}

.search-bar input::placeholder {
    color: #999;
}

.empty-state {
    text-align: center;
    padding: 40px;
    color: #999;
}

.empty-icon {
    font-size: 3rem;
    margin-bottom: 15px;
}

.empty-title {
    font-size: 1.1rem;
    color: #333;
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    .form-content {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="hero-banner">
    <div class="hero-content">
        <h1 class="hero-title">🎮 Gestion des Niveaux de Jeu</h1>
        <p class="hero-subtitle">Configurer les niveaux et leurs difficultés</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-content">
            <h3>Niveaux actifs</h3>
            <div class="stat-number">{{ niveau_jeus|length }}</div>
            <div class="stat-trend">↑ Total</div>
        </div>
        <div class="stat-icon icon-purple">🎯</div>
    </div>

    <div class="stat-card">
        <div class="stat-content">
            <h3>Difficulté Moyen</h3>
            <div class="stat-number">
                {% set count = 0 %}
                {% for nj in niveau_jeus %}
                    {% if nj.libelle == 'FACILE' %}
                        {% set count = count + 1 %}
                    {% endif %}
                {% endfor %}
                {{ (niveau_jeus|length > 0) ? ((count / niveau_jeus|length) * 100)|round : 0 }}%
            </div>
            <div class="stat-trend">↑ configurés</div>
        </div>
        <div class="stat-icon icon-pink">📊</div>
    </div>

    <div class="stat-card">
        <div class="stat-content">
            <h3>Score Maximum</h3>
            <div class="stat-number">
                {% set maxScore = 0 %}
                {% for nj in niveau_jeus %}
                    {% if nj.maxMoyenne > maxScore %}
                        {% set maxScore = nj.maxMoyenne %}
                    {% endif %}
                {% endfor %}
                {{ maxScore|number_format(0) }}
            </div>
            <div class="stat-trend">↑ Meilleur</div>
        </div>
        <div class="stat-icon icon-blue">⭐</div>
    </div>

    <div class="stat-card">
        <div class="stat-content">
            <h3>Jeux Associés</h3>
            <div class="stat-number">
                {% set totalJeux = 0 %}
                {% for nj in niveau_jeus %}
                    {% set totalJeux = totalJeux + nj.suiviTotals|length %}
                {% endfor %}
                {{ totalJeux }}
            </div>
            <div class="stat-trend">↑ en cours</div>
        </div>
        <div class="stat-icon icon-green">🎮</div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-header">
        <span>ℹ️</span>
        <div>
            <h2 class="form-section-title">Ajouter / Modifier un Niveau</h2>
            <small style="color: #999;">Mode: Ajout</small>
        </div>
    </div>

    <div class="form-content">
        <div class="form-wrapper">
            {{ form_start(form) }}

            <div class="form-group">
                {{ form_label(form.libelle, 'Niveau') }}
                {{ form_widget(form.libelle) }}
            </div>

            <div class="form-group">
                {{ form_label(form.minMoyenne, 'Moyenne minimale') }}
                {{ form_widget(form.minMoyenne) }}
            </div>

            <div class="form-group">
                {{ form_label(form.maxMoyenne, 'Moyenne maximale') }}
                {{ form_widget(form.maxMoyenne) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description, 'Description') }}
                {{ form_widget(form.description) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">💾 Enregistrer</button>
                <a href="{{ path('app_niveau_jeu_index') }}" class="btn-secondary">✕ Annuler</a>
            </div>

            {{ form_end(form) }}
        </div>

        <div class="chart-placeholder">
            <div class="chart-container">
                <canvas id="difficultyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Graphique des niveaux par difficulté
document.addEventListener('DOMContentLoaded', function() {
    const difficultyData = {};

    {% for niveau in niveau_jeus %}
        const diff = '{{ niveau.libelle }}';
        difficultyData[diff] = (difficultyData[diff] || 0) + 1;
    {% endfor %}

    const ctx = document.getElementById('difficultyChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: Object.keys(difficultyData),
            datasets: [{
                data: Object.values(difficultyData),
                backgroundColor: ['#8b5cf6', '#d946ef', '#ec4899'],
                borderColor: '#fff',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { padding: 20 } }
            }
        }
    });
});
    </script>

    <div class="table-section">
        <div class="table-header">
            <div class="search-bar" style="flex:1; max-width:300px;">
                <input type="text" id="searchInput" placeholder="Rechercher..." />
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn-primary" id="sortBtn">Trier</button>
                <button class="btn-primary" id="exportPdfBtn">Exporter PDF</button>
                <button class="btn-primary" id="exportCsvBtn">Exporter CSV</button>
            </div>
        </div>
        <table class="niveau-table" id="niveauTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Libellé</th>
                    <th>Min</th>
                    <th>Max</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
            {% for niveau in niveau_jeus %}
                <tr>
                    <td>{{ niveau.id }}</td>
                    <td>{{ niveau.libelle }}</td>
                    <td>{{ niveau.minMoyenne }}</td>
                    <td>{{ niveau.maxMoyenne }}</td>
                    <td>{{ niveau.description }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="empty-state">Aucun niveau trouvé</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.7.0/jspdf.plugin.autotable.min.js"></script>
    <script>
    // Filtrage
    document.getElementById('searchInput').addEventListener('keyup', function() {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll('#niveauTable tbody tr');
        rows.forEach(row => {
            let text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
    // Tri simple sur ID
    let asc = true;
    document.getElementById('sortBtn').onclick = function() {
        let tbody = document.querySelector('#niveauTable tbody');
        let rows = Array.from(tbody.querySelectorAll('tr')).filter(r=>r.style.display!=='none');
        rows.sort((a, b) => {
            let aVal = parseInt(a.children[0].textContent);
            let bVal = parseInt(b.children[0].textContent);
            return asc ? aVal - bVal : bVal - aVal;
        });
        asc = !asc;
        rows.forEach(r => tbody.appendChild(r));
    };
    // Export CSV
    document.getElementById('exportCsvBtn').onclick = function() {
        let rows = document.querySelectorAll('#niveauTable tr');
        let csv = Array.from(rows).map(row =>
            Array.from(row.children).map(cell => '"'+cell.textContent.replace(/"/g,'""')+'"').join(',')
        ).join('\n');
        let blob = new Blob([csv], {type: 'text/csv'});
        let a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'niveaux.csv';
        a.click();
    };
    // Export PDF
    document.getElementById('exportPdfBtn').onclick = function() {
        const { jsPDF } = window.jspdf;
        let doc = new jsPDF();
        doc.autoTable({ html: '#niveauTable' });
        doc.save('niveaux.pdf');
    };
    </script>
{% endblock %}