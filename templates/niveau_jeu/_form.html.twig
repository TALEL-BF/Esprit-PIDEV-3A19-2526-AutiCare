{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'niveau-form'}}) }}

<div class="row g-3">
    <div class="col-md-6">
        {{ form_label(form.libelle, 'Niveau', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.libelle, {'attr': {'class': 'form-select'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.libelle) }}</div>
    </div>

    <div class="col-md-3">
        {{ form_label(form.minMoyenne, 'Min moyenne', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.minMoyenne, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 0'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.minMoyenne) }}</div>
    </div>

    <div class="col-md-3">
        {{ form_label(form.maxMoyenne, 'Max moyenne', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.maxMoyenne, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 10'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.maxMoyenne) }}</div>
    </div>

    <div class="col-12">
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Décris brièvement ce niveau...'}}) }}
        <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <button class="btn-purple">
        <i class="fas fa-save me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>

    <a href="{{ path('app_niveau_jeu_index') }}" class="btn-outline-purple text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour
    </a>
</div>
<script>
document.querySelector('form').addEventListener('submit', function(e) {
    let min = parseFloat(document.querySelector('[name$="[minMoyenne]"]').value);
    let max = parseFloat(document.querySelector('[name$="[maxMoyenne]"]').value);

    if (min >= max) {
        alert("Min doit être inférieur à Max");
        e.preventDefault();
    }
});
</script>
{{ form_end(form) }}