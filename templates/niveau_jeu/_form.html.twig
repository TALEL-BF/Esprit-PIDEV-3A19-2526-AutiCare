{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="mb-3">
    {{ form_label(form.libelle, 'Niveau', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.libelle, {'attr': {'class': 'form-select'}}) }}
    <div class="text-danger small mt-1">{{ form_errors(form.libelle) }}</div>
</div>

<div class="mb-3">
    {{ form_label(form.minMoyenne, 'Min moyenne', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.minMoyenne, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 0.00'}}) }}
    <div class="text-danger small mt-1">{{ form_errors(form.minMoyenne) }}</div>
</div>

<div class="mb-3">
    {{ form_label(form.maxMoyenne, 'Max moyenne', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.maxMoyenne, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 10.00'}}) }}
    <div class="text-danger small mt-1">{{ form_errors(form.maxMoyenne) }}</div>
</div>

<div class="mb-3">
    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Décris brièvement ce niveau...'}}) }}
    <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
</div>

<div class="d-flex gap-2 mt-4">
    <button class="btn-purple" type="submit">
        <i class="fas fa-save me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>

    <a href="{{ path('app_niveau_jeu_index') }}" class="btn-outline-purple text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour
    </a>
</div>

{{ form_end(form) }}