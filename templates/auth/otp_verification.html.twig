<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Vérification OTP - AutiCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #9b59b6, #8e44ad); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border-radius: 20px; max-width: 450px; width: 90%; }
        .otp-input { font-size: 28px; text-align: center; letter-spacing: 10px; }
        .btn-primary { background: #9b59b6; border: none; border-radius: 12px; padding: 12px; }
    </style>
</head>
<body>
    <div class="card p-4">
        <h3 class="text-center mb-3">🔐 Vérification OTP</h3>
        <p class="text-center">Entrez le code à 6 chiffres reçu par email</p>
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        <form method="post">
            <input type="text" name="otp" class="form-control otp-input mb-3" placeholder="000000" maxlength="6" required autofocus>
            <button type="submit" class="btn btn-primary w-100">✅ Vérifier le code</button>
        </form>
        <div class="text-center mt-3"><a href="{{ path('app_forgot_password') }}">← Retour</a></div>
    </div>
</body>
</html>