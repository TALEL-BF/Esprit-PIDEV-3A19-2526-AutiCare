<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mot de passe oublié - AutiCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #9b59b6, #8e44ad); min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border-radius: 20px; max-width: 450px; width: 90%; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
        .card-header { background: linear-gradient(135deg, #9b59b6, #8e44ad); color: white; text-align: center; padding: 25px; border-radius: 20px 20px 0 0; }
        .card-header h3 { margin: 0; font-weight: 600; }
        .card-body { padding: 30px; }
        .form-control { border-radius: 12px; padding: 12px 15px; border: 1px solid #ddd; }
        .form-control:focus { border-color: #9b59b6; box-shadow: 0 0 0 3px rgba(155,89,182,0.1); }
        .btn-primary { background: #9b59b6; border: none; border-radius: 12px; padding: 12px; font-weight: 600; width: 100%; }
        .btn-primary:hover { background: #8e44ad; transform: translateY(-2px); }
        .alert { border-radius: 12px; border: none; }
        .alert-success { background: linear-gradient(135deg, #d4fc79, #96e6a1); color: #1e7b1e; }
        .alert-danger { background: linear-gradient(135deg, #ff9a9e, #fecfef); color: #c62828; }
        a { color: #9b59b6; text-decoration: none; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-key"></i> Mot de passe oublié</h3>
            <p class="mb-0 mt-2">Entrez votre email pour réinitialiser votre mot de passe</p>
        </div>
        <div class="card-body">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Adresse email</label>
                    <input type="email" name="email" class="form-control" placeholder="votre@email.com" required autofocus>
                </div>
                <button type="submit" class="btn-primary">Envoyer le code</button>
            </form>
            
            <div class="text-center mt-3">
                <a href="{{ path('app_signin') }}">← Retour à la connexion</a>
            </div>
        </div>
    </div>
</body>
</html>