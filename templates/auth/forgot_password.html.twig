<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mot de passe oublié - AutiCare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #9b59b6, #8e44ad); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border-radius: 20px; max-width: 450px; width: 90%; }
        .btn-primary { background: #9b59b6; border: none; border-radius: 12px; padding: 12px; }
    </style>
</head>
<body>
    <div class="card p-4">
        <h3 class="text-center mb-3">🔐 Mot de passe oublié</h3>
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        <form method="post">
            <input type="email" name="email" class="form-control mb-3" placeholder="Votre email" required>
            <button type="submit" class="btn btn-primary w-100">📧 Envoyer le code OTP</button>
        </form>
<form method="post" action="{{ path('app_forgot_password') }}">
    </div>
</body>
</html>