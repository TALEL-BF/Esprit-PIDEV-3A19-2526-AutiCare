{% extends 'base.html.twig' %}

{% block title %}ArticleEntity{% endblock %}

{% block body %}
    <h1>ArticleEntity</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article_entity.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ article_entity.titre }}</td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>{{ article_entity.contenu }}</td>
            </tr>
            <tr>
                <th>Categorie</th>
                <td>{{ article_entity.categorie }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ article_entity.dateCreation ? article_entity.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Auteur</th>
                <td>{{ article_entity.auteur }}</td>
            </tr>
            <tr>
                <th>LikesCount</th>
                <td>{{ article_entity.likesCount }}</td>
            </tr>
            <tr>
                <th>AuteurImage</th>
                <td>{{ article_entity.auteurImage }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_article_index') }}">back to list</a>

    <a href="{{ path('app_article_edit', {'id': article_entity.id}) }}">edit</a>

    {{ include('article/_delete_form.html.twig') }}
{% endblock %}
